+def _icmp_ping(ip, timeout_ms=800):
+    """Round trip to ip in ms through Windows' IcmpSendEcho (no admin rights, no child process)."""
+    try:
+        import ctypes, socket, struct
+        icmp = ctypes.windll.iphlpapi
+        icmp.IcmpCreateFile.restype = ctypes.c_void_p
+        handle = icmp.IcmpCreateFile()
+        if not handle or handle == ctypes.c_void_p(-1).value:
+            return None
+        try:
+            address = struct.unpack('<I', socket.inet_aton(ip))[0]
+            data = b'duskpanel'
+            reply = ctypes.create_string_buffer(64 + len(data))
+            icmp.IcmpSendEcho.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_char_p, ctypes.c_uint16,
+                                          ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32]
+            count = icmp.IcmpSendEcho(handle, address, data, len(data), None, reply, len(reply), timeout_ms)
+            if count == 0:
+                return None
+            status, rtt = struct.unpack_from('<II', reply.raw, 4)
+            return rtt if status == 0 else None
+        finally:
+            icmp.IcmpCloseHandle.argtypes = [ctypes.c_void_p]
+            icmp.IcmpCloseHandle(handle)
+    except Exception:
+        return None
