+            row = {'pid': pid, 'ip': ip, 'local': local, 'seen_ago': round(idle, 1),
+                   'connected_for': round(now - player.get('since', now)), 'last': player.get('last', ''),
+                   'searches': player.get('searches', 0), 'matches': player.get('matches', 0)}
+            ping = _pings.get(ip)
+            row['ping_ms'] = 0 if local else (ping[1] if ping and now - ping[0] < 10 else None)
+            row['ping_kind'] = 'this PC' if local else 'network'
+            if game and game.get('in_session'):
+                if local:
+                    row['phase'] = game.get('phase')
+                    row['clock_left'] = game.get('clock_left')
+                    row['player_no'] = game.get('player_no')
+                    if game.get('join_state') == 8:
+                        status, kind = PHASE_NAMES.get(game.get('phase'), 'In a match'), 'match'
+                    else:
