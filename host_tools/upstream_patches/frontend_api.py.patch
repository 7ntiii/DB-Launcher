+            elif kind == 'match' and (game is None or not game.get('in_session')) and ticket \
+                    and now - ticket['matched'] > 60 and local:
+                status, detail, kind = 'In the menus', '', 'menu'      # the match is over on this PC
+            if idle > 180 and kind != 'match':
+                status, kind = 'Not responding', 'gone'
+            if ticket and ticket['state'] == 'waiting':
+                row['search_left'] = _search_left(pid, now)
+            if tailscale and not local and not _in_tailscale(_p2p_address(ip)[0]):
+                # joined with a home address: no path to the players outside the home
