+def _p2p_record(ip, port):
+    """The 32-byte p2p_host_info the game accepts (decoder main+0x14d4d40): u32 1, u32 24, then
+    u32 IPv4 (LE of a<<24|b<<16|c<<8|d), u16 port LE, u16 0, 16 zero bytes. Anything else is
+    rejected silently (the endless "Connecting...")."""
+    try:
+        a, b, c, d = (int(x) for x in ip.split('.'))
+    except ValueError:
+        return []
+    rec = (1).to_bytes(4, 'little') + (24).to_bytes(4, 'little')
+    rec += ((a << 24) | (b << 16) | (c << 8) | d).to_bytes(4, 'little') + port.to_bytes(2, 'little')
+    rec += bytes(18)
+    return list(rec)
+
