+# v4.43 HOSTTEXT: the host's text for the players' screens. The game on this PC (core/dusk_lan.cpp
+# HostText) reads dusk_lan_say.txt once a second, shows the text and sends it to the other games.
+# Same channel as dusk_lan_match.txt: a small file, written atomically, in the two places the game looks
+# (next to the status file, and in this lan_fix folder). Format: "say <seq> <target> <unix time>" and, on
+# the next line, the text in UTF-8. target 0 = every player, else a player number (1..8).
+SAY_MAX = 60
+_say = {'at': 0.0, 'seq': 0}
