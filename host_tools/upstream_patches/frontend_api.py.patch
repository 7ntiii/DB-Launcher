+def _ping_loop():
+    while True:
+        with _lock:
+            ips = {p['ip'] for p in _players.values() if time.time() - p['seen'] < 600}
+        for ip in ips:
+            target = _p2p_address(ip)[0]         # N8: a relayed second game (127.0.1.d) is at <LAN>.d
+            if target.startswith('127.') or target in ('::1', '?'):
+                continue
+            _pings[ip] = (time.time(), _icmp_ping(target))
+        _host_game.update(fps=_game_fps(), at=time.time())
+        now = time.time()
+        used = time.process_time()
+        if now - _cpu['at'] >= 1:
+            _cpu.update(percent=100.0 * (used - _cpu['used']) / (now - _cpu['at']), at=now, used=used)
+        time.sleep(3)
