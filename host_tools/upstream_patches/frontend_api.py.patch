+def _clean_say(text):
+    """ASCII 0x20..0x7E only (the game's banner font is only known for those), no '<' or '>' (the UI reads
+    <?tag?> as markup), trimmed, at most SAY_MAX characters."""
+    out = ''.join(c if ' ' <= c <= '~' else ('' if c in '\r\n\t' else '?') for c in str(text))
+    out = ''.join(c for c in out if c not in '<>').strip()
+    return out[:SAY_MAX]
+
+
+def _write_say_file(seq, target, text):
+    ok = False
+    for path in _say_paths():
+        try:
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            tmp = path + '.tmp'
+            with open(tmp, 'w', encoding='utf-8', newline='\n') as f:
+                f.write('say %d %d %d\n%s\n' % (seq, target, int(time.time()), text))
+            os.replace(tmp, path)
+            ok = True
+        except OSError as e:
+            _log('online_say_file_failed', path=path, error=str(e))
+    return ok
