+                    address, port = _p2p_address(ip)
+                    peers = game.get('peers') or []
+                    free = [x for x in peers if id(x) not in used]       # each report belongs to one row
+                    peer = (next((x for x in free if x.get('ip') == address and x.get('port') == port), None)
