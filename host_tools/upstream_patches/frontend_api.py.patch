+def _say_paths():
+    paths = [os.path.join(os.path.dirname(STATUS_FILE), 'dusk_lan_say.txt'),
+             os.path.join(os.path.dirname(MATCH_FILE), 'dusk_lan_say.txt')]
+    return [p for i, p in enumerate(paths) if p not in paths[:i]]
