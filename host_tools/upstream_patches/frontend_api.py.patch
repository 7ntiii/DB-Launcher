+def _game_fps():
+    """Frame rate of the game on this PC (emulator debug server, EDEN_NX2_DEBUG_SERVER, loopback)."""
+    import socket
+    try:
+        with socket.create_connection(('127.0.0.1', int(os.environ.get('DUSK_DEBUG_PORT', '6545'))), timeout=0.5) as sock:
+            sock.settimeout(1.5)
+            sock.sendall(b'{"id": 1, "method": "status", "params": {}}\n')
+            data = b''
+            while b'\n' not in data:
+                chunk = sock.recv(65536)
+                if not chunk:
+                    break
+                data += chunk
+        result = json.loads(data.split(b'\n')[0]).get('result') or {}
+        return round(float(result.get('fps', 0)), 1)
+    except (OSError, ValueError):
+        return None
