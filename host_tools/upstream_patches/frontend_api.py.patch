+                            or (free[0] if free else None))
+                    if peer:
+                        used.add(id(peer))
+                        row['phase'] = peer.get('phase')
+                        row['clock_left'] = peer.get('clock')
+                        row['player_no'] = peer.get('no')
+                        status, kind = PHASE_NAMES.get(peer.get('phase'), 'In a match'), 'match'
+                        if peer.get('ping_ms', -1) >= 0:
+                            row['ping_ms'], row['ping_kind'] = round(peer['ping_ms']), 'game to game'
+                        row['timer_gap'] = peer.get('timer_gap')
+                        # 'direct': the host's game talks straight to this player's own address;
+                        # anything else went through another address (a relay or a VPN hop)
+                        row['route'] = 'direct' if peer.get('ip') == address else 'via ' + str(peer.get('ip'))
