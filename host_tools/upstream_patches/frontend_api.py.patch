+    """Long poll. The game ends a search after 4 wait requests that brought no match: 4 WAITING
+    answers (4 s when they come at once) or 4 timeouts of its own (120 s each; measured 2026-11-13
+    11:55-12:03: requests at 0, 121, 242 and 363 s, then none). So the answer is held back and sent
+    at once when the match is made, which keeps a player searching for about 8 minutes. A request
+    the game neither answers nor repeats within its timeout is dead: the search is over then, and
+    the ticket must not stay 'waiting' (it did before, so the host started a match with players
+    whose games had already stopped searching)."""
+    pid, _ = _player(ctx)
+    tid = value.get('matching_request_id') if isinstance(value, dict) else None
+    asked = time.time()
+    with _lock:
+        seq = _poll_seq[pid] = _poll_seq.get(pid, 0) + 1
+        info = _poll_info.get(pid)
+        if info is None or info['ticket'] != tid:
+            info = _poll_info[pid] = {'ticket': tid, 'rounds': 0, 'asked': asked}
+        info['rounds'] += 1
+        info['asked'] = asked
+    end = asked + min(LONG_POLL, CLIENT_TIMEOUT + 6)
