+def _panel_server():
+    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def _send(self, code, body, kind='application/json'):
+            data = body if isinstance(body, bytes) else json.dumps(body).encode()
+            self.send_response(code)
+            self.send_header('Content-Type', kind)
+            self.send_header('Content-Length', str(len(data)))
+            self.send_header('Cache-Control', 'no-store')
+            self.end_headers()
+            self.wfile.write(data)
+
+        def do_GET(self):
+            if self.path.startswith('/api/state'):
+                return self._send(200, panel_state())
+            if self.path in ('/', '/index.html'):
+                try:
+                    return self._send(200, open(PANEL_HTML, 'rb').read(), 'text/html; charset=utf-8')
+                except OSError:
+                    return self._send(500, b'panel.html not found (DUSK_PANEL_HTML)', 'text/plain')
+            self._send(404, {'error': 'not found'})
+
+        def do_POST(self):
+            global MIN_PLAYERS
+            length = int(self.headers.get('Content-Length') or 0)
+            try:
+                body = json.loads(self.rfile.read(length) or b'{}')
+            except ValueError:
+                body = {}
+            if self.path == '/api/start':
+                with _lock:
+                    _hold['go_until'] = time.time() + 8
+                _event('Host pressed Start match')
+                return self._send(200, {'ok': True})
+            if self.path == '/api/cancel':
+                # Cancel match: the server forgets the running match (its players count as "in the
+                # menus" again and can search). With {"searches": true}: also end every search, so
+                # all games leave "searching". Games inside a battle are not pulled out of it.
+                with _lock:
+                    _hold['go_until'] = 0.0
+                    cancelled, stopped = set(), 0
+                    for t in _tickets.values():
+                        if t['state'] == 'matched':
+                            t['state'] = 'cancelled'
+                            cancelled.add(t['match_id'])
+                        elif body.get('searches') and t['state'] in ('waiting', 'expired'):
+                            t.update(state='cancelled', release=True)
+                            stopped += 1
+                    for m in _matches:
+                        if m['id'] in cancelled:
+                            m['cancelled'] = True
+                    if cancelled:
+                        _event('Host cancelled match %s' % ', '.join(str(x) for x in sorted(cancelled)))
+                    if body.get('searches'):
+                        _event('Host stopped all searches (%d)' % stopped)
+                    if not cancelled and not body.get('searches'):
+                        _event('Host pressed Cancel match: no match was running')
+                return self._send(200, {'ok': True, 'cancelled': sorted(cancelled), 'stopped': stopped})
+            if self.path == '/api/say':
+                # v4.43 HOSTTEXT: {"text": "...", "target": 0 | player number}
+                text = _clean_say(body.get('text', ''))
+                try:
+                    target = int(body.get('target') or 0)
+                except (TypeError, ValueError):
+                    target = 0
+                if not text:
+                    return self._send(400, {'ok': False, 'error': 'empty text'})
+                if not 0 <= target <= 8:
+                    return self._send(400, {'ok': False, 'error': 'bad player number'})
+                with _lock:
+                    now = time.time()
+                    if now - _say['at'] < 3:
+                        return self._send(429, {'ok': False, 'error': 'wait 3 seconds between messages'})
+                    _say['at'] = now
+                    seq = int(now * 1000) & 0x7FFFFFFF or 1     # a restart never repeats a number
+                    if seq <= _say['seq']:
+                        seq = _say['seq'] + 1
+                    _say['seq'] = seq
+                ok = _write_say_file(seq, target, text)
+                _event('Host message %s to %s: %s' % ('sent' if ok else 'NOT written',
+                                                      'everyone' if target == 0 else 'player %d' % target, text))
+                return self._send(200 if ok else 500, {'ok': ok, 'seq': seq, 'text': text})
+            if self.path == '/api/settings':
+                with _lock:
+                    if 'all' in body:
+                        _hold['all'] = bool(body['all'])
+                        _event('Start when everyone is searching: ' + ('on' if _hold['all'] else 'off'))
+                    if 'hold' in body:
+                        _hold['on'] = bool(body['hold'])
+                        _event('Start mode: ' + ('host presses Start' if _hold['on'] else 'automatic'))
+                    if 'min_players' in body:
+                        MIN_PLAYERS = max(2, min(MAX_PLAYERS, int(body['min_players'])))
+                        _event('Minimum players set to %d' % MIN_PLAYERS)
+                return self._send(200, {'ok': True})
+            self._send(404, {'error': 'not found'})
+
+    try:
+        server = ThreadingHTTPServer(('127.0.0.1', PANEL_PORT), Handler)
+    except OSError:
+        return                                        # already running in this or another process
+    threading.Thread(target=_ping_loop, daemon=True).start()
+    server.serve_forever()
