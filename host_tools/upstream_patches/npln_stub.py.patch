+# --- LAN fix (2026-11-11): QueryUserExternalIds ------------------------------------------------
+# Duskbloods asks for each P2P peer's external id right after the peer's QUIC connection is
+# attached. An empty reply makes the peer state machine leave and Close(0) the connection at once
+# (the APPLICATION_ERROR seen on the wire 85 ms after the ClientHello). Reverse engineered
+# (main 0x38cfe0 / 0x48d7b40, protobuf-lite parsers 0x3c43a0 / 0x3c76c0 / 0x3c8420):
+#   request  {1 parent, 3 repeated {1 "tenants/{t}/users/{u}", 2 packed id types}}
+#   response {1 repeated Entry}; Entry {1 string (unused), 2 user name, the game ABORTS on a
+#            name that is not "tenants/{t}/users/{u}"; 3 {1 type, 2 id as a hex string, must be
+#            non-zero}; 4 Timestamp (optional)}
+# The game keys the ids by {u} and stores the peer's at peer+0x90; it must differ from the
+# game's own id. Here: the id is the user id's own hex number.
+@reply('QueryUserExternalIds')
+def query_user_external_ids(req, call):
+    out = b''
+    for q in submsgs(decode(req), 3):
+        name = substr(q, 1)
+        if not re.fullmatch(r'tenants/[^/]+/users/[^/]+', name):
+            continue
+        raw = next((v for n, wt, v in q if n == 2), None)
+        types = []
+        if isinstance(raw, dict) and 'hex' in raw:
+            b, i = bytes.fromhex(raw['hex']), 0
+            while i < len(b):
+                t, i = read_varint(b, i)
+                types.append(t)
+        elif isinstance(raw, int):
+            types.append(raw)
+        uid = name.rsplit('/', 1)[-1]
+        try:
+            ext = int(uid[2:], 16) or 1
+        except ValueError:
+            ext = int.from_bytes(hashlib.sha256(uid.encode()).digest()[:8], 'big') or 1
+        for t in types or [1]:
+            out += field(1, field(1, f'{name}/externalIds/{t}') + field(2, name)
+                         + field(3, field(1, t) + field(2, f'{ext:016x}')))
