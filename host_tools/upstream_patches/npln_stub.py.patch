+def _xaddr(ip, port):
+    return struct.pack('>BBH4s', 0, 1, port ^ 0x2112,
+                       bytes(a ^ b for a, b in zip(socket.inet_aton(ip), STUN_MAGIC)))
+
+
+def _unxaddr(v):
+    port = struct.unpack('>H', v[2:4])[0] ^ 0x2112
+    return socket.inet_ntoa(bytes(a ^ b for a, b in zip(v[4:8], STUN_MAGIC))), port
+
+
+def _stun_attrs(msg):
+    out, i = [], 20
+    while i + 4 <= len(msg):
+        t, n = struct.unpack('>HH', msg[i:i + 4])
+        out.append((t, msg[i + 4:i + 4 + n]))
+        i += 4 + n + (-n % 4)
+    return out
+
+
+def _stun_attr(t, v):
+    return struct.pack('>HH', t, len(v)) + v + b'\0' * (-len(v) % 4)
+
+
+def _stun_msg(mtype, tid, attrs, key=None):
+    body = b''.join(_stun_attr(t, v) for t, v in attrs)
+    if key is not None:   # MESSAGE-INTEGRITY over the message, its length already counting the MI
+        head = struct.pack('>HH', mtype, len(body) + 24) + STUN_MAGIC + tid
+        body += _stun_attr(0x0008, hmac.new(key, head + body, hashlib.sha1).digest())
+    return struct.pack('>HH', mtype, len(body)) + STUN_MAGIC + tid + body
+
