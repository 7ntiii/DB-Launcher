+def _turn_relay_ip(host):
+    # Tailscale play (tailscale_support.diff): a listener on one of this PC's addresses announces
+    # its relays at that address (the one its clients reached), so a client on Tailscale gets a
+    # 100.x relay and one on the home network a home one. The loopback listener (this PC's own
+    # game) takes DUSK_ADVERTISE_IP, the host script's choice (the launcher sets DUSK_HOST_IP).
+    if os.environ.get('DUSK_TAILSCALE') == '1':
+        if host not in ('127.0.0.1', '0.0.0.0', '') and not host.startswith('127.'):
+            return host
+        if os.environ.get('DUSK_ADVERTISE_IP'):
+            return os.environ['DUSK_ADVERTISE_IP']
+    ip = os.environ.get('DUSK_HOST_IP') or ''
+    if not ip and host not in ('127.0.0.1', '0.0.0.0', ''):
+        ip = host
+    if not ip:
+        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        try:
+            s.connect(('192.168.0.1', 9))
+            ip = s.getsockname()[0]
+        except OSError:
+            ip = '127.0.0.1'
+        finally:
+            s.close()
+    return ip
+
