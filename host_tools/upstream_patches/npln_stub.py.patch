+        rs = a['sock']
+        while not a.get('closed'):
+            try:
+                data, peer = rs.recvfrom(65536)
+            except OSError:
+                return
+            with lock:
+                num = a['peer'].get(peer)
+            if num is not None:
+                pkt = struct.pack('>HH', num, len(data)) + data + b'\0' * (-len(data) % 4)
+            else:
