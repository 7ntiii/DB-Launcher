+#pragma once
+
+#include <chrono>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include "common/common_types.h"
+
+/// A side channel between the emulators that run the same LAN game. Its datagrams travel on the
+/// game's own UDP sockets, to the addresses the game itself sends to (its player-to-player links),
+/// so they use the paths and the firewall rule the game already has. They start with a magic word
+/// and are taken out before the guest reads the socket.
+/// Used by core/dusk_lan.cpp (The Duskbloods network test). Implemented in network.cpp.
+namespace Network::LanSide {
+
+struct Packet {
+    std::vector<u8> data; ///< payload after the magic word
+    std::chrono::steady_clock::time_point at; ///< when the emulator read it from the socket
+    u32 ip = 0;  ///< sender, host byte order
+    u16 port = 0;
+};
+
+/// Turns the channel on (the port is no longer used: every guest UDP socket carries it).
+void Enable(u16 guest_port);
+
+/// Sends payload on every link. False when there is none yet.
+bool Send(std::span<const u8> payload);
+
+/// Sends payload to one peer (host byte order address). False when the socket is gone.
+bool SendTo(u32 ip, u16 port, std::span<const u8> payload);
+
+/// The addresses the game sends to: {ip, port} in host byte order, each once.
+std::vector<std::pair<u32, u16>> Peers();
+
+/// The packets received since the last call.
+std::vector<Packet> Drain();
+
+} // namespace Network::LanSide
