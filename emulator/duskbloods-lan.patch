+/// Once a second: what this game is doing, for the host panel (launcher/lan_fix/panel.html reads
+/// it through the match server). A file, so the emulator needs no connection to the panel.
+void Assist::State::WriteStatus() {
+    const bool in_session =
+        active && session.manager != 0 && system.ApplicationProcess() != nullptr;
+    const auto now = Clock::now();
+    std::string list;
+    const Peer* first = nullptr;
+    for (const auto& [key, peer] : peers) {
+        if (!in_session || now - peer.at >= 5s) {
+            continue;
+        }
+        if (first == nullptr) {
+            first = &peer;
+        }
+        list += fmt::format(
+            "{}{{\"ip\": \"{}.{}.{}.{}\", \"port\": {}, \"no\": {}, \"phase\": {}, \"clock\": {:.1f}, "
+            "\"ping_ms\": {:.1f}, \"timer_gap\": {:.2f}, \"move_delay\": {:.2f}}}",
+            list.empty() ? "" : ", ", peer.ip >> 24, (peer.ip >> 16) & 0xFF, (peer.ip >> 8) & 0xFF,
+            peer.ip & 0xFF, peer.port, static_cast<u32>(peer.no), static_cast<u32>(peer.phase),
+            peer.clock_left, peer.ping_us >= 0 ? static_cast<double>(peer.ping_us) / 1000.0 : -1.0,
+            peer.timer_gap, peer.move_delay);
+    }
+    const std::string text = fmt::format(
+        "{{\"time\": {}, \"active\": {}, \"in_session\": {}, \"join_state\": {}, \"phase\": {}, "
+        "\"clock_left\": {:.1f}, \"player_no\": {}, \"peer_known\": {}, \"peer_no\": {}, "
+        "\"peer_phase\": {}, \"peer_clock\": {:.1f}, \"ping_ms\": {:.1f}, \"timer_gap\": {:.2f}, "
+        "\"move_delay\": {:.2f}, \"clock_stepped\": {:.2f}, \"peers\": [{}]}}\n",
+        static_cast<s64>(std::time(nullptr)), active, in_session,
+        in_session ? static_cast<s32>(session.state) : -1,
+        in_session ? static_cast<s32>(session.phase) : -1, in_session ? clock_left : 0.0f,
+        in_session ? static_cast<s32>(LocalPlayerNo()) : -1, first != nullptr,
+        first != nullptr ? static_cast<u32>(first->no) : 0U,
+        first != nullptr ? static_cast<u32>(first->phase) : 0U,
+        first != nullptr ? first->clock_left : 0.0f,
+        first != nullptr && first->ping_us >= 0 ? static_cast<double>(first->ping_us) / 1000.0 : -1.0,
+        first != nullptr ? first->timer_gap : 0.0f, first != nullptr ? first->move_delay : -1.0,
+        stepped_s, list);
+    std::ofstream out{status_path, std::ios::out | std::ios::trunc};
+    out << text;
+}
+
+void Assist::State::TickSession() {
+    in_battle = false; // Side() sets it again; Sample() must not run on a dead process
+    process = system.ApplicationProcess();
+    if (process == nullptr) {
+        return;
+    }
+    memory = &process->GetMemory();
+    if (!active) {
+        if (!idle) {
+            FindMain();
+        }
+        return;
+    }
+    const auto now = Clock::now();
+    const u64 manager = Get<u64>(Get<u64>(main + SESSION_REF));
+    if (manager == 0 || Get<u32>(manager + S_MODE) != MODE_GUEST) {
+        if (session.manager != 0) {
+            EndSession("left the LAN session");
+        }
+        return;
+    }
+    if (session.manager != manager) {
+        if (session.manager != 0) {
+            EndSession("a new session started");
+        }
+        session.manager = manager;
+        ++rule_session_gen;
+        rule_session_at = now;
+        Log(fmt::format("joined a LAN session (session manager {:#x})", manager));
+    }
+    const u32 join_state = Get<u32>(manager + S_STATE);
+    // A player with a number above 1 is not the authority (items, levers, spawners) from the
+    // moment its number is known: the role must be set before the game enters state 8, where it
+    // sends and answers the join syncs. EnvEvent keeps it from then on.
+    // Keep ~0U (number not known yet) counted as "above 1": the host then has role 1 from the join
+    // to its first state-8 tick, and the PrepareSecond gate (0x114FC48 -> 0x563E78C, role 1 and
+    // MAP_FED != round -> wait) holds its Phase I preparation (map treasures) until the match is
+    // in state 8. v3.9.3 hunk A removed that hold: 0 treasures in Phase I (live 22:35, A and B).
+    const u32 join_no = LocalPlayerNo();
+    if (join_state < 8 && join_no > 1 && Get<u32>(main + GENERATOR_IDLE) == 0) {
+        Put<u32>(main + GENERATOR_IDLE, 1);
+        Log("authority (spawners, items, levers, events): not this game (player number above 1)");
+    }
+    // A player whose chr is still missing 8 s into the match: its player data never came (the
+    // one request was lost while the link to it was not up). Ask again, every 5 s.
+    if (join_state == 8) {
+        const u64 begin = Get<u64>(manager + S_MEMBERS);
+        const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+        u64 waiting = 0;
+        u64 waiting_member = 0;
+        u64 self_id = 0;
+        if (begin != 0 && end > begin && end - begin <= 16 * MEMBER_SIZE) {
+            for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+                if (Get<u8>(member + M_SELF) != 0) {
+                    self_id = Get<u64>(member + M_ID);
+                }
+                if (Get<u8>(member + M_SERVER) == 0 && Get<u8>(member + M_SELF) == 0 &&
+                    Get<u8>(member + M_PENDING) != 0) {
+                    waiting = Get<u64>(member + M_ID);
+                    waiting_member = member;
+                }
+            }
+        }
+        if (waiting == 0) {
+            if (pending_since && pending_asks != 0) {
+                Log(fmt::format("player {:#x}: its character is here now (after {} request(s) in "
+                                "this wait; v4.37 NEEDDATA)",
+                                pending_id & 0xFFFFFFFFFF, pending_asks));
+            }
+            pending_since.reset();
+            pending_box_logged = false;
+            pending_asks = 0;
+        } else if (!pending_since) {
+            pending_since = now;
+            pending_asked = now + 3s; // first one 8 s after it was first seen waiting
+            pending_id = waiting;
+            pending_asks = 0;
+        } else if (now - *pending_since >= 8s && now - pending_asked >= 5s) {
+            // v3.9.3 (B): cave 6 clears the box when it sends; still 1 = it never ran (the flow
+            // is not at step 0x17), so asking again changes nothing.
+            if (pending_count != 0 && Get<u32>(main + REREQUEST) != 0 && !pending_box_logged) {
+                pending_box_logged = true;
+                Log("player data: the last request was not sent (re-request box not consumed: "
+                    "the battle flow is not at its player check)");
+            }
+            pending_asked = now;
+            Put<u32>(main + REREQUEST, 1);
+            Log(fmt::format("player {:#x} has no character here yet: player data asked for again "
+                            "(#{})",
+                            waiting & 0xFFFFFFFFFF, ++pending_count));
+            // v4.37 NEEDDATA: ask that game through the side channel too; its assist puts our id
+            // in its game's NEEDDATA box, which the game answers with our real id.
+            pending_id = waiting;
+            ++pending_asks;
+            if (self_id != 0 && self_id != ~0ULL) {
+                NeedDataMessage need;
+                const u32 own = LocalPlayerNo();
+                need.player_no = own >= 1 && own <= 0xFF ? static_cast<u8>(own) : 0;
+                need.instance = instance;
+                need.requester = self_id;
+                need.waited = waiting;
+                need.count = pending_asks;
+                Network::LanSide::Send(
+                    std::span<const u8>(reinterpret_cast<const u8*>(&need), sizeof(need)));
+                if (pending_asks == 1 || pending_asks % 10 == 0) {
+                    Log(fmt::format("player data: player {:#x} asked through the side channel too "
+                                    "(v4.37 NEEDDATA #{}, our member id {:#x})",
+                                    waiting & 0xFFFFFFFFFF, pending_asks, self_id & 0xFFFFFFFFFF));
+                }
+            }
+            // v3.9.3 (B): what has come from it so far (remote_player_hang_notes 1 / 5b): ready
+            // bits 0x02 = type 5 (only the answer to our request carries it), 0x04 type 9, 0x08
+            // type 8, 0x10 type 0x57; 0x1F = complete. No 0x02 while the rest is there = the
+            // other game answers without its own player number (or with an empty type 5).
+            if (pending_count == 1 || pending_count % 10 == 0) {
+                const u64 table = Get<u64>(main + NET_PLAYERS);
+                const u8 slot = Get<u8>(waiting_member + M_SLOT);
+                const u64 ready = table != 0 ? Get<u64>(table + NP_READY) : 0;
+                const u64 link = Get<u64>(waiting_member + M_LINK);
+                Log(fmt::format("player data from {:#x}: ready bits {} (0x1F = all; 0x02 = its "
+                                "answer), its number here {}, type 5 seen {}, our link {} open {}, "
+                                "link blocked {}",
+                                waiting & 0xFFFFFFFFFF,
+                                ready != 0 && slot <= 11
+                                    ? fmt::format("{:#04x}", Get<u8>(ready + slot))
+                                    : std::string{"unreadable"},
+                                static_cast<s32>(Get<u32>(waiting_member + M_REMOTE_NO)),
+                                Get<u8>(waiting_member + M_TYPE5_SEEN), link != 0 ? "set" : "none",
+                                link != 0 ? (Get<u8>(link + 0xC) & 1) : 0,
+                                Get<u8>(waiting_member + M_BLOCKED)));
+            }
+        }
+        // v3.9.3 (B): a game in the match without its own player number answers every player
+        // data request without its character data (0x14DC040 sends type 5 only for a number
+        // 1..0x270D): the others then never get its chr. Logged once per session, and again
+        // when it is set.
+        const u32 own_no = LocalPlayerNo();
+        const bool own_bad = own_no == 0 || own_no == ~0U || own_no > 0x270D;
+        if (own_bad && !session.own_no_bad_logged) {
+            session.own_no_bad_logged = true;
+            Log(fmt::format("!!! our player number is not set in the match ({}): our answers to "
+                            "player-data requests carry no character data, so the other players "
+                            "cannot see us (audit_v392 F2) !!!",
+                            static_cast<s32>(own_no)));
+        } else if (!own_bad && session.own_no_bad_logged) {
+            session.own_no_bad_logged = false;
+            Log(fmt::format("our player number is set now: {}", own_no));
+        }
+    } else {
+        pending_since.reset();
+    }
+    const u64 loader = Get<u64>(manager + S_LOADER);
+    const u32 step = loader != 0 ? Get<u32>(loader + L_STEP) : ~0U;
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u32 phase = stage != 0 ? Get<u32>(stage + P_STATE) : ~0U;
+    if (join_state != session.state || step != session.step || phase != session.phase) {
+        Log(fmt::format("session state {}, loader step {}, match phase {}", join_state,
+                        static_cast<s32>(step), static_cast<s32>(phase)));
+        session.state = join_state;
+        session.step = step;
+        session.phase = phase;
+    }
+
+    LobbyShare(now); // v3.9.8 F5: before numbering, so a fresh lobby size counts at once
+    UpdateMailbox(manager, join_state);
+    NumberShare(now); // v413: after the mailbox, so a new or delivered number goes out at once
+    RuleShare(join_state, stage, phase);
+    LineupHold(now, manager, join_state, phase); // v4.52: the loading screen shows every player
+
+    // 4-game run 2026-11-15 (diag/net/four_players_notes.md): game A's P2P join to the match
+    // failed, it searched again and the LAN stub put its next join in a session of its own. The
+    // assist then walked that lone game through a whole match load (no peers, its own lists) and
+    // it hung at the start-area screen while the other three played. In the join (state 3) a game
+    // that is the only player member of its session is not walked; after 30 s alone its join timer
+    // is no longer held, so the game's own join timeout ends the session. Every working join lists
+    // the other players here (message 4 is only armed with two members or more).
+    bool alone = false;
+    if (join_state == 3) {
+        const u64 begin = Get<u64>(manager + S_MEMBERS);
+        const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+        if (begin != 0 && end > begin && (end - begin) % MEMBER_SIZE == 0 &&
+            end - begin <= 16 * MEMBER_SIZE) {
+            size_t players = 0;
+            for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+                players += Get<u8>(member + M_SERVER) == 0 ? 1 : 0;
+            }
+            alone = players == 1;
+        }
+    }
+    if (!alone) {
+        session.alone_since.reset();
+    } else if (!session.alone_since) {
+        session.alone_since = now;
+        if (!session.alone_logged) {
+            session.alone_logged = true;
+            Log("join: no other player in this session; its loader is not walked (a game alone "
+                "is in nobody's match)");
+        }
+    }
+    const bool give_up = alone && now - *session.alone_since >= 30s;
+    if (give_up && !session.alone_gave_up) {
+        session.alone_gave_up = true;
+        Log("join: alone for 30 s; the join timer is no longer held, the game's own timeout ends "
+            "this session");
+    }
+    if (join_state == 3 && !give_up) {
+        // The join waits for server replies that never come: keep its timer from running out,
+        // set the game global's server flags and resend the step's request every 5 s.
+        Put<f32>(manager + S_JOIN_TIMER, 14.0f);
+        if (const u64 global = Get<u64>(main + GAME_GLOBAL); global != 0) {
+            static constexpr std::array<u8, 4> SERVER_FLAGS{0x00, 0x00, 0x00, 0x0A};
+            Write(global + 0xAD8, SERVER_FLAGS.data(), SERVER_FLAGS.size());
+        }
+        if (loader != 0 && (!session.sent_cleared || now - *session.sent_cleared >= 5s)) {
+            Put<u8>(loader + L_SENT, 0);
+            session.sent_cleared = now;
+        }
+    }
+    // v3.9.3 (B): a game that leaves state 3 without its own number answers the others' player
+    // data requests without its character data (0x14DC040) and, as player 1, makes no map
+    // treasures (TREASURE_HOST2): the loader is not walked on while message 4 is still due
+    // (it is handed over only in states 2 / 3). At most 30 s, then as before.
+    const bool unnumbered = join_state == 3 && !alone && (join_no == 0 || join_no == ~0U);
+    if (!unnumbered) {
+        session.unnumbered_since.reset();
+    } else if (!session.unnumbered_since) {
+        session.unnumbered_since = now;
+        Log("join: our player number is not set yet; the loader waits for message 4");
+    }
+    const bool unnumbered_hold = unnumbered && now - *session.unnumbered_since < 30s;
+    if (unnumbered && !unnumbered_hold && !session.unnumbered_gave_up) {
+        session.unnumbered_gave_up = true;
+        Log("join: still no player number after 30 s; the loader is walked anyway");
+    }
+    if (loader != 0 && join_state >= 3 && join_state <= 8 && !alone && !unnumbered_hold) {
+        Walk(loader, step, now);
+    }
+    if (stage == 0) {
+        return;
+    }
+    // Review2 R10: a match pre-load (phase 1, progress 0) starts a new match, even in the same
+    // session and stage at the round the old one ended in: Map / Virtue / CommendShare reset at
+    // their next pass. Counted once per pre-load (the line below then sets progress to 1).
+    if (phase == 1 && Get<s32>(stage + P_PROGRESS) < 1) {
+        if (!match_preload) {
+            match_preload = true;
+            ++match_gen;
+            // review1b E1: the per-match parts of Session (a second match in one session).
+            session.played = false;
+            session.env_drawn.reset();
+            session.env_given_round = ~0U;
+            session.env_local_round = ~0U;
+            Log(fmt::format("match pre-load seen (stage {:#x}, round {}): match load #{}; the "
+                            "sharing state starts again (review2 R10)",
+                            stage, Get<u32>(stage + P_ROUND), match_gen));
+        }
+    } else if (phase != 1) {
+        match_preload = false;
+    }
+    if (join_state == 7 && step == LOADER_DONE && phase == 1 && Get<s32>(stage + P_PROGRESS) < 1) {
+        // The server's first progress event (0xC1 event 2) did not come.
+        Put<s32>(stage + P_PROGRESS, 1);
+        Log("match phase progress 0 -> 1");
+    }
+    if (loader != 0 && join_state == 8 && phase == PHASE_PREPARE_SECOND && step >= 13 &&
+        step <= LOADER_DONE && session.step12_count < 3 &&
+        (session.step12_count == 0 || now - session.step12_at >= 30s)) {
+        // PrepareSecond waits for the peer's step-12 (Phase) reply, but the step never sent its
+        // request: set its mask bit, clear the sent flag and go back to step 12.
+        ++session.step12_count;
+        session.step12_at = now;
+        Put<u64>(loader + L_MASK, Get<u64>(loader + L_MASK) | (u64{1} << 12));
+        Put<u8>(loader + L_SENT, 0);
+        Put<u32>(loader + L_NEXT, 12);
+        Log(fmt::format("loader back to step 12 to send the phase request (#{})",
+                        session.step12_count));
+    }
+    if (join_state == 8 && phase == PHASE_PREPARE_SECOND) {
+        if (!session.prepare_since) {
+            session.prepare_since = now;
+        }
+        for (const auto& [key, peer] : peers) { // v409: see PrepareSecondFlags
+            if (peer.no != 0 && now - peer.at < 3s &&
+                (peer.phase == PHASE_PREPARE_SECOND || peer.phase == 22 ||
+                 peer.phase == PHASE_INTERMISSION)) {
+                session.prepare_peer_at.try_emplace(peer.no, now);
+            }
+        }
+        // v409: retried every 1 s while only the step-12 flag waits (prepare_fixed is the 10-s pace
+        // of the step-7 / give-up path, not of this wait).
+        if (now - *session.prepare_since >= (session.played ? 3s : 20s) &&
+            (!session.prepare_fixed || now - *session.prepare_fixed >= 10s ||
+             session.prepare_wait_logged)) {
+            PrepareSecondFlags(stage, now);
+        }
+    } else {
+        // Each match round passes PrepareSecond again: fresh resends and answer flags then.
+        session.prepare_since.reset();
+        session.prepare_fixed.reset();
+        session.prepare_peer_at.clear();
+        session.prepare_wait_logged = false;
+        session.step12_count = 0;
+    }
+    PowerOfferNote(phase, stage);
+    Phases(phase, now);
+    StartArea(phase, now);
+    StartPoint(phase, now);
+    FinalSlotsEarly(phase); // v4.46 DECIDEONCE: before the game's first decide
+    FinalSlots(phase);
+    FinalListWatch(phase);
+    FinalWarpDefer(phase, now);
+    SfxWho(now);
+    FinalOwnPlace(phase, now);
+    IconPhaseOne(stage);
+    Side(stage, phase, join_state, now);
+    StateRepair(stage, phase, now); // v417
+}
+
+/// v417 (late_notes.md): a game suspended in the spawn window of the match load (match phase 2,
+/// PrepareSecond; rig run 2026-11-16 18:27) got another player's data only from the assist's
+/// re-request, and its copy of that player never received the spawn's state word: it stays
+/// 00 00 00 00 for the whole match, so this game's EndPhase never lists that player (no rank row,
+/// its own ranking has only itself; the cut lists and the final then differ between the games).
+/// Here, in UpdatePhase, a copy that holds 00 00 00 00 for STATE_REPAIR_AFTER while that player's
+/// own game is heard in UpdatePhase (fresh, 3 s), takes part (+0x46A0 != 0), is not cut and not out
+/// of the final, gets the spawn's word 01 01 00 00 written once per round. A copy the game spawned
+/// normally is never 00 in UpdatePhase, so a match without the fault writes nothing.
+void Assist::State::StateRepair(u64 stage, u32 phase, Clock::time_point now) {
+    if (stage == 0 || phase != PHASE_UPDATE || session.state != 8) {
+        state_zero_since.clear();
+        return;
+    }
+    const u32 round = Get<u32>(stage + P_ROUND);
+    const u64 key = (u64{match_gen} << 32) | round;
+    if (key != state_repair_key) {
+        state_repair_key = key;
+        state_zero_since.clear();
+    }
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    const u32 local_no = LocalPlayerNo();
+    if (players == 0 || local_no == 0 || local_no >= 0x100) {
+        return;
+    }
+    // The players whose own game is heard in UpdatePhase now (a stale record of the same number,
+    // e.g. from the last match, must not reset the wait of a fresh one).
+    std::set<u32> live;
+    for (const auto& [peer_key, peer] : peers) {
+        if (peer.no != 0 && peer.no != local_no && now - peer.at < 3s &&
+            peer.phase == PHASE_UPDATE && !PeerCut(peer) && !CutNo(peer.no) &&
+            !final_out.contains(peer.no)) {
+            live.insert(peer.no);
+        }
+    }
+    std::erase_if(state_zero_since, [&](const auto& item) { return !live.contains(item.first); });
+    for (const u32 no : live) {
+        const u64 pgd = VirtuePlayer(players, no);
+        if (pgd != 0 && Get<u32>(pgd + PGD_STAGE) == 0 && Get<u8>(pgd + PGD_PART) == 0 &&
+            state_part_logged.insert((u64{match_gen} << 40) | (u64{round & 0xFF} << 32) | no)
+                .second) {
+            // v417b (review_v414_417.md R1): not repaired (the game would still skip the row), but
+            // logged, so a recurrence of the 18:27 fault shows whether its copy lacked +0x46A0 too.
+            Log(fmt::format("state word: our copy of player {} holds 00 00 00 00 in UpdatePhase "
+                            "(round {}) and its take-part byte +0x46A0 is 0 too: not repaired "
+                            "(v417b, pgd {:#x})",
+                            no, round, pgd));
+        }
+        if (pgd == 0 || Get<u32>(pgd + PGD_STAGE) != 0 || Get<u8>(pgd + PGD_PART) == 0) {
+            state_zero_since.erase(no);
+            continue;
+        }
+        const auto [since, added] = state_zero_since.emplace(no, now);
+        if (added || now - since->second < STATE_REPAIR_AFTER) {
+            continue;
+        }
+        const u64 done = (u64{match_gen} << 40) | (u64{round & 0xFF} << 32) | no;
+        if (!state_repair_done.insert(done).second) {
+            continue; // once per player and round: a game that clears it again is left alone
+        }
+        Put<u32>(pgd + PGD_STAGE, STAGE_IN);
+        Log(fmt::format("!!! state word: our copy of player {} held 00 00 00 00 for {} s in "
+                        "UpdatePhase (round {}) while its game plays this phase; written 01 01 00 00 "
+                        "(the spawn's word) so that our EndPhase ranks it (v417, pgd {:#x}) !!!",
+                        no,
+                        std::chrono::duration_cast<std::chrono::seconds>(now - since->second)
+                            .count(),
+                        round, pgd));
+    }
+}
