+namespace {
+// Arenas in lazy mode, read by the exception handler without a lock. A slot is published by
+// storing its owner last and withdrawn by clearing the owner first.
+struct LazyRange {
+    std::atomic<uintptr_t> begin{};
+    std::atomic<uintptr_t> end{};
+    std::atomic<void*> owner{}; // HostMemory::Impl (private type)
+};
+constexpr size_t MaxLazyRanges = 16; // Two views per arena; tests create a few arenas
+LazyRange lazy_ranges[MaxLazyRanges];
+std::mutex lazy_ranges_mutex; // Writers only
+} // Anonymous namespace
+
+bool HostMemory::Impl::RegisterLazyRanges() {
+    static std::once_flag handler_flag;
+    std::call_once(handler_flag, [] { AddVectoredExceptionHandler(1, &Impl::LazyCommitHandler); });
+
+    const std::pair<u8*, size_t> views[] = {{backing_base, backing_size},
+                                            {virtual_base, virtual_size}};
+    std::scoped_lock lock{lazy_ranges_mutex};
+    size_t registered = 0;
+    for (LazyRange& slot : lazy_ranges) {
+        if (registered == std::size(views)) {
+            break;
+        }
+        if (slot.owner.load(std::memory_order_relaxed) != nullptr) {
+            continue;
+        }
+        const auto [base, size] = views[registered++];
+        slot.begin.store(reinterpret_cast<uintptr_t>(base), std::memory_order_relaxed);
+        slot.end.store(reinterpret_cast<uintptr_t>(base) + size, std::memory_order_relaxed);
+        slot.owner.store(this, std::memory_order_release);
+    }
+    return registered == std::size(views);
+}
+
+void HostMemory::Impl::UnregisterLazyRanges() {
+    if (!lazy_commit) {
+        return;
+    }
+    std::scoped_lock lock{lazy_ranges_mutex};
+    for (LazyRange& slot : lazy_ranges) {
+        if (slot.owner.load(std::memory_order_relaxed) == this) {
+            slot.owner.store(nullptr, std::memory_order_release);
+        }
+    }
+}
+
+LONG WINAPI HostMemory::Impl::LazyCommitHandler(PEXCEPTION_POINTERS info) {
+    const EXCEPTION_RECORD* const record = info->ExceptionRecord;
+    if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || record->NumberParameters < 2) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const uintptr_t address = static_cast<uintptr_t>(record->ExceptionInformation[1]);
+    for (LazyRange& slot : lazy_ranges) {
+        void* const owner = slot.owner.load(std::memory_order_acquire);
+        if (owner != nullptr && address >= slot.begin.load(std::memory_order_relaxed) &&
+            address < slot.end.load(std::memory_order_relaxed)) {
+            return static_cast<Impl*>(owner)->CommitOnFault(reinterpret_cast<u8*>(address),
+                                                            record->ExceptionInformation[0]);
+        }
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
