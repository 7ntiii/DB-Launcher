+    u32 net_off_gen = ~0U;           ///< match_gen in which moves were given up
+    u32 net_move_no = 0;             ///< the player the last move went to
+    u32 net_move_repeats = 0;        ///< moves in a row that left that player as far ahead
+    double net_move_size = 0;        ///< the last move (s)
+    Clock::time_point net_move_at{}; ///< when it was made
