+    std::map<std::pair<u32, u8>, std::pair<u32, Clock::time_point>> part_tries; ///< tries, last try
+    std::map<u32, Clock::time_point> part_max_differ_since; ///< battle id -> lists equal, max not
+    std::map<u32, Clock::time_point> part_reapplied;        ///< battle id -> last reapply
