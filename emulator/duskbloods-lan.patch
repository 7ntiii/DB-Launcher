+// EDEN_NX2_CRASH_DUMP=<dir>: on an unhandled exception (a real crash; fastmem faults are handled
+// before this) write <dir>/eden-crash-<pid>.txt (exception, faulting address and stack as
+// module+offset, for dbghelp/llvm-symbolizer with the PDB) and <dir>/eden-crash-<pid>.dmp.
+// Same as eden-cli's (yuzu_cmd/yuzu.cpp), for the Qt build the launcher runs.
+static void PrintCodeAddress(std::FILE* out, const char* label, const void* address) {
+    HMODULE module{};
+    char name[MAX_PATH] = "?";
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<LPCSTR>(address), &module)) {
+        GetModuleFileNameA(module, name, sizeof(name));
+    }
+    const char* base_name = std::strrchr(name, '\\');
+    std::fprintf(out, "  %s %p %s+%#llx\n", label, address, base_name ? base_name + 1 : name,
+                 static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(address) -
+                                                 reinterpret_cast<uintptr_t>(module)));
+}
+
+static LONG WINAPI WriteCrashReport(EXCEPTION_POINTERS* exception) {
+    static std::atomic<bool> written{};
+    const char* directory = std::getenv("EDEN_NX2_CRASH_DUMP");
+    if (directory == nullptr || written.exchange(true)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    char path[MAX_PATH];
+    std::snprintf(path, sizeof(path), "%s/eden-crash-%lu.txt", directory, GetCurrentProcessId());
+    if (std::FILE* out = std::fopen(path, "w")) {
+        const EXCEPTION_RECORD& record = *exception->ExceptionRecord;
+        std::fprintf(out, "Unhandled exception %#lx on thread %lu, info %#llx %#llx\n",
+                     record.ExceptionCode, GetCurrentThreadId(),
+                     static_cast<unsigned long long>(
+                         record.NumberParameters > 0 ? record.ExceptionInformation[0] : 0),
+                     static_cast<unsigned long long>(
+                         record.NumberParameters > 1 ? record.ExceptionInformation[1] : 0));
+        PrintCodeAddress(out, "at", record.ExceptionAddress);
+        void* frames[62];
+        const USHORT count = RtlCaptureStackBackTrace(0, 62, frames, nullptr);
+        for (USHORT i = 0; i < count; ++i) {
+            PrintCodeAddress(out, "frame", frames[i]);
+        }
+        std::fclose(out);
+    }
+    struct ExceptionInformation {
+        DWORD thread_id;
+        EXCEPTION_POINTERS* exception_pointers;
+        BOOL client_pointers;
+    };
+    using MiniDumpWriteDumpFn = BOOL(WINAPI*)(HANDLE, DWORD, HANDLE, int,
+                                              const ExceptionInformation*, const void*, const void*);
+    const HMODULE dbghelp = LoadLibraryA("dbghelp.dll");
+    const auto write = dbghelp ? reinterpret_cast<MiniDumpWriteDumpFn>(
+                                     GetProcAddress(dbghelp, "MiniDumpWriteDump"))
+                               : nullptr;
+    if (write != nullptr) {
+        std::snprintf(path, sizeof(path), "%s/eden-crash-%lu.dmp", directory,
+                      GetCurrentProcessId());
+        const HANDLE file = CreateFileA(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                                        FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file != INVALID_HANDLE_VALUE) {
+            const ExceptionInformation information{GetCurrentThreadId(), exception, FALSE};
+            write(GetCurrentProcess(), GetCurrentProcessId(), file, 0x1000, &information, nullptr,
+                  nullptr);
+            CloseHandle(file);
+        }
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+// std::terminate (an exception escaping a noexcept function, e.g. an Xbyak error in the JIT) and
+// abort() exit without an SEH exception, so WriteCrashReport never saw them. Write the exception
+// text, then raise an SEH exception so the report and dump above are written with this stack.
+static void ReportTerminate(const char* what) {
+    if (const char* directory = std::getenv("EDEN_NX2_CRASH_DUMP")) {
