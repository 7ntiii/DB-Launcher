+/// v4.23 MAP_TREND, guest: writes the host's +4 / +6 into this game's own table, entry by group
+/// id, while the game is in the table's round. Checked once a second; written again when the game
+/// changed it back, at most 5 write passes a round. Never on the host (the caller is the guest
+/// branch), never into an entry whose id the host did not send, never a table that is not
+/// plausible.
+void Assist::State::TrendApply(u64 map_system, u32 round, Clock::time_point now) {
+    if (trend_in.empty() || trend_in_round != round || now < trend_check_at) {
+        return;
+    }
+    trend_check_at = now + 1s;
+    const u64 begin = Get<u64>(map_system + MAP_TREND_TABLE);
+    const u64 end = Get<u64>(map_system + MAP_TREND_TABLE + 8);
+    if (begin == 0 || end <= begin || (end - begin) % MAP_TREND_STRIDE != 0 ||
+        (end - begin) / MAP_TREND_STRIDE > MAP_TREND_MAX) {
+        if (trend_bad_logged != round) {
+            trend_bad_logged = round;
+            Log(fmt::format("map trend: round {} own table not usable (begin {:#x} end {:#x}); "
+                            "nothing written",
+                            round, begin, end));
+        }
+        return;
+    }
+    const size_t count = (end - begin) / MAP_TREND_STRIDE;
+    std::unordered_map<u32, u32> host;
+    for (const auto& entry : trend_in) {
+        host.emplace(entry.id, entry.values);
+    }
+    size_t differ = 0;
+    size_t unknown = 0;
+    std::vector<std::pair<u64, u32>> writes;
+    for (size_t i = 0; i < count; ++i) {
+        const u64 entry = begin + i * MAP_TREND_STRIDE;
+        const auto it = host.find(Get<u32>(entry));
+        if (it == host.end()) {
+            ++unknown;
+            continue;
+        }
+        if (Get<u32>(entry + 4) != it->second) {
+            ++differ;
+            writes.emplace_back(entry + 4, it->second);
+        }
+    }
+    if (differ == 0) {
+        if (trend_done_round != round) {
+            trend_done_round = round;
+            Log(fmt::format("map trend: round {} table matches the host's ({} groups, {} not "
+                            "sent by it)",
+                            round, count, unknown));
+        }
+        return;
+    }
+    if (trend_writes >= 5) {
+        if (trend_writes == 5) {
+            ++trend_writes;
+            Log(fmt::format("map trend: round {} the game keeps changing {} groups back; no "
+                            "more writes this round",
+                            round, differ));
+        }
+        return;
+    }
+    ++trend_writes;
+    for (const auto& [address, values] : writes) {
+        Put<u32>(address, values);
+    }
+    Log(fmt::format("map trend: round {} {} of {} groups written from player {}'s table (pass "
+                    "{}, {} ids not sent by it)",
+                    round, differ, count, trend_in_from, trend_writes, unknown));
+}
+
+/// LEVELSHARE: this game's strength-level map ([stage+0x3378]+0x38) as sorted entries
+/// u16 key | u16 level << 16, or nothing when the module is absent or the walk is not plausible
+/// (a torn read while the game inserts: the next call reads again).
+std::optional<std::vector<u32>> Assist::State::LevelRead(u64 stage) {
+    const u64 module = stage != 0 ? Get<u64>(stage + LEVEL_MODULE) : 0;
+    if (module == 0) {
+        return std::nullopt;
+    }
+    const u64 size = Get<u64>(module + LEVEL_MAP_SIZE);
+    if (size > 256) {
+        return std::nullopt;
+    }
+    std::vector<u32> out;
+    u64 node = Get<u64>(module + LEVEL_MAP_FIRST);
+    for (u64 i = 0; node != 0 && i <= size; ++i) {
+        const u16 key = Get<u16>(node + LEVEL_NODE_KEY);
+        const u16 level = Get<u16>(node + LEVEL_NODE_LEVEL);
+        out.push_back(u32{key} | (u32{level} << 16));
+        node = Get<u64>(node);
+    }
+    if (node != 0 || out.size() != size) {
+        return std::nullopt;
+    }
+    std::sort(out.begin(), out.end());
+    return out;
+}
+
+/// LEVELSHARE: are the cave's hook word in this game and the switch on? A file
+/// dusk_lan_levelshare_off.txt next to the status file switches the guest side off on this game.
+bool Assist::State::LevelOn() {
+    if (main == 0 || Get<u32>(main + LV_HOOK_SITE) != LV_HOOK_WORD) {
+        return false;
+    }
+    if (!status_path.empty()) {
+        std::error_code ec;
+        if (std::filesystem::exists(status_path.parent_path() / "dusk_lan_levelshare_off.txt", ec)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/// LEVELSHARE, host: its map goes out every 2 s in a match (any round; a few bytes), and at once
+/// when it changes (the trend step may run again later in round 1, alpha I1REPICK).
+void Assist::State::LevelSend(u64 stage, u32 round, Clock::time_point now) {
+    if (level_armed_round != ~0U) {
+        // This game was a guest before: its box must not feed its own map now.
+        Put<u32>(main + LEVEL_BOX, 0);
+        level_armed_round = ~0U;
+    }
+    const auto own = LevelRead(stage);
+    if (!own) {
+        return;
+    }
+    const bool changed = round != level_sent_round || *own != level_sent;
+    if (!changed && now - level_sent_at < 2s) {
+        return;
+    }
+    const u32 player_no = LocalPlayerNo();
+    if (player_no == 0 || player_no > 0xFF) {
+        return;
+    }
+    const size_t count = std::min(own->size(), LEVEL_MAX);
+    if (changed) {
+        std::string list;
+        for (const u32 entry : *own) {
+            list += fmt::format(" {:#x}:{}", entry & 0xFFFF, static_cast<s16>(entry >> 16));
+        }
+        Log(fmt::format("levels: round {} strength-level map here, {} entries{}{}", round,
+                        own->size(), list,
+                        own->size() > LEVEL_MAX
+                            ? fmt::format(" (only the first {} are sent)", LEVEL_MAX)
+                            : std::string{}));
+    }
+    LevelMessage head;
+    head.player_no = static_cast<u8>(player_no);
+    head.count = static_cast<u16>(count);
+    head.instance = instance;
+    head.round = round;
+    std::vector<u8> packet(sizeof(head) + count * 4);
+    std::memcpy(packet.data(), &head, sizeof(head));
+    if (count != 0) {
+        std::memcpy(packet.data() + sizeof(head), own->data(), count * 4);
+    }
+    Network::LanSide::Send(std::span<const u8>(packet));
+    level_sent = *own;
+    level_sent_round = round;
+    level_sent_at = now;
+}
+
+/// LEVELSHARE, guest: once a second, compares this game's map with the host's of this round and,
+/// when entries are missing here, hands the host's to the cave (LEVEL_BOX; the cave inserts them
+/// with the game's own insert before the next chr is built, once per round). Never writes the
+/// game's map itself; never on the host; at most 3 hand-overs a round.
+void Assist::State::LevelApply(u64 stage, u32 round, Clock::time_point now) {
+    if (level_in_round != round || now < level_check_at) {
+        return;
+    }
+    level_check_at = now + 1s;
+    const auto own = LevelRead(stage);
+    if (!own) {
+        return;
+    }
+    std::unordered_map<u16, u16> mine;
+    for (const u32 entry : *own) {
+        mine.emplace(static_cast<u16>(entry & 0xFFFF), static_cast<u16>(entry >> 16));
+    }
+    size_t missing = 0;
+    size_t differ = 0;
+    for (const u32 entry : level_in) {
+        const auto it = mine.find(static_cast<u16>(entry & 0xFFFF));
+        if (it == mine.end()) {
+            ++missing;
+        } else if (it->second != static_cast<u16>(entry >> 16)) {
+            ++differ;
+        }
+    }
+    const bool armed = level_armed_round == round;
+    const u32 fed = armed ? Get<u32>(main + LEVEL_BOX + 4) : 0;
+    // HPO5: with the v2 cave a key with another level here counts as missing (it is updated).
+    const bool updates = differ != 0 && Get<u32>(main + LV_UPDATE_SITE) == LV_UPDATE_WORD;
+    if (updates) {
+        missing += differ;
+        differ = 0;
+    }
+    if (missing == 0) {
+        if (level_done_round != round) {
+            level_done_round = round;
+            Log(fmt::format("levels: round {} map matches player {}'s ({} entries{}{})", round,
+                            level_in_from, level_in.size(),
+                            differ != 0 ? fmt::format(", {} with another level here", differ)
+                                        : std::string{},
+                            armed && fed == round + 1
+                                ? fmt::format(", cave runs {}", Get<u32>(main + LEVEL_BOX + 12))
+                                : std::string{}));
+        }
+        return;
+    }
+    if (!LevelOn()) {
+        if (!level_off_logged) {
+            level_off_logged = true;
+            Log(fmt::format("levels: round {} {} of player {}'s {} entries missing here, but "
+                            "LEVELSHARE is off (no hook word at {:#x}, or "
+                            "dusk_lan_levelshare_off.txt); bosses keep their base rows",
+                            round, missing, level_in_from, level_in.size(), LV_HOOK_SITE));
+        }
+        return;
+    }
+    if (armed && fed != round + 1) {
+        // Handed over, but no chr was built since: this round's chrs were built before the host's
+        // map came (they keep their base rows until they are built again).
+        if (!level_late_logged && now - level_armed_at > 20s) {
+            level_late_logged = true;
+            Log(fmt::format("levels: round {} {} entries handed to the cave {} s ago; no chr built "
+                            "since",
+                            round, level_in.size(),
+                            std::chrono::duration_cast<std::chrono::seconds>(now - level_armed_at)
+                                .count()));
+        }
+        return;
+    }
+    if (level_armed_round != round) {
+        level_arms = 0;
+        level_late_logged = false;
+    }
+    if (level_arms >= 3) {
+        if (level_arms == 3) {
+            ++level_arms;
+            Log(fmt::format("levels: round {} still {} entries missing after 3 hand-overs; no more "
+                            "this round",
+                            round, missing));
+        }
+        return;
+    }
+    ++level_arms;
+    const size_t count = std::min(level_in.size(), LEVEL_MAX);
+    Put<u32>(main + LEVEL_BOX, 0); // the cave ignores the box while it is written
+    if (count != 0) {
+        Write(main + LEVEL_BOX + 16, level_in.data(), count * 4);
+    }
+    Put<u32>(main + LEVEL_BOX + 8, static_cast<u32>(count));
+    Put<u32>(main + LEVEL_BOX + 4, 0);
+    Put<u32>(main + LEVEL_BOX, round + 1);
+    level_armed_round = round;
+    level_armed_at = now;
+    Log(fmt::format("levels: round {} {} of player {}'s {} entries missing here; handed to the "
+                    "LEVELSHARE cave (pass {})",
+                    round, missing, level_in_from, level_in.size(), level_arms));
+}
+
+/// PARTSYNC: are the cave's hook word in this game and the switch on? A file
+/// dusk_lan_partsync_off.txt next to the status file keeps this game comparing and logging only.
+bool Assist::State::PartOn() {
+    if (main == 0 || Get<u32>(main + PS_SITE) != PS_HOOK) {
+        return false;
+    }
+    if (!status_path.empty()) {
+        std::error_code ec;
+        if (std::filesystem::exists(status_path.parent_path() / "dusk_lan_partsync_off.txt", ec)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/// PARTSYNC, side type 29: another game's own view of its Trespasser battles in step 2..3.
+void Assist::State::PartHeard(const Network::LanSide::Packet& packet) {
+    PartMessage head;
+    if (packet.data.size() < sizeof(head)) {
+        return;
+    }
+    std::memcpy(&head, packet.data.data(), sizeof(head));
+    if (head.instance == instance || head.player_no == 0 || head.count > PART_BATTLES_MAX ||
+        packet.data.size() != sizeof(head) + size_t{head.count} * sizeof(PartEntry) ||
+        CutNo(head.player_no)) {
+        return;
+    }
+    for (size_t i = 0; i < head.count; ++i) {
+        PartEntry in;
+        std::memcpy(&in, packet.data.data() + sizeof(head) + i * sizeof(in), sizeof(in));
+        if (in.list_n > PART_LIST_MAX || in.step < 2 || in.step > 3) {
+            continue;
+        }
+        auto& view = part_heard[{in.id, head.player_no}];
+        const bool self_in = in.self_in != 0;
+        if (view.at == Clock::time_point{} || view.self_in != self_in || view.step != in.step ||
+            packet.at - view.at > PART_FRESH) {
+            view.stable = packet.at; // a new value (or a gap): the grace starts again
+        }
+        view.at = packet.at;
+        view.step = in.step;
+        view.self_in = self_in;
+        view.self_b = in.self_b;
+        view.boss_max = in.boss_max;
+        view.list.assign(in.list, in.list + in.list_n);
+    }
+}
+
+/// PARTSYNC (diag/net/zt_faults/partcount): every 100 ms. (1) Reads this game's battles in step 2..3
+/// (participant list read twice: the game thread may be changing it) and sends them (side type 29:
+/// every 500 ms, at once on a change). (2) For every other player whose OWN game reports, for a
+/// battle we have too, a membership that differs from our list for PART_GRACE, hands one job to the
+/// cave: add with the game's kind-4 apply or remove with its kind-6 apply. The player's own game is
+/// the source of truth for its own entry: in LAN it decides every join and leave of its player
+/// (0x102CFC0 area entry and 0x101C368 leave run for the local player only). Our own entry is never
+/// touched. (3) When every fresh list equals ours but a boss max differs for 3 s, the cave re-runs
+/// the game's count functor once (0x101B6E0 stores the count even when it could not apply it).
+void Assist::State::PartSync(Clock::time_point now) {
+    if (main == 0 || now < part_check_at) {
+        return;
+    }
+    part_check_at = now + 100ms;
+    const u32 local_no = LocalPlayerNo();
+    if (local_no == 0 || local_no > 0xFF) {
+        return;
+    }
+    struct Battle {
+        u64 ins = 0;
+        u32 id = 0;
+        u32 step = 0;
+        bool open = false;
+        std::vector<u8> list;   // sorted player numbers
+        std::map<u8, u8> b;     // player no -> entry +0xD
+    };
+    std::vector<Battle> battles;
+    const auto read_list = [&](u64 ins, Battle& out) {
+        const u64 begin = Get<u64>(ins + INS_PARTS);
+        const u64 end = Get<u64>(ins + INS_PARTS + 8);
+        if (begin == 0 || end < begin || (end - begin) % PART_ENTRY != 0 ||
+            (end - begin) / PART_ENTRY > 16) {
+            return false;
+        }
+        out.list.clear();
+        out.b.clear();
+        for (u64 e = begin; e < end; e += PART_ENTRY) {
+            const u32 no = Get<u32>(e);
+            if (no == 0 || no > 0xFF) {
+                return false;
+            }
+            out.list.push_back(static_cast<u8>(no));
+            out.b[static_cast<u8>(no)] = Get<u8>(e + 0xD);
+        }
+        std::sort(out.list.begin(), out.list.end());
+        return true;
+    };
+    const u64 manager = Get<u64>(main + STRUGGLE_MANAGER);
+    const u64 first_slot = manager != 0 ? Get<u64>(manager + 8) : 0;
+    const u64 end_slot = manager != 0 ? Get<u64>(manager + 0x10) : 0;
+    if (first_slot != 0 && end_slot > first_slot && end_slot - first_slot <= u64{64 * 8}) {
+        for (u64 slot = first_slot; slot < end_slot && battles.size() < PART_BATTLES_MAX;
+             slot += 8) {
+            const u64 ins = Get<u64>(slot);
+            if (ins == 0) {
+                continue;
+            }
+            Battle one;
+            one.ins = ins;
+            one.id = Get<u32>(ins + INS_ID);
+            one.step = Get<u32>(ins + INS_STEP);
+            one.open = Get<u8>(ins + INS_OPEN) != 0;
+            if (one.id == 0 || one.step < 2 || one.step > 3) {
+                continue;
+            }
+            Battle again;
+            if (!read_list(ins, one) || !read_list(ins, again) || again.list != one.list) {
+                continue; // torn read: next pass
+            }
+            battles.push_back(std::move(one));
+        }
+    }
+    const auto boss_max = [&](u32 id) {
+        const auto it = part_boss_max.find(id >> 16);
+        return it != part_boss_max.end() ? it->second : 0;
+    };
+    const auto names = [](const std::vector<u8>& list) {
+        std::string s;
+        for (const u8 no : list) {
+            s += fmt::format("{}p{}", s.empty() ? "" : " ", no);
+        }
+        return s.empty() ? std::string{"-"} : s;
+    };
+
+    // (1) send
+    std::string sig;
+    for (const auto& one : battles) {
+        sig += fmt::format("{:x}:{}:{};", one.id, one.step, names(one.list));
+    }
+    if (!battles.empty() &&
+        ((sig != part_sent_sig && now - part_sent_at >= 100ms) || now - part_sent_at >= 500ms)) {
+        PartMessage head;
+        head.player_no = static_cast<u8>(local_no);
+        head.count = static_cast<u8>(battles.size());
+        head.instance = instance;
+        head.round = battles.front().id & 0xFFFF; // logs only
+        std::vector<u8> packet(sizeof(head) + battles.size() * sizeof(PartEntry));
+        std::memcpy(packet.data(), &head, sizeof(head));
+        for (size_t i = 0; i < battles.size(); ++i) {
+            const auto& one = battles[i];
+            PartEntry out;
+            out.id = one.id;
+            out.step = static_cast<u8>(one.step);
+            const auto own = one.b.find(static_cast<u8>(local_no));
+            out.self_in = own != one.b.end() ? 1 : 0;
+            out.self_b = own != one.b.end() ? own->second : 0;
+            out.list_n = static_cast<u8>(std::min(one.list.size(), PART_LIST_MAX));
+            std::copy_n(one.list.begin(), out.list_n, out.list);
+            out.boss_max = boss_max(one.id);
+            std::memcpy(packet.data() + sizeof(head) + i * sizeof(out), &out, sizeof(out));
+        }
+        Network::LanSide::Send(std::span<const u8>(packet));
+        part_sent_at = now;
+        part_sent_sig = sig;
+    }
+
+    // old reports and marks go (a battle that ended, a player that left)
+    std::erase_if(part_heard, [&](const auto& kv) { return now - kv.second.at > 30s; });
+    std::erase_if(part_differ_since, [&](const auto& kv) {
+        const auto it = part_heard.find(kv.first);
+        return it == part_heard.end() || now - it->second.at > PART_FRESH;
+    });
+
+    // a job under way: wait for the cave (one at a time)
+    const bool on = PartOn();
+    if (part_armed_at) {
+        if (Get<u32>(main + PS_BOX + 4) == part_seq) {
+            Log(fmt::format("partsync: {} -> taken by the cave (cave runs {})", part_job,
+                            Get<u8>(main + PS_BOX + 0xF)));
+            part_armed_at.reset();
+        } else if (now - *part_armed_at > 1s) {
+            Put<u32>(main + PS_BOX, Get<u32>(main + PS_BOX + 4)); // withdraw: armed = fed
+            Log(fmt::format("!!! partsync: {} -> the cave did not take it in 1 s (battle no longer "
+                            "updated here?); withdrawn !!!",
+                            part_job));
+            part_armed_at.reset();
+        } else {
+            return;
+        }
+    }
+    if (!on && !part_off_logged && !battles.empty()) {
+        part_off_logged = true;
+        Log(fmt::format("partsync: the PARTSYNC cave is not built in or dusk_lan_partsync_off.txt "
+                        "is there (word at {:#x}); participant lists are compared and logged only",
+                        PS_SITE));
+    }
+
+    for (const auto& one : battles) {
+        // the view of every game, logged when it changes
+        std::string view = fmt::format("here [{}] max {}", names(one.list), boss_max(one.id));
+        bool lists_equal = true;
+        bool max_differs = false;
+        const s32 max_here = boss_max(one.id);
+        for (const auto& [key, heard] : part_heard) {
+            if (key.first != one.id || now - heard.at > PART_FRESH) {
+                continue;
+            }
+            view += fmt::format("; player {} [{}] max {}", key.second, names(heard.list),
+                                heard.boss_max);
+            lists_equal = lists_equal && heard.list == one.list;
+            max_differs = max_differs || (heard.boss_max >= ENEMY_MAX_MIN &&
+                                          max_here >= ENEMY_MAX_MIN &&
+                                          std::abs(heard.boss_max - max_here) > 1);
+        }
+        if (auto& logged = part_logged[one.id]; logged != view) {
+            logged = view;
+            Log(fmt::format("partsync: battle {:#x} (enemy key {:#x}) step {}: {}", one.id,
+                            one.id >> 16, one.step, view));
+        }
+        if (!one.open) {
+            continue; // 0x101B6E0 applies nothing any more; the battle is closing
+        }
+        // (2) a player whose own game says otherwise
+        for (const auto& [key, heard] : part_heard) {
+            if (key.first != one.id || key.second == local_no || now - heard.at > PART_FRESH) {
+                continue;
+            }
+            const u8 no = key.second;
+            const bool here = std::binary_search(one.list.begin(), one.list.end(), no);
+            if (here == heard.self_in) {
+                part_differ_since.erase(key);
+                part_tries.erase(key);
+                continue;
+            }
+            const auto since = part_differ_since.try_emplace(key, now).first->second;
+            if (now - since < PART_GRACE || now - heard.stable < PART_GRACE) {
+                continue;
+            }
+            auto& tries = part_tries[key];
+            if (tries.first >= PART_TRIES || (tries.first != 0 && now - tries.second < PART_RETRY)) {
+                if (tries.first == PART_TRIES) {
+                    ++tries.first;
+                    Log(fmt::format("!!! partsync: battle {:#x}: player {} still {} here after {} "
+                                    "jobs; left as it is !!!",
+                                    one.id, no, here ? "listed" : "missing", PART_TRIES));
+                }
+                continue;
+            }
+            const std::string text = fmt::format(
+                "battle {:#x}: player {}'s own game {} it (step {}), this game's list [{}] {} it: {}",
+                one.id, no, heard.self_in ? "lists" : "does not list", heard.step,
+                names(one.list), here ? "has" : "lacks",
+                heard.self_in ? "added with the game's kind-4 apply" : "removed with the game's "
+                                                                       "kind-6 apply");
+            if (!on) {
+                if (tries.first == 0) {
+                    tries = {PART_TRIES + 1, now}; // logged once per difference
+                    Log(fmt::format("partsync: {} (NOT done: PARTSYNC off)", text));
+                }
+                continue;
+            }
+            ++tries.first;
+            tries.second = now;
+            part_seq = Get<u32>(main + PS_BOX + 4) + 1;
+            Put<u32>(main + PS_BOX + 8, one.id);
+            Put<u8>(main + PS_BOX + 0xC, heard.self_in ? PS_ADD : PS_REMOVE);
+            Put<u8>(main + PS_BOX + 0xD, heard.self_b);
+            Put<u8>(main + PS_BOX + 0xE, no);
+            Put<u32>(main + PS_BOX, part_seq); // armed last
+            part_armed_at = now;
+            part_job = fmt::format("{} (job {}, try {})", text, part_seq, tries.first);
+            return; // one job at a time
+        }
+        // (3) same lists everywhere, another max: re-run the count functor here once
+        if (!lists_equal || !max_differs) {
+            part_max_differ_since.erase(one.id);
+            continue;
+        }
+        const auto since = part_max_differ_since.try_emplace(one.id, now).first->second;
+        const auto last = part_reapplied.find(one.id);
+        if (!on || now - since < 3s || (last != part_reapplied.end() && now - last->second < 10s)) {
+            continue;
+        }
+        part_reapplied[one.id] = now;
+        part_seq = Get<u32>(main + PS_BOX + 4) + 1;
+        Put<u32>(main + PS_BOX + 8, one.id);
+        Put<u8>(main + PS_BOX + 0xC, PS_REAPPLY);
+        Put<u8>(main + PS_BOX + 0xD, 0);
+        Put<u8>(main + PS_BOX + 0xE, 0);
+        Put<u32>(main + PS_BOX, part_seq);
+        part_armed_at = now;
+        part_job = fmt::format("battle {:#x}: every list is [{}] but the boss max differs ({}); the "
+                               "game's count functor runs again here (job {})",
+                               one.id, names(one.list), view, part_seq);
+        return;
+    }
+}
+
+/// v4.27 AREA_ICONS, host: one type-22 packet with this round's area-icon list (MS+0x538), or
+/// nothing when the list is not plausible (then the guests keep theirs).
+std::vector<u8> Assist::State::IconSnapshot(u64 map_system, u32 round) {
+    const u64 begin = Get<u64>(map_system + MAP_ICONS);
+    const u64 end = Get<u64>(map_system + MAP_ICONS + 8);
+    if ((begin == 0) != (end == 0) || end < begin || (end - begin) % 8 != 0 ||
+        (end - begin) / 8 > MAP_ICONS_MAX) {
+        Log(fmt::format("area icons: round {} list not sent (begin {:#x} end {:#x})", round, begin,
+                        end));
+        return {};
+    }
+    const size_t count = (end - begin) / 8;
+    std::vector<u64> raw(count);
+    std::vector<u64> again(count);
+    // Two equal reads (the game thread may be refilling it): a torn list is not sent.
+    if (count != 0 &&
+        (!Read(begin, raw.data(), count * 8) || !Read(begin, again.data(), count * 8) ||
+         raw != again || Get<u64>(map_system + MAP_ICONS) != begin ||
+         Get<u64>(map_system + MAP_ICONS + 8) != end)) {
+        Log(fmt::format("area icons: round {} list changed while read; not sent", round));
+        return {};
+    }
+    for (const u64 entry : raw) {
+        if ((entry >> 32) > MAP_ICON_KIND_MAX) {
+            Log(fmt::format("area icons: round {} list has kind {} (area {}); not sent", round,
+                            entry >> 32, entry & 0xFFFFFFFFU));
+            return {};
+        }
+    }
+    const u32 player_no = LocalPlayerNo();
+    if (player_no == 0 || player_no > 0xFF) {
+        return {};
+    }
+    AreaIconMessage head;
+    head.player_no = static_cast<u8>(player_no);
+    head.count = static_cast<u16>(count);
+    head.instance = instance;
+    head.round = round;
+    std::vector<u8> packet(sizeof(head) + count * 8);
+    std::memcpy(packet.data(), &head, sizeof(head));
+    if (count != 0) {
+        std::memcpy(packet.data() + sizeof(head), raw.data(), count * 8);
+    }
+    Log(fmt::format("area icons: round {} list sent with the lists ({} entries)", round, count));
+    return packet;
+}
+
+/// v4.27 AREA_ICONS, guest: when this game's own area-icon list differs from the host's for the
+/// game's current round, hand the host's list to the game through ICON_BOX (the patched 0x6A reader
+/// copies it into LISTBUF and clears the box). Checked once a second, at most 5 hand-overs a round.
+/// Never on the host (the caller is the guest branch).
+/// v4.28: a list handed in an earlier round is emptied (count 0) once the game is in another round
+/// and the host's list for it is not in, e.g. the final, which has no lists (b_final_crash_notes.md).
+void Assist::State::IconApply(u64 map_system, u32 round, Clock::time_point now) {
+    if (icons_given_round != ~0U && icons_given_round != round &&
+        !(icons_in_valid && icons_in_round == round) && now >= icons_check_at) {
+        icons_check_at = now + 1s;
+        if (Get<u32>(main + ICON_BOX) == 0) {
+            Put<u32>(main + ICON_BOX + 4, 0);
+            Put<u32>(main + ICON_BOX, 1);
+            icons_ours = true;
+            Log(fmt::format("area icons: round {}: the list handed in round {} is emptied (no list "
+                            "from the host for this round yet)",
+                            round, icons_given_round));
+            icons_given_round = ~0U;
+        }
+        return;
+    }
+    if (!icons_in_valid || icons_in_round != round || now < icons_check_at) {
+        return;
+    }
+    icons_check_at = now + 1s;
+    const u64 begin = Get<u64>(map_system + MAP_ICONS);
+    const u64 end = Get<u64>(map_system + MAP_ICONS + 8);
+    std::vector<u64> own;
+    if (begin != 0 && end > begin) {
+        if ((end - begin) % 8 != 0 || (end - begin) / 8 > 256) {
+            if (icons_bad_logged != round) {
+                icons_bad_logged = round;
+                Log(fmt::format("area icons: round {} own list not usable (begin {:#x} end {:#x}); "
+                                "nothing handed over",
+                                round, begin, end));
+            }
+            return;
+        }
+        own.resize((end - begin) / 8);
+        if (!Read(begin, own.data(), own.size() * 8)) {
+            return;
+        }
+    }
+    if (own == icons_in) {
+        if (icons_done_round != round) {
+            icons_done_round = round;
+            Log(fmt::format("area icons: round {} list matches the host's ({} entries)", round,
+                            own.size()));
+        }
+        return;
+    }
+    if (Get<u32>(main + ICON_BOX) != 0) {
+        return; // the game has not taken the last hand-over yet
+    }
+    if (icons_writes >= 5) {
+        if (icons_writes == 5) {
+            ++icons_writes;
+            Log(fmt::format("area icons: round {} the list still differs after 5 hand-overs "
+                            "({} here, {} from the host); no more this round",
+                            round, own.size(), icons_in.size()));
+        }
+        return;
+    }
+    ++icons_writes;
+    Put<u32>(main + ICON_BOX + 4, static_cast<u32>(icons_in.size()));
+    if (!icons_in.empty()) {
+        Write(main + ICON_BOX + 8, icons_in.data(), icons_in.size() * 8);
+    }
+    Put<u32>(main + ICON_BOX, 1);
+    icons_given_round = icons_in.empty() ? ~0U : round;
+    icons_ours = true;
+    Log(fmt::format("area icons: round {} {} entries handed to the game from player {}'s list "
+                    "(pass {}, {} here before)",
+                    round, icons_in.size(), icons_in_from, icons_writes, own.size()));
+}
+
+/// The game server ran the "map system" once per round: it decided where that round's map objects
+/// stand (kin summoning circles, the regional features, ...) and sent the lists to every game.
+/// Without it the map stayed bare. The built-in patch lets the host game run that simulation; here
+/// the host's emulator sends its lists to the others, whose emulators hand them to their game
+/// through the inbox the patched 0x6A reader empties (one record per game update), then "ready".
+void Assist::State::MapShare(Clock::time_point now) {
+    if (main == 0 || session.manager == 0) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 map_system = stage != 0 ? Get<u64>(stage + MAP_SYSTEM) : 0;
+    if (session.state != 8) {
+        // Review M3: the assist does not look while the join state is not 8, but the patched
+        // PrepareThird only goes on once MAP_FED == round. A game that waits there for 5 s with
+        // the join state off 8 is let go (with the lists it has).
+        const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+        if (map_system != 0 && Get<u32>(stage + P_STATE) == PHASE_PREPARE_THIRD && round < 4 &&
+            Get<u8>(main + GENERATOR_IDLE) != 0 && Get<u32>(main + MAP_FED) != round) {
+            if (!map_off_since) {
+                map_off_since = now;
+            } else if (now - *map_off_since > 5s) {
+                Put<u32>(main + MAP_FED, round);
+                map_fed_round = round;
+                map_off_since.reset();
+                Log(fmt::format("map: the game waits in PrepareThird of round {} while the join "
+                                "state is {} (not 8) for 5 s; let go with the lists it has "
+                                "(review M3)",
+                                round, session.state));
+            }
+        } else {
+            map_off_since.reset();
+        }
+        return;
+    }
+    map_off_since.reset();
+    if (map_system == 0) {
+        return;
+    }
+    const u32 round = Get<u32>(stage + P_ROUND);
+    const u32 phase = Get<u32>(stage + P_STATE);
+    // Review H1: a new match is another session or stage, or a lower round (the stage object may
+    // be reused by the next match).
+    // Review2 R10: or a match pre-load seen since (match_gen), for a new match in the same session
+    // and stage that starts at the round the old one ended.
+    if (session.manager != map_manager || stage != map_stage || round < map_round_seen ||
+        match_gen != map_gen) {
+        Log(fmt::format("map: new match (session {:#x}, stage {:#x}, round {} after {}, match "
+                        "load #{}); map sharing state reset",
+                        session.manager, stage, round, map_round_seen, match_gen));
+        map_manager = session.manager;
+        map_stage = stage;
+        map_gen = match_gen;
+        MapReset(~0U);
+    }
+    map_round_seen = round;
+
+    if (Get<u8>(main + GENERATOR_IDLE) == 0) {
+        // LEVELSHARE: the host's strength levels go out in every round (type 28).
+        LevelSend(stage, round, now);
+        // v4.28: this game was a guest whose area-icon list points at LISTBUF; as the host its body
+        // grows or frees that list with the game's allocator, so the patched reader hands it back
+        // empty (begin 0) first (ICON_BOX = 2). Done once the box is taken and begin is not LISTBUF.
+        if (icons_ours) {
+            const u32 box = Get<u32>(main + ICON_BOX);
+            if (box == 0 && icons_detach_sent &&
+                Get<u64>(map_system + MAP_ICONS) != main + ICON_LIST) {
+                icons_ours = icons_detach_sent = false;
+                Log("area icons: host now; the list is the game's own again (LISTBUF let go)");
+            } else if (box != 2) {
+                Put<u32>(main + ICON_BOX, 2);
+                icons_detach_sent = true;
+            }
+        }
+        // Host: the lists stand between the simulation (PrepareFirst) and the apply (PrepareThird).
+        // Review M4: MAP_READY may still be 1 from the last round (the step-12 responder sets it
+        // on every game, nothing shows the game clears it when the round goes up), so a 1 counts
+        // only after a 0 was seen in this round. Without that edge the lists go out once the game
+        // is in PrepareThird (the simulation of this round ran before it) or, if that step was
+        // too short to be seen, in UpdatePhase (the lists of this round stand until the next).
+        const u8 ready_flag = Get<u8>(map_system + MAP_READY);
+        if (round != map_round_logged) {
+            map_round_logged = round;
+            Log(fmt::format("map: round {} seen here as the host; lists-ready flag {} (phase {})",
+                            round, ready_flag, phase));
+        }
+        if (ready_flag == 0) {
+            map_ready_low_round = round;
+        }
+        const bool edge = ready_flag == 1 && map_ready_low_round == round;
+        const bool late = phase == PHASE_PREPARE_THIRD || phase == PHASE_UPDATE;
+        if (round != map_sent_round && round < 4 && (edge || late)) {
+            bool too_long = false;
+            const auto snapshot = [&]() {
+                std::vector<std::vector<u8>> lists(30);
+                for (u64 kind = 0; kind < 30; ++kind) {
+                    const u64 begin = Get<u64>(map_system + MAP_LISTS + kind * 0x20);
+                    const u64 end = Get<u64>(map_system + MAP_LISTS + kind * 0x20 + 8);
+                    if (end >= begin && (end - begin) % 16 == 0 && end - begin > 0x8000 &&
+                        end - begin <= 0x100000) {
+                        too_long = true; // L5: a real but too long list (not a torn read)
+                    }
+                    if (end < begin || end - begin > 0x8000 || (end - begin) % 16 != 0) {
+                        return std::vector<std::vector<u8>>{};
+                    }
+                    lists[kind].resize(end - begin);
+                    if (end != begin && !Read(begin, lists[kind].data(), lists[kind].size())) {
+                        return std::vector<std::vector<u8>>{};
+                    }
+                }
+                return lists;
+            };
+            const auto lists = snapshot();
+            const bool any = std::any_of(lists.begin(), lists.end(),
+                                         [](const auto& list) { return !list.empty(); });
+            if (too_long) {
+                too_long = false;
+                snapshot(); // a second read: a torn begin/end pair is not taken for a long list
+            }
+            if (too_long) {
+                // L5: a list over 0x8000 bytes cannot be sent; retrying every 50 ms would read
+                // every list twice a call for the whole round. The round counts as sent (none).
+                Log(fmt::format("map: round {} has a list over 0x8000 bytes; nothing sent this "
+                                "round (the others go on without after their wait)",
+                                round));
+                map_sent_round = round;
+                map_out.clear();
+                map_out_repeats = 0;
+                map_out_cursor = 0;
+            } else if (lists.size() == 30 && (any || late) && lists == snapshot()) {
+                std::vector<std::pair<u16, std::span<const u8>>> records;
+                size_t bytes = 0;
+                for (u16 kind = 0; kind < 30; ++kind) {
+                    const std::span<const u8> all(lists[kind]);
+                    bytes += all.size();
+                    size_t at = 0;
+                    do {
+                        const size_t part = std::min<size_t>(MAP_INBOX_DATA, all.size() - at);
+                        records.emplace_back(static_cast<u16>(kind | (at != 0 ? 0x100 : 0)),
+                                             all.subspan(at, part));
+                        at += part;
+                    } while (at < all.size());
+                }
+                records.emplace_back(u16{0xFF}, std::span<const u8>{});
+                map_out.clear();
+                if (records.size() > MAP_MAX_RECORDS) {
+                    // L5: every guest drops a set of more than MAP_MAX_RECORDS records.
+                    Log(fmt::format("map: round {} lists need {} records (> {}); nothing sent "
+                                    "this round",
+                                    round, records.size(), MAP_MAX_RECORDS));
+                    records.clear();
+                }
+                for (size_t i = 0; i < records.size(); ++i) {
+                    MapMessage head;
+                    head.player_no = static_cast<u8>(LocalPlayerNo());
+                    head.index = static_cast<u16>(i);
+                    head.instance = instance;
+                    head.round = round;
+                    head.total = static_cast<u16>(records.size());
+                    head.kind = records[i].first;
+                    head.size = static_cast<u32>(records[i].second.size());
+                    std::vector<u8> packet(sizeof(head) + records[i].second.size());
+                    std::memcpy(packet.data(), &head, sizeof(head));
+                    if (!records[i].second.empty()) {
+                        std::memcpy(packet.data() + sizeof(head), records[i].second.data(),
+                                    records[i].second.size());
+                    }
+                    map_out.push_back(std::move(packet));
+                }
+                // v4.23 MAP_TREND: the group-arrangement table goes out with the lists (same
+                // passes and repeats). A new host after a hand-over takes its snapshot here too.
+                for (auto& trend : TrendSnapshot(map_system, round)) {
+                    map_out.push_back(std::move(trend));
+                }
+                // v4.27 AREA_ICONS: the area-icon list too (same passes and repeats).
+                if (auto icons = IconSnapshot(map_system, round); !icons.empty()) {
+                    map_out.push_back(std::move(icons));
+                }
+                map_sent_round = round;
+                map_out_repeats = 20; // about 15 s: the others may be busy loading
+                map_out_cursor = 0;
+                map_out_at = now;
+                map_slow_logged = false;
+                if (!records.empty()) {
+                    Log(fmt::format("map: round {} lists drawn here ({} bytes, {} records) and "
+                                    "sent to the other players ({})",
+                                    round, bytes, records.size(),
+                                    edge ? "ready flag 0 -> 1 in this round"
+                                         : (phase == PHASE_PREPARE_THIRD
+                                                ? "PrepareThird"
+                                                : "UpdatePhase, ready edge and PrepareThird not "
+                                                  "seen")));
+                }
+            }
+        }
+        // Review M5: after the fast passes the set goes out once every 3 s for the rest of the
+        // round (a late joiner, or a game that did not read its socket while loading, gets it).
+        // A set of an older round stops once the fast passes are over.
+        if (map_out_repeats <= 0 && !map_out.empty() && round != map_sent_round) {
+            Log(fmt::format("map: round {} set no longer repeated (the game is in round {})",
+                            map_sent_round, round));
+            map_out.clear();
+            map_out_cursor = 0;
+        }
+        // A few packets per call (every 50 ms): a burst of the whole set overflows the other
+        // emulator's socket buffer while its game is busy loading.
+        if (!map_out.empty() && now >= map_out_at) {
+            for (int i = 0; i < 6 && map_out_cursor < map_out.size(); ++i, ++map_out_cursor) {
+                Network::LanSide::Send(std::span<const u8>(map_out[map_out_cursor]));
+            }
+            if (map_out_cursor >= map_out.size()) {
+                map_out_cursor = 0;
+                if (map_out_repeats > 0) {
+                    --map_out_repeats;
+                }
+                if (map_out_repeats > 0) {
+                    map_out_at = now + 700ms;
+                } else {
+                    map_out_at = now + 3s;
+                    if (!map_slow_logged) {
+                        map_slow_logged = true;
+                        Log(fmt::format("map: round {} set sent 20 times; now once every 3 s "
+                                        "for the rest of the round",
+                                        map_sent_round));
+                    }
+                }
+            }
+        }
+        return;
+    }
+    // Not the host (any more): send nothing; a later host role takes a fresh snapshot.
+    if (!map_out.empty()) {
+        map_out.clear();
+        map_out_cursor = 0;
+        map_out_repeats = 0;
+        map_sent_round = ~0U;
+        Log("map: not the host any more; this game's set is no longer sent");
+    }
+    // v4.23 MAP_TREND: the host's group-arrangement table (area icons), any step of its round.
+    TrendApply(map_system, round, now);
+    // v4.27 AREA_ICONS: the host's area-icon list (the icons beside the area names).
+    IconApply(map_system, round, now);
+    // LEVELSHARE: the host's strength levels into this game's map (through the cave).
+    LevelApply(stage, round, now);
+
+    // Guest: feed a complete set, one record per game update.
+    // Review M1: only the set of the game's current round. A set that comes a little before the
+    // round counter steps (the host is a moment ahead) is kept and fed once this game is in that
+    // round: PrepareThird waits for MAP_FED == round and the round is already the new one there
+    // (MAP_WAIT reads the same counter), so it is never late. Feeding it a round early would swap
+    // the kin-circle lists to "previous" and fill the lists before this round's apply.
+    if (map_feed_since && map_in_round != round) {
+        // The game left the round this set was for before it took it all (never in PrepareThird
+        // long enough): drop it. A record still in the inbox is taken by the game before the next
+        // set's first one (one inbox, valid == 0 is waited for), and each kind's first record
+        // replaces the list.
+        Log(fmt::format("map: round {} set dropped after {} of {} records (the game is in round "
+                        "{})",
+                        map_in_round, map_feed_next, map_in.size(), round));
+        map_feed_since.reset();
+        map_feed_next = 0;
+        map_in.clear();
+        map_in_round = ~0U;
+    }
+    const bool complete = !map_in.empty() && map_in_round == round &&
+                          map_in_round != map_fed_round &&
+                          std::all_of(map_in.begin(), map_in.end(),
+                                      [](const auto& record) { return record.has_value(); });
+    if (complete) {
+        map_wait_since.reset();
+        if (!map_feed_since) {
+            map_feed_since = now;
+            map_feed_progress_at = now;
+            map_feed_next = 0;
+            MapClearLists(map_system, false);
+        }
+        // Review M2: the 10 s give-up counts from the last record the game took, and only while
+        // the game is in PrepareThird (outside it the reader may not run: loading).
+        if (phase != PHASE_PREPARE_THIRD) {
+            map_feed_progress_at = now;
+        }
+        const auto deadline = Clock::now() + 40ms;
+        while (map_feed_next <= map_in.size()) {
+            if (Get<u32>(main + MAP_INBOX) != 0) {
+                if (Clock::now() > deadline) {
+                    break;
+                }
+                std::this_thread::sleep_for(2ms);
+                continue;
+            }
+            if (map_feed_next == map_in.size()) {
+                ++map_feed_next;
+                break;
+            }
+            const MapRecord& record = *map_in[map_feed_next];
+            std::array<u32, 3> head{record.kind, static_cast<u32>(record.data.size()), 0};
+            Write(main + MAP_INBOX + 4, head.data(), sizeof(head));
+            if (!record.data.empty()) {
+                Write(main + MAP_INBOX + 0x10, record.data.data(), record.data.size());
+            }
+            Put<u32>(main + MAP_INBOX, 1);
+            ++map_feed_next;
+            map_feed_progress_at = Clock::now(); // the record before this one was taken
+        }
+        if (map_feed_next > map_in.size()) {
+            Log(fmt::format("map: round {} lists from the host are in ({} records, match step {})",
+                            map_in_round, map_in.size(), phase));
+            map_fed_round = map_in_round;
+            Put<u32>(main + MAP_FED, map_in_round);
+            map_feed_since.reset();
+        } else if (now - map_feed_progress_at > 10s) {
+            // Review L2: the lists are game vectors; the game may be in the setter for the record
+            // in the inbox. Clear them only once the inbox is empty (valid == 0: the setter has
+            // returned). If the game does not take that record within 5 s more, go on without
+            // touching the lists (the reader is not running, so nothing of ours is half done).
+            const bool inbox_empty = Get<u32>(main + MAP_INBOX) == 0;
+            if (inbox_empty || now - map_feed_progress_at > 15s) {
+                Log(fmt::format("map: the game took only {} of {} records of round {} (no "
+                                "progress for {} s in PrepareThird); going on {}",
+                                map_feed_next, map_in.size(), map_in_round,
+                                std::chrono::duration_cast<std::chrono::seconds>(
+                                    now - map_feed_progress_at)
+                                    .count(),
+                                inbox_empty ? "with empty lists"
+                                            : "with the lists as they are (a record stayed in "
+                                              "the inbox, review L2)"));
+                if (inbox_empty) {
+                    MapClearLists(map_system, true);
+                } else {
+                    Put<u32>(main + MAP_INBOX, 0);
+                }
+                Put<u8>(map_system + MAP_READY, 1);
+                map_fed_round = map_in_round;
+                Put<u32>(main + MAP_FED, map_in_round);
+                map_feed_since.reset();
+            }
+        }
+        return;
+    }
+    // The patched game waits in PrepareThird for the lists; do not let it wait for ever.
+    if (phase == PHASE_PREPARE_THIRD && round < 4 && Get<u32>(main + MAP_FED) != round) {
+        if (!map_wait_since) {
+            map_wait_since = now;
+            map_wait_logged = false;
+        } else if (now - *map_wait_since > 8s) {
+            // Balance fix M4: going on without the lists gives this player another map than the
+            // host's. While the host is still on the side channel its lists may yet come (it
+            // sends them for about 15 s once it has them): wait up to 45 s in all.
+            // A set of the next round here: the host is past this round and sends no more of it.
+            const bool host_ahead = !map_in.empty() && map_in_round == round + 1;
+            const bool host_here = HostFresh(now) && !host_ahead;
+            if (host_here && now - *map_wait_since < 45s) {
+                if (!map_wait_logged) {
+                    map_wait_logged = true;
+                    Log(fmt::format("map: no lists from the host for round {} after 8 s, but the "
+                                    "host is still here; waiting up to 45 s",
+                                    round));
+                }
+                return;
+            }
+            // Review L2: never empty the lists while a record is in the inbox (the game may be in
+            // the setter). Wait for it up to 5 s more, then go on without touching the lists.
+            const bool inbox_empty = Get<u32>(main + MAP_INBOX) == 0;
+            if (!inbox_empty && now - *map_wait_since < (host_here ? 50s : 13s)) {
+                return;
+            }
+            if (inbox_empty) {
+                MapClearLists(map_system, true);
+            } else {
+                Put<u32>(main + MAP_INBOX, 0);
+                Log("map: a record stayed in the inbox; the lists are left as they are (review "
+                    "L2)");
+            }
+            Put<u8>(map_system + MAP_READY, 1);
+            map_fed_round = round;
+            Put<u32>(main + MAP_FED, round);
+            Log(fmt::format("map: no lists from the host for round {} after {} s ({}); going on "
+                            "without",
+                            round,
+                            std::chrono::duration_cast<std::chrono::seconds>(now -
+                                                                             *map_wait_since)
+                                .count(),
+                            host_here ? "waited the full 45 s"
+                                      : (host_ahead ? "the host is already in the next round"
+                                                    : "the host is gone")));
+            map_wait_since.reset();
+        }
+    } else {
+        map_wait_since.reset();
+    }
+}
+
+/// The copy of another player (its pgd in the pool) with player number no, or 0. Never the local
+/// player's own pgd.
+u64 Assist::State::VirtuePlayer(u64 players, u32 no) {
+    if (players == 0 || no == 0 || no == ~0U) {
+        return 0;
+    }
+    const u64 local = Get<u64>(players + PGD_LOCAL);
+    const u64 local_alt = Get<u64>(players + PGD_LOCAL_ALT);
+    const u64 pool = Get<u64>(players + PGD_POOL);
+    if (pool == 0) {
+        return 0;
+    }
+    for (u64 i = 0; i < PGD_POOL_MAX; ++i) {
+        const u64 pgd = pool + i * PGD_SIZE;
+        if (pgd == local || pgd == local_alt) {
+            continue;
+        }
+        if (Get<u32>(pgd + PGD_NO) == no) {
+            return pgd;
+        }
+    }
+    return 0;
+}
+
+/// H2 (many_players_fix_notes.md): the last 5 s of a phase (UpdatePhase, phase clock under 5 s):
+/// Virtue (8) and Commendation (9) sets then go out every 50 ms instead of every 250 ms, so every
+/// game ranks the same values when its EndPhase cuts. Logged once per round.
+bool Assist::State::ShareFast(u64 stage) {
+    if (stage == 0 || Get<u32>(stage + P_STATE) != PHASE_UPDATE) {
+        return false;
+    }
+    const u64 phase_clock = Get<u64>(stage + P_CLOCK);
+    const f32 phase_left = phase_clock != 0 ? Get<f32>(phase_clock + 8) : 0.0f;
+    if (!(phase_left > 0.0f && phase_left < 5.0f)) {
+        return false;
+    }
+    const u64 key = (u64{match_gen} << 32) | Get<u32>(stage + P_ROUND);
+    if (share_fast_logged != key) {
+        share_fast_logged = key;
+        Log(fmt::format("virtue / commend: last 5 s of round {}'s phase ({:.1f} s left); types 8 "
+                        "and 9 now every 50 ms (H2)",
+                        Get<u32>(stage + P_ROUND), phase_left));
+    }
+    return true;
+}
+
+/// The game server ranked everybody by Virtue (win points) and sent the result. In LAN each game
+/// ranks for itself, but only its own player's Virtue is real there: a copy of another player only
+/// banks what this game counted for it (about 0), so every game ranks its own player first and the
+/// cuts after Phase II / III differ. The patched UI getter publishes the local total in VIRTUE_BOX;
+/// here it goes to the others a few times a second, and each total heard is written into this
+/// game's copy of that player as banked Virtue (pgd+0x42C8). Copy total = banked + its counters
+/// (about 0), so ranking, HUD and Outcome rows show the owner's real Virtue.
+void Assist::State::VirtueShare(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    if (stage == 0 || players == 0) {
+        return;
+    }
+    const u32 round = Get<u32>(stage + P_ROUND);
+    if (session.manager != virtue_manager || stage != virtue_stage ||
+        round < virtue_round_seen || match_gen != virtue_gen) { // a new match (R10: match_gen)
+        virtue_manager = session.manager;
+        virtue_stage = stage;
+        virtue_gen = match_gen;
+        virtue_sent_logged = false;
+        virtue_off_logged = false;
+        virtue_in.clear();
+        virtue_written.clear();
+        virtue_missing.clear();
+        virtue_stale.clear();
+        virtue_writes = 0;
+        virtue_sent_total = INT32_MIN;
+        virtue_change_logs = 0;
+        Put<u32>(main + VIRTUE_BOX, 0);
+        Put<u32>(main + VIRTUE_BOX + 4, 0);
+    }
+    virtue_round_seen = round;
+    const u32 local_no = LocalPlayerNo();
+
+    // Review2 R7: the copies' own counters off on every call, for every copy (not only those with
+    // a fresh total): a wp re-created or reset at a phase start while its sender is silent
+    // (loading) would otherwise count its own commendation award on top of the mirrored total.
+    if constexpr (VIRTUE_COPY_COUNTERS_OFF) {
+        const u64 local = Get<u64>(players + PGD_LOCAL);
+        const u64 local_alt = Get<u64>(players + PGD_LOCAL_ALT);
+        if (const u64 pool = Get<u64>(players + PGD_POOL); pool != 0) {
+            u32 turned_off = 0;
+            for (u64 i = 0; i < PGD_POOL_MAX; ++i) {
+                const u64 pgd = pool + i * PGD_SIZE;
+                if (pgd == local || pgd == local_alt) {
+                    continue;
+                }
+                const u32 no = Get<u32>(pgd + PGD_NO);
+                if (no == 0 || no >= 0x100 || no == local_no) {
+                    continue; // empty slot (-1) or our own player
+                }
+                const u64 wp = Get<u64>(pgd + PGD_WP);
+                if (wp != 0 && Get<u8>(wp + WP_NO_COUNTERS) == 0) {
+                    Put<u8>(wp + WP_NO_COUNTERS, 1);
+                    ++turned_off;
+                }
+            }
+            if (turned_off != 0 && !virtue_off_logged) {
+                virtue_off_logged = true;
+                Log(fmt::format("virtue: own counters of {} copy(ies) turned off (round {}; every "
+                                "copy, every pass: review2 R7)",
+                                turned_off, round));
+            }
+        }
+    }
+
+    // Ours: only once the game has computed it (count != 0), every 250 ms (UDP may drop some).
+    // H2: at once when the total changed, and every 50 ms in the last 5 s of the phase, so a gain
+    // just before the cut is in every game's ranking.
+    const u32 count = Get<u32>(main + VIRTUE_BOX + 4);
+    const s32 total_now = Get<s32>(main + VIRTUE_BOX);
+    const bool total_changed = virtue_sent_total != INT32_MIN && total_now != virtue_sent_total;
+    if (count != 0 && local_no != 0 && local_no < 0x100 &&
+        (total_changed || now - virtue_sent_at >= (ShareFast(stage) ? 50ms : 250ms))) {
+        if (total_changed && virtue_change_logs < 3) {
+            ++virtue_change_logs;
+            Log(fmt::format("virtue: our total changed {} -> {}; sent at once (H2)",
+                            virtue_sent_total, total_now));
+        }
+        VirtueMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.instance = instance;
+        out.round = round;
+        out.total = total_now;
+        out.count = count;
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+        virtue_sent_at = now;
+        virtue_sent_total = total_now;
+        if (!virtue_sent_logged) {
+            virtue_sent_logged = true;
+            Log(fmt::format("virtue: our total {} (player {}, round {}) is sent to the others",
+                            out.total, local_no, round));
+        }
+    }
+
+    // Theirs: into our copy of each sender, when it differs.
+    for (const auto& [no, in] : virtue_in) {
+        if (no == local_no) {
+            continue; // never our own player
+        }
+        // A total from another round than ours by more than one is from another match.
+        if (std::abs(static_cast<s64>(in.round) - static_cast<s64>(round)) > 1) {
+            continue;
+        }
+        // Review L1: a total not heard for 3 s (sender gone, or player numbers moved) is not
+        // written; its copy keeps what it has.
+        if (now - in.at > 3s) {
+            if (virtue_stale.insert(no).second) {
+                Log(fmt::format("virtue: player {}'s total {} not heard for 3 s; no longer written "
+                                "(review L1)",
+                                no, in.total));
+            }
+            continue;
+        }
+        virtue_stale.erase(no);
+        const u64 pgd = VirtuePlayer(players, no);
+        if (pgd == 0) {
+            if (virtue_missing.insert(no).second) {
+                Log(fmt::format("virtue: player {}'s total {} heard, but this game has no copy of "
+                                "that player (yet)",
+                                no, in.total));
+            }
+            continue;
+        }
+        const u16 want = static_cast<u16>(std::clamp<s32>(in.total, 0, VIRTUE_MAX));
+        const u16 have = Get<u16>(pgd + PGD_BANKED);
+        if (have != want) {
+            Put<u16>(pgd + PGD_BANKED, want);
+            ++virtue_writes;
+            if (virtue_written.insert(no).second) {
+                Log(fmt::format("virtue: player {}'s copy set to its game's total: banked {} -> "
+                                "{} (round {}, pgd {:#x})",
+                                no, have, want, round, pgd));
+            }
+        }
+        // Counters off: done for every copy above (review2 R7).
+    }
+}
+
+/// Commendation (Bloodfang = enemy kills, Collector = items found in exploration): the top two of
+/// each pay Virtue at every phase end. With commendation_live.py every game counts and ranks for
+/// itself, from its own pgd of every player. A kill or pickup is counted once, on one game, into
+/// that game's pgd of the player (maybe a copy). So each game sends, for every player, what it
+/// added itself ("part" = count minus what this function wrote), and sets each pgd to its own part
+/// + every other game's part. Then all games hold the same counts and rank the same way
+/// (commendation_notes.md section 5c).
+void Assist::State::CommendShare(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    if (Get<u32>(main + COMMEND_EVAL_GATE) != COMMEND_EVAL_NOP) {
+        if (!commend_off_logged) {
+            commend_off_logged = true;
+            Log("commend: COMMEND_EVAL is not in the game (0x110B36C not patched); counts not shared");
+        }
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    if (stage == 0 || players == 0) {
+        return;
+    }
+    const u32 round = Get<u32>(stage + P_ROUND);
+    if (session.manager != commend_manager || stage != commend_stage ||
+        round < commend_round_seen || match_gen != commend_gen) { // a new match (R10: match_gen)
+        commend_manager = session.manager;
+        commend_stage = stage;
+        commend_gen = match_gen;
+        commend_sent_logged = false;
+        commend_heard.clear();
+        commend_written.clear();
+        commend_logged.clear();
+        commend_reset_logged.clear();
+        commend_result_logged.clear();
+        commend_lower_logged.clear();
+        commend_far_logged.clear();
+        commend_last_out.clear();
+        commend_change_logs = 0;
+    }
+    commend_round_seen = round;
+    const u32 local_no = LocalPlayerNo();
+
+    // Every pgd this game holds, once per player number: the local one first, then the pool.
+    std::vector<std::pair<u8, u64>> pgds;
+    const auto add = [&](u64 pgd) {
+        if (pgd == 0) {
+            return;
+        }
+        const u32 no = Get<u32>(pgd + PGD_NO);
+        if (no == 0 || no >= 0x100) {
+            return; // -1 = empty slot
+        }
+        for (const auto& entry : pgds) {
+            if (entry.first == no) {
+                return;
+            }
+        }
+        pgds.emplace_back(static_cast<u8>(no), pgd);
+    };
+    // Review2 R11: ALT first, the order LocalPlayerNo reads them in (if the two differ, the game
+    // counts into the one whose number is ours).
+    add(Get<u64>(players + PGD_LOCAL_ALT));
+    add(Get<u64>(players + PGD_LOCAL));
+    if (const u64 pool = Get<u64>(players + PGD_POOL); pool != 0) {
+        for (u64 i = 0; i < PGD_POOL_MAX; ++i) {
+            add(pool + i * PGD_SIZE);
+        }
+    }
+
+    // Review2 R2: a count below what we wrote into this pgd means the game rebuilt the copy (or the
+    // number moved to it): what we wrote is gone, so start again from 0 there.
+    const auto check_written = [&](u8 no, u64 pgd, std::array<u32, 2>& written) {
+        for (size_t k = 0; k < PGD_COMMEND.size(); ++k) {
+            const u32 have = Get<u32>(pgd + PGD_COMMEND[k]);
+            if (have < written[k]) {
+                if (commend_reset_logged.insert({no, pgd}).second) {
+                    Log(fmt::format("commend: player {}'s {} is {}, below the {} we wrote (pgd "
+                                    "{:#x}); copy rebuilt, our writes there start from 0 (review2 "
+                                    "R2)",
+                                    no, k == 0 ? "Bloodfang" : "Collector", have, written[k], pgd));
+                }
+                written[k] = 0;
+            }
+        }
+    };
+
+    // Ours: what this game added itself, every 250 ms. Review2 R4a: the header goes out even with
+    // no parts, so an empty set replaces an old match's set on the others.
+    // H2: built every pass (50 ms); sent at once when it differs from the last one sent, and every
+    // 50 ms in the last 5 s of the phase.
+    if (local_no != 0 && local_no < 0x100) {
+        std::vector<u8> out(sizeof(CommendMessage));
+        CommendMessage head;
+        head.player_no = static_cast<u8>(local_no);
+        head.instance = instance;
+        head.round = round;
+        for (const auto& [no, pgd] : pgds) {
+            auto& written = commend_written[{no, pgd}];
+            check_written(no, pgd, written);
+            CommendPart part;
+            part.no = no;
+            const u32 fang = Get<u32>(pgd + PGD_BLOODFANG);
+            const u32 coll = Get<u32>(pgd + PGD_COLLECTOR);
+            part.bloodfang = fang > written[0] ? fang - written[0] : 0;
+            part.collector = coll > written[1] ? coll - written[1] : 0;
+            if ((part.bloodfang == 0 && part.collector == 0) || head.count >= COMMEND_MAX_PARTS) {
+                continue;
+            }
+            const size_t at = out.size();
+            out.resize(at + sizeof(part));
+            std::memcpy(out.data() + at, &part, sizeof(part));
+            ++head.count;
+        }
+        std::memcpy(out.data(), &head, sizeof(head));
+        const bool set_changed = !commend_last_out.empty() && out != commend_last_out;
+        const bool due = now - commend_sent_at >= (ShareFast(stage) ? 50ms : 250ms);
+        if (set_changed || due) {
+            if (set_changed && !due && commend_change_logs < 3) {
+                ++commend_change_logs;
+                Log(fmt::format("commend: our parts changed (player {}, round {}, {} part(s)); "
+                                "sent at once (H2)",
+                                local_no, round, head.count));
+            }
+            Network::LanSide::Send(std::span<const u8>(out.data(), out.size()));
+            commend_sent_at = now;
+            commend_last_out = out;
+        }
+        if (commend_sent_at == now && head.count != 0 && !commend_sent_logged) {
+            commend_sent_logged = true;
+            Log(fmt::format("commend: our parts for {} player(s) are sent (player {}, round {})",
+                            head.count, local_no, round));
+        }
+    }
+
+    // Review2 R4b: a set more than a round ahead of ours is from another match: dropped (rounds
+    // only go up within a match). A set from an older round is kept: a game that left keeps the
+    // credit it gave (R5, totals never go down), and the sets of this match are the only ones
+    // here (cleared at the new match; old-match senders at a result screen are not taken, R4c;
+    // and a sender whose round went down replaces its set, R4a).
+    std::erase_if(commend_heard, [&](const auto& item) {
+        if (item.second.round <= round + 1) {
+            return false;
+        }
+        if (commend_far_logged.insert(item.first).second) {
+            Log(fmt::format("commend: player {}'s set (round {}) is from another match (we are in "
+                            "round {}); dropped (review2 R4b)",
+                            item.second.player_no, item.second.round, round));
+        }
+        return true;
+    });
+
+    // Theirs: each pgd = its count without our writes + the sum of the other games' parts.
+    for (const auto& [no, pgd] : pgds) {
+        std::array<u32, 2> others{};
+        // Review2 R1: by sender instance; our own instance is never stored (dropped on receive).
+        for (const auto& [sender, in] : commend_heard) {
+            if (const auto found = in.parts.find(no); found != in.parts.end()) {
+                others[0] += found->second[0];
+                others[1] += found->second[1];
+            }
+        }
+        auto& written = commend_written[{no, pgd}];
+        check_written(no, pgd, written);
+        for (size_t k = 0; k < PGD_COMMEND.size(); ++k) {
+            if (others[k] == written[k]) {
+                continue;
+            }
+            const u32 have = Get<u32>(pgd + PGD_COMMEND[k]);
+            const u32 base = have > written[k] ? have - written[k] : 0;
+            Put<u32>(pgd + PGD_COMMEND[k], base + others[k]);
+            written[k] = others[k];
+            if (commend_logged.insert(no).second) {
+                Log(fmt::format("commend: player {}'s {} set {} -> {} (others' part {}, round {}, "
+                                "pgd {:#x})",
+                                no, k == 0 ? "Bloodfang" : "Collector", have, base + others[k],
+                                others[k], round, pgd));
+            }
+        }
+    }
+}
+
+namespace {
+/// A holder value that is a player number (-1 = free; 0 is the never-set value of other kinds).
+constexpr bool TakenHeld(s32 value) {
+    return value >= 1 && value < 32;
+}
+/// The lowest player number in a player mask (bit n-1 = player n), 0 = none.
+u8 TakenLowest(u32 mask) {
+    for (u32 n = 1; n <= 32; ++n) {
+        if ((mask >> (n - 1)) & 1) {
+            return static_cast<u8>(n);
+        }
+    }
+    return 0;
+}
+} // namespace
+
+/// Forgets the taken state of a match (TakenShare): at a new match and at the session's end.
+void Assist::State::TakenClear() {
+    taken_objects.clear();
+    taken_out.clear();
+    taken_heard_seq.clear();
+    taken_pending.clear();
+    taken_pending_logged = false;
+    taken_slot_no.fill(0);
+    ids_logged.fill(0);
+    ids_logs = 0;
+    taken_round_seen = 0;
+    taken_round = ~0U;
+    taken_logs = 0;
+    taken_dup_logged = false;
+    taken_rescan = false;
+    taken_scan_logged = false;
+    taken_poll_at = {};
+    taken_scan_at = {};
+}
+
+void Assist::State::TakenLog(const std::string& line) {
+    if (taken_logs >= TAKEN_LOG_MAX) {
+        return;
+    }
+    ++taken_logs;
+    Log(line);
+    if (taken_logs == TAKEN_LOG_MAX) {
+        Log(fmt::format("taken: {} lines in this match; further ones are not logged",
+                        TAKEN_LOG_MAX));
+    }
+}
+
+/// This game's slot bits (INFO_TAKEN) as player numbers (bit n-1 = player n). A slot without a
+/// player here is left out.
+u32 Assist::State::TakenPlayers(u16 bits) const {
+    u32 mask = 0;
+    for (size_t slot = 0; slot < TAKEN_SLOTS; ++slot) {
+        const u8 no = taken_slot_no[slot];
+        if (((bits >> slot) & 1) != 0 && no >= 1 && no <= 32) {
+            mask |= 1U << (no - 1);
+        }
+    }
+    return mask;
+}
+
+/// Player numbers as this game's slot bits.
+u16 Assist::State::TakenSlots(u32 players) const {
+    u16 bits = 0;
+    for (size_t slot = 0; slot < TAKEN_SLOTS; ++slot) {
+        const u8 no = taken_slot_no[slot];
+        if (no >= 1 && no <= 32 && ((players >> (no - 1)) & 1) != 0) {
+            bits = static_cast<u16>(bits | (1U << slot));
+        }
+    }
+    return bits;
+}
+
+/// Finds the shared assets (TakenKind) of every loaded block, as diag/twin/flames.py does:
+/// CSWorldGeomMan+0x18 tree (libc++: anchor -> root, node +0 left, +8 right, +0x28 value) of block
+/// geoms; a loaded block's ins array (+0x70, count +0x80) and its big-index tree (+0x1A8). Objects
+/// still at the same ins and info keep what was seen; the others start unseen.
+void Assist::State::TakenScan() {
+    const u64 geom_man = Get<u64>(main + GEOM_MAN);
+    if (geom_man == 0) {
+        return;
+    }
+    std::map<u64, TakenObject> found;
+    size_t geoms = 0;
+    const auto visit = [&](u64 ins) {
+        if (ins == 0 || ++geoms > TAKEN_GEOMS_MAX) {
+            return;
+        }
+        const u64 info = Get<u64>(ins + INS_INFO);
+        const s32 raw = info != 0 ? Get<s32>(info + INFO_ASSET) : 0;
+        if (raw <= 0) {
+            return;
+        }
+        const u32 asset = static_cast<u32>(raw) % 10000000;
+        if (TakenKind(asset) == nullptr) {
+            return;
+        }
+        const u32 handle = Get<u32>(ins + INS_HANDLE);
+        if (handle == 0 || handle == ~0U) {
+            return; // no identity the other games share
+        }
+        const u64 key = (u64{asset} << 32) | handle;
+        if (const auto old = found.find(key); old != found.end()) {
+            if (old->second.ins != ins && !taken_dup_logged) {
+                taken_dup_logged = true;
+                TakenLog(fmt::format("taken: asset {} handle {:08x} found twice (ins {:#x} and "
+                                     "{:#x}); only the first is shared",
+                                     asset, handle, old->second.ins, ins));
+            }
+            return;
+        }
+        TakenObject object;
+        if (const auto known = taken_objects.find(key);
+            known != taken_objects.end() && known->second.ins == ins &&
+            known->second.info == info) {
+            object = known->second;
+        } else {
+            object.ins = ins;
+            object.info = info;
+        }
+        found.emplace(key, object);
+    };
+    const auto walk = [this](u64 anchor, size_t limit, const std::function<void(u64)>& each) {
+        std::vector<u64> stack;
+        u64 node = Get<u64>(anchor);
+        size_t count = 0;
+        while ((!stack.empty() || node != 0) && count < limit) {
+            while (node != 0 && stack.size() < 64) {
+                stack.push_back(node);
+                node = Get<u64>(node);
+            }
+            if (stack.empty()) {
+                break;
+            }
+            node = stack.back();
+            stack.pop_back();
+            each(Get<u64>(node + 0x28));
+            node = Get<u64>(node + 8);
+            ++count;
+        }
+    };
+    walk(geom_man + GEOM_BLOCKS, 512, [&](u64 block) {
+        if (block == 0 || Get<u8>(block + BG_LOADED) == 0 || geoms >= TAKEN_GEOMS_MAX) {
+            return;
+        }
+        const u32 n = Get<u32>(block + BG_COUNT);
+        const u64 arr = Get<u64>(block + BG_ARRAY);
+        if (arr != 0 && n != 0 && n < TAKEN_GEOMS_MAX) {
+            std::vector<u64> list(n);
+            if (Read(arr, list.data(), list.size() * sizeof(u64))) {
+                for (const u64 ins : list) {
+                    visit(ins);
+                }
+            }
+        }
+        walk(block + BG_TREE, 4096, visit);
+    });
+    taken_objects = std::move(found);
+}
+
+/// Reads one object; sends a change when it GAINED state here (a slot bit, used 0 -> 1, a holder)
+/// or its holder went to -1. Other clears are only taken as seen. False when the ins no longer
+/// holds that object (a rescan is asked for).
+bool Assist::State::TakenPoll(u64 key, TakenObject& object, u32 round, Clock::time_point now) {
+    if (Get<u64>(object.ins + INS_INFO) != object.info ||
+        Get<u32>(object.ins + INS_HANDLE) != static_cast<u32>(key)) {
+        taken_rescan = true;
+        return false;
+    }
+    const u16 bits = static_cast<u16>(Get<u16>(object.info + INFO_TAKEN) & TAKEN_SLOT_BITS);
+    const u8 used = static_cast<u8>(Get<u8>(object.info + INFO_USED) != 0 ? 1 : 0);
+    const s32 holder = Get<s32>(object.info + INFO_HOLDER);
+    if (!object.seen) {
+        // First look in this round (or after the record moved): what it holds already is sent once
+        // (the receivers only OR it in), so a take just before the scan is not lost.
+        object.seen = true;
+        object.bits = bits;
+        object.used = used;
+        object.holder = holder;
+        if (used != 0 && object.taker == 0) {
+            object.taker = TakenLowest(TakenPlayers(bits));
+        }
+        if (bits != 0 || used != 0 || TakenHeld(holder)) {
+            TakenSend(key, object, round, -1, "found taken here", now);
+        }
+        return true;
+    }
+    const u16 gained = static_cast<u16>(bits & ~object.bits);
+    const bool used_gained = used != 0 && object.used == 0;
+    const bool holder_gained = TakenHeld(holder) && holder != object.holder;
+    const bool released = holder == -1 && TakenHeld(object.holder);
+    const s32 before = object.holder;
+    if (used_gained && object.taker == 0) {
+        object.taker = TakenLowest(TakenPlayers(gained));
+        if (object.taker == 0 && TakenHeld(holder)) {
+            object.taker = static_cast<u8>(holder);
+        }
+    }
+    object.bits = bits;
+    object.used = used;
+    object.holder = holder;
+    if (gained != 0 || used_gained || holder_gained) {
+        TakenSend(key, object, round, -1, "gained here", now);
+    } else if (released) {
+        TakenSend(key, object, round, before, "holder released here", now);
+    }
+    return true;
+}
+
+void Assist::State::TakenSend(u64 key, const TakenObject& object, u32 round, s32 holder_before,
+                              std::string_view why, Clock::time_point now) {
+    TakenMessage out;
+    out.player_no = static_cast<u8>(LocalPlayerNo());
+    out.used = object.used;
+    out.taker = object.taker;
+    out.instance = instance;
+    out.round = round;
+    out.asset = static_cast<u32>(key >> 32);
+    out.handle = static_cast<u32>(key);
+    out.players = TakenPlayers(object.bits);
+    out.holder = object.holder;
+    out.holder_before = holder_before;
+    out.seq = ++taken_seq;
+    std::vector<u8> data(sizeof(out));
+    std::memcpy(data.data(), &out, sizeof(out));
+    // V400-2 (realnet_notes R2): 7 sends, the first 3 as before, then 1 / 2 / 4 / 8 s later
+    // (about 16 s in all), so a 1-3 s stall no longer loses a change for the round.
+    taken_out.push_back(TakenOut{std::move(data), TAKEN_SENDS, now});
+    TakenLog(fmt::format("taken: {} {} h={:08x} round {}: players {:#x} (slots {:03x}) used {} "
+                         "holder {}{} taker {} ({}); sent to the others (x7 in about 16 s)",
+                         TakenKind(out.asset), out.asset, out.handle, round, out.players,
+                         object.bits, out.used, out.holder,
+                         holder_before != -1 ? fmt::format(" (was {})", holder_before) : "",
+                         out.taker, why));
+}
+
+/// One heard type-12 change: ORs the bits, sets used / the holder on the same asset's record when
+/// the round is ours, and takes it as seen (no echo). True when done with it; false to try again
+/// (its round is ahead of ours, or the object is not found yet).
+bool Assist::State::TakenApply(const std::vector<u8>& data, u32 round, Clock::time_point now,
+                               bool replay) {
+    TakenMessage in;
+    std::memcpy(&in, data.data(), sizeof(in));
+    if (in.round != round) {
+        return in.round < round; // an older round: dropped; a newer one: kept until we are there
+    }
+    const u64 key = (u64{in.asset} << 32) | in.handle;
+    const std::pair<u32, u64> from{in.instance, key};
+    if (const auto heard = taken_heard_seq.find(from);
+        !replay && heard != taken_heard_seq.end() && in.seq <= heard->second) {
+        return true; // a repeat or an older change
+    }
+    if (!replay) {
+        // v3.6 audit S2: the newest change of each sender per object is kept for the whole round
+        // and replayed whenever a scan finds the object fresh (loaded later, or loaded again).
+        if (const auto stored = taken_pending.find(from); stored != taken_pending.end()) {
+            TakenMessage old;
+            std::memcpy(&old, stored->second.second.data(), sizeof(old));
+            if (in.seq > old.seq) {
+                stored->second = {++taken_pending_order, data};
+            }
+        } else {
+            if (taken_pending.size() >= TAKEN_PENDING_MAX) {
+                if (!taken_pending_logged) {
+                    taken_pending_logged = true;
+                    TakenLog(fmt::format("taken: {} heard changes kept this round; one kept "
+                                         "change is dropped for each new one",
+                                         TAKEN_PENDING_MAX));
+                }
+                taken_pending.erase(taken_pending.begin());
+            }
+            taken_pending.emplace(from, std::make_pair(++taken_pending_order, data));
+        }
+    }
+    const auto found = taken_objects.find(key);
+    if (found == taken_objects.end()) {
+        // v3.6 audit S1: not loaded here. No forced rescan: the kept change above is replayed
+        // when the periodic scan finds the object.
+        return true;
+    }
+    TakenObject& object = found->second;
+    // Our own change not sent yet goes first, so the race below sees both sides.
+    if (!TakenPoll(key, object, round, now)) {
+        return false;
+    }
+    const u16 add = static_cast<u16>(TakenSlots(in.players) & ~object.bits);
+    const u16 bits = static_cast<u16>(object.bits | add);
+    const u8 used = static_cast<u8>((object.used != 0 || in.used != 0) ? 1 : 0);
+    s32 holder = object.holder;
+    std::string notes;
+    if (TakenHeld(in.holder)) {
+        if (!TakenHeld(object.holder)) {
+            holder = in.holder;
+        } else if (object.holder != in.holder) {
+            holder = std::min(object.holder, in.holder);
+            notes += fmt::format("; holder race: player {} here, player {} there, player {} wins "
+                                 "on every game",
+                                 object.holder, in.holder, holder);
+        }
+    } else if (in.holder == -1 && TakenHeld(in.holder_before)) {
+        if (object.holder == in.holder_before) {
+            holder = -1;
+        } else if (object.holder != -1) {
+            notes += fmt::format("; release of holder {} not applied (holder here {})",
+                                 in.holder_before, object.holder);
+        }
+    }
+    if (in.used != 0 && in.taker != 0) {
+        if (object.taker == 0) {
+            object.taker = in.taker;
+        } else if (object.taker != in.taker) {
+            const u8 winner = std::min(object.taker, in.taker);
+            notes += fmt::format("; first-taker race: player {} here, player {} there, player {} "
+                                 "wins on every game (the other keeps what he already got)",
+                                 object.taker, in.taker, winner);
+            object.taker = winner;
+        }
+    }
+    const bool changed = bits != object.bits || used != object.used || holder != object.holder;
+    if (changed && replay) {
+        notes += "; a kept change, replayed on the object found here now";
+    }
+    if (changed) {
+        if (Get<u64>(object.ins + INS_INFO) != object.info ||
+            Get<u32>(object.ins + INS_HANDLE) != in.handle) {
+            taken_rescan = true;
+            return false;
+        }
+        if (add != 0) {
+            const u16 word = Get<u16>(object.info + INFO_TAKEN);
+            Put<u16>(object.info + INFO_TAKEN, static_cast<u16>(word | add));
+        }
+        if (used != object.used) {
+            Put<u8>(object.info + INFO_USED, 1);
+        }
+        if (holder != object.holder) {
+            Put<s32>(object.info + INFO_HOLDER, holder);
+        }
+    }
+    if (changed || !notes.empty()) {
+        TakenLog(fmt::format("taken: {} {} h={:08x} from player {} (round {}): slots {:03x} -> "
+                             "{:03x}, used {} -> {}, holder {} -> {}{}; {}",
+                             TakenKind(in.asset), in.asset, in.handle, in.player_no, round,
+                             object.bits, bits, object.used, used, object.holder, holder, notes,
+                             changed ? "applied" : "nothing to write"));
+    }
+    object.bits = bits;
+    object.used = used;
+    object.holder = holder;
+    taken_heard_seq[from] = in.seq;
+    return true;
+}
+
+/// Type 12 as heard: kept for TakenShare (it writes only while the match runs).
+void Assist::State::TakenHeard(const Network::LanSide::Packet& packet) {
+    TakenMessage in;
+    if (packet.data.size() != sizeof(in)) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.player_no == 0 || TakenKind(in.asset) == nullptr) {
+        return; // ours, a sender without a number, or not a shared asset
+    }
+    const u64 key = (u64{in.asset} << 32) | in.handle;
+    if (const auto heard = taken_heard_seq.find({in.instance, key});
+        heard != taken_heard_seq.end() && in.seq <= heard->second) {
+        return; // a repeat of a change already applied
+    }
+    // V400-2: a repeat of a change still waiting here (7 sends now) does not take a second place
+    // in the 256-entry queue.
+    if (std::ranges::any_of(taken_in,
+                            [&packet](const TakenIn& item) { return item.data == packet.data; })) {
+        return;
+    }
+    if (taken_in.size() >= 256) {
+        taken_in.pop_front();
+    }
+    taken_in.push_back(TakenIn{packet.data, packet.at});
+}
+
+/// The game server granted an action-menu asset once (pay-once Flame corpses, kin circle holder)
+/// and told every game. In LAN the grant marks the record only on the granting game, so every
+/// player could take a large corpse's reward on his own game. Here every 250 ms each game reads
+/// the shared assets' records (INFO_TAKEN / INFO_USED / INFO_HOLDER) and sends what GAINED state
+/// (type 12, 3 times); the others OR it into the same asset's record (asset id + 0x74 handle).
+/// deep_audit_L 1b: a holder whose player is cut, or (3+ players) not heard for OWNER_GONE.
+bool Assist::State::HolderGone(s32 holder, Clock::time_point now) {
+    if (holder <= 0 || holder > 100) {
+        return false;
+    }
+    const u32 no = static_cast<u32>(holder);
+    if (CutNo(no)) {
+        return true;
+    }
+    if (session.member_count < 3 || no == LocalPlayerNo()) {
+        return false;
+    }
+    // handover review HR2: read the peers here, not owner_no_heard: EnemyOwners refreshes that map
+    // only while enemies are listed, so in an area without enemies every holder looked gone after
+    // 8 s. And only while this game hears another player (2 s): a stall or a load on this game
+    // makes everyone look silent at once, which is not a leave.
+    Clock::time_point heard{};
+    bool other_fresh = false;
+    for (const auto& [peer_key, peer] : peers) {
+        if (peer.no == no) {
+            heard = std::max(heard, peer.at);
+        } else if (peer.no != 0 && now - peer.at < 2s) {
+            other_fresh = true;
+        }
+    }
+    return heard != Clock::time_point{} && other_fresh && now - heard >= HOLDER_GONE;
+}
+
+/// deep_audit_L 1b: every game, in a match: a world item that has carried the take mark for
+/// ITEM_MARK_STALE (the take request was never answered) gets the mark cleared, so its player can
+/// take it again. A late answer still works (the award and the removal go by id); a second request
+/// finds the item gone on the authority and gets nothing (serialised there). report = log the
+/// counts (HandoverState).
+void Assist::State::ItemMarkWatch(Clock::time_point now, bool report) {
+    if (main == 0 || session.manager == 0 || session.state != 8 || Get<u64>(main + STAGE_PHASE) == 0) {
+        return;
+    }
+    if (item_watch_gen != match_gen) {
+        item_watch_gen = match_gen;
+        item_marks.clear();
+        item_marks_cleared = 0;
+    }
+    if (!report && now - item_watch_at < 1s) {
+        return;
+    }
+    item_watch_at = now;
+    const u64 man = Get<u64>(main + MAP_ITEM_MAN);
+    if (man == 0) {
+        return;
+    }
+    size_t items = 0;
+    size_t marked = 0;
+    std::set<u32> seen;
+    // handover review HR1: the authority serves its own takes locally; a mark it set itself and
+    // still carries is not an unanswered request, so clearing it could let the item be taken twice.
+    // There only marks first seen before this game took the authority are cleared.
+    const bool authority = Get<u32>(main + GENERATOR_IDLE) == 0;
+    for (const u64 list : ITEM_LISTS) {
+        const u64 head = Get<u64>(man + list);
+        u64 node = head;
+        for (size_t n = 0; node != 0 && n < ITEM_WALK_MAX; ++n) {
+            const u32 id = Get<u32>(node + ITEM_ID);
+            const u32 flags = Get<u32>(node + ITEM_FLAGS);
+            ++items;
+            if ((flags & ITEM_TAKE_MARK) != 0 && id != 0) {
+                ++marked;
+                seen.insert(id);
+                auto [mark, fresh] = item_marks.try_emplace(id, ItemMark{node, now});
+                if (!fresh && mark->second.node != node) {
+                    mark->second = ItemMark{node, now}; // another record with this id: start again
+                } else if (!fresh && now - mark->second.since >= ITEM_MARK_STALE &&
+                           (!authority || mark->second.since < handover_at) &&
+                           Get<u32>(node + ITEM_ID) == id) {
+                    Put<u32>(node + ITEM_FLAGS, Get<u32>(node + ITEM_FLAGS) & ~ITEM_TAKE_MARK);
+                    ++item_marks_cleared;
+                    Log(fmt::format("items: take of item {:#010x} not answered for {} s (no "
+                                    "authority, or a lost packet): mark cleared, it can be taken "
+                                    "again (deep_audit_L 1b; {} this match)",
+                                    id,
+                                    std::chrono::duration_cast<std::chrono::seconds>(
+                                        now - mark->second.since).count(),
+                                    item_marks_cleared));
+                    item_marks.erase(mark);
+                    seen.erase(id);
+                }
+            }
+            const u64 next = Get<u64>(node + ITEM_NEXT);
+            if (next == head || next == node) {
+                break;
+            }
+            node = next;
+        }
+    }
+    std::erase_if(item_marks, [&seen](const auto& entry) { return !seen.contains(entry.first); });
+    if (report) {
+        Log(fmt::format("hand-over: world items: {} here (the host made them, every game created "
+                        "them from the same message, so the ids match); {} take(s) pending, cleared "
+                        "after {} s if unanswered",
+                        items, marked, ITEM_MARK_STALE.count()));
+    }
+}
+
+/// deep_audit_L 1b: once, 3 s after this game took the authority from a lower-numbered player:
+/// one log line per category of host-side state (what this game already mirrors, what it repairs,
+/// what cannot be rebuilt here).
+void Assist::State::HandoverState(Clock::time_point now) {
+    if (!handover_pending || now - handover_at < 3s) {
+        return;
+    }
+    if (main == 0 || session.manager == 0 || session.state != 8 || Get<u64>(main + STAGE_PHASE) == 0) {
+        return; // not in a match yet: nothing to check (the next match starts as host anyway)
+    }
+    handover_pending = false;
+    if (Get<u8>(main + GENERATOR_IDLE) != 0) {
+        Log("hand-over: the authority went back to a lower-numbered player; nothing checked");
+        return;
+    }
+    ItemMarkWatch(now, true);
+    size_t held = 0;
+    size_t gone = 0;
+    for (const auto& [key, object] : taken_objects) {
+        const s32 holder = Get<s32>(object.info + INFO_HOLDER);
+        held += TakenHeld(holder) ? 1 : 0;
+        gone += TakenHeld(holder) && HolderGone(holder, now) ? 1 : 0;
+    }
+    Log(fmt::format("hand-over: shared objects (circles, corpses, chests): {} mirrored here, {} "
+                    "held, {} held by a cut or gone player (released now by TakenShare)",
+                    taken_objects.size(), held, gone));
+    Log("hand-over: kept as they are (shared before): the round's environment event, map lists and "
+        "Ritual Site layout, cut lists (CUTAUTH), enemy owners (v414); the next round is made here");
+    Log("hand-over: NOT rebuildable here (only the old host held them): stored airship strike "
+        "requests (ZEP_S4), the 0xBC queue, a pledge being decided, the old host's per-player "
+        "taken masks; a player may have to repeat one action");
+}
+
+void Assist::State::TakenShare(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 map_system = stage != 0 ? Get<u64>(stage + MAP_SYSTEM) : 0;
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    if (map_system == 0 || players == 0) {
+        return;
+    }
+    const u32 round = Get<u32>(stage + P_ROUND);
+    if (session.manager != taken_manager || stage != taken_stage || round < taken_round_seen ||
+        match_gen != taken_gen) { // a new match (as MapShare, R10: match_gen)
+        TakenClear();
+        taken_manager = session.manager;
+        taken_stage = stage;
+        taken_gen = match_gen;
+        // review7: changes heard while no match ran here (they wait for UpdatePhase) belong to the
+        // last match when they are older than the 5 s an unapplied change is kept anyway.
+        std::erase_if(taken_in, [now](const TakenIn& item) { return now - item.at >= 5s; });
+    }
+    taken_round_seen = round;
+    if (round != taken_round) {
+        // A new round: the phase reset cleared the per-phase records. Start again from what the
+        // game holds; the last round's changes are no longer sent.
+        taken_round = round;
+        taken_objects.clear();
+        taken_out.clear();
+        taken_pending.clear();
+        taken_scan_at = {};
+        taken_scan_logged = false;
+    }
+    // Repeats: each change 3 times, 250 ms apart (50 ms in the last 5 s of a phase), as type 8.
+    if (!taken_out.empty()) {
+        const auto gap = ShareFast(stage) ? 50ms : 250ms;
+        for (auto& out : taken_out) {
+            if (now >= out.next) {
+                Network::LanSide::Send(std::span<const u8>(out.data));
+                --out.left;
+                // V400-2: sends 1..3 as before (gap), then 1, 2, 4, 8 s.
+                const int sent = TAKEN_SENDS - out.left;
+                const std::chrono::milliseconds later =
+                    sent < 3 ? std::chrono::milliseconds{gap}
+                             : std::chrono::milliseconds{1000 << (sent - 3)};
+                out.next = now + later;
+            }
+        }
+        std::erase_if(taken_out, [](const TakenOut& item) { return item.left <= 0; });
+    }
+    // MapShare's guards: only in UpdatePhase, never while a guest's lists are fed or not in yet.
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const bool guest_waits =
+        Get<u8>(main + GENERATOR_IDLE) != 0 && round < 4 && map_fed_round != round;
+    if (phase != PHASE_UPDATE || map_feed_since.has_value() || guest_waits) {
+        return;
+    }
+    const u32 local_no = LocalPlayerNo();
+    if (local_no == 0 || local_no >= 0x100 || now - taken_poll_at < 250ms) {
+        return;
+    }
+    taken_poll_at = now;
+
+    // Slot -> player number on this game (pgd+0x104 / +0xD0): ALT first, as LocalPlayerNo.
+    taken_slot_no.fill(0);
+    const auto add_slot = [&](u64 pgd) {
+        if (pgd == 0) {
+            return;
+        }
+        const u32 no = Get<u32>(pgd + PGD_NO);
+        const u8 slot = Get<u8>(pgd + PGD_SLOT);
+        if (no == 0 || no > 32 || slot >= TAKEN_SLOTS || taken_slot_no[slot] != 0) {
+            return;
+        }
+        taken_slot_no[slot] = static_cast<u8>(no);
+    };
+    add_slot(Get<u64>(players + PGD_LOCAL_ALT));
+    add_slot(Get<u64>(players + PGD_LOCAL));
+    if (const u64 pool = Get<u64>(players + PGD_POOL); pool != 0) {
+        for (u64 i = 0; i < PGD_POOL_MAX; ++i) {
+            add_slot(pool + i * PGD_SIZE);
+        }
+    }
+    // v405: write this game's slot -> player no map once per match, again only when it changes
+    // (late joiners), at most 4 lines a match. Reads nothing new, changes nothing.
+    if (taken_slot_no != ids_logged && ids_logs < 4) {
+        ids_logged = taken_slot_no;
+        ++ids_logs;
+        std::string pairs;
+        for (size_t s = 0; s < TAKEN_SLOTS; ++s) {
+            if (taken_slot_no[s] != 0) {
+                pairs += fmt::format(" {}:{}", s, taken_slot_no[s]);
+            }
+        }
+        Log(fmt::format("v405 ids: round {} local no {}; slot:no{}", round, local_no, pairs));
+    }
+
+    const auto every = (taken_objects.empty() || taken_rescan) ? 1s : 5s;
+    std::vector<u64> fresh_keys; // objects this scan found anew: kept heard changes are replayed
+    if (now - taken_scan_at >= every) {
+        taken_scan_at = now;
+        taken_rescan = false;
+        TakenScan();
+        if (!taken_pending.empty()) {
+            for (const auto& scanned : taken_objects) {
+                if (!scanned.second.seen) {
+                    fresh_keys.push_back(scanned.first); // sorted: map order
+                }
+            }
+        }
+        if (!taken_scan_logged && !taken_objects.empty()) {
+            taken_scan_logged = true;
+            std::map<std::string, u32> counts;
+            for (const auto& entry : taken_objects) {
+                ++counts[TakenKind(static_cast<u32>(entry.first >> 32))];
+            }
+            std::string text;
+            for (const auto& [name, n] : counts) {
+                text += fmt::format(" {} {}", name, n);
+            }
+            TakenLog(fmt::format("taken: round {}: {} shared objects found ({} ); their taken "
+                                 "state is shared",
+                                 round, taken_objects.size(), text));
+        }
+    }
+    // deep_audit_L 1b: the authority frees a circle held by a player who is cut or whose game left
+    // (silent for HOLDER_GONE while another player is heard, 3+ players; handover review HR2). Only the holder word is written; TakenPoll then sees
+    // "holder released here" and sends the release with the old holder, which every game applies
+    // only if it holds the same holder (TakenApply), so a stale release cannot free a new holder.
+    if (Get<u8>(main + GENERATOR_IDLE) == 0) {
+        for (auto& [key, object] : taken_objects) {
+            const s32 holder = Get<s32>(object.info + INFO_HOLDER);
+            if (TakenHeld(holder) && holder == object.holder && HolderGone(holder, now) &&
+                Get<u64>(object.ins + INS_INFO) == object.info &&
+                Get<u32>(object.ins + INS_HANDLE) == static_cast<u32>(key)) {
+                Put<s32>(object.info + INFO_HOLDER, -1);
+                const char* kind = TakenKind(static_cast<u32>(key >> 32));
+                TakenLog(fmt::format("taken: {} {} h={:08x}: holder player {} is cut or gone; "
+                                     "released by the authority (deep_audit_L 1b)",
+                                     kind != nullptr ? kind : "object", key >> 32,
+                                     static_cast<u32>(key), holder));
+            }
+        }
+    }
+    for (auto& [key, object] : taken_objects) {
+        TakenPoll(key, object, round, now);
+    }
+    // v3.6 audit S2: a change heard while the object was not loaded here (or before it loaded
+    // again) is written now that the scan found it.
+    if (!fresh_keys.empty()) {
+        // review12 S1: in the order heard (newest last), not in sender order, so a stale
+        // "holder A" heard before A's release cannot be applied after it.
+        std::vector<const std::pair<u64, std::vector<u8>>*> replays;
+        for (const auto& [sender_key, kept] : taken_pending) {
+            if (std::binary_search(fresh_keys.begin(), fresh_keys.end(), sender_key.second)) {
+                replays.push_back(&kept);
+            }
+        }
+        std::sort(replays.begin(), replays.end(),
+                  [](const auto* earlier, const auto* later) {
+                      return earlier->first < later->first;
+                  });
+        for (const auto* kept : replays) {
+            TakenApply(kept->second, round, now, true);
+        }
+    }
+    std::deque<TakenIn> keep;
+    for (auto& item : taken_in) {
+        if (TakenApply(item.data, round, now)) {
+            continue;
+        }
+        if (now - item.at < 5s) {
+            keep.push_back(std::move(item));
+        }
+    }
+    taken_in.swap(keep);
+}
