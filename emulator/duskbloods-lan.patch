+/// One u32 write of the final placement, logged (the first 10 per address, then every 20th: a
+/// value the game keeps writing back would otherwise fill the log).
+void Assist::State::FinalPut(u64 address, u32 value, const std::string& what) {
+    const u32 have = Get<u32>(address);
+    if (have == value) {
+        return;
+    }
+    Put<u32>(address, value);
+    const u32 n = ++final_put_count[address];
+    if (n <= 10 || n % 20 == 0) {
+        Log(fmt::format("final placement: {}: {:#x} -> {:#x} at {:#x} (write #{} there)", what,
+                        have, value, address, n));
+    }
+}
