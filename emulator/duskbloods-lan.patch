+/// v4.46 DECIDEONCE (log only): counts the start lists applied on this game in the final (every
+/// change of the decided list's players / areas / points), so a run shows whether a guest
+/// applied one list or two.
+void Assist::State::FinalListWatch(u32 phase) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    if (stage == 0 || mediator == 0 || Get<u32>(stage + P_ROUND) != FINAL_ROUND) {
+        return;
+    }
+    if (list_watch_gen != match_gen) {
+        list_watch_gen = match_gen;
+        list_watch_applies = 0;
+        list_watch_sig = 0;
+    }
+    if (Get<u8>(mediator + MED_DECIDED) == 0) {
+        return;
+    }
+    const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+    if (count == 0 || count > MED_LIST_MAX) {
+        return;
+    }
+    u64 sig = 1469598103934665603ULL;
+    std::string list;
+    for (u64 i = 0; i < count; ++i) {
+        const u64 entry = mediator + MED_LIST + i * MED_LIST_ENTRY;
+        const u32 no = Get<u32>(entry);
+        const s32 index = Get<s32>(entry + ENTRY_INDEX);
+        const f32 x = Get<f32>(entry + ENTRY_POSITION);
+        const f32 z = Get<f32>(entry + ENTRY_POSITION + 8);
+        u32 xb = 0;
+        u32 zb = 0;
+        std::memcpy(&xb, &x, 4);
+        std::memcpy(&zb, &z, 4);
+        for (const u64 v : {u64{no}, u64(u32(index)), u64{xb}, u64{zb}}) {
+            sig = (sig ^ v) * 1099511628211ULL;
+        }
+        list += fmt::format("{}player {} area {} at ({:.1f}, {:.1f})", list.empty() ? "" : ", ",
+                            no, index, x, z);
+    }
+    if (sig == list_watch_sig) {
+        return;
+    }
+    list_watch_sig = sig;
+    ++list_watch_applies;
+    Log(fmt::format("final: start list apply #{} here ({}, phase {}): {} entries: {} (v4.46 "
+                    "DECIDEONCE)",
+                    list_watch_applies, Get<u8>(main + GENERATOR_IDLE) == 0 ? "host" : "guest",
+                    phase, count, list));
+}
+
+/// alpha 13d SFXWHO / CREATEWHO / RECVWHO (diagnostic): once a second while a count moves, log the requests of
+/// effect 10004 with their distinct 7-frame caller chains, and the kind-7 world-item creates with their
+/// distinct requesters (x30 at 0x159E380) and the newest record's 16 words.
+void Assist::State::SfxWho(Clock::time_point now) {
+    if (main == 0 || (sfxwho_at && now - *sfxwho_at < 1s)) {
+        return;
+    }
+    sfxwho_at = now;
+    const auto name = [&](u64 a) {
+        a &= 0xFFFFFFFFFFULL; // no pointer-auth bits
+        return a >= main && a < main + 0x6000000 ? fmt::format("{:#x}", a - main)
+                                                 : fmt::format("abs {:#x}", a);
+    };
+    if (Get<u32>(main + SW_SITE) == SW_SITE_HOOK) {
+        const u32 count = Get<u32>(main + SW_BOX);
+        if (count != sfxwho_seen) {
+            const u32 fresh = count - sfxwho_seen;
+            for (u32 i = 0; i < std::min<u32>(fresh, 4); ++i) {
+                std::array<u64, 7> chain{};
+                Read(main + SW_BOX + 8 + ((count - 1 - i) & 3) * 0x38, chain.data(), sizeof(chain));
+                std::string text;
+                for (const u64 a : chain) {
+                    if (a == 0) {
+                        break;
+                    }
+                    text += (text.empty() ? "" : " <- ") + name(a);
+                }
+                ++sfxwho_chains[text];
+            }
+            sfxwho_seen = count;
+            std::string chains;
+            for (const auto& [text, n] : sfxwho_chains) {
+                chains += fmt::format("{}[{}] (x{})", chains.empty() ? "" : "; ", text, n);
+            }
+            Log(fmt::format("sfx who: 10004 requested {} times (+{}); callers (main+) {} (alpha 13d "
+                            "SFXWHO)",
+                            count, fresh, chains));
+        }
+    }
+    if (Get<u32>(main + CW_SITE) == CW_SITE_HOOK) {
+        const u32 count = Get<u32>(main + CW_BOX);
+        if (count != createwho_seen) {
+            const u32 fresh = count - createwho_seen;
+            for (u32 i = 0; i < std::min<u32>(fresh, 2); ++i) {
+                std::array<u64, 7> chain{};
+                Read(main + CW_BOX + 8 + ((count - 1 - i) & 1) * 0x38, chain.data(), sizeof(chain));
+                std::string text;
+                for (const u64 a : chain) {
+                    if (a == 0) {
+                        break;
+                    }
+                    text += (text.empty() ? "" : " <- ") + name(a);
+                }
+                ++createwho_chains[text];
+            }
+            createwho_seen = count;
+            std::string chains;
+            for (const auto& [text, n] : createwho_chains) {
+                chains += fmt::format("{}[{}] (x{})", chains.empty() ? "" : "; ", text, n);
+            }
+            Log(fmt::format("create who: this game ran the attached-item create (cave_push sender) {} "
+                            "times (+{}); callers (main+) {} (alpha 13d CREATEWHO)",
+                            count, fresh, chains));
+        }
+    }
+    if (Get<u32>(main + RW_SITE) == RW_SITE_HOOK) {
+        const u32 count = Get<u32>(main + RW_BOX);
+        if (count != recvwho_seen) {
+            const u32 fresh = count - recvwho_seen;
+            std::string newest;
+            for (u32 i = 0; i < std::min<u32>(fresh, 4); ++i) {
+                std::array<u32, 10> entry{}; // u64 sender word, then the message's first 0x20 bytes
+                Read(main + RW_BOX + 8 + ((count - 1 - i) & 3) * 0x28, entry.data(), sizeof(entry));
+                const std::string sender = fmt::format("{:08x}{:08x}", entry[1], entry[0]);
+                ++recvwho_heads[sender];
+                std::string head = fmt::format("{}[from {}:", newest.empty() ? "" : "; ", sender);
+                for (size_t k = 2; k < entry.size(); ++k) {
+                    head += fmt::format(" {:08x}", entry[k]);
+                }
+                newest += head + "]";
+            }
+            recvwho_seen = count;
+            std::string senders;
+            for (const auto& [text, n] : recvwho_heads) {
+                senders += fmt::format("{}{} (x{})", senders.empty() ? "" : ", ", text, n);
+            }
+            Log(fmt::format("recv who: 0x1E subtype 4 received {} times (+{}); senders {}; newest {} "
+                            "(alpha 13d RECVWHO)",
+                            count, fresh, senders, newest));
+        }
+    }
+    if (Get<u32>(main + RO_SITE) == RO_SITE_HOOK) {
+        const u64 counts = Get<u64>(main + RO_BOX + 4); // u32 gives, u32 skips
+        // every change of "given"; the held-back count (every frame after an out) at most every 10 s
+        if (static_cast<u32>(counts) != static_cast<u32>(rewardonce_seen) ||
+            (counts != rewardonce_seen && (!rewardonce_at || now - *rewardonce_at >= 10s))) {
+            rewardonce_seen = counts;
+            rewardonce_at = now;
+            Log(fmt::format("reward once: the final's phase reward given {} times, held back {} times "
+                            "(players given: mask {:#x}) (alpha 13 REWARDONCE)",
+                            static_cast<u32>(counts), static_cast<u32>(counts >> 32),
+                            Get<u32>(main + RO_BOX)));
+        }
+    }
+}
+
+bool Assist::State::WarpDeferHooked() {
+    return main != 0 && Get<u32>(main + WD_SITE) == WD_SITE_HOOK;
+}
+
+/// v4.50 WARPDEFER (13-ALPHA_TEST.md, alpha 9 final 1: the warp-now byte stage+0x4728 is already 1
+/// in phase 21 on a guest, so the list apply warps our player at once, mid-load; in the
+/// single-entry finals our warp came later, through StartPoint's M+0x6A8 and the pump in phase 26).
+/// On a guest in the final, from the final's load on (round 4, phases 17..22) WDBOX.hold makes the
+/// record read the warp-now byte as 0 at the list apply (0x10F4060: M+0x6A8 instead of a warp) and
+/// at the pump (0x10EF864: the pump waits). HOLD_AFTER into Intermission (or at phase 4 at the
+/// latest) hold is cleared and the pump warps our player on its next frame, as in the single-entry
+/// finals. The host is unchanged. Logs when our deferred warp ran (M+0x6A8 1 -> 0) and in which phase.
+void Assist::State::FinalWarpDefer(u32 phase, Clock::time_point now) {
+    constexpr auto HOLD_AFTER = 2s;
+    if (main == 0) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    const bool hooked = WarpDeferHooked();
+    const auto release = [&](const char* why) {
+        if (hooked) {
+            Put<u8>(main + WD_BOX, 0);
+        }
+        if (defer_hold) {
+            defer_hold = false;
+            defer_released = true;
+            Log(fmt::format("final: our start-point warp is let go ({}, phase {}): {} apply read(s) and "
+                            "{} pump read(s) were held; M+0x6A8 is {} (v4.50 WARPDEFER)",
+                            why, phase, Get<u32>(main + WD_BOX + 4), Get<u32>(main + WD_BOX + 8),
+                            mediator != 0 ? Get<u8>(mediator + MED_WARP_LOCAL) : 0));
+        }
+    };
+    if (session.manager == 0 || session.state != 8 || stage == 0 || mediator == 0 ||
+        round != FINAL_ROUND || Get<u8>(main + GENERATOR_IDLE) == 0) {
+        if (defer_hold) {
+            release("not in the final any more");
+        }
+        return;
+    }
+    if (!hooked) {
+        if (!defer_off_logged) {
+            defer_off_logged = true;
+            Log("final: WARPDEFER record not applied at 0x10F4060; the guest's warp is stock (v4.50 "
+                "WARPDEFER)");
+        }
+        return;
+    }
+    if (defer_gen != match_gen) {
+        const bool loading = phase == PHASE_ENV_LOT || phase == 18 || phase == 19 ||
+                             phase == PHASE_PREPARE_SECOND || phase == PHASE_PREPARE_THIRD;
+        if (!loading) {
+            return;
+        }
+        defer_gen = match_gen;
+        defer_hold = true;
+        defer_released = false;
+        defer_warp_logged = false;
+        defer_flag_seen = 0;
+        defer_inter_at.reset();
+        std::array<u8, 16> box{};
+        Write(main + WD_BOX + 4, box.data(), 12);
+        defer_warp_at.reset();
+        replay_logged = false;
+        Put<u8>(main + WD_BOX + 1, Get<u32>(main + WR_SITE) == WR_SITE_HOOK ? 1 : 0); // v4.51
+        Put<u8>(main + WD_BOX, 1);
+        Log(fmt::format("final: our start-point warp is held until {} s into Intermission (phase {}, "
+                        "warp-now byte {}) (v4.50 WARPDEFER)",
+                        std::chrono::duration<double>(HOLD_AFTER).count(), phase,
+                        Get<u8>(stage + STAGE_WARP_READY)));
+        return;
+    }
+    const u8 flag = Get<u8>(mediator + MED_WARP_LOCAL);
+    if (defer_hold) {
+        if (phase == PHASE_INTERMISSION && !defer_inter_at) {
+            defer_inter_at = now;
+        }
+        if ((defer_inter_at && now - *defer_inter_at >= HOLD_AFTER) || phase == PHASE_PRE_BEGIN ||
+            phase == PHASE_UPDATE) {
+            release(phase == PHASE_INTERMISSION ? "Intermission" : "the battle starts");
+        }
+    } else if (defer_released && !defer_warp_logged && defer_flag_seen != 0 && flag == 0) {
+        defer_warp_logged = true;
+        defer_warp_at = now;
+        Log(fmt::format("final: our deferred start-point warp ran (the pump cleared M+0x6A8) in phase "
+                        "{} (v4.50 WARPDEFER)",
+                        phase));
+    }
+    // v4.51 WARPREPLAY: 1 s after our deferred warp, where every listed player's copy stands here.
+    if (defer_warp_at && !replay_logged && now - *defer_warp_at >= 1s) {
+        replay_logged = true;
+        const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+        const u64 world = Get<u64>(main + WORLD_CHR);
+        const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+        std::string placed;
+        for (u64 i = 0; i < count && count <= MED_LIST_MAX; ++i) {
+            const u64 entry = mediator + MED_LIST + i * MED_LIST_ENTRY;
+            const u32 no = Get<u32>(entry);
+            std::array<f32, 3> point{};
+            Read(entry + ENTRY_POSITION, point.data(), sizeof(point));
+            std::string where = "no copy here";
+            for (size_t e = 0; entries != 0 && e < MAX_ENTRIES; ++e) {
+                const u64 base = entries + e * 0x38;
+                const u64 chr = Get<u64>(base);
+                if (chr == 0 || !PlayerEntry(chr, e)) {
+                    continue;
+                }
+                const u64 chr_data = Get<u64>(chr + 0x20);
+                const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+                if (player_data == 0 || Get<u32>(player_data + 0xD0) != no) {
+                    continue;
+                }
+                std::array<f32, 3> at{};
+                if (const u64 physics = Get<u64>(base + 0x28);
+                    physics != 0 && Read(physics + 0x70, at.data(), sizeof(at))) {
+                    where = fmt::format("{} at ({:.1f}, {:.1f}), {:.1f} m from its point",
+                                        e == 0 ? "ours" : "copy", at[0], at[2],
+                                        std::hypot(at[0] - point[0], at[2] - point[2]));
+                }
+                break;
+            }
+            placed += fmt::format("{}player {}: {}", placed.empty() ? "" : "; ", no, where);
+        }
+        Log(fmt::format("final: placement re-run {} time(s) at our deferred warp; {} (v4.51 "
+                        "WARPREPLAY)",
+                        Get<u32>(main + WD_BOX + 12), placed));
+    }
+    defer_flag_seen = flag;
+}
+
+/// v4.49 OWNPLACE (13-ALPHA_TEST.md: alpha 8 still crashed 2 in 10 with one list per final, both
+/// 1-3 s into phase 6). On a guest in a final whose decided list holds our own entry, the pump's
+/// local warp (M+0x6A8 -> 0x10EFDAC at battle-flow step 0x18: start transform into
+/// [0x5B65C20]+0xAA0, the warp request 0xF357C0, chr+0x2620) is not run: M+0x6A8 is cleared every
+/// tick until the battle starts (only the pump reads it: 0x10EF848; nothing in the battle flow
+/// waits on it), and when the pump would have warped (stage+0x4728 set, or phase 4 / 6) our player
+/// is placed by writing the entry's position to its physics (+0x70, as FinalCrowd does), to
+/// chr+0x2620 and to the start-transform position, i.e. everything 0x10EFDAC does except the warp
+/// request. Checked again in the first 3 s of phase 6 (rewritten if more than 3 m off, at most
+/// 3 writes). A list without our entry (StartPoint's case) is left to StartPoint and the pump.
+/// Every game logs where its player stands 3 s into the final (A / B on distinct points).
+void Assist::State::FinalOwnPlace(u32 phase, Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    if (stage == 0 || mediator == 0 || Get<u32>(stage + P_ROUND) != FINAL_ROUND) {
+        return;
+    }
+    if (own_gen != match_gen) {
+        own_gen = match_gen;
+        own_armed = false;
+        own_writes = 0;
+        own_area = -1;
+        own_update_at.reset();
+        own_report_logged = false;
+    }
+    const bool guest = Get<u8>(main + GENERATOR_IDLE) != 0;
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+    const u64 chr = entries != 0 ? Get<u64>(entries) : 0;
+    const u64 physics = chr != 0 && PlayerEntry(chr, 0) ? Get<u64>(entries + 0x28) : 0;
+    const auto planar = [](const std::array<f32, 3>& p, const std::array<f32, 3>& q) {
+        return std::hypot(p[0] - q[0], p[2] - q[2]);
+    };
+    if (phase == PHASE_UPDATE && !own_update_at) {
+        own_update_at = now;
+    }
+    // Every game: where our player stands 3 s into the final.
+    if (own_update_at && !own_report_logged && now - *own_update_at >= 3s && physics != 0) {
+        own_report_logged = true;
+        std::array<f32, 3> at{};
+        if (Read(physics + 0x70, at.data(), sizeof(at))) {
+            Log(fmt::format("final: 3 s in, our player (no {}) stands at ({:.1f}, {:.1f}, {:.1f}){} "
+                            "(v4.49 OWNPLACE)",
+                            LocalPlayerNo(), at[0], at[1], at[2],
+                            own_armed ? fmt::format(", {:.1f} m from our start point",
+                                                    planar(at, own_point))
+                                      : std::string{}));
+        }
+    }
+    if (!guest || session.start_tries != 0 || WarpDeferHooked()) {
+        return; // the host's pump warp is unchanged; StartPoint's own entry keeps the pump warp;
+                // v4.50: with WARPDEFER the guest's warp is deferred to phase 26, not replaced
+    }
+    const bool before_battle = phase == PHASE_PREPARE_SECOND || phase == PHASE_PREPARE_THIRD ||
+                               phase == PHASE_INTERMISSION || phase == PHASE_PRE_BEGIN;
+    if (!own_armed) {
+        if (!before_battle || Get<u8>(mediator + MED_DECIDED) == 0) {
+            return;
+        }
+        const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+        const u32 local_no = LocalPlayerNo();
+        if (count < 2 || count > MED_LIST_MAX || local_no == 0 || local_no == ~0U) {
+            return;
+        }
+        for (u64 i = 0; i < count; ++i) {
+            const u64 entry = mediator + MED_LIST + i * MED_LIST_ENTRY;
+            if (Get<u32>(entry) != local_no) {
+                continue;
+            }
+            std::array<f32, 3> point{};
+            if (!Read(entry + ENTRY_POSITION, point.data(), sizeof(point)) ||
+                !std::ranges::all_of(point,
+                                     [](f32 v) { return std::isfinite(v) && std::abs(v) < 5000.0f; }) ||
+                std::abs(point[0]) + std::abs(point[2]) < 0.1f) {
+                return;
+            }
+            own_armed = true;
+            own_point = point;
+            own_area = Get<s32>(entry + ENTRY_INDEX);
+            Put<u8>(mediator + MED_WARP_LOCAL, 0);
+            Log(fmt::format("final: our start point (area {} at {:.1f}, {:.1f}) is set by position "
+                            "write; the mediator's local warp is skipped (v4.49 OWNPLACE; phase {})",
+                            own_area, point[0], point[2], phase));
+            break;
+        }
+        if (!own_armed) {
+            return;
+        }
+    }
+    if (before_battle && Get<u8>(mediator + MED_WARP_LOCAL) != 0) {
+        Put<u8>(mediator + MED_WARP_LOCAL, 0); // set again (an apply after ours): still skipped
+    }
+    const bool warp_time = Get<u8>(stage + STAGE_WARP_READY) != 0 || phase == PHASE_PRE_BEGIN ||
+                           phase == PHASE_UPDATE;
+    if (!warp_time || physics == 0 || own_writes >= 3) {
+        return;
+    }
+    if (own_writes > 0) {
+        // Re-check only in the first 3 s of the battle; rewrite when more than 3 m off.
+        if (!own_update_at || now - *own_update_at > 3s) {
+            return;
+        }
+        std::array<f32, 3> at{};
+        if (!Read(physics + 0x70, at.data(), sizeof(at)) || planar(at, own_point) <= 3.0f) {
+            return;
+        }
+    }
+    std::array<f32, 3> before{};
+    Read(physics + 0x70, before.data(), sizeof(before));
+    Write(physics + 0x70, own_point.data(), sizeof(own_point));
+    if (chr != 0) {
+        Write(chr + CHR_WARP_POS, own_point.data(), sizeof(own_point));
+    }
+    if (const u64 global = Get<u64>(main + START_GLOBAL_REF); global != 0 && own_writes == 0) {
+        Write(global + START_GLOBAL_POS, own_point.data(), sizeof(own_point));
+    }
+    ++own_writes;
+    Log(fmt::format("final: our player is placed on its start point by position write #{} (phase "
+                    "{}, warp byte {}): ({:.1f}, {:.1f}, {:.1f}), {:.1f} m from where it stood "
+                    "(v4.49 OWNPLACE)",
+                    own_writes, phase, Get<u8>(stage + STAGE_WARP_READY), own_point[0],
+                    own_point[1], own_point[2], planar(before, own_point)));
+}
+
+void Assist::State::SampleNetClock(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        net_samples.clear();
+        return;
+    }
+    const f32 clock = Get<f32>(main + GAME_TIME);
+    if (clock <= 0) {
+        return;
+    }
+    // The value is from the start of the game's current frame, so it is up to a frame old: the
+    // largest "clock minus now" of the last second is the one read right after a frame began.
+    const double t = static_cast<double>(MicrosNow(now)) / 1e6;
+    net_samples.emplace_back(t, static_cast<double>(clock) - t);
+    while (!net_samples.empty() && t - net_samples.front().first > 1.5) {
+        net_samples.pop_front();
+    }
+}
+
+void Assist::State::SyncNetClock(Clock::time_point now) {
+    if (now < net_hold || net_samples.size() < 8) {
+        return;
+    }
+    double ours = -1e300;
+    for (const auto& [t, offset] : net_samples) {
+        ours = std::max(ours, offset);
+    }
+    NetClockMessage out;
+    out.player_no = static_cast<u8>(LocalPlayerNo());
+    out.instance = instance;
+    out.offset = ours;
+    Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+
+    double ahead = 0;
+    u32 ahead_no = 0;
+    for (const auto& [key, peer] : peers) {
+        if (now - peer.net_at > 3s || peer.clock_delta_us == INT64_MAX) {
+            continue;
+        }
+        // Its clock now = its offset + its steady time = its offset + ours - the difference.
+        const double theirs = peer.net_offset - static_cast<double>(peer.clock_delta_us) / 1e6;
+        if (theirs - ours > ahead) {
+            ahead = theirs - ours;
+            ahead_no = peer.no;
+        }
+    }
+    if (ahead < 0.025) {
+        net_have_last = false;
+        return;
+    }
+    // Twice the same answer, a second apart, before the clock is touched.
+    if (!net_have_last || std::abs(ahead - net_last_ahead) > 0.02) {
+        net_last_ahead = ahead;
+        net_have_last = true;
+        return;
+    }
+    // review1b C2: rig 2026-11-16 (userD): +7..8 s to player 3 every 4 s for two hours, the gap
+    // never closed. A move to the same player that is still at least half as far ahead within 10 s
+    // did nothing; after three of those in a row this match moves the clock no more.
+    if (net_off_gen == match_gen) {
+        net_have_last = false;
+        return;
+    }
+    if (ahead_no == net_move_no && net_move_at != Clock::time_point{} &&
+        now - net_move_at < 10s && ahead >= 0.5 * net_move_size &&
+        // review1b_r (helper 4): and more than 0.9 x the seconds since the move. A game that
+        // runs slow drifts back by at most that much, so steady drift is never counted.
+        ahead > 0.9 * std::chrono::duration<double>(now - net_move_at).count()) {
+        ++net_move_repeats;
+    } else {
+        net_move_repeats = 0;
+    }
+    if (net_move_repeats >= 3) {
+        net_off_gen = match_gen;
+        net_have_last = false;
+        Log(fmt::format("!!! network clock: player {}'s is still {:+.3f} s ahead after {} moves "
+                        "toward it; the moves have no effect, so the clock is left alone for the "
+                        "rest of this match (review1b C2) !!!",
+                        ahead_no, ahead, net_move_repeats));
+        return;
+    }
+    net_move_no = ahead_no;
+    net_move_size = ahead;
+    net_move_at = now;
+    const f32 start = Get<f32>(session.manager + S_NET_CLOCK);
+    Put<f32>(session.manager + S_NET_CLOCK, start + static_cast<f32>(ahead));
+    Log(fmt::format("network clock moved {:+.3f} s forward to player {}'s (the others' moves "
+                    "showed that much late here)",
+                    ahead, ahead_no));
+    net_samples.clear();
+    net_have_last = false;
+    net_hold = now + 3s;
+}
