+/// {"name": flag, "value": 0/1}: switches an optimization (common/nx2_perf_flags.h) live.
+json PerfFlag(ToolState& state, const json& params) {
+    const std::string name = params.at("name").get<std::string>();
+    const bool on = params.at("value").get<int>() != 0;
+    if (name == "idle_spin_us") {
+        Common::Nx2PerfFlags::g_idle_spin_us.store(params.at("value").get<int>(),
+                                                   std::memory_order_relaxed);
+    } else if (name == "trap_expand_kb") {
+        Common::Nx2PerfFlags::g_trap_expand_kb.store(params.at("value").get<unsigned>(),
+                                                     std::memory_order_relaxed);
+    } else if (name == "pin_gpu") {
+        Common::SetGpuThreadPinning(on);
+    } else if (name == "mutex_spin") {
+        Common::g_spin_mutex_count.store(params.at("value").get<int>(), std::memory_order_relaxed);
+    } else if (name == "front_spin") {
+        Common::Nx2PerfFlags::g_front_spin.store(params.at("value").get<unsigned>(),
+                                                 std::memory_order_relaxed);
+    } else if (name == "pin_plan") {
+        // Switches the pinning plan and pins with it (pin_gpu 0 unpins).
+        Common::Nx2PerfFlags::g_pin_plan.store(params.at("value").get<int>(),
+                                               std::memory_order_relaxed);
+        Common::SetGpuThreadPinning(true);
+    } else if (name == "frames_ahead_extra") {
+        Common::Nx2PerfFlags::g_frames_ahead_extra.store(
+            (std::min)(params.at("value").get<unsigned>(), 5U), std::memory_order_relaxed);
+    } else if (name == "svc_wait_frames") {
+        Common::Nx2PerfFlags::g_svc_wait_until.store(
+            Core::g_nx2_present_count.load(std::memory_order_relaxed) +
+                params.at("value").get<unsigned>(),
+            std::memory_order_relaxed);
+    } else if (name == "service_spin_us") {
+        Common::Nx2PerfFlags::g_service_spin_us.store(params.at("value").get<unsigned>(),
+                                                      std::memory_order_relaxed);
+    } else if (name == "hitch_ms") {
+        Common::Nx2PerfFlags::g_hitch_ms.store(params.at("value").get<unsigned>(),
+                                               std::memory_order_relaxed);
+    } else if (name == "back_slow") {
+        Common::Nx2PerfFlags::g_back_slow.store(params.at("value").get<unsigned>(),
+                                                std::memory_order_relaxed);
+    } else if (name == "cntpct_streak") {
+        Common::Nx2PerfFlags::g_cntpct_streak.store(params.at("value").get<unsigned>(),
+                                                    std::memory_order_relaxed);
+    } else if (name == "tick_offset_ms") {
+        // Steps the counter the guest reads (LAN clock tests): value in milliseconds.
+        Common::Nx2PerfFlags::g_guest_tick_offset.store(
+            static_cast<s64>(params.at("value").get<double>() *
+                             static_cast<double>(Common::g_wall_clock.GetGuestCNTFRQ()) / 1000.0),
+            std::memory_order_relaxed);
+    } else if (name == "pin_adapt_low") {
+        Common::Nx2PerfFlags::g_pin_adapt_low.store(params.at("value").get<int>(),
+                                                    std::memory_order_relaxed);
+    } else if (name == "pin_adapt_high") {
+        Common::Nx2PerfFlags::g_pin_adapt_high.store(params.at("value").get<int>(),
+                                                     std::memory_order_relaxed);
+    } else if (name == "jit_inline_dispatch") {
+        Common::Nx2PerfFlags::g_jit_inline_dispatch.store(on, std::memory_order_relaxed);
+        if (auto* process = state.system.ApplicationProcess()) {
+            for (size_t core = 0; core < Core::Hardware::NUM_CPU_CORES; ++core) {
+                if (auto* cpu = process->GetArmInterface(core)) {
+                    cpu->ClearInstructionCache();
+                }
+            }
+        }
+    } else if (!Common::Nx2PerfFlags::Set(name, on)) {
+        throw std::runtime_error{fmt::format("no perf flag \"{}\"", name)};
+    }
+    LOG_INFO(Debug, "perf flag {} = {}", name, on);
+    return json{{"name", name}, {"value", on}};
+}
