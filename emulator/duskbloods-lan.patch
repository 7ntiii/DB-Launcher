+namespace {
+// ours (88c9f27688, adapted to shader cache v2): a shared build ships a pipeline cache beside the
+// exe, shader_seed/<title>/<the cache file's name>. A player whose own cache is missing or smaller
+// gets the seed, so every pipeline the packager's sessions met is built at boot instead of while
+// playing (each first-time pipeline stalled the GPU thread 2-38 ms). The cache holds the game's
+// shaders and pipeline states, not driver code: any GPU can use it. The file is copied through a
+// temporary name, so a failed copy leaves the player's cache as it was. The seed must be a cache
+// of this build's format (CacheV2::FileName); older seeds are not found under that name.
+void SeedPipelineCache(u64 title_id, const std::filesystem::path& cache_file) {
+    namespace fs = std::filesystem;
+    const fs::path seed_dir =
+        Common::FS::GetExeDirectory() / "shader_seed" / fmt::format("{:016x}", title_id);
+    const fs::path seed_cache = seed_dir / cache_file.filename();
+    std::error_code ec;
+    const auto seed_size = fs::file_size(seed_cache, ec);
+    if (ec || seed_size == 0) {
+        return;
+    }
+    const auto own_size = fs::file_size(cache_file, ec);
+    const bool own_exists = !ec;
+    if (own_exists && own_size >= seed_size) {
+        return;
+    }
+    fs::path temp = cache_file;
+    temp += ".seeding";
+    fs::copy_file(seed_cache, temp, fs::copy_options::overwrite_existing, ec);
+    if (!ec) {
+        fs::rename(temp, cache_file, ec);
+    }
+    if (ec) {
+        std::error_code ignored;
+        fs::remove(temp, ignored);
+        LOG_WARNING(Render_Vulkan, "Shipped pipeline cache not copied: {}", ec.message());
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "Shipped pipeline cache installed ({} KiB, own cache was {} KiB)",
+             seed_size / 1024, own_exists ? own_size / 1024 : 0);
+}
