+void Assist::State::StartPoint(u32 phase, Clock::time_point now) {
+    // Each game picks start points in Intermission only until a 0x51 list marks them decided, and
+    // a peer that gets there first can decide with a list that leaves this game's player out. Then
+    // nothing places it: it stays at the map's default spot (under Forest of Heresy) and dies when
+    // the match starts. Give it an entry of its own and let the mediator pump warp it (+0x6A8, done
+    // once the battle flow sets stage+0x4728). The entry is a copy of another one with this game's
+    // player no and a start AREA id no entry uses (+0x24 is the area id, not a point index); its
+    // position stays the copy's, as positions only come with lists the game builds. Last resort
+    // only: with START_AREA the host's list holds every player, so this does not touch a pick.
+    const bool placing = phase == PHASE_INTERMISSION || phase == PHASE_PRE_BEGIN ||
+                         (phase == PHASE_UPDATE && session.update_since &&
+                          now - *session.update_since < 10s);
+    if (!placing) {
+        session.start_missing_since.reset();
+        session.start_tries = 0;
+        return;
+    }
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    const u32 local_no = LocalPlayerNo();
+    if (session.start_tries >= 3 || mediator == 0 || local_no == ~0U ||
+        Get<u8>(mediator + MED_DECIDED) == 0) {
+        return;
+    }
+    const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+    if (count == 0 || count >= MED_LIST_MAX) {
+        return;
+    }
+    std::vector<u32> used;
+    for (u64 i = 0; i < count; ++i) {
+        const u64 at = mediator + MED_LIST + i * MED_LIST_ENTRY;
+        if (Get<u32>(at) == local_no) {
+            session.start_missing_since.reset();
+            return;
+        }
+        used.push_back(Get<u32>(at + ENTRY_INDEX));
+    }
+    // Give the game 2 s to add its own entry, and a rebuilt list 5 s before the next try.
+    if (!session.start_missing_since) {
+        session.start_missing_since = now;
+        return;
+    }
+    if (now - *session.start_missing_since < (session.start_tries == 0 ? 2s : 5s)) {
+        return;
+    }
+    ++session.start_tries;
+    session.start_missing_since = now;
+    const auto sane = [](f32 v) { return std::isfinite(v) && std::abs(v) < 5000.0f; };
+    std::array<u8, MED_LIST_ENTRY> entry{};
+    std::array<f32, 3> position{};
+    bool usable = false;
+    for (u64 i = 0; i < count && !usable; ++i) {
+        if (Read(mediator + MED_LIST + i * MED_LIST_ENTRY, entry.data(), entry.size())) {
+            std::memcpy(position.data(), entry.data() + ENTRY_POSITION, sizeof(position));
+            usable = std::ranges::all_of(position, sane) &&
+                     std::abs(position[0]) + std::abs(position[2]) > 1.0f;
+        }
+    }
+    if (!usable) {
+        Log(fmt::format("start point: player {} has none and no entry has a usable position",
+                        local_no));
+        return;
+    }
+    u32 index = 0;
+    std::memcpy(&index, entry.data() + ENTRY_INDEX, sizeof(index));
+    const u64 begin = Get<u64>(mediator + MED_MAP_POINTS);
+    const u64 end = Get<u64>(mediator + MED_MAP_POINTS + 8);
+    if (begin != 0 && end > begin && (end - begin) % 16 == 0 && end - begin <= 64 * 16) {
+        for (u64 point = begin; point < end; point += 16) {
+            if (const u32 candidate = Get<u32>(point + 12);
+                std::ranges::find(used, candidate) == used.end()) {
+                index = candidate;
+                break;
+            }
+        }
+    }
+    const u32 flags = 0;
+    std::memcpy(entry.data(), &local_no, sizeof(local_no));
+    std::memcpy(entry.data() + ENTRY_FLAGS, &flags, sizeof(flags));
+    std::memcpy(entry.data() + ENTRY_INDEX, &index, sizeof(index));
+    if (!Write(mediator + MED_LIST + count * MED_LIST_ENTRY, entry.data(), entry.size())) {
+        return;
+    }
+    Put<u64>(mediator + MED_LIST_COUNT, count + 1);
+    Put<u8>(mediator + MED_WARP_LOCAL, 1);
+    Log(fmt::format("start point: player {} had none (the peer decided first); added start point "
+                    "{} at ({:.1f}, {:.1f}, {:.1f}), try {}",
+                    local_no, index, position[0], position[1], position[2], session.start_tries));
+}
