+/// v4.31 POWER_CHOICE (power_choice_notes.md), read only. With powerchoice2_live.py a LAN match
+/// holds the award of the own Power drop while a Power "Select what to receive" dialog is open
+/// (only its notice shows), and the dialog's OK stores the highlighted entry. The caves count each
+/// step in PC_BOX; this logs every change (4 times a second at most). Counters only grow (the box
+/// lives as long as the game), so the first look only takes them in.
+void Assist::State::PowerChoiceWatch(Clock::time_point now) {
+    if (main == 0 || now < pc_next) {
+        return;
+    }
+    pc_next = now + 250ms;
+    const u64 box = main + PC_BOX;
+    const std::array<u32, 8> cur{Get<u32>(box + 0x18), Get<u32>(box + 0x1C), Get<u32>(box + 0x10),
+                                 Get<u32>(box + 0x20), Get<u32>(box + 0x34), Get<u32>(box + 0x38),
+                                 Get<u32>(box + 0x48), 0};
+    if (!pc_seen) {
+        pc_seen = true;
+        pc_last = cur;
+        if (cur[0] != 0 || cur[3] != 0 || cur[4] != 0) {
+            Log(fmt::format("power choice: so far {} LAN dialogs ({} Power), {} choices stored, {} "
+                            "Power awards stored at once (POWER_CHOICE)",
+                            cur[0], cur[1], cur[3], cur[4]));
+        }
+        return;
+    }
+    if (cur[0] != pc_last[0]) {
+        const u32 first = Get<u32>(box + 0x28);
+        const u32 handle = Get<u32>(box + 0x2C);
+        const u32 layout = Get<u32>(box + 0x30);
+        if (cur[1] != pc_last[1]) {
+            Log(fmt::format("power choice: Power dialog opened (handle {:#x}, first entry {:#010x}, "
+                            "layout {}): the award waits for the choice (POWER_CHOICE)",
+                            handle, first, layout));
+        } else {
+            Log(fmt::format("power choice: dialog opened (handle {:#x}, first entry {:#010x}, layout "
+                            "{}): not a Power dialog, unchanged (POWER_CHOICE)",
+                            handle, first, layout));
+        }
+    }
+    if (cur[6] != pc_last[6]) {
+        Log("!!! power choice: the Power dialog opened less than 32 s after a Power was stored: the "
+            "award came first, this choice cannot count (POWER_CHOICE) !!!");
+    }
+    if (cur[4] != pc_last[4]) {
+        Log(fmt::format("power choice: Power award stored at once, no Power dialog open ({} so far) "
+                        "(POWER_CHOICE)",
+                        cur[4]));
+    }
+    if (cur[2] > pc_last[2]) {
+        Log(fmt::format("power choice: award of Power {:#010x} held until the choice (POWER_CHOICE)",
+                        Get<u32>(box + 0x14)));
+        pc_held_at = now;
+        pc_held_logged = false;
+    }
+    if (cur[5] != pc_last[5]) {
+        Log("power choice: OK before the award: the award is stored as usual (POWER_CHOICE)");
+    }
+    if (cur[3] != pc_last[3]) {
+        const u32 chosen = Get<u32>(box + 0x24);
+        const u32 held = Get<u32>(box + 0x14);
+        Log(fmt::format("power choice: chosen Power {:#010x} stored (held award {:#010x}, {}) "
+                        "(POWER_CHOICE)",
+                        chosen, held, chosen == held ? "the same entry" : "another entry"));
+        pc_held_at = {};
+    }
+    if (pc_held_at != Clock::time_point{} && !pc_held_logged && now - pc_held_at > 60s &&
+        Get<u32>(box + 0x10) != 0) {
+        pc_held_logged = true;
+        Log(fmt::format("power choice: Power {:#010x} held for 60 s without an OK (Decline, or the "
+                        "dialog is still open): nothing stored yet (POWER_CHOICE)",
+                        Get<u32>(box + 0x14)));
+    }
+    pc_last = cur;
+}
