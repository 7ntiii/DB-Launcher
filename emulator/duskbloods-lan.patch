+/// TEST ONLY (diag/net/netsim_notes.md): LICHII_NET_SIM=delay_ms,jitter_ms,loss_percent
+/// [,stall_every_s,stall_ms] makes this emulator's guest UDP sends to other addresses behave like
+/// a home Wi-Fi link: each datagram leaves delay_ms (+- jitter_ms, uniform) later, loss_percent of
+/// them are dropped (seeded PRNG, LICHII_NET_SIM_SEED, default 1, so a run repeats), and every
+/// stall_every_s seconds (windows start at multiples of that period in unix time, so a test script
+/// can aim a stall at a phase end) everything is held for stall_ms and then sent in a burst, as an
+/// access point does. Without jitter the order is kept. The side channel (LanSide) goes the same
+/// way. TCP, loopback and receives are never touched. Unset: one cached flag test per send.
+namespace NetSim {
+namespace {
+
+using SimClock = std::chrono::steady_clock;
+
+struct Pending {
+    SOCKET fd;
+    std::vector<u8> data;
+    sockaddr_in to;
+    bool has_to; ///< false: a connected socket's send()
+};
+
+struct Sim {
+    double delay_ms = 0.0;
+    double jitter_ms = 0.0;
+    double loss_percent = 0.0;
+    std::chrono::microseconds stall_period{0};
+    std::chrono::microseconds stall_length{0};
+    SimClock::time_point anchor; ///< steady time of a unix-time multiple of stall_period
+    u64 seed = 1;
+
+    std::mutex lock;
+    std::condition_variable wake;
+    std::map<std::pair<SimClock::time_point, u64>, Pending> queue; ///< by release time, then seq
+    u64 seq = 0;
+    std::mt19937_64 random;
+    long long logged_window = -1;
+    u64 sent = 0;
+    u64 lost = 0;
+    u64 failed = 0;
+    u64 overflow = 0;
+};
+
+constexpr size_t MAX_PENDING = 20000;
+
+/// Parses LICHII_NET_SIM; false (and a log line) when it is set but not understood.
+bool Parse(Sim& sim, const char* text) {
+    std::string_view rest{text};
+    std::vector<double> values;
+    bool ok = true;
+    while (ok) {
+        const size_t comma = rest.find(',');
+        const std::string item{rest.substr(0, comma)};
+        char* end = nullptr;
+        const double value = std::strtod(item.c_str(), &end);
+        ok = end != item.c_str() && *end == '\0' && value >= 0.0 && value <= 1e7;
+        if (ok) {
+            values.push_back(value);
+        }
+        if (comma == std::string_view::npos) {
+            break;
+        }
+        rest = rest.substr(comma + 1);
+    }
+    ok = ok && (values.size() == 3 || values.size() == 5) && values[2] <= 100.0;
+    if (ok && values.size() == 5 && values[3] > 0.0 && values[4] > 0.0) {
+        ok = values[4] < values[3] * 1000.0; // a stall as long as its period would hold for ever
+    }
+    if (!ok) {
+        LOG_ERROR(Network, "NET SIM: LICHII_NET_SIM='{}' not understood (want delay_ms,jitter_ms,"
+                           "loss_percent[,stall_every_s,stall_ms], stall_ms below the period); "
+                           "the network is NOT impaired",
+                  text);
+        return false;
+    }
+    sim.delay_ms = values[0];
+    sim.jitter_ms = values[1];
+    sim.loss_percent = values[2];
+    if (values.size() == 5 && values[3] > 0.0 && values[4] > 0.0) {
+        sim.stall_period = std::chrono::microseconds{static_cast<long long>(values[3] * 1e6)};
+        sim.stall_length = std::chrono::microseconds{static_cast<long long>(values[4] * 1e3)};
+    }
+    return true;
+}
+
+void SendNow(Sim& sim, const Pending& packet) {
+    int flags = 0;
+#ifdef __unix__
+    flags |= MSG_NOSIGNAL;
+#endif
+    const auto result =
+        packet.has_to
+            ? sendto(packet.fd, reinterpret_cast<const char*>(packet.data.data()),
+                     static_cast<int>(packet.data.size()), flags,
+                     reinterpret_cast<const sockaddr*>(&packet.to), sizeof(packet.to))
+            : send(packet.fd, reinterpret_cast<const char*>(packet.data.data()),
+                   static_cast<int>(packet.data.size()), flags);
+    if (result == SOCKET_ERROR) {
+#ifdef _WIN32
+        const int error = WSAGetLastError();
+#else
+        const int error = errno;
+#endif
+        if (++sim.failed <= 10) {
+            LOG_WARNING(Network, "NET SIM: a delayed UDP send failed (#{}): {}", sim.failed,
+                        Common::NativeErrorToString(error));
+        }
+        return;
+    }
+    ++sim.sent;
+}
+
+/// Sends every packet whose release time has come, in release order.
+[[noreturn]] void Run(Sim& sim) {
+    std::unique_lock guard{sim.lock};
+    while (true) {
+        if (sim.queue.empty()) {
+            sim.wake.wait(guard);
+            continue;
+        }
+        const SimClock::time_point first = sim.queue.begin()->first.first;
+        if (SimClock::now() < first) {
+            sim.wake.wait_until(guard, first);
+            continue;
+        }
+        const SimClock::time_point now = SimClock::now();
+        while (!sim.queue.empty() && sim.queue.begin()->first.first <= now) {
+            auto node = sim.queue.extract(sim.queue.begin());
+            SendNow(sim, node.mapped());
+        }
+    }
+}
+
+/// The emulator's simulator; never destroyed, so its thread needs no join at exit.
+Sim* Make() {
+    const char* const text = std::getenv("LICHII_NET_SIM");
+    if (text == nullptr || *text == '\0') {
+        return nullptr;
+    }
+    auto* const sim = new Sim;
+    if (!Parse(*sim, text)) {
+        delete sim;
+        return nullptr;
+    }
+    if (const char* const seed = std::getenv("LICHII_NET_SIM_SEED"); seed && *seed) {
+        sim->seed = std::strtoull(seed, nullptr, 10);
+    }
+    sim->random.seed(sim->seed);
+    if (sim->stall_period.count() > 0) {
+        const auto unix_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                                 std::chrono::system_clock::now().time_since_epoch())
+                                 .count();
+        sim->anchor = SimClock::now() -
+                      std::chrono::microseconds{unix_us % sim->stall_period.count()};
+    }
+    LOG_WARNING(Network,
+                "NET SIM (TEST ONLY): guest UDP sends to other addresses: delay {} ms +- {} ms, "
+                "{}% lost (seed {}), stall {} ms every {} s (from unix-time multiples of the "
+                "period); TCP, loopback and receives untouched",
+                sim->delay_ms, sim->jitter_ms, sim->loss_percent, sim->seed,
+                sim->stall_length.count() / 1000, sim->stall_period.count() / 1000000.0);
+    std::thread{[sim] { Run(*sim); }}.detach();
+    return sim;
+}
+
+Sim* Get() {
+    static Sim* const sim = Make();
+    return sim;
+}
+
+/// The end of the stall window that holds time t (t itself outside a window). Non-decreasing in
+/// t, so it keeps the order of the packets it moves.
+SimClock::time_point HoldUntil(const Sim& sim, SimClock::time_point t) {
+    if (sim.stall_period.count() == 0 || t < sim.anchor) {
+        return t;
+    }
+    const auto since = std::chrono::duration_cast<std::chrono::microseconds>(t - sim.anchor);
+    const auto phase = since % sim.stall_period;
+    return phase < sim.stall_length ? t + (sim.stall_length - phase) : t;
+}
+
+/// True when the simulator took the datagram (queued, sent or dropped): the caller reports it as
+/// sent and does not send it itself. False: send as usual (simulator off, TCP, loopback).
+bool Submit(SOCKET fd, std::span<const u8> data, const sockaddr* to) {
+    Sim* const sim = Get();
+    if (sim == nullptr) {
+        return false;
+    }
+    int type = 0;
+    socklen_t length = sizeof(type);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, reinterpret_cast<char*>(&type), &length) != 0 ||
+        type != SOCK_DGRAM) {
+        return false;
+    }
+    sockaddr_in dest{};
+    if (to != nullptr) {
+        if (to->sa_family != AF_INET) {
+            return false;
+        }
+        std::memcpy(&dest, to, sizeof(dest));
+    } else {
+        socklen_t dest_length = sizeof(dest);
+        if (getpeername(fd, reinterpret_cast<sockaddr*>(&dest), &dest_length) != 0 ||
+            dest.sin_family != AF_INET) {
+            return false;
+        }
+    }
+    if ((ntohl(dest.sin_addr.s_addr) >> 24) == 127) {
+        return false;
+    }
+    const SimClock::time_point now = SimClock::now();
+    std::scoped_lock guard{sim->lock};
+    // Both draws for every packet, so the n-th packet's fate depends on the seed only.
+    const bool drop = std::uniform_real_distribution<double>{0.0, 100.0}(sim->random) <
+                      sim->loss_percent;
+    const double shift =
+        std::uniform_real_distribution<double>{-1.0, 1.0}(sim->random) * sim->jitter_ms;
+    if (drop) {
+        ++sim->lost;
+        return true;
+    }
+    const double wait_ms = (std::max)(0.0, sim->delay_ms + shift);
+    const SimClock::time_point wanted =
+        now + std::chrono::microseconds{static_cast<long long>(wait_ms * 1000.0)};
+    const SimClock::time_point release = HoldUntil(*sim, wanted);
+    if (release != wanted) {
+        const long long window = (wanted - sim->anchor) / sim->stall_period;
+        if (window != sim->logged_window) {
+            sim->logged_window = window;
+            LOG_WARNING(Network,
+                        "NET SIM: stall #{} ({} ms) holding UDP sends; so far sent {}, lost {}, "
+                        "failed {}, over the queue cap {}",
+                        window, sim->stall_length.count() / 1000, sim->sent, sim->lost,
+                        sim->failed, sim->overflow);
+        }
+    }
+    Pending packet{fd, std::vector<u8>(data.begin(), data.end()), dest, to != nullptr};
+    if (sim->queue.empty() && release <= now) {
+        SendNow(*sim, packet);
+        return true;
+    }
+    if (sim->queue.size() >= MAX_PENDING) {
+        ++sim->overflow;
+        return true;
+    }
+    const bool earliest = sim->queue.empty() || release < sim->queue.begin()->first.first;
+    sim->queue.emplace(std::make_pair(release, sim->seq++), std::move(packet));
+    if (earliest) {
+        sim->wake.notify_one();
+    }
+    return true;
+}
+
+/// The socket is closing: its queued datagrams go (the handle may be reused).
+void Closed(SOCKET fd) {
+    Sim* const sim = Get();
+    if (sim == nullptr) {
+        return;
+    }
+    std::scoped_lock guard{sim->lock};
+    std::erase_if(sim->queue, [fd](const auto& entry) { return entry.second.fd == fd; });
+}
+
+} // Anonymous namespace
+} // namespace NetSim
+
+namespace LanSide {
+namespace {
+
+constexpr std::array<u8, 8> MAGIC{'D', 'u', 's', 'k', 'L', 'a', 'n', 1};
+constexpr size_t MAX_QUEUE = 2048;
+constexpr size_t MAX_LINKS = 64;
+// v3.9.5 F9: when the list is full, a link the game has not sent on for this long is dropped so
+// a new peer can be added (a link was only ever removed when its socket closed).
+constexpr auto LINK_IDLE = std::chrono::seconds{60};
+
+/// A guest UDP socket and one address the game sends to on it.
+struct Link {
+    SOCKET fd;
+    sockaddr_in to;
+    std::chrono::steady_clock::time_point last; ///< v3.9.5 F9: the game's last send on it
+};
+
+/// review2r N1r: true when the game sent on some link in the last LINK_IDLE (mutex held). Only then are
+/// idle links left out of the side traffic: a game silent on every link (a long load) keeps them all.
+bool AnyFresh(const std::vector<Link>& all, std::chrono::steady_clock::time_point now) {
+    return std::any_of(all.begin(), all.end(),
+                       [now](const Link& link) { return now - link.last < LINK_IDLE; });
+}
+
+std::mutex mutex;
+// Audit Q1: held by the assist while it sends side packets (without `mutex`) and by Closed before
+// the game closes a socket, so the game's own sends (Sent, every datagram) never wait for the
+// assist's sendto calls and a closed handle is never sent on. Order: send_mutex before mutex.
+std::mutex send_mutex;
+std::atomic<bool> enabled{false};
+std::vector<Link> links;
+std::deque<Packet> received;
+
+std::vector<u8> Framed(std::span<const u8> payload) {
+    std::vector<u8> out(MAGIC.begin(), MAGIC.end());
+    out.insert(out.end(), payload.begin(), payload.end());
+    return out;
+}
+
+} // Anonymous namespace
+
+void Enable(u16) {
+    enabled = true;
+}
+
+void Closed(SOCKET fd) {
+    if (!enabled) {
+        return;
+    }
+    std::scoped_lock lock{send_mutex, mutex}; // audit Q1: no side send is in flight on fd
+    std::erase_if(links, [fd](const Link& link) { return link.fd == fd; });
+}
+
+/// The game sent a datagram on fd: remember the link (UDP to another machine or another game).
+void Sent(SOCKET fd, const sockaddr& to) {
+    if (!enabled || to.sa_family != AF_INET) {
+        return;
+    }
+    sockaddr_in in{};
+    std::memcpy(&in, &to, sizeof(in));
+    if ((ntohl(in.sin_addr.s_addr) >> 24) == 127) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    std::scoped_lock lock{mutex};
+    for (auto& link : links) {
+        if (link.fd == fd && link.to.sin_addr.s_addr == in.sin_addr.s_addr &&
+            link.to.sin_port == in.sin_port) {
+            link.last = now; // v3.9.5 F9
+            return;
+        }
+    }
+    int type = 0;
+    socklen_t length = sizeof(type);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, reinterpret_cast<char*>(&type), &length) != 0 ||
+        type != SOCK_DGRAM) {
+        return;
+    }
+    // v3.9.5 F9: only a full list is aged (fewer than 64 links: nothing changes); logged per
+    // event, never per send.
+    if (links.size() >= MAX_LINKS) {
+        const size_t before = links.size();
+        std::erase_if(links, [now](const Link& old) { return now - old.last >= LINK_IDLE; });
+        if (links.size() < before) {
+            LOG_INFO(Network, "LAN side channel: {} link(s) idle for {} s dropped, {} left",
+                     before - links.size(), LINK_IDLE.count(), links.size());
+        }
+        if (links.size() >= MAX_LINKS) {
+            static bool full_logged = false;
+            if (!full_logged) {
+                full_logged = true;
+                LOG_WARNING(Network, "LAN side channel: {} links, none idle for {} s; a new "
+                                     "address is not linked (logged once)",
+                            links.size(), LINK_IDLE.count());
+            }
+            return;
+        }
+    }
+    links.push_back(Link{fd, in, now});
+}
+
+/// True when the datagram read from a guest socket is a side-channel packet: it is queued and the
+/// guest must not see it.
+bool Take(SOCKET, const sockaddr_in& from, std::span<const u8> data) {
+    if (!enabled || data.size() < MAGIC.size() ||
+        std::memcmp(data.data(), MAGIC.data(), MAGIC.size()) != 0) {
+        return false;
+    }
+    Packet packet;
+    packet.data.assign(data.begin() + MAGIC.size(), data.end());
+    packet.at = std::chrono::steady_clock::now();
+    packet.ip = ntohl(from.sin_addr.s_addr);
+    packet.port = ntohs(from.sin_port);
+    std::scoped_lock lock{mutex};
+    if (received.size() >= MAX_QUEUE) {
+        received.pop_front();
+    }
+    received.push_back(std::move(packet));
+    return true;
+}
+
+// merge build-366: upstream receives into a sockaddr_storage (IPv6 sockets); only IPv4 carries the
+// side channel.
+bool Take(SOCKET fd, const sockaddr_storage& from, std::span<const u8> data) {
+    if (from.ss_family != AF_INET) {
+        return false;
+    }
+    sockaddr_in in{};
+    std::memcpy(&in, &from, sizeof(in));
+    return Take(fd, in, data);
+}
+
+bool Send(std::span<const u8> payload) {
+    const std::vector<u8> out = Framed(payload);
+    const auto now = std::chrono::steady_clock::now();
+    // Audit Q1: the targets are copied under `mutex` and sent under send_mutex only.
+    std::scoped_lock send_lock{send_mutex};
+    std::vector<Link> targets;
+    bool any_link = false;
+    {
+        std::scoped_lock lock{mutex};
+        any_link = !links.empty();
+        const bool any_fresh = AnyFresh(links, now); // review2r N1r
+        for (const auto& link : links) {
+            // Audit J (N1): only to addresses the game itself still talks to; a link of an
+            // earlier match (the socket stays open) would carry our side traffic into another.
+            if (!(any_fresh && now - link.last >= LINK_IDLE)) {
+                targets.push_back(link);
+            }
+        }
+    }
+    for (const auto& link : targets) {
+        if (NetSim::Submit(link.fd, out, reinterpret_cast<const sockaddr*>(&link.to))) {
+            continue;
+        }
+        (void)sendto(link.fd, reinterpret_cast<const char*>(out.data()), static_cast<int>(out.size()),
+                     0, reinterpret_cast<const sockaddr*>(&link.to), sizeof(link.to));
+    }
+    return any_link;
+}
+
+bool SendTo(u32 ip, u16 port, std::span<const u8> payload) {
+    const std::vector<u8> out = Framed(payload);
+    std::scoped_lock send_lock{send_mutex}; // audit Q1: as Send
+    std::vector<Link> targets;
+    {
+        std::scoped_lock lock{mutex};
+        for (const auto& link : links) {
+            if (ntohl(link.to.sin_addr.s_addr) == ip && ntohs(link.to.sin_port) == port) {
+                targets.push_back(link);
+            }
+        }
+    }
+    for (const auto& link : targets) {
+        if (NetSim::Submit(link.fd, out, reinterpret_cast<const sockaddr*>(&link.to))) {
+            continue;
+        }
+        (void)sendto(link.fd, reinterpret_cast<const char*>(out.data()),
+                     static_cast<int>(out.size()), 0,
+                     reinterpret_cast<const sockaddr*>(&link.to), sizeof(link.to));
+    }
+    return !targets.empty();
+}
+
+std::vector<std::pair<u32, u16>> Peers() {
+    const auto now = std::chrono::steady_clock::now();
+    std::scoped_lock lock{mutex};
+    std::vector<std::pair<u32, u16>> out;
+    const bool any_fresh = AnyFresh(links, now); // review2r N1r
+    for (const auto& link : links) {
+        if (any_fresh && now - link.last >= LINK_IDLE) { // Audit J (N1), as in Send
+            continue;
+        }
+        const std::pair<u32, u16> address{ntohl(link.to.sin_addr.s_addr), ntohs(link.to.sin_port)};
+        if (std::find(out.begin(), out.end(), address) == out.end()) {
+            out.push_back(address);
+        }
+    }
+    return out;
+}
+
+std::vector<Packet> Drain() {
+    std::scoped_lock lock{mutex};
+    std::vector<Packet> out(std::make_move_iterator(received.begin()),
+                            std::make_move_iterator(received.end()));
+    received.clear();
+    return out;
+}
+
+} // namespace LanSide
+
+
+namespace {
+
+// Traffic to and from other machines (not loopback): the first few of each kind per address and
+// then every 500th, so a two-machine online test shows who reaches whom. Warning level, to pass
+// the default log filter.
+void TracePeer(const char* what, const sockaddr_in& addr, long long bytes,
+               std::span<const u8> data = {}) {
+    if (addr.sin_family != AF_INET) {
+        return;
+    }
+    const u32 ip = ntohl(addr.sin_addr.s_addr);
+    if ((ip >> 24) == 127) {
+        return;
