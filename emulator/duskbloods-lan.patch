+/// Final placement state is per match (as in Virtue / CommendShare): reset at a new match (session,
+/// stage or match load) and while the match is not in round 4. True while this game is in the final
+/// rounds (round 4 with the last-phase coordinator par+0x3388).
+bool Assist::State::FinalReset(u64 stage) {
+    const u32 round = Get<u32>(stage + P_ROUND);
+    if (session.manager != final_manager || stage != final_stage || match_gen != final_gen ||
+        round < FINAL_ROUND) {
+        if (final_manager != 0 && (final_own_out || !final_out.empty() || !final_host.empty())) {
+            Log(fmt::format("final placement: state of the last final cleared (round {}, match "
+                            "load #{})",
+                            round, match_gen));
+        }
+        final_manager = session.manager;
+        final_stage = stage;
+        final_gen = match_gen;
+        final_dead_since.reset();
+        final_own_out = false;
+        final_own_hidden = false;
+        final_own_stage = STAGE_OUT;
+        final_own_order = 0;
+        final_own_left_ms = 0;
+        final_dead_left = 0;
+        final_last_life_seen = false;
+        final_own_at = {};
+        final_out_sent_at = {};
+        final_out.clear();
+        final_finalists.clear();
+        final_vt_logged = false;
+        final_hold_logged = false;
+        final_won_since.reset();
+        final_over_since.reset();
+        final_entries_sent_at = {};
+        final_entries_logged = false;
+        final_host.clear();
+        final_host_from = 0;
+        final_host_at = {};
+        final_host_team.clear();
+        final_host_team_from = 0;
+        final_host_team_at = {};
+        final_teams_logged = false;
+        final_fed.clear();
+        final_fed_done.clear();
+        final_feed_logged = false;
+        final_feed_bb_logged = false;
+        final_feed_own_logged = false;
+        // v399b: a player number left in the mailbox (the final ended before the game took it) must
+        // not reach the next final; outside round 4 the game never takes it, so clearing is safe.
+        if (main != 0 && Get<u32>(main + FINALOUT_SITE) == FINALOUT_HOOK_WORD &&
+            Get<u32>(main + FINALOUT_BOX) != 0) {
+            Put<u32>(main + FINALOUT_BOX, 0);
+        }
+        // alpha 13 REWARDONCE: every final starts with no reward given.
+        if (main != 0 && Get<u32>(main + RO_SITE) == RO_SITE_HOOK && Get<u64>(main + RO_BOX + 4) != 0) {
+            Log(fmt::format("final reset: REWARDONCE box cleared (mask {:#x}, {} given, {} held back; "
+                            "alpha 13)",
+                            Get<u32>(main + RO_BOX), Get<u32>(main + RO_BOX + 4),
+                            Get<u32>(main + RO_BOX + 8)));
+            Put<u32>(main + RO_BOX + 8, 0);
+            Put<u32>(main + RO_BOX + 4, 0);
+            Put<u32>(main + RO_BOX, 0);
+        }
+        rewardonce_seen = 0;
+        final_result_since.reset();
+        final_align_why.clear();
+        final_put_count.clear();
+        final_heard_at.clear();
+        final_cut_off = false;
+        final_hear_reports.clear();
+        final_quorum_logged.clear();
+        final_hear_out.clear();
+        final_n2_logged.clear();
+        bb_align_logged = false;
+    }
+    return round == FINAL_ROUND && Get<u64>(stage + P_FINAL) != 0;
+}
