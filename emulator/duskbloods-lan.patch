+/// The game server kept one match clock for everybody. Without it each game counts its own, frame
+/// by frame, so every stall leaves it further behind the others. The emulators tell each other
+/// their phase and clock once a second, and every game follows the player with the lowest number.
+/// The same messages measure the round trip between the games.
+/// Review2 R6: drains the side channel every 50 ms (Run). Virtue (8) and Commendation (9) sets are
+/// taken at once, so a kill in the last second of a phase reaches the others' ranking in time; all
+/// other packets wait in side_queue for Side, which still reads them once a second in the order
+/// they came (their handlers use packet.at, the time the socket delivered them, so their timing is
+/// what it was).
+void Assist::State::SideFast() {
+    for (auto& packet : Network::LanSide::Drain()) {
+        // v410 H1: types 3, 7..15 carry the sender's instance at +4. A game cut in this match
+        // (latched by PeerCut) may be playing a match of its own: its Virtue, Commendation, final,
+        // rule, taken, cut-list, lobby, map and environment packets are not ours. Type 1 still
+        // goes to Side (its peer record stays cut there).
+        if (packet.data.size() >= 8 && cut_instances_gen == match_gen && !cut_instances.empty()) {
+            const u8 type = packet.data[0];
+            if (type == 3 || (type >= 7 && type <= 17) || (type >= 22 && type <= 25) || type == 27 || type == LEVEL_TYPE || type == PART_TYPE) { // v413: 16; v4.23: 17; v4.27: 22; v4.30: 23; v4.34: 24; v4.36: 25; v4.43: 27; LEVELSHARE: 28; PARTSYNC: 29
+                u32 from = 0;
+                std::memcpy(&from, packet.data.data() + 4, sizeof(from));
+                if (cut_instances.contains(from)) {
+                    if (cut_instance_drop_logged.insert((u64{from} << 8) | type).second) {
+                        Log(fmt::format("side: type {} from game {:#010x} dropped: that game was cut "
+                                        "in this match (v410 H1)",
+                                        type, from));
+                    }
+                    continue;
+                }
+            }
+        }
+        if (!packet.data.empty() && (packet.data[0] == 8 || packet.data[0] == 9)) {
+            SideShare(packet);
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 10) {
+            FinalHeard(packet); // final placement: at once too
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 11) {
+            RuleHeard(packet); // rule set: at once, also before the stage exists
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 12) {
+            TakenHeard(packet); // taken state: kept, applied by TakenShare
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == PART_TYPE) {
+            PartHeard(packet); // PARTSYNC: at once (the 1.5 s grace counts from the socket time)
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 13) {
+            CutHeard(packet); // v3.9.4 F1: the authority's cut list, compared by CutCheck
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 14) {
+            LobbyHeard(packet); // v3.9.8 F5: the lobby size, at once (numbering waits on it)
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 16) {
+            NumberHeard(packet); // v413: the number exchange, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 26) {
+            NeedDataHeard(packet); // v4.37 NEEDDATA: a game still waits for our player data
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 27) {
+            HostTextHeard(packet); // v4.43 HOSTTEXT: the host's text, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 21) {
+            ClockAddHeard(packet); // CLOCKADD: a guest's Moon Phase Watch, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 23) {
+            CutVoteHeard(packet); // v4.30 CUTSCENE_VOTE: a skip vote, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 24) {
+            HearHeard(packet); // v4.34 quorum: who the sender hears in the final, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 25) {
+            TakeRaceHeard(packet); // v4.36 TAKERACE: asks / answers, at once
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 15) {
+            CutAckHeard(packet); // V400-1: an answer to our cut list
+            continue;
+        }
+        if (side_queue.size() >= 2048) { // the socket queue's own cap (network.cpp MAX_QUEUE)
+            side_queue.pop_front();
+        }
+        side_queue.push_back(std::move(packet));
+    }
+}
