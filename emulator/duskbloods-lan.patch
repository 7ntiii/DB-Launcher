+/// Without the game server nobody answers a player's effect requests, so the effect never
+/// applies: the Goldblood Stake plays its animation and restores no health, and its count stays.
+/// Marks every request record that is still waiting (state 0) as accepted (state 1), for every
+/// player's slot, as the server's answer would.
+void Assist::State::ConfirmEffects() {
+    if (main == 0) {
+        return;
+    }
+    const u64 holder = Get<u64>(main + EFFECT_SYNC);
+    const u64 manager = holder != 0 ? Get<u64>(holder) : 0;
+    if (manager == 0) {
+        return;
+    }
+    bool flask_waiting = false; // a local Goldblood Stake request was answered in this pass
+    u8 flask_spent = 0;         // review2 R9: stakes accepted in this pass (not yet off the count)
+    for (u64 slot = manager + EFFECT_SLOTS; slot < manager + EFFECT_SLOTS_END;
+         slot += EFFECT_SLOT_SIZE) {
+        if (Get<s32>(slot) == -1) {
+            continue;
+        }
+        const u64 map = Get<u64>(slot + EFFECT_RECORDS);
+        const u64 map_end = Get<u64>(slot + EFFECT_RECORDS + 8);
+        const u64 first = Get<u64>(slot + EFFECT_RECORDS + 0x20);
+        const u64 count = Get<u64>(slot + EFFECT_RECORDS + 0x28);
+        if (map == 0 || map_end <= map || count == 0 || count > 4096) {
+            continue;
+        }
+        for (u64 i = 0; i < count; ++i) {
+            const u64 index = first + i;
+            const u64 block_slot = map + index / EFFECT_RECORDS_PER_BLOCK * 8;
+            if (block_slot >= map_end) {
+                break;
+            }
+            const u64 block = Get<u64>(block_slot);
+            if (block == 0) {
+                break;
+            }
+            const u64 record = block + index % EFFECT_RECORDS_PER_BLOCK * EFFECT_RECORD_SIZE;
+            if (Get<s32>(record + EFFECT_RECORD_STATE) != 0) {
+                continue;
+            }
+            // The server's answer also says how many are left and when; the game sets its count
+            // from that. For our own flask (Goldblood Stake) fill both in, or the count never
+            // goes down: left = what we have minus what this use asks for, time = now (a time
+            // older than the count's last change is ignored by the game).
+            const u32 item = Get<u32>(record + 0x10);
+            s32 answer = 1; // accepted
+            if (Get<s32>(slot) == static_cast<s32>(LocalPlayerNo()) && item == ITEM_FLASK) {
+                const u64 world = Get<u64>(main + WORLD_CHR);
+                const u64 chr = world != 0 ? Get<u64>(world + 0x1A8) : 0;
+                const u64 chr_data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+                const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+                if (player_data != 0) {
+                    const u8 have = Get<u8>(player_data + PLAYER_FLASKS);
+                    // A use asks for 1; a 0 here would be a use that costs nothing.
+                    const u8 asked = std::max<u8>(Get<u8>(record + 0x14), u8{1});
+                    const f32 when = std::max(Get<f32>(main + GAME_TIME), Get<f32>(slot + 0x40));
+                    Put<f32>(record + 0x1C, when);
+                    Put<u8>(record + 0x21, 0);
+                    flask_waiting = true;
+                    const bool idle_known = flask_idle.has_value() && flask_pd == player_data;
+                    // Review2 R9: what an earlier request of this pass took is not off the count
+                    // yet; with 1 stake left two waiting requests must not both pass.
+                    const u8 avail = have > flask_spent ? static_cast<u8>(have - flask_spent) : 0;
+                    const bool idle_ok =
+                        idle_known ? (*flask_idle > flask_spent &&
+                                      *flask_idle - flask_spent >= asked)
+                                   : flask_spent == 0;
+                    if (avail >= asked) {
+                        Put<u8>(record + 0x20, static_cast<u8>(avail - asked));
+                        flask_spent = static_cast<u8>(flask_spent + asked);
+                    } else if (flask_spent != 0 && !idle_ok) {
+                        Put<u8>(record + 0x20, avail);
+                        answer = 2;
+                        Log(fmt::format("effect request {} (Goldblood Stake) rejected: has {}, {} "
+                                        "already taken by another request in this pass, asks {} "
+                                        "(review2 R9)",
+                                        Get<s32>(record + 8), have, flask_spent, asked));
+                    } else if (idle_ok) {
+                        flask_spent = static_cast<u8>(flask_spent + asked);
+                        // Review check: the count was not short before this request (or is not
+                        // known): the game may have lowered it before the answer. Keep the old
+                        // verified answer (accepted, left = max(0, have - asked) = 0).
+                        Put<u8>(record + 0x20, 0);
+                        Log(fmt::format("effect request {} (Goldblood Stake): has {} now, but had "
+                                        "{} before the request; accepted with 0 left (not "
+                                        "rejected)",
+                                        Get<s32>(record + 8), have,
+                                        idle_known ? fmt::format("{}", *flask_idle)
+                                                   : std::string("an unknown count")));
+                    } else {
+                        // The server's 0xCF6D10 rejects a use the player cannot pay for (state
+                        // 2: nothing applied). The count stays what it is.
+                        Put<u8>(record + 0x20, have);
+                        answer = 2;
+                        Log(fmt::format("effect request {} (Goldblood Stake) rejected: has {}, "
+                                        "asks {}, had {} before the request (balance fix H3)",
+                                        Get<s32>(record + 8), have, asked, *flask_idle));
+                    }
+                }
+            } else if (item != ITEM_FLASK && item != last_other_item) {
+                // Other goods: the assist cannot read their count (flask-type or inventory, not
+                // traced), so no have-check and no remaining count; left as before (audit H3).
+                last_other_item = item;
+                Log(fmt::format("effect request for item {:#x} (not the flask): accepted without a "
+                                "count",
+                                item));
+            }
+            Put<s32>(record + EFFECT_RECORD_STATE, answer);
+            if (++effects_confirmed <= 5 || effects_confirmed % 50 == 0) {
+                Log(fmt::format("effect request {} of player {} {} in place of the game "
+                                "server (#{})",
+                                Get<s32>(record + 8), Get<s32>(slot),
+                                answer == 1 ? "accepted" : "rejected", effects_confirmed));
+            }
+        }
+    }
+    // The flask count while no request waits: what the player had before the next request.
+    if (!flask_waiting) {
+        const u64 world = Get<u64>(main + WORLD_CHR);
+        const u64 chr = world != 0 ? Get<u64>(world + 0x1A8) : 0;
+        const u64 chr_data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+        const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+        flask_pd = player_data;
+        if (player_data != 0) {
+            flask_idle = Get<u8>(player_data + PLAYER_FLASKS);
+        } else {
+            flask_idle.reset();
+        }
+    }
+}
+
+/// Online every enemy is a network chr: one game drives it (runs its AI, sends its position,
+/// actions and status) and the others show what they receive. The game server chose the driver of
+/// each enemy from the clients' distance reports; with no server no game drives any enemy and they
+/// all stand still. Here each game takes the enemies that are nearer to its own player than to any
+/// other player (its game also has them loaded then) and leaves the rest to the others, so every
+/// player sees the same enemies. Four times a second.
+void Assist::State::EnemyOwners(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8 || now - owners_at < 250ms) {
+        return;
+    }
+    owners_at = now;
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 sync = world != 0 ? Get<u64>(world + CHR_SYNC) : 0;
+    if (sync == 0) {
+        enemy_list.clear();
+        kin_last.clear();
+        return;
+    }
+    // The enemies (their chrs come and go with rounds and spawners): relisted every 2 s.
+    if (enemy_list.empty() || now - owners_listed >= 2s) {
+        if (enemy_list.empty()) {
+            owners_since = now;
+        }
+        owners_listed = now;
+        enemy_list.clear();
+        const u32 sets = std::min<u32>(Get<u32>(sync + 8), 16);
+        std::vector<u64> entries;
+        for (u32 i = 0; i < sets; ++i) {
+            const u64 set = Get<u64>(sync + SYNC_SETS + 8 * i);
+            const u64 chr_set = set != 0 ? Get<u64>(set + SYNC_CHR_SET) : 0;
+            const u32 count = set != 0 ? Get<u32>(set + SYNC_COUNT) : 0;
+            const u64 owners = set != 0 ? Get<u64>(set + SYNC_OWNER) : 0;
+            const u64 first = chr_set != 0 ? Get<u64>(chr_set + 8) : 0;
+            if (count == 0 || count > 8192 || owners == 0 || first == 0) {
+                continue;
+            }
+            entries.resize(static_cast<size_t>(count) * 7);
+            if (!Read(first, entries.data(), entries.size() * sizeof(u64))) {
+                continue;
+            }
+            // review1 I1: the id is (set << 12) | index: only indexes that fit 12 bits get one.
+            for (u32 j = 0; j < count && j < 4096; ++j) {
+                const u64 chr = entries[j * 7];
+                const u64 physics = entries[j * 7 + 5];
+                if (chr != 0 && physics != 0 && Get<u64>(chr) == main + ENEMY_VTABLE) {
+                    enemy_list.push_back({owners + 2 * j, physics, chr, (u64{i} << 12) | j});
+                }
+            }
+        }
+    }
+    if (enemy_list.empty()) {
+        owners_since = now;
+        return;
+    }
+    // v3.6 zeppelin (zeppelin4_notes 6.3): in the environment event "zeppelin" the airships are
+    // driven by the authority's game (GENERATOR_IDLE 0: the lowest-numbered player in the match,
+    // or whoever took the role after a cut / hand-over), never by distance: that game decides the
+    // strikes, so its airship AI must fire the volley and send the end message that clears busy.
+    // Support object = *(stage phase + 0x2C0), type +8 0x0A, airship list +0xF0 (0x40-byte entries,
+    // u16 id at +0), matched to a chr by [[chr+0x20]+0x78] & 0xFFFF AND the airship type bit
+    // [[[chr+0x20]+0xE8]+8]+0x39D bit 3 (diag/twin/zeppelin.py is_airship_type).
+    // review12 S2: this pass runs before our own player is read, so a game whose chr is missing
+    // (cut host, area load) still releases the ships when it is no longer the authority.
+    const u32 local_no = LocalPlayerNo();
+    // v414 (audit8_hostleave.md L1): which players' games are still heard in this match. A game
+    // that dropped (the host mid-phase, a crash, a lost link) leaves its chr standing on the other
+    // games until their game drops the member (~31 s, if at all): every enemy nearer to that chr
+    // than to a live player, and its kin, was driven by nobody. Only with 3+ players in the game's
+    // own member list at numbering (session.member_count; not the lobby size, not peers, which may
+    // hold stale or other matches' games): a two-player match keeps the rule as it was.
+    if (owner_no_gen != match_gen) {
+        owner_no_gen = match_gen;
+        owner_no_heard.clear();
+    }
+    for (const auto& [peer_key, peer] : peers) {
+        if (peer.no != 0 && peer.no != local_no) {
+            auto& heard = owner_no_heard[peer.no];
+            heard = std::max(heard, peer.at);
+        }
+    }
+    const auto player_gone = [&](u32 no) {
+        if (session.member_count < 3 || no == 0 || no == local_no) {
+            return false;
+        }
+        const auto heard = owner_no_heard.find(no);
+        if (heard == owner_no_heard.end() || now - heard->second < OWNER_GONE) {
+            return false;
+        }
+        if (owner_gone_logged.insert((u64{match_gen} << 32) | no).second) {
+            Log(fmt::format("enemies: player {} not heard for {} s: its chr and kin no longer count "
+                            "for the enemy owners (v414)",
+                            no, std::chrono::duration_cast<std::chrono::seconds>(
+                                    now - heard->second).count()));
+        }
+        return true;
+    };
+    size_t owned = 0;
+    const bool authority = Get<u32>(main + GENERATOR_IDLE) == 0;
+    std::unordered_set<u64> ship_chrs;
+    {
+        std::array<u16, ZEP_SHIPS_MAX> ship_ids{};
+        size_t ship_count = 0;
+        const u64 stage = Get<u64>(main + STAGE_PHASE);
+        const u64 support = stage != 0 ? Get<u64>(stage + ZEP_SUPPORT) : 0;
+        if (support != 0 && Get<u8>(support + 8) == ZEP_ENV_TYPE) {
+            const u64 ship_first = Get<u64>(support + ZEP_SHIPS);
+            const u64 ship_end = Get<u64>(support + ZEP_SHIPS + 8);
+            if (ship_first != 0 && ship_end > ship_first &&
+                (ship_end - ship_first) % ZEP_SHIP_SIZE == 0 &&
+                (ship_end - ship_first) / ZEP_SHIP_SIZE <= 256) {
+                const u64 listed = (ship_end - ship_first) / ZEP_SHIP_SIZE;
+                for (u64 k = 0; k < listed && ship_count < ship_ids.size(); ++k) {
+                    const u16 ship_id = Get<u16>(ship_first + k * ZEP_SHIP_SIZE);
+                    if (ship_id != 0 && ship_id != 0xFFFF) {
+                        ship_ids[ship_count++] = ship_id;
+                    }
+                }
+            }
+        }
+        std::string ship_states; // review12 N2: copy state ([chr+0x18]+0x10, 5 = awake)
+        if (ship_count != 0) {
+            const auto ship_last = ship_ids.begin() + static_cast<std::ptrdiff_t>(ship_count);
+            for (const auto& ship : enemy_list) {
+                const u64 ship_flag = ship[0];
+                const u64 ship_chr = ship[2];
+                const u64 ship_data = Get<u64>(ship_chr + 0x20);
+                const u16 chr_id = ship_data != 0
+                                       ? static_cast<u16>(Get<u32>(ship_data + 0x78) & 0xFFFF)
+                                       : u16{0};
+                if (chr_id == 0 || std::find(ship_ids.begin(), ship_last, chr_id) == ship_last) {
+                    continue;
+                }
+                // review12 N1: an enemy or kin whose low 16 bits collide is not an airship.
+                const u64 type_x = Get<u64>(ship_data + 0xE8);
+                const u64 type_y = type_x != 0 ? Get<u64>(type_x + 8) : 0;
+                if (type_y == 0 || (Get<u8>(type_y + 0x39D) & 8) == 0) {
+                    continue;
+                }
+                ship_chrs.insert(ship_chr);
+                const bool ship_mine = Get<s16>(ship_flag) >= 0;
+                if (ship_mine != authority) {
+                    Put<s16>(ship_flag, authority ? s16{1} : s16{-1});
+                }
+                if (authority) {
+                    const u64 ship_ent = Get<u64>(ship_chr + 0x18);
+                    const u32 ship_copy = ship_ent != 0 ? Get<u32>(ship_ent + 0x10) : 0;
+                    ship_states += fmt::format(" {:#06x}={} ({})", chr_id,
+                                               ship_copy == 5 ? "awake" : "idle", ship_copy);
+                }
+            }
+        }
+        if (!ship_chrs.empty()) {
+            const u64 ship_key = support | (authority ? u64{1} : u64{0}); // heap object: bit 0 free
+            if (ship_key != zeppelin_logged) {
+                zeppelin_logged = ship_key;
+                std::string listed;
+                for (size_t k = 0; k < ship_count; ++k) {
+                    listed += fmt::format(" {:#06x}", ship_ids[k]);
+                }
+                Log(fmt::format("zeppelin: {} of {} airships (ids{}) {} (player {}; never by "
+                                "distance){}",
+                                ship_chrs.size(), ship_count, listed,
+                                authority ? "taken: driven by this game, the authority"
+                                          : "left to the authority's game",
+                                local_no,
+                                authority ? "; copy state" + ship_states : std::string{}));
+            }
+        }
+    }
+    // v3.9.4 F4: our player is cut (H1 LocalCut: a result step 14 / 29 / 36 in rounds 2..3 of a
+    // match with 3+ players). Our game drives no enemy any more and sends no claims, so the
+    // players still in the match take every enemy by distance. Airships are left to the ship pass
+    // above (a cut game is not the authority). Never in a two-player match, round 1 or the final.
+    if (const u64 cut_stage = Get<u64>(main + STAGE_PHASE);
+        cut_stage != 0 && LocalCut(Get<u32>(cut_stage + P_STATE))) {
+        size_t released = 0;
+        for (const auto& [flag, physics, chr, id] : enemy_list) {
+            if (ship_chrs.contains(chr) || Get<s16>(flag) < 0) {
+                continue;
+            }
+            Put<s16>(flag, s16{-1});
+            ++released;
+        }
+        if (owner_cut_logged.insert({match_gen, 0U}).second) {
+            Log(fmt::format("enemies: our player is cut: this game drives no enemy any more ({} "
+                            "let go) and sends no claims (F4)",
+                            released));
+        }
+        return;
+    }
+    // Entry 0 is our player, the others are the other players' chrs in our game.
+    const u64 players = Get<u64>(world + 0x30);
+    // A dead player's game sends no position and its chr stays where it fell: it drives nothing
+    // until it is back, and the others do not count it.
+    std::array<std::array<f32, 3>, MAX_ENTRIES> spot{};
+    size_t others = 0;
+    bool alive = true;
+    for (size_t entry = 0; entry < MAX_ENTRIES && players != 0; ++entry) {
+        const u64 base = players + entry * 0x38;
+        const u64 chr = Get<u64>(base);
+        // v3.9.4 F4: another player's chr whose player is cut (H1 record) is no rival: an enemy
+        // near its leftover chr is taken by the nearest player still in the match.
+        if (entry != 0 && chr != 0) {
+            const u64 cut_data = Get<u64>(chr + 0x20);
+            const u64 cut_pgd = cut_data != 0 ? Get<u64>(cut_data + 0x1D0) : 0;
+            const u32 cut_no = cut_pgd != 0 ? Get<u32>(cut_pgd + PGD_NO) : 0;
+            if (cut_no != 0 && cut_no != ~0U && CutNo(cut_no)) {
+                if (owner_cut_logged.insert({match_gen, 0x200U | cut_no}).second) {
+                    Log(fmt::format("enemies: player {} is cut: its chr (entry {}) no longer "
+                                    "counts for the enemy owners (F4)",
+                                    cut_no, entry));
+                }
+                continue;
+            }
+            if (cut_no != 0 && cut_no != ~0U && player_gone(cut_no)) {
+                continue; // v414 L1: its game left (silent for OWNER_GONE): no rival
+            }
+        }
+        const u64 physics = chr != 0 && PlayerEntry(chr, entry) ? Get<u64>(base + 0x28) : 0;
+        std::array<f32, 3> at{};
+        // review8: an entry that cannot be read for a moment (chr / physics / HP) keeps its last
+        // good position and dead state for up to 2 s; a real HP of 0 is taken at once.
+        const bool last_fresh = owner_last_seen[entry] != Clock::time_point{} &&
+                                now - owner_last_seen[entry] <= 2s;
+        bool dead = false;
+        if (physics == 0 || !Read(physics + 0x70, at.data(), sizeof(at))) {
+            if (entry == 0) {
+                return; // no player of ours yet (flags stay as they are)
+            }
+            if (!last_fresh) {
+                continue;
+            }
+            at = owner_last_at[entry];
+            dead = owner_last_dead[entry];
+        } else {
+            const u64 modules = Get<u64>(chr + 0x2470);
+            const u64 data = modules != 0 ? Get<u64>(modules + 0x18) : 0;
+            s32 hp = 0;
+            if (data != 0 && Read(data + 0x290, &hp, sizeof(hp))) {
+                dead = hp <= 0;
+                owner_last_at[entry] = at;
+                owner_last_dead[entry] = dead;
+                owner_last_seen[entry] = now;
+            } else {
+                dead = last_fresh && owner_last_dead[entry]; // unreadable: as before (alive)
+            }
+        }
+        if (entry == 0) {
+            spot[0] = at;
+            alive = !dead;
+        } else if (!dead) {
+            spot[++others] = at;
+        }
+    }
+    const auto distance = [](const std::array<f32, 3>& a, const std::array<f32, 3>& b) {
+        return std::sqrt((a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1]) +
+                         (a[2] - b[2]) * (a[2] - b[2]));
+    };
+    // Kin (buddies) are enemy-class chrs too, but each belongs to its summoner: that player's
+    // game drives it wherever it is. Buddy manager = [[world+0x5B8]+0x10]: list at +0x10 (node
+    // +0x10 = chr), count at +0x20; the chr's data +0xB8 is the owner's PLAYER NUMBER (kin8_notes:
+    // not a chr handle; v4.04 compares it with our PlayerGameData number [[data+0x1D0]+0xD0]).
+    // review7 task 3: a pass that cannot read the list (count out of range, list being rebuilt) or
+    // our own handle (our chr briefly missing) must not hand a kin to the distance rule below, nor
+    // release our own kin as "not ours": the last good pass (up to 5 s old) is used instead, and
+    // a kin whose summoner is still unknown keeps its flag as it is.
+    std::unordered_map<u64, bool> kin; // chr -> ours
+    std::unordered_set<u64> kin_unknown; // kin whose summoner is not known in this pass
+    {
+        const u64 holder = Get<u64>(world + 0x5B8);
+        const u64 buddies = holder != 0 ? Get<u64>(holder + 0x10) : 0;
+        const u64 own_chr = Get<u64>(world + 0x1A8);
+        const u64 own_data = own_chr != 0 ? Get<u64>(own_chr + 0x20) : 0;
+        const u64 own_pgd = own_data != 0 ? Get<u64>(own_data + 0x1D0) : 0;
+        const u32 own_no = own_pgd != 0 ? Get<u32>(own_pgd + 0xD0) : 0; // 0 = not known yet
+        const bool list_ok = buddies != 0 && Get<u32>(buddies + 0x20) <= 64;
+        const bool last_fresh = now - kin_last_at < 5s;
+        if (list_ok) {
+            u64 node = Get<u64>(buddies + 0x10);
+            for (int n = 0; n < 64 && node != 0 && node != buddies + 0x10; ++n) {
+                const u64 chr = Get<u64>(node + 0x10);
+                const u64 data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+                // v414 L1: a kin whose summoner's game left is driven by the authority game, as
+                // KIN4's gone-owner rule gives it the HP authority (none in the role gap: as before).
+                if (data != 0 && player_gone(Get<u32>(data + 0xB8))) {
+                    kin[chr] = authority;
+                } else if (data != 0) {
+                    if (own_no != 0) {
+                        kin[chr] = Get<u32>(data + 0xB8) == own_no;
+                    } else if (const auto known = kin_last.find(chr);
+                               last_fresh && known != kin_last.end()) {
+                        kin[chr] = known->second;
+                    } else {
+                        kin_unknown.insert(chr);
+                    }
+                }
+                node = Get<u64>(node);
+            }
+            if (own_no != 0) {
+                kin_last = kin;
+                kin_last_at = now;
+            }
+        } else if (last_fresh) {
+            kin = kin_last;
+        }
+    }
+    // Clearly nearer to us: ours. Clearly nearer to another player: theirs. In between, whoever
+    // has it keeps it (the games tell each other what they drive, so two games never both take an
+    // enemy that stands between their players; if they did, the lower player number keeps it).
+    std::vector<u16> claims;
+    // v426: once a second this pass also collects the max HP of the strong enemies we drive.
+    const bool max_pass = now - enemy_max_sent >= 1s;
+    if (max_pass) {
+        enemy_max_sent = now;
+    }
+    std::vector<EnemyMaxEntry> max_out;
+    if (enemy_max_heard.size() > 1024) {
+        enemy_max_heard.clear();
+    }
+    // Trespassers (joint struggle): enemy key -> battle step of its instance. Steps 2..8
+    // (Activate .. WaitFinishReturnWarp) are a battle under way; 1 WaitActivate is not.
+    // Only these chrs get the hand-over guards below; ordinary enemies keep the rule as it was.
+    std::unordered_map<u32, u32> struggle_steps;
+    {
+        const u64 manager = Get<u64>(main + STRUGGLE_MANAGER);
+        const u64 first_slot = manager != 0 ? Get<u64>(manager + 8) : 0;
+        const u64 end_slot = manager != 0 ? Get<u64>(manager + 0x10) : 0;
+        if (first_slot != 0 && end_slot > first_slot && end_slot - first_slot <= u64{64 * 8}) {
+            for (u64 slot = first_slot; slot < end_slot; slot += 8) {
+                const u64 ins = Get<u64>(slot);
+                const u32 fight_key = ins != 0 ? Get<u32>(ins + 0xC0) >> 16 : 0;
+                const u32 fight_step = ins != 0 ? Get<u32>(ins + 0x50) : 0;
+                if (fight_key != 0) {
+                    auto& kept = struggle_steps[fight_key];
+                    if (fight_step >= 2 && fight_step <= 8) {
+                        kept = fight_step; // a battle wins over an older round's instance
+                    } else if (kept < 2 || kept > 8) {
+                        kept = fight_step;
+                    }
+                }
+            }
+        }
+    }
+    if (owner_refusals.size() > 4096) {
+        owner_refusals.clear();
+    }
+    if (enemy_fight.size() > 2048 || enemy_idle_take.size() > 2048) {
+        enemy_fight.clear(); // v425: only enemies near a halfway line are kept; a new round refills
+        enemy_idle_take.clear();
+    }
+    if (boss_contested.size() > 1024 || boss_yielded.size() > 1024) {
+        boss_contested.clear();
+        boss_yielded.clear();
+    }
+    const auto log_refusal = [&](u64 enemy_chr, u64 reason, const std::string& text) {
+        auto& last = owner_refusals[(enemy_chr << 3) | reason];
+        if (last == Clock::time_point{} || now - last >= 10s) {
+            last = now;
+            Log(fmt::format("enemies: chr {:#x} {} (logged every 10 s at most)", enemy_chr, text));
+        }
+    };
+    for (const auto& [flag, physics, chr, id] : enemy_list) {
+        if (ship_chrs.contains(chr)) {
+            owned += authority ? 1 : 0;
+            continue; // airship: set in the ship pass above, never by distance, never claimed
+        }
+        std::array<f32, 3> at{};
+        if (!Read(physics + 0x70, at.data(), sizeof(at))) {
+            continue;
+        }
+        const bool mine_now = Get<s16>(flag) >= 0;
+        if (const auto buddy = kin.find(chr); buddy != kin.end()) {
+            if (buddy->second != mine_now) {
+                Put<s16>(flag, buddy->second ? s16{1} : s16{-1});
+                if (!kin_fix_logged) {
+                    kin_fix_logged = true;
+                    Log(fmt::format("enemies: a kin (chr {:#x}) was {} on this game; it is kept "
+                                    "with its summoner ({}) whoever stands nearer (logged once)",
+                                    chr, mine_now ? "driven here" : "left to the others",
+                                    buddy->second ? "us" : "another player"));
+                }
+            }
+            owned += buddy->second ? 1 : 0;
+            continue;
+        }
+        if (kin_unknown.contains(chr)) {
+            owned += mine_now ? 1 : 0; // a kin whose summoner is unknown now: flag left as it is
+            continue;
+        }
+        const f32 ours = distance(at, spot[0]);
+        f32 theirs = 1e9f;
+        size_t nearest = 0;
+        for (size_t i = 1; i <= others; ++i) {
+            const f32 d = distance(at, spot[i]);
+            if (d < theirs) {
+                theirs = d;
+                nearest = i;
+            }
+        }
+        bool mine = alive || others == 0;
+        if (mine && nearest != 0) {
+            const auto claim = enemy_claims.find(static_cast<u16>(id));
+            const bool claimed = claim != enemy_claims.end() && now - claim->second.first < 2500ms;
+            if (ours < theirs - OWNER_MARGIN) {
+                mine = true;
+            } else if (ours > theirs + OWNER_MARGIN) {
+                mine = false;
+            } else if (mine_now) {
+                mine = !(claimed && local_no != 0 && claim->second.second < local_no);
+            } else {
+                // Nobody's yet: both games agree on which player is further east. If the two
+                // games see the distances a little differently, neither may take it: one that
+                // nobody has claimed for 6 s is taken anyway.
+                const bool orphan = now - owners_since > 8s &&
+                                    (claim == enemy_claims.end() || now - claim->second.first > 6s);
+                mine = !claimed && (orphan || spot[0][0] > spot[nearest][0] ||
+                                    (spot[0][0] == spot[nearest][0] &&
+                                     spot[0][2] > spot[nearest][2]));
+            }
+        }
+        // assist_owner_notes: an enemy is not handed from a game that runs it (its copy awake, or
+        // its Trespasser battle under way) to one whose copy is idle. Only the hand-over is held
+        // back; the rule above is unchanged and a dead player of ours always lets go.
+        // review8: ordinary enemies read nothing more (no instance list: no reads at all).
+        const u64 enemy_data = struggle_steps.empty() ? 0 : Get<u64>(chr + 0x20);
+        const auto fight =
+            enemy_data != 0 ? struggle_steps.find(Get<u32>(enemy_data + 0x78) & 0xFFFF)
+                            : struggle_steps.end();
+        const bool trespasser = fight != struggle_steps.end();
+        const bool in_fight = trespasser && fight->second >= 2 && fight->second <= 8;
+        const u64 ent = trespasser ? Get<u64>(chr + 0x18) : 0;
+        const u32 copy_state = ent != 0 ? Get<u32>(ent + 0x10) : 0;
+        const bool copy_awake = copy_state == 5;
+        const auto claim_seen =
+            trespasser ? enemy_claims.find(static_cast<u16>(id)) : enemy_claims.end();
+        const bool claim_fresh =
+            claim_seen != enemy_claims.end() && now - claim_seen->second.first < 2500ms;
+        const u32 claim_no = claim_fresh ? claim_seen->second.second : 0;
+        // A lower-numbered game claimed it within the last 0.75 s (it still drives it).
+        const bool lower_active = claim_fresh && local_no != 0 && claim_no < local_no &&
+                                  now - claim_seen->second.first < OWNER_FIGHT_CLAIM; // HPO1
+        bool contested = false;
+        if (trespasser && (!claim_fresh || mine_now)) {
+            boss_yielded.erase(chr);
+        }
+        if (!trespasser) {
+            // ordinary enemy: the rule above, plus v425. One that is being hit stays with the game
+            // that drives it, so a combo across the halfway line is not split between two AIs (the
+            // new owner's AI would start from an idle copy and its old owner's hits in flight
+            // could be lost). Only enemies near a halfway line are read (one HP read each).
+            const bool near_line = nearest != 0 && std::fabs(ours - theirs) < OWNER_CONTEST;
+            if (!near_line) {
+                enemy_fight.erase(chr);
+            } else {
+                const u64 mods = Get<u64>(chr + CHR_MODULES);
+                const u64 dmod = mods != 0 ? Get<u64>(mods + MODULE_DATA) : 0;
+                const bool hp_ok = dmod != 0 && Get<u64>(dmod + 8) == chr;
+                const s32 hp = hp_ok ? Get<s32>(dmod + DATA_HP) : 0;
+                auto& seen = enemy_fight[chr];
+                if (hp_ok && hp != seen.hp) {
+                    // (the first read counts as a change only if it is a hurt enemy: no record yet)
+                    if (seen.changed != Clock::time_point{} || seen.hp != 0) {
+                        seen.changed = now;
+                    }
+                    seen.hp = hp;
+                }
+                const bool fighting = hp_ok && hp > 0 && seen.changed != Clock::time_point{} &&
+                                      now - seen.changed < OWNER_FIGHT_RECENT;
+                const auto ord_claim = enemy_claim_last.find(static_cast<u16>(id)); // v425r R1
+                const bool ord_claim_live = ord_claim != enemy_claim_last.end() &&
+                                            now - ord_claim->second.first < 750ms;
+                // HPO1: the taker's test: the driver still claims it (see OWNER_FIGHT_CLAIM).
+                const bool ord_claim_held = ord_claim != enemy_claim_last.end() &&
+                                            now - ord_claim->second.first < OWNER_FIGHT_CLAIM;
+                const u32 ord_claim_no = ord_claim_live ? ord_claim->second.second : 0;
+                if (!fighting) {
+                    seen.held = {};
+                } else if (mine_now && !mine && alive && ours < OWNER_KEEP_AWAKE) {
+                    if (seen.held == Clock::time_point{}) {
+                        seen.held = now;
+                    }
+                    // HPO1 (diag/net/zt_faults/hp_owner): one driver for the whole fight. ZT2 is out
+                    // (chr data +0x11C is written at death only: 0xE8E4DC <- 0xE8E380 / 0xE8E67C), and
+                    // so is the OWNER_FIGHT_HOLD cap. Another player's hit reaches us as message 0x12
+                    // (0x195C0A0 -> 0x1CD8008, to every member), is applied here once and at once
+                    // (0x17E7B60 -> 0x195C848 -> 0xDE0D60), and our status word shows it on every
+                    // screen. Another game that claims it now has taken it (its copy did not see
+                    // the hit): it is let go at once, so there are never two owners for long.
+                    if (!ord_claim_live) {
+                        mine = true;
+                        log_refusal(chr, 6, fmt::format("kept here: hit {:.1f} s ago, HP {} "
+                                                        "(ours {:.1f} m, other player {:.1f} m)",
+                                                        std::chrono::duration<double>(
+                                                            now - seen.changed).count(),
+                                                        hp, ours, theirs));
+                    }
+                } else if (!mine_now && mine && ord_claim_held && theirs < OWNER_KEEP_AWAKE) {
+                    // The game that drives it still claims it while it is being hit: it holds it
+                    // (the rule above on its side). HPO1: not taken until it lets go (no claim
+                    // for OWNER_FIGHT_CLAIM: its player died, left or went out of range).
+                    if (seen.held == Clock::time_point{}) {
+                        seen.held = now;
+                    }
+                    {
+                        mine = false;
+                        log_refusal(chr, 7, fmt::format("not taken: hit {:.1f} s ago and player "
+                                                        "{} still drives it (ours {:.1f} m, other "
+                                                        "player {:.1f} m)",
+                                                        std::chrono::duration<double>(
+                                                            now - seen.changed).count(),
+                                                        ord_claim_no, ours, theirs));
+                    }
+                } else if (mine == mine_now) {
+                    seen.held = {};
+                }
+            }
+            // v425: our copy of an enemy near our player that is idle here (entry +0x10 not 5)
+            // has a stale state (position, HP, AI): taking it at once makes it jump back to where
+            // our copy was (the "bring_enemy" snap-back, trespasser_flow2 2.2-2.4). Wait up to
+            // OWNER_IDLE_WAIT for it to wake here, then take it as before.
+            if (!mine_now && mine && nearest != 0 && ours < OWNER_KEEP_AWAKE) {
+                const u64 entry = Get<u64>(chr + 0x18);
+                const u32 idle_state =
+                    entry != 0 && Get<u64>(entry) == chr ? Get<u32>(entry + 0x10) : 0; // v425r R2
+                if (idle_state != 5) {
+                    const auto since = enemy_idle_take.try_emplace(chr, now).first->second;
+                    if (now - since < OWNER_IDLE_WAIT) {
+                        mine = false;
+                        log_refusal(chr, 3, fmt::format("not taken yet: idle here (entry +0x10 {}) "
+                                                        "though near (ours {:.1f} m, other "
+                                                        "player {:.1f} m)",
+                                                        idle_state, ours, theirs));
+                    }
+                } else {
+                    enemy_idle_take.erase(chr);
+                }
+            } else if (!enemy_idle_take.empty()) {
+                enemy_idle_take.erase(chr);
+            }
+        } else if (mine_now && !mine && alive) {
+            // (an idle copy here is not kept even in a battle: it would freeze the boss)
+            if (in_fight && copy_awake && !(claim_fresh && local_no != 0 && claim_no < local_no)) {
+                mine = true;
+                log_refusal(chr, 0, fmt::format("kept here: its Trespasser battle is at step {} "
+                                                "(ours {:.1f} m, other player {:.1f} m)",
+                                                fight->second, ours, theirs));
+            } else if (!in_fight && copy_awake && ours < OWNER_KEEP_AWAKE && !claim_fresh) {
+                // (a claim here means the other game took it: its copy is awake, see below)
+                mine = true;
+                log_refusal(chr, 1, fmt::format("kept here: awake here and nobody else drives "
+                                                "it (ours {:.1f} m, other player {:.1f} m)",
+                                                ours, theirs));
+            }
+        } else if (mine_now && mine && lower_active) {
+            // review8: both games drive it (e.g. our game saw no battle yet and took it while the
+            // other kept it for its battle). The existing tie break only works within the 3 m
+            // margin; here the higher number lets go after 2 s and does not take it back while
+            // the lower one keeps claiming it.
+            contested = true;
+            const auto held = boss_contested.try_emplace(chr, now).first;
+            if (now - held->second >= OWNER_BOSS_YIELD) { // HPO2 (was 2 s of two drivers)
+                mine = false;
+                boss_yielded.insert(chr);
+                log_refusal(chr, 4, fmt::format("let go: player {} drives it too (ours {:.1f} m, "
+                                                "other player {:.1f} m)",
+                                                claim_no, ours, theirs));
+            }
+        } else if (!mine_now && mine && claim_fresh &&
+                   (in_fight || !copy_awake || boss_yielded.contains(chr))) {
+            mine = false;
+            if (boss_yielded.contains(chr)) {
+                log_refusal(chr, 5, fmt::format("not taken: given up to player {} who drives "
+                                                "it too", claim_no));
+            } else if (in_fight) {
+                log_refusal(chr, 2, fmt::format("not taken: player {} drives its Trespasser "
+                                                "battle (step {})",
+                                                claim_no, fight->second));
+            } else {
+                log_refusal(chr, 3, fmt::format("not taken: idle here (entry +0x10 {}) while "
+                                                "player {} drives it (ours {:.1f} m)",
+                                                copy_state, claim_no, ours));
+            }
+        }
+        if (trespasser && !contested) {
+            boss_contested.erase(chr);
+        }
+        if (mine && !mine_now) {
+            // HPO3 (hp_owner, hypothesis H1): on a copy the status word sets only the working HP
+            // (P+0x10) while P+8 != 0; the master (P+0x40) keeps the value from when this game
+            // last drove it. Taking it with that stale master put the boss back to (near) full
+            // on every screen. Seed the master from the copy's working value first.
+            const u64 mods = Get<u64>(chr + CHR_MODULES);
+            const u64 dmod = mods != 0 ? Get<u64>(mods + MODULE_DATA) : 0;
+            const u64 prop = dmod != 0 && Get<u64>(dmod + 8) == chr ? Get<u64>(dmod + HP_PROP) : 0;
+            if (prop != 0) {
+                const s32 working = Get<s32>(prop + HP_PROP_WORKING);
+                const s32 master = Get<s32>(prop + HP_PROP_MASTER);
+                const s32 shown = Get<s32>(dmod + DATA_HP);
+                if (working > 0 && working == shown && master > working &&
+                    master <= Get<s32>(dmod + DATA_MAX_HP)) {
+                    Put<s32>(prop + HP_PROP_MASTER, working);
+                    Log(fmt::format("enemies: chr {:#x} taken: master HP {} was stale, set to the "
+                                    "copy's {} first (HPO3)",
+                                    chr, master, working));
+                }
+            }
+        }
+        if (mine != mine_now) {
+            Put<s16>(flag, mine ? s16{1} : s16{-1});
+        }
+        if (trespasser) {
+            // PARTSYNC: this game's max HP of the boss goes into the participant report (logs and
+            // the reapply check only; nothing is written).
+            const u64 mods = Get<u64>(chr + CHR_MODULES);
+            const u64 dmod = mods != 0 ? Get<u64>(mods + MODULE_DATA) : 0;
+            if (dmod != 0 && Get<u64>(dmod + 8) == chr) {
+                part_boss_max[fight->first] = Get<s32>(dmod + DATA_MAX_HP);
+            }
+        }
+        // v426: strong enemies' max HP (see ENEMY_MAX_TYPE). ZT1 (diag/net/zt_faults/FINDINGS.md 1):
+        // each game scales a strong enemy's max HP its own way (one Trespasser: 9474 on the host,
+        // 7579 on both guests), and v426 took the CURRENT driver's value, so at every hand-over of
+        // the driver every screen's bar fraction jumped by up to 25 %. Now one value per enemy: the
+        // authority's game sends the max of every strong enemy it has (a driver still sends its own,
+        // the fallback while no authority is heard); the receive keeps the lowest-numbered sender,
+        // and every game but the authority writes that value, its driver included.
+        const bool max_send = max_pass && (mine || authority);
+        if (max_send || (!authority && !enemy_max_heard.empty())) {
+            const auto heard =
+                authority ? enemy_max_heard.end() : enemy_max_heard.find(static_cast<u16>(id));
+            if (max_send || heard != enemy_max_heard.end()) {
+                const u64 mods = Get<u64>(chr + CHR_MODULES);
+                const u64 dmod = mods != 0 ? Get<u64>(mods + MODULE_DATA) : 0;
+                const bool dmod_ok = dmod != 0 && Get<u64>(dmod + 8) == chr;
+                const s32 max_here = dmod_ok ? Get<s32>(dmod + DATA_MAX_HP) : 0;
+                const u32 handle = Get<u32>(chr + 8);
+                if (max_send && dmod_ok && max_here >= ENEMY_MAX_MIN &&
+                    max_out.size() < ENEMY_MAX_MAX) {
+                    max_out.push_back({static_cast<u16>(id), 0, handle, max_here});
+                }
+                if (heard != enemy_max_heard.end() && heard->second.no != local_no && dmod_ok &&
+                    now - heard->second.at < 3s && heard->second.handle == handle &&
+                    heard->second.max != max_here && Get<s32>(dmod + DATA_HP) > 0) {
+                    // HPO4 (hp_owner C): no write. In a Trespasser battle the max is base x the
+                    // MultiPlayCorrectionParam SpEffect of THIS game's participant count (0x101B6E0:
+                    // ins+0x2B0 entries -> NpcParam +0x20C row, field 0x24 + 4 (n-1): 7251 x1, 7252
+                    // x1.545 ...), re-applied by the game: the ZT1 write fought it 40 times in 10 s
+                    // (match 2) and the ZT1b HP write moved HP with it. The cause is a participant
+                    // list that differs per game; the difference is logged once per enemy and match.
+                    if (enemy_max_logged.insert((u64{match_gen} << 32) | id).second) {
+                        Log(fmt::format("enemies: chr {:#x} max HP {} here, {} on player {}'s game "
+                                        "({}; not written, HPO4: compare the participant lists, "
+                                        "diag/twin/trespassers.py)",
+                                        chr, max_here, heard->second.max, heard->second.no,
+                                        mine ? "we drive it" : "its copy here"));
+                    }
+                }
+            }
+        }
+        if (mine) {
+            ++owned;
+            // A Trespasser is always claimed, so the other games see who drives it.
+            if (((nearest != 0 && theirs < ours + OWNER_CONTEST) || trespasser) &&
+                claims.size() < OWNER_CLAIMS_MAX) {
+                claims.push_back(static_cast<u16>(id));
+            }
+        }
+    }
+    if (max_pass && !max_out.empty() && local_no != 0) {
+        // v426: max HP of the strong enemies this game drives, ENEMY_MAX_PER_PACKET per packet.
+        for (size_t start = 0; start < max_out.size(); start += ENEMY_MAX_PER_PACKET) {
+            const size_t part = std::min(ENEMY_MAX_PER_PACKET, max_out.size() - start);
+            EnemyMaxMessage head;
+            head.player_no = static_cast<u8>(local_no);
+            head.count = static_cast<u16>(part);
+            head.instance = instance;
+            std::vector<u8> bytes(sizeof(head) + part * sizeof(EnemyMaxEntry));
+            std::memcpy(bytes.data(), &head, sizeof(head));
+            std::memcpy(bytes.data() + sizeof(head), max_out.data() + start,
+                        part * sizeof(EnemyMaxEntry));
+            Network::LanSide::Send(bytes);
+        }
+    }
+    if (!claims.empty() && local_no != 0) {
+        // v3.9.5 F6: one packet per OWNER_CLAIMS_PER_PACKET claims (one packet, as before, up to
+        // 500); the receiver takes each packet on its own.
+        for (size_t start = 0; start < claims.size(); start += OWNER_CLAIMS_PER_PACKET) {
+            const size_t part = std::min(OWNER_CLAIMS_PER_PACKET, claims.size() - start);
+            OwnerMessage head;
+            head.player_no = static_cast<u8>(local_no);
+            head.count = static_cast<u16>(part);
+            head.instance = instance;
+            std::vector<u8> bytes(sizeof(head) + part * sizeof(u16));
+            std::memcpy(bytes.data(), &head, sizeof(head));
+            std::memcpy(bytes.data() + sizeof(head), claims.data() + start, part * sizeof(u16));
+            Network::LanSide::Send(bytes);
+        }
+        if (claims.size() > OWNER_CLAIMS_PER_PACKET && owner_split_gen != match_gen) {
+            owner_split_gen = match_gen;
+            const size_t packets =
+                (claims.size() + OWNER_CLAIMS_PER_PACKET - 1) / OWNER_CLAIMS_PER_PACKET;
+            Log(fmt::format("enemies: {} claims this pass, sent in {} packets (F6; once per match)",
+                            claims.size(), packets));
+        }
+    }
+    if (owned != enemies_owned && now - owners_logged >= 10s) {
+        owners_logged = now;
+        enemies_owned = owned;
+        Log(fmt::format("enemies: this game drives {} of {} ({} other player(s) here)", owned,
+                        enemy_list.size(), others));
+    }
+}
