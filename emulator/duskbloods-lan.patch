+// The certificate as PEM, which the TLS library reads (players get ca.der or ca.pem)
+std::string CaPem(const std::string& path) {
+    if (path.empty()) {
+        return {};
+    }
+    std::ifstream file(std::filesystem::path{Common::FS::ToU8String(path)}, std::ios::binary);
+    std::string data{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+    if (data.size() > 64 * 1024) {
+        return {};
+    }
+    if (data.empty() || data.find("-----BEGIN CERTIFICATE-----") != std::string::npos) {
+        return data;
+    }
+    static constexpr char Digits[] =
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string pem = "-----BEGIN CERTIFICATE-----\n";
+    for (size_t i = 0, column = 0; i < data.size(); i += 3) {
+        const u32 chunk = (static_cast<u8>(data[i]) << 16) |
+                          (i + 1 < data.size() ? static_cast<u8>(data[i + 1]) << 8 : 0) |
+                          (i + 2 < data.size() ? static_cast<u8>(data[i + 2]) : 0);
+        pem += Digits[(chunk >> 18) & 63];
+        pem += Digits[(chunk >> 12) & 63];
+        pem += i + 1 < data.size() ? Digits[(chunk >> 6) & 63] : '=';
+        pem += i + 2 < data.size() ? Digits[chunk & 63] : '=';
+        if ((column += 4) == 64 || i + 3 >= data.size()) {
+            pem += '\n';
+            column = 0;
+        }
+    }
+    return pem + "-----END CERTIFICATE-----\n";
+}
+
+std::vector<FriendEntry> Entries(const nlohmann::json& view, const char* key) {
+    std::vector<FriendEntry> out;
+    if (!view.contains(key) || !view[key].is_array()) {
+        return out;
+    }
+    for (const auto& item : view[key]) {
+        if (!item.is_object()) {
+            continue;
+        }
+        FriendEntry entry;
+        entry.code = item.value("code", std::string{});
+        entry.name = item.value("name", std::string{});
+        entry.online = item.value("online", false);
+        if (entry.code.size() == 12) {
+            out.push_back(std::move(entry));
+        }
+    }
+    return out;
+}
+
+// "name[:port]" or "a.b.c.d[:port]", as online play reads it: the friends API is on port + 1
+bool ApiAddress(const std::string& server, std::string& host, int& port) {
+    host = server;
+    unsigned online_port = 443;
+    if (const size_t colon = host.rfind(':'); colon != std::string::npos) {
+        online_port = static_cast<unsigned>(std::strtoul(host.c_str() + colon + 1, nullptr, 10));
+        host.resize(colon);
+    }
+    port = static_cast<int>(online_port + 1);
+    return !host.empty() && online_port != 0 && online_port < 65535;
+}
+
+FriendLists Call(const Profile& profile, const std::string& ca, const std::string& path,
+                 const std::string* body) {
+    FriendLists out;
+    std::string host;
+    int port = 0;
+    if (!ApiAddress(profile.server, host, port)) {
+        out.error = "the server address isn't name:port";
+        return out;
+    }
+    const std::string pem = CaPem(ca.empty() ? ServerCa() : ca);
+    if (pem.empty()) {
+        out.error = "the server's certificate isn't set";
+        return out;
+    }
+    httplib::SSLClient client(host, port);
+    client.set_connection_timeout(5);
+    client.set_read_timeout(10);
+    client.set_write_timeout(10);
+    client.load_ca_cert_store(pem.data(), pem.size());
+    client.enable_server_certificate_verification(true);
+    // The certificate names Nintendo's hosts (the ones games connect to), not this address: the
+    // server's own CA, the only one trusted here, is the check
+    client.enable_server_hostname_verification(false);
+    const httplib::Headers headers{{"X-Droplet-Code", profile.code}, {"X-Droplet-Secret", profile.secret}};
+    const auto result = body ? client.Post(path, headers, *body, "application/json")
+                             : client.Get(path, headers);
+    if (!result) {
+        out.error = "couldn't reach the server's friend list (" + httplib::to_string(result.error()) + ")";
+        return out;
+    }
+    const auto view = nlohmann::json::parse(result->body, nullptr, false);
+    if (view.is_discarded() || !view.is_object()) {
+        out.error = result->status == 404 ? "this server has no friend requests (an older server)"
+                                           : "the server's answer wasn't readable";
+        return out;
+    }
+    out.reached = true;
+    // A field of another type throws, which would end the program from the settings page's thread
+    try {
+        if (result->status != 200) {
+            out.error = view.value("error", std::string{"the server refused"});
+            return out;
+        }
+        out.friends = Entries(view, "friends");
+        out.received = Entries(view, "received");
+        out.sent = Entries(view, "sent");
+    } catch (const nlohmann::json::exception&) {
+        out = {};
+        out.error = "the server's answer wasn't readable";
+    }
+    return out;
+}
+
+} // namespace
+
+std::string FetchServerCa(const std::string& server) {
+    std::string host;
+    int port = 0;
+    if (!ApiAddress(server, host, port)) {
+        return "the server address isn't name:port";
+    }
+    httplib::SSLClient client(host, port);
+    client.set_connection_timeout(3);
+    client.set_read_timeout(5);
+    client.enable_server_certificate_verification(false);
+    const auto result = client.Get("/v1/ca.der");
+    if (!result) {
+        return "the server didn't answer on port " + std::to_string(port) + " (" +
+               httplib::to_string(result.error()) + ")";
+    }
+    const std::string& der = result->body;
+    // A DER certificate: an X.509 SEQUENCE of a few hundred bytes to a few kilobytes
+    if (result->status != 200 || der.size() < 64 || der.size() > 16 * 1024 ||
+        static_cast<u8>(der[0]) != 0x30) {
+        return result->status == 404 ? "this server doesn't hand out its certificate (an older server)"
+                                     : "the server's answer wasn't a certificate";
+    }
+    const auto path = SavedServerCa(server);
+    std::error_code ec;
+    std::filesystem::create_directories(path.parent_path(), ec);
+    const auto part = std::filesystem::path{path}.concat(".part");
+    {
+        std::ofstream out(part, std::ios::binary | std::ios::trunc);
+        if (!out.write(der.data(), static_cast<std::streamsize>(der.size()))) {
+            return "couldn't save the certificate in " + Common::FS::PathToUTF8String(path.parent_path());
+        }
+    }
+    std::filesystem::rename(part, path, ec);
+    if (ec) {
+        return "couldn't save the certificate in " + Common::FS::PathToUTF8String(path.parent_path());
+    }
+    return {};
+}
+
+FriendLists FetchFriends(const Profile& profile, const std::string& ca) {
+    return Call(profile, ca, "/v1/friends", nullptr);
+}
+
+FriendLists FriendAction(const Profile& profile, const std::string& action, const std::string& code,
+                         const std::string& ca) {
+    const std::string body = nlohmann::json{{"code", code}}.dump();
+    return Call(profile, ca, "/v1/friends/" + action, &body);
+}
+
+} // namespace Service::Sockets::OnlineRedirect
diff --git a/src/core/hle/service/sockets/online_friends.h b/src/core/hle/service/sockets/online_friends.h
new file mode 100644
index 0000000000..0f51b733e7
--- /dev/null
+++ b/src/core/hle/service/sockets/online_friends.h
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: Copyright 2026 Droplet
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "core/hle/service/sockets/online_profile.h"
+
+// Friend requests on a private online server: Reservoir's friends API, HTTPS on the online-play
+// port + 1. Only the server's certificate is trusted there, as in a game's sign-in, and the
+// profile's friend code and secret sign each call. The same port hands out that certificate, so
+// players don't need to fetch it themselves. The calls block (a few seconds at most), so the
+// settings page makes them off its thread.
+namespace Service::Sockets::OnlineRedirect {
+
+struct FriendEntry {
+    std::string code;
+    std::string name; // the player's name in the game, as the server last saw it
+    bool online = false;
+};
+
+struct FriendLists {
+    std::vector<FriendEntry> friends;
+    std::vector<FriendEntry> received; // requests to this player, newest first
+    std::vector<FriendEntry> sent;     // requests this player sent that aren't answered yet
+    std::string error;                 // why the server didn't answer, or refused the action
+    bool reached = false;              // the server answered (an error then is its refusal)
+};
+
+// Gets the server's certificate from the server and keeps it (SavedServerCa), for games and for
+// the calls below: an empty string, or why not. Nothing vouches for this first download (the
+// certificate is what would); after it, the kept certificate is the check, as with SSH.
+std::string FetchServerCa(const std::string& server);
+
+// The player's friends and requests. `ca` is the server's certificate (DER or PEM file); empty
+// takes the one online play uses.
+FriendLists FetchFriends(const Profile& profile, const std::string& ca = {});
+// "request", "accept", "decline", "cancel" or "remove" for `code`; the lists as they are after.
+FriendLists FriendAction(const Profile& profile, const std::string& action, const std::string& code,
+                         const std::string& ca = {});
+
+} // namespace Service::Sockets::OnlineRedirect
diff --git a/src/core/hle/service/sockets/online_profile.cpp b/src/core/hle/service/sockets/online_profile.cpp
new file mode 100644
index 0000000000..0328c9228e
--- /dev/null
+++ b/src/core/hle/service/sockets/online_profile.cpp
@@ -0,0 +1,294 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <random>
+#include <sstream>
+
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "core/hle/service/sockets/online_profile.h"
+
+namespace Service::Sockets::OnlineRedirect {
+
+namespace {
+
+std::mutex profile_mutex;
+
+std::string ProfileKey(const std::string& server) {
+    std::string key;
+    for (const char ch : server) {
+        const char lower = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+        key += (std::isalnum(static_cast<unsigned char>(lower)) || lower == '.' || lower == '-')
+                   ? lower
+                   : '_';
+    }
+    return key.empty() ? "default" : key;
+}
+
+std::filesystem::path ProfilePath(const std::string& server) {
+    return ProfilesDir() / (ProfileKey(server) + ".txt");
+}
+
+} // namespace
+
+std::filesystem::path SavedServerCa(const std::string& server) {
+    return ProfilesDir() / (ProfileKey(server) + ".ca.der");
+}
+
+namespace {
+
+std::string NewCode() {
+    std::random_device device;
+    std::uniform_int_distribution<unsigned long long> digits(1, 999'999'999'999ULL);
+    char code[16];
+    std::snprintf(code, sizeof(code), "%012llu", digits(device));
+    return code;
+}
+
+std::string JoinCodes(const std::vector<std::string>& codes) {
+    std::string out;
+    for (const std::string& code : codes) {
+        out += (out.empty() ? "" : ",") + code;
+    }
+    return out;
+}
+
+bool HasProfiles() {
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(ProfilesDir(), ec)) {
+        if (entry.path().extension() == ".txt") {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Before profiles, each emulator folder had one friend code for every server
+std::optional<Profile> LegacyIdentity(const std::string& server) {
+    std::ifstream in(Common::FS::GetEdenPath(Common::FS::EdenPath::EdenDir) / "online" / "identity.txt");
+    std::stringstream text;
+    text << in.rdbuf();
+    auto profile = ParseProfile(text.str());
+    if (!profile) {
+        return std::nullopt;
+    }
+    profile->server = server;
+    for (const std::string& code : ParseCodes(Settings::values.online_friends.GetValue())) {
+        AddFriend(*profile, code);
+    }
+    return profile;
+}
+
+// <base>/<name>/profiles. Profiles from before the rename to Droplet (<base>/<old_name>) move
+// there the first time.
+std::filesystem::path UserProfilesDir(const std::filesystem::path& base, const char* old_name,
+                                      const char* name) {
+    const auto dir = base / name / "profiles";
+    static std::once_flag moved;
+    std::call_once(moved, [&] {
+        const auto old_dir = base / old_name / "profiles";
+        std::error_code ec;
+        if (std::filesystem::exists(dir, ec) || !std::filesystem::is_directory(old_dir, ec)) {
+            return;
+        }
+        std::filesystem::create_directories(dir.parent_path(), ec);
+        std::filesystem::rename(old_dir, dir, ec);
+        if (ec) {
+            ec.clear();
+            std::filesystem::copy(old_dir, dir, std::filesystem::copy_options::recursive, ec);
+        }
+        if (ec) {
+            LOG_ERROR(Network, "Online: could not move the profiles in {} to {}: {}",
+                      old_dir.string(), dir.string(), ec.message());
+        } else {
+            LOG_INFO(Network, "Online: moved the profiles in {} to {}", old_dir.string(), dir.string());
+        }
+    });
+    return dir;
+}
+
+} // namespace
+
+std::filesystem::path ProfilesDir() {
+    if (const char* dir = std::getenv("EDEN_NX2_ONLINE_PROFILES"); dir != nullptr && *dir != '\0') {
+        return std::filesystem::path{dir};
+    }
+#ifdef _WIN32
+    if (const wchar_t* appdata = _wgetenv(L"APPDATA"); appdata != nullptr && *appdata != L'\0') {
+        return UserProfilesDir(std::filesystem::path{appdata}, "Ounce2dn-online", "Droplet-online");
+    }
+#else
+    if (const char* data = std::getenv("XDG_DATA_HOME"); data != nullptr && *data == '/') {
+        return UserProfilesDir(std::filesystem::path{data}, "ounce2dn-online", "droplet-online");
+    }
+    if (const char* home = std::getenv("HOME"); home != nullptr && *home != '\0') {
+        return UserProfilesDir(std::filesystem::path{home} / ".local" / "share", "ounce2dn-online",
+                               "droplet-online");
+    }
+#endif
+    return Common::FS::GetEdenPath(Common::FS::EdenPath::EdenDir) / "online" / "profiles";
+}
+
+std::optional<Profile> LoadProfile(const std::string& server, bool create) {
+    std::scoped_lock lock{profile_mutex};
+    std::ifstream in(ProfilePath(server));
+    if (in) {
+        std::stringstream text;
+        text << in.rdbuf();
+        if (auto profile = ParseProfile(text.str())) {
+            profile->server = server;
+            return profile;
+        }
+        LOG_ERROR(Network, "Online: {} is damaged; making a new friend code",
+                  ProfilePath(server).string());
+    }
+    std::optional<Profile> profile;
+    if (!HasProfiles()) {
+        profile = LegacyIdentity(server);
+    }
+    if (!create) {
+        return profile; // the friend code the first sign-in will keep, if there is one
+    }
+    if (!profile) {
+        profile = Profile{server, NewCode(), NewSecret(), {}, {}};
+    }
+    std::error_code ec;
+    std::filesystem::create_directories(ProfilesDir(), ec);
+    const auto path = ProfilePath(server);
+    std::ofstream out(path, std::ios::trunc);
+    out << ProfileText(*profile);
+    out.close();
+    if (!out) {
+        LOG_ERROR(Network, "Online: could not save the friend code to {}", path.string());
+    }
+    std::filesystem::permissions(path, std::filesystem::perms::owner_read |
+                                           std::filesystem::perms::owner_write, ec);
+    return profile;
+}
+
+bool SaveProfile(const Profile& profile) {
+    std::scoped_lock lock{profile_mutex};
+    std::error_code ec;
+    std::filesystem::create_directories(ProfilesDir(), ec);
+    const auto path = ProfilePath(profile.server);
+    auto temp = path;
+    temp += ".new";
+    {
+        std::ofstream out(temp, std::ios::trunc);
+        out << ProfileText(profile);
+        if (!out) {
+            LOG_ERROR(Network, "Online: could not save {}", path.string());
+            return false;
+        }
+    }
+    std::filesystem::permissions(temp, std::filesystem::perms::owner_read |
+                                           std::filesystem::perms::owner_write, ec);
+    std::filesystem::rename(temp, path, ec);
+    if (ec) {
+        LOG_ERROR(Network, "Online: could not save {}: {}", path.string(), ec.message());
+        return false;
+    }
+    return true;
+}
+
+std::string ProfileText(const Profile& profile) {
+    return "server=" + profile.server + "\ncode=" + profile.code + "\nsecret=" + profile.secret +
+           "\nfriends=" + JoinCodes(profile.friends) + "\nremoved=" + JoinCodes(profile.removed) +
+           "\n";
+}
+
+std::optional<Profile> ParseProfile(std::string_view text) {
+    Profile profile;
+    while (!text.empty()) {
+        const size_t end = text.find('\n');
+        std::string_view line = text.substr(0, end);
+        text = end == std::string_view::npos ? std::string_view{} : text.substr(end + 1);
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) {
+            line.remove_suffix(1);
+        }
+        const size_t equals = line.find('=');
+        if (equals == std::string_view::npos) {
+            continue;
+        }
+        const std::string_view key = line.substr(0, equals), value = line.substr(equals + 1);
+        if (key == "server") {
+            profile.server = value;
+        } else if (key == "code") {
+            profile.code = value;
+        } else if (key == "secret") {
+            profile.secret = value;
+        } else if (key == "friends") {
+            profile.friends = ParseCodes(value);
+        } else if (key == "removed") {
+            profile.removed = ParseCodes(value);
+        }
+    }
+    const auto codes = ParseCodes(profile.code);
+    if (codes.size() != 1 || profile.secret.size() < 16) {
+        return std::nullopt;
+    }
+    profile.code = codes.front();
+    return profile;
+}
+
+std::string NewSecret() {
+    std::random_device device;
+    char secret[40];
+    std::snprintf(secret, sizeof(secret), "%08x%08x%08x%08x", device(), device(), device(),
+                  device());
+    return secret;
+}
+
+std::vector<std::string> ParseCodes(std::string_view text) {
+    std::vector<std::string> codes;
+    std::string digits;
+    const auto flush = [&] {
+        if (digits.size() == 12 && digits != "000000000000" &&
+            std::find(codes.begin(), codes.end(), digits) == codes.end()) {
+            codes.push_back(digits);
+        }
+        digits.clear();
+    };
+    for (const char ch : text) {
+        if (ch >= '0' && ch <= '9') {
+            digits += ch;
+        } else if (ch == ',' || ch == ';' || ch == '\n' || std::isalpha(static_cast<unsigned char>(ch))) {
+            // A letter starts the next code: "SW-1234-5678-9012 SW-2345-6789-0123"
+            flush();
+        }
+    }
+    flush();
+    return codes;
+}
+
+std::string FormatCode(const std::string& code) {
+    return code.size() == 12
+               ? "SW-" + code.substr(0, 4) + '-' + code.substr(4, 4) + '-' + code.substr(8)
+               : code;
+}
+
+void AddFriend(Profile& profile, const std::string& code) {
+    if (code == profile.code) {
+        return;
+    }
+    std::erase(profile.removed, code);
+    if (std::find(profile.friends.begin(), profile.friends.end(), code) == profile.friends.end()) {
+        profile.friends.push_back(code);
+    }
+}
+
+void RemoveFriend(Profile& profile, const std::string& code) {
+    std::erase(profile.friends, code);
+    if (std::find(profile.removed.begin(), profile.removed.end(), code) == profile.removed.end()) {
+        profile.removed.push_back(code);
+    }
+}
+
+} // namespace Service::Sockets::OnlineRedirect
diff --git a/src/core/hle/service/sockets/online_profile.h b/src/core/hle/service/sockets/online_profile.h
new file mode 100644
index 0000000000..19416b1f26
--- /dev/null
+++ b/src/core/hle/service/sockets/online_profile.h
@@ -0,0 +1,53 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Who this emulator is on each private online server: a friend code, the secret the server ties
+// it to, and the friend codes added there. One profile per server, so no server learns the secret
+// another server knows. Profiles live in the OS user's data folder, not the emulator's, so a new
+// emulator version or folder keeps them: %APPDATA%\Droplet-online\profiles on Windows, else
+// $XDG_DATA_HOME (or ~/.local/share)/droplet-online/profiles (the Ounce2dn-online folders of
+// builds before the rename move there). EDEN_NX2_ONLINE_PROFILES moves them (test instances each
+// keep their own).
+namespace Service::Sockets::OnlineRedirect {
+
+struct Profile {
+    std::string server;               // as entered, e.g. "raiders.example.org:8443"
+    std::string code;                 // 12 digits, never all zeros
+    std::string secret;               // 32 hex digits
+    std::vector<std::string> friends; // codes added on this server
+    std::vector<std::string> removed; // codes removed since, so the server forgets them too
+};
+
+std::filesystem::path ProfilesDir();
+// The certificate Droplet got from this server (online_friends.cpp), next to its profile.
+std::filesystem::path SavedServerCa(const std::string& server);
+
+// This server's profile. When it has none: nullopt, or with `create` a new one. The first profile
+// takes over the friend code that emulator folders had before profiles (<data folder>/online/
+// identity.txt) and the friends' codes from the old setting; until then, that is what a load
+// without `create` returns.
+std::optional<Profile> LoadProfile(const std::string& server, bool create);
+bool SaveProfile(const Profile& profile);
+
+// A profile as text (its file, and the backup players keep) and back.
+std::string ProfileText(const Profile& profile);
+std::optional<Profile> ParseProfile(std::string_view text);
+
+std::string NewSecret();
+// 12-digit codes in text ("SW-1234-5678-9012, 2345 6789 0123"), in order, without duplicates.
+std::vector<std::string> ParseCodes(std::string_view text);
+// "SW-1234-5678-9012", as a Switch shows friend codes.
+std::string FormatCode(const std::string& code);
+
+void AddFriend(Profile& profile, const std::string& code);
+void RemoveFriend(Profile& profile, const std::string& code);
+
+} // namespace Service::Sockets::OnlineRedirect
diff --git a/src/core/hle/service/sockets/online_redirect.h b/src/core/hle/service/sockets/online_redirect.h
new file mode 100644
index 0000000000..ae12da667e
--- /dev/null
+++ b/src/core/hle/service/sockets/online_redirect.h
@@ -0,0 +1,266 @@
+// SPDX-FileCopyrightText: Copyright 2026 Droplet
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <variant>
+#include <vector>
+
+#include "common/common_types.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "core/hle/service/sockets/online_profile.h"
+#include "core/internal_network/network.h"
+
+// Droplet's private online server (Reservoir). Off unless a server is set, in the emulator's
+// settings (Network: online_server, online_server_ca) or, overriding them, the environment:
+//   EDEN_NX2_ONLINE_SERVER=<ipv4>[:<port>]  resolve the redirected host names to <ipv4>, and send
+//       connections to <ipv4>:443 to <port> (an unprivileged port on the host). While it is set,
+//       no other host name resolves, and connections may only go to loopback, private (RFC 1918)
+//       and link-local addresses, so nothing reaches Nintendo or any other public server.
+//   EDEN_NX2_ONLINE_HOSTS=<suffix>,...  host names (and their subdomains) to redirect. The default
+//       is Nintendo's NPLN hosts, Pia's NAT check servers (nncs1/nncs2) and Pia's monitoring
+//       server (connection-quality reports, UDP 34343; g<id>.<env>.p.srv.nintendo.net).
+//   EDEN_NX2_ONLINE_CA=<file>  DER or PEM certificate that the ssl service hands out as the
+//       system's built-in CA (see ssl/cert_store.cpp), so the game trusts the private server.
+//       Without one, the certificate Droplet got from the server before (online_friends.cpp) is
+//       used, else <data folder>/online/ca.der (or ca.pem); without any, the ssl service gets it
+//       from the server when a game first goes online.
+//   EDEN_NX2_ONLINE_FRIENDS=<code>,...  friend codes to add for this run (scripts and tests).
+// Each server gets its own friend code, secret and friend list (online_profile.h), sent to the
+// server as the account's ID token at login.
+namespace Service::Sockets::OnlineRedirect {
+
+constexpr std::string_view DefaultHosts =
+    "npln.srv.nintendo.net,npln.nintendo.net,n.n.srv.nintendo.net,p.srv.nintendo.net";
+
+// How often a game tried to go online while online play was off (nifm reported no internet, or a
+// server name was refused). The windowed app tells the player where to turn it on.
+inline std::atomic<u32> online_off_attempts{0};
+
+inline void NoteOnlineOffAttempt() {
+    if (online_off_attempts.fetch_add(1, std::memory_order_relaxed) == 0) {
+        LOG_WARNING(Network, "A game tried to go online, but online play is off: turn on \"Play "
+                             "online on a private server\" in Configure > System > Network");
+    }
+}
+
+// How often a game set up a secure connection with a server set but without its certificate,
+// which Droplet couldn't get from the server either (ssl/cert_store.cpp): the game can't trust
+// the server and stops with an error (Mario Kart World: 2321-4992). The windowed app tells the
+// player what to check.
+inline std::atomic<u32> missing_ca_attempts{0};
+
+inline void NoteMissingCaAttempt() {
+    if (missing_ca_attempts.fetch_add(1, std::memory_order_relaxed) == 0) {
+        LOG_WARNING(Network, "A game tried to go online, but Droplet couldn't get the server's "
+                             "certificate: check the server address, or pick the certificate "
+                             "(ca.der, from the server's status page) in Multiplayer > Online Play "
+                             "Settings");
+    }
+}
+
+struct Config {
+    bool enabled = false;
+    std::array<u8, 4> ip{};
+    u16 port = 443;
+    std::vector<std::string> suffixes;
+};
+
+// The environment wins over the emulator's settings (scripts and tests).
+inline std::string FromEnvOr(const char* name, const std::string& setting) {
+    const char* value = std::getenv(name);
+    return value != nullptr && *value != '\0' ? std::string{value} : setting;
+}
+
+inline std::string ServerAddress() {
+    return FromEnvOr("EDEN_NX2_ONLINE_SERVER", Settings::values.online_enabled.GetValue()
+                                                   ? Settings::values.online_server.GetValue()
+                                                   : std::string());
+}
+
+inline std::filesystem::path OnlineDir() {
+    return Common::FS::GetEdenPath(Common::FS::EdenPath::EdenDir) / "online";
+}
+
+inline std::string ServerCa() {
+    // Found whether online play is on or not: the certificate store is made when a game starts,
+    // and turning online play on mid-game must find the server's certificate there.
+    std::string path = FromEnvOr("EDEN_NX2_ONLINE_CA", Settings::values.online_server_ca.GetValue());
+    if (path.empty()) {
+        const std::string server =
+            FromEnvOr("EDEN_NX2_ONLINE_SERVER", Settings::values.online_server.GetValue());
+        std::vector<std::filesystem::path> found{OnlineDir() / "ca.der", OnlineDir() / "ca.pem"};
+        if (!server.empty()) {
+            found.insert(found.begin(), SavedServerCa(server));
+        }
+        for (const auto& file : found) {
+            std::error_code ec;
+            if (std::filesystem::exists(file, ec)) {
+                return Common::FS::PathToUTF8String(file);
+            }
+        }
+    }
+    return path;
+}
+
+// The account's ID token while a server is set: this server's profile (friend code, secret, the
+// codes added and removed) and the running game's build, read by the server at sign-in
+// (npln_stub.py, parse_identity). Servers keep friendships across sign-ins and only drop the
+// removed codes; the build (the main module's build ID in hex) is the game's exact version.
+inline std::string IdentityToken(std::string_view build = {}) {
+    const std::string server = ServerAddress();
+    const auto profile = server.empty() ? std::nullopt : LoadProfile(server, true);
+    if (!profile) {
+        return {};
+    }
+    std::vector<std::string> friends = profile->friends;
+    if (const char* extra = std::getenv("EDEN_NX2_ONLINE_FRIENDS"); extra != nullptr) {
+        for (const std::string& code : ParseCodes(extra)) {
+            if (code != profile->code &&
+                std::find(friends.begin(), friends.end(), code) == friends.end()) {
+                friends.push_back(code);
+            }
+        }
+    }
+    const auto join = [](const std::vector<std::string>& codes) {
+        std::string out;
+        for (const std::string& code : codes) {
+            out += (out.empty() ? "" : ",") + code;
+        }
+        return out;
+    };
+    std::string token = "ounce2dn-online-v1;code=" + profile->code + ";secret=" + profile->secret;
+    if (!build.empty()) {
+        token += ";build=" + std::string{build};
+    }
+    token += ";friends=" + join(friends);
+    if (!profile->removed.empty()) {
+        token += ";removed=" + join(profile->removed);
+    }
+    return token;
+}
+
+inline Config Parse(const std::string& server_setting) {
+    Config c;
+    const char* server = server_setting.c_str();
+    if (*server == '\0') {
+        return c;
+    }
+    unsigned a = 0, b = 0, d = 0, e = 0, port = 443;
+    const int fields = std::sscanf(server, "%u.%u.%u.%u:%u", &a, &b, &d, &e, &port);
+    if (fields < 4) {
+        // A host name ("raiders.example.org:8443"), looked up once through the host's DNS. Never a
+        // Nintendo name: the redirect would then send the game to Nintendo.
+        std::string name{server};
+        port = 443;
+        if (const size_t colon = name.rfind(':'); colon != std::string::npos) {
+            port = static_cast<unsigned>(std::strtoul(name.c_str() + colon + 1, nullptr, 10));
+            name.resize(colon);
+        }
+        std::string lower = name;
+        for (char& ch : lower) {
+            ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+        }
+        if (name.empty() || port == 0 || port > 65535 || lower.find("nintendo") != std::string::npos) {
+            LOG_CRITICAL(Network, "Online server {} is not <ipv4>[:<port>] or <name>[:<port>]; "
+                                  "online play is off", server);
+            return c;
+        }
+        const auto found = Network::GetAddressInfo(name, std::nullopt);
+        const auto* addresses = std::get_if<std::vector<Network::AddrInfo>>(&found);
+        if (addresses == nullptr || addresses->empty()) {
+            LOG_CRITICAL(Network, "Online server {}: {} has no address; online play is off", server,
+                         name);
+            return c;
+        }
+        const auto& ip = addresses->front().addr.ip;
+        a = ip[0], b = ip[1], d = ip[2], e = ip[3];
+        LOG_INFO(Network, "Online server {} is {}.{}.{}.{}", name, a, b, d, e);
+    } else if (a > 255 || b > 255 || d > 255 || e > 255 || port == 0 || port > 65535) {
+        LOG_CRITICAL(Network, "Online server {} is not <ipv4>[:<port>]; online play is off", server);
+        return c;
+    }
+    c.enabled = true;
+    c.ip = {static_cast<u8>(a), static_cast<u8>(b), static_cast<u8>(d), static_cast<u8>(e)};
+    c.port = static_cast<u16>(port);
+    const char* hosts = std::getenv("EDEN_NX2_ONLINE_HOSTS");
+    std::string_view list =
+        hosts != nullptr && *hosts != '\0' ? std::string_view{hosts} : DefaultHosts;
+    while (!list.empty()) {
+        const size_t comma = list.find(',');
+        const std::string_view item = list.substr(0, comma);
+        if (!item.empty()) {
+            c.suffixes.emplace_back(item);
+        }
+        list = comma == std::string_view::npos ? std::string_view{} : list.substr(comma + 1);
+    }
+    LOG_WARNING(Network, "Online redirect: {} -> {}.{}.{}.{}, port 443 -> {}",
+                hosts ? std::string_view{hosts} : DefaultHosts, a, b, d, e, c.port);
+    if (const auto profile = LoadProfile(server_setting, true)) {
+        LOG_INFO(Network, "Online: your friend code on this server is {}; friends added: {} ({})",
+                 FormatCode(profile->code), profile->friends.size(), ProfilesDir().string());
+    }
+    return c;
+}
+
+// The redirect for the current server setting (read again when it changes between games).
+inline const Config& Get() {
+    static std::mutex mutex;
+    static std::string current = "\x01";
+    static Config config;
+    const std::string server = ServerAddress();
+    std::scoped_lock lock{mutex};
+    if (server != current) {
+        current = server;
+        config = Parse(server);
+    }
+    return config;
+}
+
+inline bool IsRedirectedHost(std::string_view host) {
+    // A resolver may be handed a trailing dot (an absolute name).
+    if (!host.empty() && host.back() == '.') {
+        host.remove_suffix(1);
+    }
+    for (const std::string& suffix : Get().suffixes) {
+        if (host == suffix || (host.size() > suffix.size() && host.ends_with(suffix) &&
+                               host[host.size() - suffix.size() - 1] == '.')) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Destinations a game may connect or send to while the redirect is on.
+// Where a UDP datagram may go in online mode: the TCP rules below plus other players' public
+// addresses, so games reach each other directly over the internet as on a Switch (Pia's peer
+// traffic is UDP). Nintendo stays out by name: only the redirected names resolve, to the server.
+inline bool IsAllowedDestination(const std::array<u8, 4>& ip);
+inline bool IsAllowedPeerDestination(const std::array<u8, 4>& ip) {
+    const bool unicast = ip[0] != 0 && ip[0] != 127 && ip[0] < 224;
+    return unicast || IsAllowedDestination(ip);
+}
+
+inline bool IsAllowedDestination(const std::array<u8, 4>& ip) {
+    const Config& c = Get();
+    // 100.64.0.0/10 is shared address space: mesh VPNs (Tailscale) give each PC one, so friends
+    // in other places reach each other's games through the mesh. Not routable on the internet.
+    return ip == c.ip || ip[0] == 127 || ip[0] == 10 || (ip[0] == 172 && (ip[1] & 0xf0) == 16) ||
+           (ip[0] == 192 && ip[1] == 168) || (ip[0] == 169 && ip[1] == 254) ||
+           (ip[0] == 100 && (ip[1] & 0xc0) == 64) ||
+           ip == std::array<u8, 4>{255, 255, 255, 255} || ip == std::array<u8, 4>{};
+}
+
+} // namespace Service::Sockets::OnlineRedirect
