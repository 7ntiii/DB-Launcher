+
+namespace Core {
+class System;
+}
+
+namespace Core::DuskLan {
+
+/// The Duskbloods network test (0400D1D02399A000) runs its online battles through a dedicated game
+/// server. A LAN session has none, so this host thread drives, once a second, the match steps that
+/// server would drive: the join steps it answers, the player numbers it hands out and the match
+/// phase changes it starts. It pairs with the "Duskbloods LAN (built-in)" patch in
+/// file_sys/patch_manager.cpp and stays idle when that patch is not applied.
+/// LICHII_DUSK_LAN=0 turns it off; LICHII_DUSK_PLAYER=no:team sets this game's player number and team
+/// (otherwise they follow the order of the members' ids). It logs to dusk_lan.txt in the log folder.
+class Assist {
+public:
+    explicit Assist(System& system);
+    ~Assist();
+
+    Assist(const Assist&) = delete;
+    Assist& operator=(const Assist&) = delete;
+
+private:
+    struct State;
+    std::unique_ptr<State> state;
+    /// Declared after state, so it stops before state goes away.
+    std::jthread thread;
+};
+
+/// The assist for The Duskbloods network test unless LICHII_DUSK_LAN=0; null for other titles.
+[[nodiscard]] std::unique_ptr<Assist> MaybeStart(System& system, u64 program_id);
+
+} // namespace Core::DuskLan
