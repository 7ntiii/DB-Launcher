+// Merge note (build-366): upstream grows the pool by program id; our launchers also set
+// EDEN_NX2_APP_POOL_PROBE=<MiB> (1152). The variable still works and overrides the size, and it
+// still turns the growth on for any program, as before.
+const char* Nx2AppPoolProbeEnv() {
+    return std::getenv("EDEN_NX2_APP_POOL_PROBE");
+}
+
+bool Nx2AppPoolGrows() {
+    return g_application_program_id == DuskbloodsNetworkTestProgramId ||
+           Nx2AppPoolProbeEnv() != nullptr;
+}
+
+// Extra application pool beyond the arrangement (remote memory not included), 0 when off.
+size_t Nx2AppPoolProbeSize() {
+    if (const char* probe = Nx2AppPoolProbeEnv(); probe != nullptr) {
+        return static_cast<size_t>(std::strtoull(probe, nullptr, 10)) * 1_MiB;
+    }
+    return g_application_program_id == DuskbloodsNetworkTestProgramId ? DuskbloodsPoolGrowth
+                                                                      : size_t{0};
+}
+
+// Everything the application pool grows by beyond its arrangement.
+size_t Nx2AppPoolGrowth() {
+    if (!Nx2AppPoolGrows()) {
+        return 0;
+    }
+    return Nx2AppPoolProbeSize() + KSystemControl::Nx2RemoteMemorySize();
+}
