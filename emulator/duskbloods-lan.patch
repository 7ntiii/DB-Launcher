+/// Side-channel types 8 (Virtue total) and 9 (Commendation parts): kept here, written into the
+/// game by VirtueShare / CommendShare.
+void Assist::State::SideShare(const Network::LanSide::Packet& packet) {
+    if (packet.data[0] == 8) {
+        VirtueMessage in;
+        if (packet.data.size() != sizeof(in)) {
+            return;
+        }
+        std::memcpy(&in, packet.data.data(), sizeof(in));
+        if (in.instance == instance || in.player_no == 0) {
+            return; // ours, or a sender without a number
+        }
+        // review1b V1: a late packet (lower change count, same game and round, within 3 s) is
+        // older than the total already kept.
+        if (const auto kept = virtue_in.find(in.player_no);
+            kept != virtue_in.end() && kept->second.instance == in.instance &&
+            kept->second.round == in.round && in.count < kept->second.count &&
+            packet.at - kept->second.at < 3s) {
+            return;
+        }
+        // Kept here, written by VirtueShare (every 50 ms, so a value the game changes back is
+        // put in again).
+        virtue_in[in.player_no] = VirtueIn{in.instance, in.round, in.total, packet.at, in.count};
+        return;
+    }
+    CommendMessage head;
+    if (packet.data.size() < sizeof(head)) {
+        return;
+    }
+    std::memcpy(&head, packet.data.data(), sizeof(head));
+    if (head.instance == instance || head.player_no == 0 || head.count > COMMEND_MAX_PARTS ||
+        packet.data.size() != sizeof(head) + head.count * sizeof(CommendPart)) {
+        return;
+    }
+    // Review2 R4c: a game at a result screen (14 / 29 / 36) may still be in the old match (a
+    // culled player, a slower game); its set is not taken. Its last set of this match stays.
+    if (const auto sender = peers.find(head.instance); sender != peers.end()) {
+        const u8 at = sender->second.phase;
+        if (at == 14 || at == 29 || at == 36) {
+            if (commend_result_logged.insert(head.instance).second) {
+                Log(fmt::format("commend: player {} is at result step {}; its sets are not taken "
+                                "(review2 R4c)",
+                                head.player_no, at));
+            }
+            return;
+        }
+    }
+    CommendIn in{head.player_no, head.round, {}};
+    for (size_t i = 0; i < head.count; ++i) {
+        CommendPart part;
+        std::memcpy(&part, packet.data.data() + sizeof(head) + i * sizeof(part), sizeof(part));
+        if (part.no != 0) {
+            in.parts[part.no] = {part.bloodfang, part.collector};
+        }
+    }
+    // The newest set replaces the sender's old one (parts are cumulative); CommendShare adds them
+    // in every 50 ms. Review2 R1: kept by the sender's instance, not its player number.
+    // Review2 R5: within a match a part never goes down (a game that rejoined starts from 0, a late
+    // UDP packet holds an older set): the larger one is kept, per sender and player. A sender whose
+    // round went down is in a new match: its set replaces the old one as it is (R4a).
+    if (const auto old = commend_heard.find(head.instance);
+        old != commend_heard.end() && head.round >= old->second.round) {
+        bool lower = false;
+        for (const auto& [no, value] : old->second.parts) {
+            auto& now_part = in.parts[no];
+            for (size_t k = 0; k < now_part.size(); ++k) {
+                if (now_part[k] < value[k]) {
+                    now_part[k] = value[k];
+                    lower = true;
+                }
+            }
+        }
+        if (lower && commend_lower_logged.insert(head.instance).second) {
+            Log(fmt::format("commend: player {} reported less than before in this match (rejoin or "
+                            "late packet); the larger parts are kept (review2 R5)",
+                            head.player_no));
+        }
+    }
+    commend_heard[head.instance] = std::move(in);
+}
+
+/// v3.9.8 F5 (diag/net/numbering_notes.md): the lobby size without DUSK_MATCH_MIN. The match server
+/// (frontend_api.py) writes "match <id> players <n> time <unix>" to dusk_lan_match.txt next to
+/// dusk_lan_status.json whenever it makes a match; the game on the host PC reads it (every 2 s
+/// until known; a newer match id replaces it; older than 5 min = another evening) and every game
+/// that knows it sends it once a second (type 14), so the others learn it over the P2P links of
+/// the join. PlayerNumber then waits for that many members (as for DUSK_MATCH_MIN).
+void Assist::State::LobbyShare(Clock::time_point now) {
+    if (session.manager == 0) {
+        return;
+    }
+    if (now - session.lobby_read_at >= 2s && !status_path.empty()) {
+        session.lobby_read_at = now;
+        // V403 (lobbysize_notes.md): the file may be in two places. (1) Next to our own status file
+        // (our data folder's log: what the v3.9.4 server writes to %APPDATA%\eden\log, and the rig's).
+        // (2) The package's lan_fix folder next to our Lichii folder (<package>\Lichii\lichii.exe ->
+        // <package>\lan_fix\dusk_lan_match.txt), where lan_fix_host.py lets the host's server write
+        // it: every game started from the host PC's package finds it there, whichever data folder it
+        // uses (a portable Lichii\user, the second player's SecondPlayer\user). The freshest valid
+        // one counts. Guest PCs have neither (or one older than 5 min) and learn it from type 14.
+        std::vector<std::filesystem::path> paths{status_path.parent_path() / "dusk_lan_match.txt"};
+#ifdef _WIN32
+        paths.push_back(Common::FS::GetExeDirectory().parent_path() / "lan_fix" /
+                        "dusk_lan_match.txt");
+#endif
+        struct Found {
+            unsigned match_id = 0;
+            unsigned players = 0;
+            long long age = 0;
+            std::filesystem::path path;
+        };
+        std::optional<Found> best;
+        for (const auto& path : paths) {
+            std::ifstream file{path};
+            if (!file) {
+                continue;
+            }
+            std::string word_match, word_players, word_time;
+            unsigned match_id = 0;
+            unsigned players = 0;
+            long long written = 0;
+            const bool got = static_cast<bool>(file >> word_match >> match_id >> word_players >>
+                                               players >> word_time >> written) &&
+                             word_match == "match" && word_players == "players" &&
+                             word_time == "time";
+            const long long age = static_cast<long long>(std::time(nullptr)) - written;
+            if (got && players >= 2 && players <= 16 && age >= -60 && age <= 300 &&
+                (!best || age < best->age)) {
+                best = Found{match_id, players, age, path};
+            }
+        }
+        if (best && (session.lobby_players == 0 || best->match_id > session.lobby_match)) {
+            session.lobby_players = best->players;
+            session.lobby_match = best->match_id;
+            session.lobby_origin = instance;
+            Log(fmt::format("lobby: the match server put {} games in match {} ({} s ago, read "
+                            "here from {}); numbering waits for {} members (F5)",
+                            best->players, best->match_id, best->age, Common::FS::PathToUTF8String(best->path),
+                            best->players));
+        }
+    }
+    if (session.lobby_players != 0 && now - session.lobby_sent_at >= 1s) {
+        session.lobby_sent_at = now;
+        LobbyMessage out;
+        out.players = static_cast<u8>(session.lobby_players);
+        out.instance = instance;
+        out.match_id = session.lobby_match;
+        out.origin = session.lobby_origin;
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+    }
+    // Learned only after this game took its number from a shorter list: say so once.
+    if (session.lobby_players != 0 && session.no != 0 && !session.lobby_late_logged &&
+        session.match_players < session.lobby_players && match_min == 0) {
+        session.lobby_late_logged = true;
+        Log(fmt::format("!!! lobby: {} games in the match, but our number came from a list of {} "
+                        "(the lobby size came too late): a late joiner may share a number "
+                        "(F5; see DUPLICATE PLAYER NUMBER) !!!",
+                        session.lobby_players, session.match_players));
+    }
+}
+
+/// v3.9.8 F5: side type 14 from another game (taken at once by SideFast).
+void Assist::State::LobbyHeard(const Network::LanSide::Packet& packet) {
+    LobbyMessage in;
+    if (packet.data.size() != sizeof(in) || session.manager == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.players < 2 || in.players > 16) {
+        return;
+    }
+    if (session.lobby_players != 0 && in.match_id <= session.lobby_match) {
+        return; // known already (or an older match)
+    }
+    session.lobby_players = in.players;
+    session.lobby_match = in.match_id;
+    session.lobby_origin = in.origin;
+    Log(fmt::format("lobby: {} games in match {} (heard from game {:#010x}, read on game "
+                    "{:#010x}); numbering waits for {} members (F5)",
+                    in.players, in.match_id, in.instance, in.origin, in.players));
+}
+
+/// Rule sets (diag/net/rules_fix_notes.md). Without the server's message 0x19 every LAN match was
+/// Standard. The host (player 1) reads its own menu mask (room+0xE4; the lowest checked item wins:
+/// Standard before No Alliances before Bloodbound) and sends it (type 11) every second from the
+/// moment it has its number, which is long before STEP_Init. Every game, host included, writes the
+/// rule byte each second from the join until MatchPreprocess (stage phase 1) is over; RULE_KEEP
+/// keeps it through the stage ctor. A game that heard nothing writes Standard. Bloodbound
+/// (bloodbound_notes 1e) only when BB_PAIRS is in the host's game and the session has an even
+/// 2..8 players: the host then sends its ordered player numbers too (28-byte packet) and every game
+/// fills BB_BOX with the same pairs (BloodboundBox); else the host logs why and uses Standard.
+void Assist::State::RuleShare(u32 join_state, u64 stage, u32 phase) {
+    const bool keep = Get<u32>(main + RULE_KEEP_WORD) == RULE_KEEP_NOP;
+    if (!rule_keep_seen || *rule_keep_seen != keep) {
+        rule_keep_seen = keep;
+        Log(keep ? "rule set: RULE_KEEP is in the game (0x113F380 nop): the host's rule set is used "
+                   "on every game"
+                 : "rule set: RULE_KEEP is not in the game (0x113F380 is not the nop): rule byte left "
+                   "alone, every match is Standard");
+    }
+    if (!keep) {
+        return;
+    }
+    u32 own_no = LocalPlayerNo();
+    if ((own_no == 0 || own_no == ~0U) && session.armed) {
+        own_no = session.no; // message 4 armed, not delivered yet
+    }
+    const bool host = own_no == 1;
+    if (host) {
+        const u64 g2 = Get<u64>(main + RULE_NET_MANAGER);
+        const u64 room = g2 != 0 ? Get<u64>(g2 + RULE_G2_ROOM) : 0;
+        if (room != 0) {
+            const u32 mask = Get<u32>(room + RULE_ROOM_MASK);
+            // Several items checked: the real server picked one of them (the client only applies
+            // 0x19); we take the lowest. None checked (the menu refuses that): Standard.
+            const u8 asked = (mask & 1) != 0   ? RULE_STANDARD
+                             : (mask & 2) != 0 ? RULE_NO_ALLIANCES
+                             : (mask & 4) != 0 ? RULE_BLOODBOUND
+                                               : RULE_STANDARD;
+            // Bloodbound: N = the session's players (non-server members, as PlayerNumber counts
+            // them; numbers 1..N in member-id order on every game). Read only when it is asked.
+            size_t members = 0;
+            const bool hook = asked == RULE_BLOODBOUND && BloodboundHook();
+            if (asked == RULE_BLOODBOUND) {
+                const u64 begin = Get<u64>(session.manager + S_MEMBERS);
+                const u64 end = Get<u64>(session.manager + S_MEMBERS + 8);
+                if (begin != 0 && end > begin && (end - begin) % MEMBER_SIZE == 0 &&
+                    end - begin <= 16 * MEMBER_SIZE) {
+                    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+                        if (Get<u8>(member + M_SERVER) == 0) {
+                            ++members;
+                        }
+                    }
+                }
+            }
+            // v412 N1 (audit8_numbering.md): the numbers are 1..N only when nobody left between
+            // numbering and now and nobody took a number out of order (N2). When the host knows
+            // every member's number (type 5 seen), the pairs are made from those numbers in rising
+            // order (a dense set gives 1..N as before). Re-sent when they become known. v412b: the
+            // number from member +0xD4 alone (+0xE8 is set only at the spawn), 3+ players only.
+            std::vector<u8> real;
+            bool real_known = asked == RULE_BLOODBOUND && members >= 3 && // v412b: 3+ players only
+                              own_no >= 1 && own_no <= BB_MAX_PLAYERS;
+            if (real_known) {
+                const u64 mb = Get<u64>(session.manager + S_MEMBERS);
+                const u64 me = Get<u64>(session.manager + S_MEMBERS + 8);
+                for (u64 member = mb; real_known && member < me && me - mb <= 16 * MEMBER_SIZE;
+                     member += MEMBER_SIZE) {
+                    if (Get<u8>(member + M_SERVER) != 0) {
+                        continue;
+                    }
+                    const u32 n = Get<u8>(member + M_SELF) != 0
+                                      ? own_no
+                                      : Get<u32>(member + M_REMOTE_NO); // v412b: +0xD4 alone
+                    if (n < 1 || n > BB_MAX_PLAYERS) {
+                        real_known = false;
+                    } else {
+                        real.push_back(static_cast<u8>(n));
+                    }
+                }
+                std::ranges::sort(real);
+                real_known = real_known && real.size() == members;
+            }
+            if (!real_known) {
+                real.clear();
+            }
+            if (mask != rule_mask_seen || rule_from_instance != instance ||
+                (asked == RULE_BLOODBOUND &&
+                 (members != rule_members_seen || hook != rule_bb_hook ||
+                  real != rule_bb_real_seen))) {
+                rule_bb_real_seen = real; // v412 N1
+                rule_mask_seen = mask;
+                rule_members_seen = members;
+                rule_bb_hook = hook;
+                u8 value = asked;
+                std::vector<u8> nos;
+                if (asked == RULE_BLOODBOUND) {
+                    // bloodbound_notes 1e: only with BB_PAIRS in the game and an even N in 2..8
+                    // (an odd N would leave one player solo: the host plays Standard instead).
+                    std::string why;
+                    if (!hook) {
+                        why = fmt::format("BB_PAIRS is not in the game (main+0x10AC510 = {:#010x}, "
+                                          "stock {:#010x})",
+                                          Get<u32>(main + BB_HOOK), BB_HOOK_STOCK);
+                    } else if (members < 2 || members > BB_MAX_PLAYERS) {
+                        why = fmt::format("{} player(s) in the session (pairs need 2..8)", members);
+                    } else if (members % 2 != 0) {
+                        why = fmt::format("{} players in the session, an odd count (one would be "
+                                          "left without a partner)",
+                                          members);
+                    } else {
+                        for (size_t i = 0; i < members; ++i) {
+                            nos.push_back(static_cast<u8>(i + 1));
+                        }
+                        // v412 N1: the players' own numbers when all are known
+                        if (!real.empty() &&
+                            std::adjacent_find(real.begin(), real.end()) != real.end()) {
+                            nos.clear();
+                            why = "two players hold the same number (DUPLICATE; v412 N1)";
+                        } else if (!real.empty() && real != nos) {
+                            Log(fmt::format("rule set: Bloodbound pairs from the players' own "
+                                            "numbers, not 1..{} (a gap or a moved number; v412 N1)",
+                                            members));
+                            nos = real;
+                        }
+                    }
+                    if (nos.empty()) {
+                        value = RULE_STANDARD;
+                        why = fmt::format("!!! rule set: the host chose Bloodbound Alliances, but "
+                                          "{}: this match is played as Standard !!!",
+                                          why);
+                    } else {
+                        std::string pairs;
+                        for (size_t i = 0; i + 1 < nos.size(); i += 2) {
+                            pairs += fmt::format("{}({}, {})", pairs.empty() ? "" : ", ", nos[i],
+                                                 nos[i + 1]);
+                        }
+                        why = fmt::format("rule set: Bloodbound Alliances with {} players (BB_PAIRS "
+                                          "in the game): pairs {}",
+                                          members, pairs);
+                    }
+                    if (why != rule_bb_why) {
+                        rule_bb_why = why;
+                        Log(why);
+                    }
+                }
+                if (!rule_value || *rule_value != value || rule_from_instance != instance ||
+                    nos != rule_players) {
+                    ++rule_seq;
+                }
+                rule_value = value;
+                rule_asked = asked;
+                rule_from = 1;
+                rule_from_instance = instance;
+                rule_players = std::move(nos);
+                Log(fmt::format("rule set (host): menu mask {:#x} -> {}; sent to the others as {} "
+                                "(session #{}, change #{})",
+                                mask, RuleName(asked), RuleName(value), rule_session_gen,
+                                rule_seq));
+            }
+        }
+        if (rule_value && rule_from_instance == instance) {
+            RuleMessage out;
+            out.player_no = 1;
+            out.rule = *rule_value;
+            out.asked = rule_asked;
+            out.instance = instance;
+            out.gen = rule_session_gen;
+            out.seq = rule_seq;
+            out.mask = static_cast<u8>(rule_mask_seen);
+            if (out.rule == RULE_BLOODBOUND) {
+                // 28 bytes: the header with N, then the ordered player numbers.
+                RulePlayers tail;
+                tail.count = static_cast<u8>(rule_players.size());
+                std::copy(rule_players.begin(), rule_players.end(), tail.nos.begin());
+                out.players = tail.count;
+                std::array<u8, sizeof(RuleMessage) + sizeof(RulePlayers)> bytes{};
+                std::memcpy(bytes.data(), &out, sizeof(out));
+                std::memcpy(bytes.data() + sizeof(out), &tail, sizeof(tail));
+                Network::LanSide::Send(std::span<const u8>(bytes.data(), bytes.size()));
+            } else {
+                Network::LanSide::Send(
+                    std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+            }
+        }
+    }
+    // Write until MatchPreprocess is over: no stage yet, Init (0) or MatchPreprocess (1).
+    const bool before_play = stage == 0 || phase <= 1;
+    const u8 want = rule_value.value_or(RULE_STANDARD);
+    if (before_play) {
+        const u8 have = Get<u8>(main + RULE_BYTE);
+        if (have != want || !rule_touched) {
+            Put<u8>(main + RULE_BYTE, want);
+            rule_touched = true;
+        }
+        // G1: the match kind the same (Casual) on every game until MatchPreprocess is over.
+        if (const u8 kind = Get<u8>(main + MATCH_KIND_BYTE); kind != MATCH_KIND_CASUAL) {
+            Put<u8>(main + MATCH_KIND_BYTE, MATCH_KIND_CASUAL);
+            if (kind_fixed_gen != rule_session_gen) {
+                kind_fixed_gen = rule_session_gen;
+                Log(fmt::format("match kind: {} on this game, set to 1 (Casual) for the LAN match "
+                                "(audit G1; session state {}, stage phase {})",
+                                kind, join_state, static_cast<s32>(phase)));
+            }
+        }
+        if (want != rule_written) {
+            rule_written = want;
+            Log(fmt::format("rule set: {} written on this game (main+0x5B65C70 = {}, was {}; {}; "
+                            "session state {}, stage phase {})",
+                            RuleName(want), want, have,
+                            !rule_value ? std::string("nothing from the host yet")
+                            : rule_from_instance == instance
+                                ? std::string("our own menu, we are the host")
+                                : fmt::format("from player {}", rule_from),
+                            join_state, static_cast<s32>(phase)));
+        }
+        if (stage != 0 && phase == 1 && !rule_pre_logged) {
+            rule_pre_logged = true;
+            Log(fmt::format("rule set: this match reaches MatchPreprocess with {}{}",
+                            RuleName(Get<u8>(main + RULE_BYTE)),
+                            rule_value ? ""
+                                       : " (!!! no rule heard from the host: Standard on this "
+                                         "game; if the host chose No Alliances, the games differ)"));
+        }
+        if (phase != 1) {
+            rule_pre_logged = false; // stage 0 / Init: the next MatchPreprocess is logged again
+        }
+        rule_late_logged = false;
+    } else if (rule_value && *rule_value != Get<u8>(main + RULE_BYTE) && !rule_late_logged) {
+        rule_late_logged = true;
+        Log(fmt::format("!!! rule set: {} from player {} came after MatchPreprocess (stage phase "
+                        "{}): this game keeps {} for this match !!!",
+                        RuleName(*rule_value), rule_from, phase,
+                        RuleName(Get<u8>(main + RULE_BYTE))));
+    }
+    BloodboundBox(want, before_play, stage, phase);
+}
+
+/// BB_PAIRS (bloodbound_live.py) is in the game: the hook word at main+0x10AC510 is its `b` to the
+/// trampoline. Logged when it changes.
+bool Assist::State::BloodboundHook() {
+    const u32 word = Get<u32>(main + BB_HOOK);
+    const bool present = word == BB_HOOK_PATCHED;
+    if (!bb_hook_seen || *bb_hook_seen != present) {
+        bb_hook_seen = present;
+        Log(present ? std::string("rule set: BB_PAIRS is in the game (main+0x10AC510 = b tramp): "
+                                  "Bloodbound pairs can be formed")
+                    : fmt::format("rule set: BB_PAIRS is not in the game (main+0x10AC510 = {:#010x}"
+                                  "{}): no Bloodbound pairs on this game",
+                                  word, word == BB_HOOK_STOCK ? ", the stock b.ne" : ""));
+    }
+    return present;
+}
+
+/// BB_BOX (bloodbound_build_notes.md 1): under rule 2, the host's pairs for the cave, the same bytes
+/// on every game, before MatchPreprocess: +1.. first, then +0 = 2 LAST. The cave writes 3 when it
+/// takes it; we then write 0 and do not fill it again until the next match (stage gone or Init).
+/// After MatchPreprocess, or with another rule, a box we wrote is cleared (the cave leaves it at 2
+/// when the rule byte was not 2). Never touched in a session that was not Bloodbound.
+void Assist::State::BloodboundBox(u8 want, bool before_play, u64 stage, u32 phase) {
+    const bool fill = want == RULE_BLOODBOUND && rule_players.size() >= 2 &&
+                      rule_players.size() <= BB_MAX_PLAYERS && rule_players.size() % 2 == 0;
+    if (!fill && !bb_touched) {
+        return; // rules 0 / 1: nothing read, nothing written (as before)
+    }
+    if (stage == 0 || phase == 0) {
+        bb_consumed = false; // the next match's MatchPreprocess is still ahead
+    }
+    std::array<u8, BB_BOX_SIZE> have{};
+    if (!Read(main + BB_BOX, have.data(), have.size())) {
+        if (fill && !bb_touched) {
+            bb_touched = true; // log once; RuleEnd tries the clear anyway
+            Log("!!! rule set: BB_BOX (main+0xC50F210) is not mapped on this game: no Bloodbound "
+                "pairs here (is the far cave region loaded?) !!!");
+        }
+        return;
+    }
+    if (have[0] == BB_STATE_CONSUMED) {
+        Put<u8>(main + BB_BOX, BB_STATE_EMPTY);
+        bb_consumed = true;
+        bb_touched = true;
+        Log(fmt::format("rule set: BB_BOX was taken by the cave at MatchPreprocess ({} pair(s)); "
+                        "cleared (stage phase {})",
+                        have[1], static_cast<s32>(phase)));
+        return;
+    }
+    if (fill && before_play && !bb_consumed) {
+        if (!BloodboundHook()) {
+            // v3.6 audit S3: no cave reads the box without the hook: nothing is written.
+            if (!bb_no_hook_logged) {
+                bb_no_hook_logged = true;
+                Log("!!! rule set: the host plays Bloodbound Alliances but BB_PAIRS is not in "
+                    "THIS game: its pairs will be missing here, the games differ; BB_BOX is not "
+                    "written !!!");
+            }
+            return;
+        }
+        std::array<u8, BB_BOX_SIZE> box{};
+        box[0] = BB_STATE_VALID;
+        box[1] = static_cast<u8>(rule_players.size() / 2);
+        std::copy(rule_players.begin(), rule_players.end(), box.begin() + 2);
+        if (have != box) {
+            Write(main + BB_BOX + 1, box.data() + 1, box.size() - 1);
+            Put<u8>(main + BB_BOX, BB_STATE_VALID); // last: the cave reads +0 first
+        }
+        bb_touched = true;
+        if (box != bb_last) {
+            bb_last = box;
+            std::string pairs;
+            for (size_t i = 0; i + 1 < rule_players.size(); i += 2) {
+                pairs += fmt::format("{}({}, {})", pairs.empty() ? "" : ", ", rule_players[i],
+                                     rule_players[i + 1]);
+            }
+            // bloodbound_notes 4.6 (review7 task 4, only logged): entries already in the alliance
+            // manager now are pacts of an earlier match; 0x10AD600 would refuse their members.
+            const u64 am = Get<u64>(main + BB_AM);
+            Log(fmt::format("rule set: BB_BOX written: {} pair(s) {} (state 2; stage phase {}); "
+                            "alliance entries before the cave (AM+0x38): {} (0 expected; more = "
+                            "stale pacts, not cleared)",
+                            box[1], pairs, static_cast<s32>(phase),
+                            am != 0 ? fmt::format("{}", Get<u64>(am + BB_AM_COUNT))
+                                    : std::string("AM not readable")));
+        }
+        return;
+    }
+    if (have[0] != BB_STATE_EMPTY) {
+        Put<u8>(main + BB_BOX, BB_STATE_EMPTY);
+        Log(fmt::format("rule set: BB_BOX cleared (state {} -> 0; {}, stage phase {})", have[0],
+                        !fill ? "the rule is not Bloodbound now"
+                        : bb_consumed ? "already taken in this match"
+                                      : "MatchPreprocess is over and the cave did not take it",
+                        static_cast<s32>(phase)));
+    }
+    bb_last = {};
+}
+
+/// Side-channel type 11 (RuleMessage), taken at once by SideFast (also before the stage exists).
+void Assist::State::RuleHeard(const Network::LanSide::Packet& packet) {
+    RuleMessage in;
+    RulePlayers tail;
+    const bool with_players = packet.data.size() == sizeof(in) + sizeof(tail);
+    if (packet.data.size() != sizeof(in) && !with_players) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (with_players) {
+        std::memcpy(&tail, packet.data.data() + sizeof(in), sizeof(tail));
+    }
+    if (in.instance == instance || in.player_no == 0 || in.player_no == 0xFF ||
+        in.rule > RULE_BLOODBOUND) {
+        return; // ours, a sender without a number, or a value we never send
+    }
+    // Rule 2 only with its player list (28 bytes): an even count 2..8 of distinct numbers 1..8 in
+    // rising order; rules 0 / 1 come as the 16-byte packet (as before; a tail is ignored).
+    std::vector<u8> nos;
+    if (in.rule == RULE_BLOODBOUND) {
+        const size_t n = with_players ? static_cast<size_t>(tail.count) : size_t{0};
+        if (n < 2 || n > BB_MAX_PLAYERS || n % 2 != 0 || static_cast<size_t>(in.players) != n) {
+            return;
+        }
+        for (size_t i = 0; i < n; ++i) {
+            const u8 no = tail.nos[i];
+            if (no == 0 || static_cast<size_t>(no) > BB_MAX_PLAYERS ||
+                (!nos.empty() && no <= nos.back())) {
+                return;
+            }
+            nos.push_back(no);
+        }
+    }
+    if (session.manager == 0 || packet.at < rule_session_at) {
+        return; // not in a session, or sent before this one began (an earlier match's)
+    }
+    if (rule_from_instance == instance) {
+        return; // we are the host: our own menu decides
+    }
+    const u64 key = (u64{in.gen} << 32) | in.seq;
+    auto& newest = rule_heard_key[in.instance];
+    if (key < newest) {
+        return; // older than what this sender already told us (a late packet)
+    }
+    newest = key;
+    if (rule_from_instance != 0 && rule_from_instance != in.instance && in.player_no >= rule_from) {
+        return; // one host: the lowest player number heard
+    }
+    const bool changed = !rule_value || *rule_value != in.rule ||
+                         rule_from_instance != in.instance || nos != rule_players;
+    rule_value = in.rule;
+    rule_from = in.player_no;
+    rule_from_instance = in.instance;
+    rule_players = std::move(nos);
+    if (changed) {
+        std::string pairs;
+        for (size_t i = 0; i + 1 < rule_players.size(); i += 2) {
+            pairs += fmt::format("{}({}, {})", pairs.empty() ? "" : ", ", rule_players[i],
+                                 rule_players[i + 1]);
+        }
+        Log(fmt::format("rule set: {} received from player {} (game {:#010x}, its session #{}, "
+                        "change #{}; its menu mask {:#x} asked for {}{})",
+                        RuleName(in.rule), in.player_no, in.instance, in.gen, in.seq, in.mask,
+                        RuleName(in.asked),
+                        in.rule == RULE_BLOODBOUND
+                            ? fmt::format("; {} players, pairs {}", rule_players.size(), pairs)
+                        : in.asked == RULE_BLOODBOUND
+                            ? std::string(": the host could not play it, Standard")
+                            : std::string()));
+    }
+}
+
+/// Session end: the rule byte back to 0 (Standard) for the hub and the next match, since RULE_KEEP
+/// took away the stage ctor's reset; the next session writes its own value again.
+void Assist::State::RuleEnd() {
+    rule_bb_real_seen.clear(); // v412 N1: per match
+    if (rule_touched) {
+        if (Get<u8>(main + RULE_BYTE) != RULE_STANDARD) {
+            Log(fmt::format("rule set: session over, rule byte {} -> 0 (Standard)",
+                            Get<u8>(main + RULE_BYTE)));
+        }
+        Put<u8>(main + RULE_BYTE, RULE_STANDARD);
+    }
+    if (bb_touched) {
+        // Bloodbound: the box empty for the hub and the next session (build notes 1, step 3).
+        const u8 box_state = Get<u8>(main + BB_BOX);
+        Put<u8>(main + BB_BOX, BB_STATE_EMPTY);
+        // bloodbound_notes 4.6 (not fixed, only logged): pacts left in the alliance manager after a
+        // Bloodbound match would make the next match's 0x10AD600 refuse their members.
+        const u64 am = Get<u64>(main + BB_AM);
+        Log(fmt::format("rule set: session over, BB_BOX state {} -> 0; alliance entries left "
+                        "(AM+0x38): {} (4.6: 0 expected; more = stale pacts, not cleared)",
+                        box_state, am != 0 ? fmt::format("{}", Get<u64>(am + BB_AM_COUNT))
+                                       : std::string("AM not readable")));
+    }
+    bb_touched = false;
+    bb_consumed = false;
+    bb_no_hook_logged = false;
+    bb_last = {};
+    bb_hook_seen.reset();
+    rule_players.clear();
+    rule_members_seen = ~size_t{0};
+    rule_bb_why.clear();
+    rule_bb_hook = false;
+    rule_touched = false;
+    rule_value.reset();
+    rule_from = 0;
+    rule_from_instance = 0;
+    rule_asked = 0;
+    rule_seq = 0;
+    rule_mask_seen = ~0U;
+    rule_written = 0xFF;
+    rule_pre_logged = false;
+    rule_late_logged = false;
+    rule_keep_seen.reset(); // the next session logs whether RULE_KEEP is in again
+}
+
+void Assist::State::Side(u64 stage, u32 phase, u32 join_state, Clock::time_point now) {
+    SideFast(); // whatever came since the last 50 ms pass
+    std::deque<Network::LanSide::Packet> drained;
+    drained.swap(side_queue);
+    for (const auto& packet : drained) {
+        const u64 address = (u64{packet.ip} << 16) | packet.port;
+        if (!packet.data.empty() && packet.data[0] == 2) {
+            SpotsHeader head;
+            if (packet.data.size() < sizeof(head)) {
+                continue;
+            }
+            std::memcpy(&head, packet.data.data(), sizeof(head));
+            const auto found = peers.find(head.instance);
+            if (head.instance == instance || found == peers.end() ||
+                found->second.clock_delta_us == INT64_MAX ||
+                packet.data.size() != sizeof(head) + head.count * sizeof(SpotSample)) {
+                continue;
+            }
+            for (size_t i = 0; i < head.count; ++i) {
+                SpotSample spot;
+                std::memcpy(&spot, packet.data.data() + sizeof(head) + i * sizeof(spot),
+                            sizeof(spot));
+                // The same samples arrive once per link: keep them in time order, once.
+                const double at = static_cast<double>(static_cast<s64>(spot.at_us) +
+                                                      found->second.clock_delta_us) /
+                                  1e6;
+                if (!found->second.own.empty() && at <= found->second.own.back().t + 1e-4) {
+                    continue;
+                }
+                found->second.own.push_back(Spot{at, spot.x, spot.z});
+            }
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 6) {
+            GroupMessage in;
+            if (packet.data.size() != sizeof(in)) {
+                continue;
+            }
+            std::memcpy(&in, packet.data.data(), sizeof(in));
+            const u32 our_no = LocalPlayerNo();
+            const u64 key = (u64{in.instance} << 16) | in.seq;
+            if (in.instance == instance || in.player_no == 0 ||
+                (our_no != 0 && in.player_no >= our_no) || key == group_heard) {
+                continue; // ours, not from a player before us, or taken already
+            }
+            if (const auto sender = peers.find(in.instance);
+                sender != peers.end() && PeerCut(sender->second)) {
+                continue; // H1: a cut player is not the host any more
+            }
+            group_heard = key;
+            Put<u32>(main + GROUP_BOX, in.id);
+            Put<u32>(main + GROUP_BOX + 4, 1);
+            Log(fmt::format("enemy group {} activated by player {}'s game: handed to ours", in.id,
+                            in.player_no));
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 5) {
+            NetClockMessage in;
+            if (packet.data.size() != sizeof(in)) {
+                continue;
+            }
+            std::memcpy(&in, packet.data.data(), sizeof(in));
+            const auto found = peers.find(in.instance);
+            if (in.instance != instance && found != peers.end()) {
+                found->second.net_offset = in.offset;
+                found->second.net_at = packet.at;
+            }
+            continue;
+        }
+        if (!packet.data.empty() && packet.data[0] == 4) {
+            OwnerMessage head;
+            if (packet.data.size() < sizeof(head)) {
+                continue;
+            }
+            std::memcpy(&head, packet.data.data(), sizeof(head));
+            if (head.instance == instance || head.player_no == 0 ||
+                packet.data.size() != sizeof(head) + head.count * sizeof(u16)) {
