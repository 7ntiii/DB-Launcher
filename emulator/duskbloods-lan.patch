+
+void Start(PFN_vkFreeMemory real) {
+    auto& state{Get()};
+    if (state.thread.joinable()) {
+        return;
+    }
+    state.real = real;
+    state.stop = false;
+    state.thread = std::thread([&state] {
+        Common::SetCurrentThreadName("VkFreeMemory");
+        std::unique_lock lock{state.mutex};
+        while (true) {
+            state.cv.wait(lock, [&state] { return state.stop || !state.queue.empty(); });
+            if (state.queue.empty()) {
+                return; // stopping, all done
+            }
+            const auto [device, memory] = state.queue.front();
+            state.queue.pop_front();
+            lock.unlock();
+            state.real(device, memory, nullptr);
+            lock.lock();
+        }
+    });
+}
+
+void Stop() {
+    auto& state{Get()};
+    {
+        std::scoped_lock lock{state.mutex};
+        state.stop = true;
+    }
+    state.cv.notify_one();
+    if (state.thread.joinable()) {
