     SCOPE_EXIT {
+        if (slow_log) {
+            const auto done = std::chrono::steady_clock::now();
+            const double total_ms =
+                std::chrono::duration<double, std::milli>(done - entered).count();
+            {
+                std::scoped_lock lock{ipc_time_mutex};
+                auto& entry = ipc_time[{service_name, ctx.GetCommand()}];
