+/// Review 2.6 case 4: the authority's ring and queue are forgotten when this game stops being the
+/// authority (hand-over, peers gone, match end) or a new match starts, so no stale ask is decided later
+/// and no stale claim is made. Undecided asks are forgotten too: a guest that asks again (it resends every
+/// 300 ms) is decided fresh if this game is the authority again.
+void Assist::State::TakeRaceClearRing() {
+    const u64 box = main + TR_BOX;
+    for (u64 i = 0; i < TR_SLOTS; ++i) {
+        Put<u8>(box + TR_ASKS + 16 * i, 0);
+        if (const u64 key = race_slot_key[i]; key != 0) {
+            if (const auto found = race_seen.find(key); found != race_seen.end() && found->second.verdict == 0) {
+                race_seen.erase(found);
+            }
+        }
+    }
+    for (const RaceAsk& ask : race_asks) {
+        const u64 key = (u64{ask.instance} << 32) | ask.ask;
+        if (const auto found = race_seen.find(key); found != race_seen.end() && found->second.verdict == 0) {
+            race_seen.erase(found);
+        }
+    }
+    race_slot_key.fill(0);
+    race_asks.clear();
+}
+
+/// Review 2.6 case 3: answers park park_id (state 1 -> 2) only while the game still holds it parked. The
+/// state byte goes 1 -> 2 by compare-exchange, so a park the game just settled itself (150-frame backstop,
+/// state -> 0) is never answered again, and so never replayed twice.
+bool Assist::State::TakeRaceAnswerPark(u32 park_id, u8 verdict, u8 why) {
+    const u64 box = main + TR_BOX;
+    if (Get<u8>(box + TR_PARK) != 1 || Get<u32>(box + TR_PARK_ID) != park_id) {
+        return false;
+    }
+    u8* const park_byte = memory->GetPointerSilent(box + TR_PARK);
+    if (park_byte == nullptr) {
+        return false;
+    }
+    Put<u8>(box + TR_VERDICT, verdict);
+    Put<u8>(box + TR_WHY, why);
+    u8 expected = 1;
+    return std::atomic_ref<u8>(*park_byte).compare_exchange_strong(expected, u8{2});
+}
+
+/// "flameL 99281 h=6000013e": the kind and asset as TakenShare names them (its scan of this round).
+std::string Assist::State::TakeRaceWhat(u32 handle) const {
+    for (const auto& [key, object] : taken_objects) {
+        if (static_cast<u32>(key) == handle) {
+            const u32 asset = static_cast<u32>(key >> 32);
+            const char* kind = TakenKind(asset);
+            return fmt::format("{} {} h={:08x}", kind != nullptr ? kind : "object", asset, handle);
+        }
+    }
+    return fmt::format("object h={:08x}", handle);
+}
+
+void Assist::State::TakeRaceSend(u8 kind, u8 player_no, u8 why, u32 to, u32 handle, u32 ask, u32 round,
+                                 u32 who) {
+    TakeRaceMessage out;
+    out.kind = kind;
+    out.player_no = player_no;
+    out.why = why;
+    out.instance = instance;
+    out.to = to;
+    out.handle = handle;
+    out.ask = ask;
+    out.round = round;
+    out.who = who;
+    out.seq = ++race_seq;
+    Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+}
+
+static std::string TakeRaceReason(u8 why, u32 who) {
+    switch (why) {
+    case 0:
+        return "first";
+    case 1:
+        return fmt::format("player {} was granted it first", who);
+    case 2:
+        return "used up";
+    case 3:
+        return fmt::format("held by player {}", who);
+    case 4:
+        return "not found on the authority; granted";
+    default:
+        return fmt::format("why {}", why);
+    }
+}
+
+/// v4.36 TAKERACE: another game's ask (we are the authority), answer (ours) or "ready" (the authority's).
+void Assist::State::TakeRaceHeard(const Network::LanSide::Packet& packet) {
+    TakeRaceMessage in;
+    if (packet.data.size() != sizeof(in) || main == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.player_no == 0 || CutNo(in.player_no)) {
+        return; // ours, no number, or a cut player's game (not in our match)
+    }
+    const bool authority = Get<u32>(main + GENERATOR_IDLE) == 0;
+    if (in.kind == 0) {
+        if (!authority) {
+            if (race_authority != in.instance) {
+                TakeRaceLog(fmt::format("takerace: the authority (player {}, game {:#010x}) is ready: a "
+                                        "shared pay-once take here waits for its answer (TAKERACE)",
+                                        in.player_no, in.instance));
+            }
+            race_authority = in.instance;
+            race_authority_no = in.player_no;
+            race_ready_at = packet.at;
+        }
+        return;
+    }
+    if (in.kind == 1) {
+        if (!authority || in.to != instance) {
+            return;
+        }
+        const u64 key = (u64{in.instance} << 32) | in.ask;
+        if (const auto found = race_seen.find(key); found != race_seen.end()) {
+            if (found->second.verdict != 0) { // a repeat: our answer was lost, send it again
+                TakeRaceSend(found->second.verdict, in.player_no, found->second.why, in.instance,
+                             in.handle, in.ask, in.round, found->second.who);
+            }
+            return;
+        }
+        const u64 stage = Get<u64>(main + STAGE_PHASE);
+        const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+        if (round != in.round) {
+            TakeRaceLog(fmt::format("takerace: player {} asks for {} (round {}, ask #{}), but this game is "
+                                    "in round {}: not answered (it takes it itself after 1.5 s)",
+                                    in.player_no, TakeRaceWhat(in.handle), in.round, in.ask, round));
+            race_seen[key] = RaceAnswer{};
+            return;
+        }
+        race_seen[key] = RaceAnswer{0, 0, 0, in.player_no, in.handle, in.round};
+        race_asks.push_back(RaceAsk{in.instance, in.ask, in.player_no, in.handle, in.round});
+        return;
+    }
+    if ((in.kind == 3 || in.kind == 4) && in.to == instance) {
+        if (in.ask == race_park && race_park != 0 && Get<u8>(main + TR_BOX + TR_PARK) == 1) {
+            race_answers[in.ask] = RaceAnswer{in.kind, in.why, in.who, in.player_no, in.handle, in.round};
+        } else if (race_late_logged.insert(in.ask).second) {
+            if (in.kind == 4 && race_timed_out.count(in.ask) != 0) {
+                TakeRaceLog(fmt::format("takerace: late answer for park #{}: the authority refused it ({}), "
+                                        "but this game had already taken it on the 1.5-s timeout: two "
+                                        "takers this time (the timeout's trade-off; a lost authority never "
+                                        "blocks a take)",
+                                        in.ask, TakeRaceReason(in.why, in.who)));
+            } else {
+                TakeRaceLog(fmt::format("takerace: late answer for park #{} ({} {}) ignored: that press was "
+                                        "already settled here",
+                                        in.ask, in.kind == 3 ? "granted" : "refused",
+                                        TakeRaceReason(in.why, in.who)));
+            }
+        }
+    }
+}
+
+/// v4.36 TAKERACE (takerace_live.py, layout_notes 2.5). Online the server granted a shared pay-once
+/// object (a large Flame corpse, a kin circle) to the first request only and refused the second. In LAN
+/// every game granted its own player's press at once, so two players pressing within one network delay
+/// both got it. With the caves in: the authority's game decides (claims, used, holder), in the order the
+/// asks reach it; a guest's press parks its grant (the prompt and the player's action already ran) and we
+/// carry the ask and the answer; no answer within 1.5 s (a lost authority) = granted here, as before.
+/// Mode 0 (no caves, offline, solo, no ready authority): the caves change nothing.
+void Assist::State::TakeRace(Clock::time_point now) {
+    if (main == 0) {
+        return;
+    }
+    const u32 hook = Get<u32>(main + TR_SITE);
+    if (hook == TR_STOCK_WORD || hook == 0) {
+        return; // the group is not in this build
+    }
+    const u64 box = main + TR_BOX;
+    if (race_gen != match_gen) {
+        race_gen = match_gen;
+        race_logs = 0;
+        TakeRaceClearRing(); // review 2.6 case 4: no ask of the last match is decided in this one
+        race_seen.clear();
+        race_answers.clear();
+        race_late_logged.clear();
+        race_timed_out.clear();
+        race_park = 0;
+        race_own_seen = Get<u32>(box + TR_OWN);
+        race_done_seen = Get<u32>(box + TR_DONE);
+        race_dropped_seen = Get<u32>(box + TR_DROPPED);
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const bool in_match = session.manager != 0 && session.state == 8 && stage != 0;
+    const bool authority = Get<u32>(main + GENERATOR_IDLE) == 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    bool peers_live = false;
+    for (const auto& [id, peer] : peers) {
+        if (peer.no != 0 && now - peer.at < 5s && !CutNo(peer.no)) {
+            peers_live = true;
+        }
+    }
+    u8 mode = 0;
+    std::string why;
+    if (!in_match) {
+        why = "not in a match";
+    } else if (authority) {
+        mode = peers_live ? 1 : 0;
+        why = peers_live ? "this game is the authority: it decides shared pay-once takes"
+                         : "no other game heard: every take is granted at once (today's way)";
+    } else if (race_authority != 0 && now - race_ready_at < TR_READY_STALE) {
+        mode = 2;
+        why = fmt::format("the authority is player {}: our shared pay-once takes wait for it",
+                          race_authority_no);
+    } else {
+        why = "no ready authority heard for 3 s: our takes are granted at once (today's way)";
+    }
+    if (mode != race_mode || Get<u8>(box + TR_MODE) != mode) {
+        Put<u8>(box + TR_MODE, mode);
+        if (race_mode == 1 && mode != 1) {
+            TakeRaceClearRing(); // review 2.6 case 4: after the mode byte, so the game decides no more
+        }
+        if (mode != race_mode && in_match) {
+            TakeRaceLog(fmt::format("takerace: mode {} ({}) (TAKERACE)",
+                                    mode == 1 ? "authority" : mode == 2 ? "guest" : "off", why));
+        }
+        race_mode = mode;
+    }
+    if (mode == 1 && now - race_ready_sent >= 1s) {
+        race_ready_sent = now;
+        TakeRaceSend(0, static_cast<u8>(LocalPlayerNo()), 0, 0, 0, 0, round, 0);
+    }
+
+    // Guest: our parked press.
+    const u8 park = Get<u8>(box + TR_PARK);
+    const u32 park_id = Get<u32>(box + TR_PARK_ID);
+    if (park == 1) {
+        if (park_id != race_park) {
+            race_park = park_id;
+            race_park_handle = Get<u32>(box + TR_PARK_HANDLE);
+            race_park_round = Get<u32>(box + TR_PARK_ROUND); // the round of the press (the game wrote it)
+            race_park_at = now;
+            race_ask_sent = {};
+            TakeRaceLog(fmt::format("takerace: {} round {} (player {}): pressed here; the grant waits for "
+                                    "the authority (park #{}, {})",
+                                    TakeRaceWhat(race_park_handle), race_park_round, Get<u32>(box + TR_PARK_NO),
+                                    park_id,
+                                    mode == 2 ? fmt::format("asked player {}", race_authority_no)
+                                              : std::string("no authority now: 1.5-s timeout")));
+        }
+        const auto waited = std::chrono::duration_cast<std::chrono::milliseconds>(now - race_park_at);
+        if (const auto answer = race_answers.find(park_id); answer != race_answers.end()) {
+            TakeRaceAnswerPark(park_id, answer->second.verdict, 0);
+            TakeRaceLog(fmt::format("takerace: {} round {} park #{}: the authority {} it ({}) after {} ms; "
+                                    "{}",
+                                    TakeRaceWhat(race_park_handle), race_park_round, park_id,
+                                    answer->second.verdict == 3 ? "granted" : "refused",
+                                    TakeRaceReason(answer->second.why, answer->second.who), waited.count(),
+                                    answer->second.verdict == 3 ? "taken here" : "not taken here"));
+            race_answers.erase(answer);
+        } else if (now - race_park_at >= TR_TIMEOUT) {
+            if (TakeRaceAnswerPark(park_id, 3, 1)) {
+                race_timed_out.insert(park_id);
+            }
+            TakeRaceLog(fmt::format("takerace: {} round {} park #{}: no answer from the authority in {} ms; "
+                                    "taken here as before (timeout)",
+                                    TakeRaceWhat(race_park_handle), race_park_round, park_id,
+                                    waited.count()));
+        } else if (mode == 2 && now - race_ask_sent >= TR_RESEND) {
+            race_ask_sent = now;
+            TakeRaceSend(1, static_cast<u8>(Get<u32>(box + TR_PARK_NO)), 0, race_authority,
+                         race_park_handle, park_id, race_park_round, 0);
+        }
+    }
+    if (const u32 done = Get<u32>(box + TR_DONE); done != race_done_seen) {
+        race_done_seen = done;
+        if (const u8 done_why = Get<u8>(box + TR_WHY); done_why == 2) {
+            TakeRaceLog(fmt::format("takerace: park #{}: no answer for 150 frames (the assist did not "
+                                    "serve it); the game took it here as before (backstop)",
+                                    park_id));
+        } else if (done_why == 3) {
+            TakeRaceLog(fmt::format("takerace: park #{}: the round changed before the answer; refused here "
+                                    "(a press of the last round grants nothing in this one)",
+                                    park_id));
+        }
+    }
+    if (const u32 dropped = Get<u32>(box + TR_DROPPED); dropped != race_dropped_seen) {
+        TakeRaceLog(fmt::format("takerace: park #{}: the stage changed before the answer (map unloaded or "
+                                "a new match); dropped here, nothing granted ({} dropped in all)",
+                                park_id, dropped));
+        race_dropped_seen = dropped;
+    }
+
+    if (mode != 1) {
+        race_asks.clear();
+        return;
+    }
+    // Authority: answers the game decided (ring slots in state 2), sent to every game.
+    bool pending = false;
+    for (u64 i = 0; i < TR_SLOTS; ++i) {
+        const u64 slot = box + TR_ASKS + 16 * i;
+        const u8 slot_state = Get<u8>(slot);
+        if (slot_state == 1) {
+            pending = true;
+            continue;
+        }
+        if (slot_state != 2) {
+            continue;
+        }
+        const u8 verdict = Get<u8>(slot + 1);
+        const u8 slot_why = Get<u8>(slot + 3);
+        const u32 who = Get<u32>(slot + 0xC);
+        const u64 key = race_slot_key[i];
+        Put<u8>(slot, 0);
+        race_slot_key[i] = 0;
+        auto found = race_seen.find(key);
+        if (found == race_seen.end() || key == 0) {
+            continue;
+        }
+        found->second.verdict = verdict == 4 ? 4 : 3;
+        found->second.why = slot_why;
+        found->second.who = who;
+        const RaceAnswer& answer = found->second;
+        TakeRaceSend(answer.verdict, answer.player_no, answer.why, static_cast<u32>(key >> 32),
+                     answer.handle, static_cast<u32>(key), answer.round, answer.who);
+        TakeRaceLog(fmt::format("takerace: player {} asks for {} round {} (game {:#010x}, ask #{}): {} ({})",
+                                answer.player_no, TakeRaceWhat(answer.handle), answer.round,
+                                static_cast<u32>(key >> 32), static_cast<u32>(key),
+                                answer.verdict == 3 ? "granted" : "refused",
+                                TakeRaceReason(answer.why, answer.who)));
+    }
+    if (!pending) {
+        race_head = static_cast<u8>(Get<u8>(box + TR_ASK_NEXT) % TR_SLOTS);
+    }
+    // New asks into the ring, in the order they reached us; the game decides them in ring order.
+    while (!race_asks.empty()) {
+        const u64 slot = box + TR_ASKS + 16 * race_head;
+        if (Get<u8>(slot) != 0) {
+            break; // the ring is full: the rest waits for the next pass
+        }
+        const RaceAsk& ask = race_asks.front();
+        Put<u8>(slot + 1, 0);
+        Put<u8>(slot + 2, ask.player_no);
+        Put<u8>(slot + 3, 0);
+        Put<u32>(slot + 4, ask.handle);
+        Put<u32>(slot + 8, ask.ask);
+        Put<u32>(slot + 0xC, 0);
+        Put<u8>(slot, 1); // asked (written last)
+        race_slot_key[race_head] = (u64{ask.instance} << 32) | ask.ask;
+        race_head = static_cast<u8>((race_head + 1) % TR_SLOTS);
+        race_asks.pop_front();
+    }
+    if (const u32 own = Get<u32>(box + TR_OWN); own != race_own_seen) {
+        const u32 count = own - race_own_seen; // review 2.6 case 6: several in one pass are counted
+        race_own_seen = own;
+        const u32 handle = Get<u32>(box + TR_OWN_HANDLE);
+        TakeRaceLog(fmt::format("takerace: own press on {} round {} refused: player {} was granted it "
+                                "first{}",
+                                TakeRaceWhat(handle), round, Get<u32>(box + TR_OWN_WHO),
+                                count > 1 ? fmt::format(" ({} own refusals since the last pass; the last "
+                                                        "one named)",
+                                                        count)
+                                          : std::string()));
+    }
+}
+
+/// v4.30 CUTSCENE_VOTE: another player's skip vote (type 23), counted by CutsceneVote.
+void Assist::State::CutVoteHeard(const Network::LanSide::Packet& packet) {
+    CutsceneVoteMessage in;
+    if (packet.data.size() != sizeof(in) || main == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.player_no == 0 || CutNo(in.player_no)) {
+        return; // ours, no number, or a cut player's game (not in our match)
+    }
+    auto& vote = cut_votes[in.id];
+    if (!vote.voters.contains(in.player_no)) {
+        Log(fmt::format("cutscene vote: player {} voted to skip cutscene {} (CUTSCENE_VOTE)",
+                        in.player_no, in.id));
+    }
+    vote.voters[in.player_no] = packet.at;
+}
+
+/// v4.30 CUTSCENE_VOTE (cutscene_vote_notes.md). With cutvote_live.py an online skip press in a
+/// shared cutscene only marks the vote entry (+5); nothing skips. Here: our votes go to the others
+/// every 0.5 s while the entry stands; the votes of the players present (ours and every peer heard
+/// in the last 5 s that is not cut: a silent or cut game does not hold the skip up) are counted;
+/// count / total go to entry+6 / +7 as the server's kind 1 did; once all of them voted, entry+4 = 1
+/// ends the cutscene here, as the server's kind 2 did on every game. Solo cutscenes skip at once
+/// in the game (unchanged); their entry is voted and skipped already.
+void Assist::State::CutsceneVote(Clock::time_point now) {
+    if (main == 0 || session.manager == 0) {
+        return;
+    }
+    const u32 me = LocalPlayerNo();
+    if (me == 0 || me > 16) {
+        return;
+    }
+    std::map<u32, u64> local; // cutscene id -> its vote entry here
+    if (const u64 mgr = Get<u64>(main + CUT_VOTE_MGR); mgr != 0) {
+        const u64 begin = Get<u64>(mgr + 8);
+        const u64 end = Get<u64>(mgr + 0x10);
+        if (begin != 0 && end > begin && (end - begin) % 8 == 0 && end - begin <= 64 * 8) {
+            for (u64 entry = begin; entry < end; entry += 8) {
+                local.emplace(Get<u32>(entry), entry);
+            }
+        }
+    }
+    if (local.empty() && cut_votes.empty()) {
+        return;
+    }
+    const bool send = now >= cut_vote_send_at;
+    for (const auto& [id, entry] : local) {
+        if (Get<u8>(entry + 5) == 0) {
+            continue; // our player did not vote in this one
+        }
+        auto& vote = cut_votes[id];
+        if (!vote.voters.contains(me)) {
+            Log(fmt::format("cutscene vote: our player voted to skip cutscene {} (CUTSCENE_VOTE)",
+                            id));
+        }
+        vote.voters[me] = now;
+        if (send) {
+            CutsceneVoteMessage out;
+            out.player_no = static_cast<u8>(me);
+            out.instance = instance;
+            out.id = id;
+            out.seq = ++cut_vote_seq;
+            Network::LanSide::Send(
+                std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+        }
+    }
+    if (send) {
+        cut_vote_send_at = now + 500ms;
+    }
+    std::set<u32> present{me};
+    for (auto& [key, peer] : peers) {
+        if (peer.no != 0 && now - peer.at < 5s && !PeerCut(peer)) {
+            present.insert(peer.no);
+        }
+    }
+    for (auto it = cut_votes.begin(); it != cut_votes.end();) {
+        const u32 id = it->first;
+        CutVote& vote = it->second;
+        std::erase_if(vote.voters, [now](const auto& item) { return now - item.second > 2s; });
+        if (vote.voters.empty()) {
+            it = cut_votes.erase(it);
+            continue;
+        }
+        u32 count = 0;
+        for (const auto& [no, at] : vote.voters) {
+            count += present.contains(no) ? 1 : 0;
+        }
+        const u32 total = static_cast<u32>(present.size());
+        const auto here = local.find(id);
+        if (here != local.end()) {
+            const u64 entry = here->second;
+            const u8 shown_count = static_cast<u8>(std::min<u32>(count, 15));
+            const u8 shown_total = static_cast<u8>(std::min<u32>(total, 15));
+            if (Get<u8>(entry + 6) != shown_count) {
+                Put<u8>(entry + 6, shown_count);
+            }
+            if (Get<u8>(entry + 7) != shown_total) {
+                Put<u8>(entry + 7, shown_total);
+            }
+            if (count >= total && Get<u8>(entry + 4) == 0) {
+                Put<u8>(entry + 4, 1);
+                Log(fmt::format("cutscene vote: all {} players voted; cutscene {} skipped here "
+                                "(CUTSCENE_VOTE)",
+                                total, id));
+            }
+        }
+        if (vote.shown != (count << 8 | total)) {
+            vote.shown = count << 8 | total;
+            Log(fmt::format("cutscene vote: cutscene {}: {} / {} players voted to skip{}", id, count,
+                            total, here == local.end() ? " (no vote entry here yet)" : ""));
+        }
+        ++it;
+    }
+}
+
+void Assist::State::UpdateMailbox(u64 manager, u32 join_state) {
+    u32 no = 0;
+    u32 team = 0;
+    size_t players = 0;
+    u32 current = ~0U;
+    bool want = false;
+    if (join_state == 2 || join_state == 3) {
+        // Server message 4 gives each player its number and team; the stub hands it to the game
+        // while the local player has none (+0xD0 == -1).
+        const u64 table = Get<u64>(main + NET_PLAYERS);
+        u64 local = table != 0 ? Get<u64>(table + 0x28) : 0;
+        if (local == 0 && table != 0) {
+            local = Get<u64>(table + 0x20);
+        }
+        if (local != 0) {
+            current = Get<u32>(local + 0xD0);
+            want = current == ~0U && PlayerNumber(manager, no, team, players);
+            if (want) {
+                session.match_players = std::max(session.match_players, players); // review5 case 8
+            }
+        }
+    }
+    if (want && (!session.armed || no != session.no || team != session.team)) {
+        // b8 is the server's "takes part in the match" flag (the game stores it in
+        // PlayerGameData+0x46A0). With 0 the ranking skips the player, its rank stays 255 and the
+        // first cut (end of Phase II, top 6 go on) eliminates everybody: the match ended after
+        // two of its four phases.
+        const Mailbox box{.no = no, .team = static_cast<u8>(team), .b8 = 1, .pad = {}};
+        Write(main + MAILBOX, &box, sizeof(box));
+        Put<u32>(main + MAILBOX + 8, 1);
+        session.armed = true;
+        session.no = no;
+        session.team = team;
+        Log(fmt::format("player no {} team {} ({} players): message 4 armed", no, team, players));
+    } else if (!want && session.armed) {
+        Put<u32>(main + MAILBOX + 8, 0);
+        session.armed = false;
+        session.number_delivered = current == session.no; // v413
+        Log(fmt::format("message 4 {}: player no is now {}",
+                        current == session.no ? "delivered" : "disarmed",
+                        static_cast<s32>(current)));
+    }
+}
+
+void Assist::State::Walk(u64 loader, u32 step, Clock::time_point now) {
+    if (step != session.walk_step) {
+        session.walk_step = step;
+        session.walk_since = now;
+        return;
+    }
+    if (step == 0 || step >= LOADER_DONE) {
+        return;
+    }
+    const auto need = IsServerStep(step) ? 5s : 20s;
+    if (now - session.walk_since < need ||
+        (session.walk_written && now - *session.walk_written < 5s)) {
+        return;
+    }
+    Put<u32>(loader + L_NEXT, step + 1);
+    session.walk_written = now;
+    Log(fmt::format("loader step {} -> {} (no server reply)", step, step + 1));
+}
+
+void Assist::State::Phases(u32 phase, Clock::time_point now) {
+    // LOADREL (diag/net/loadrel_gen.py): the game code counts each Release of a load process that a worker
+    // still held (state 1 or 2) and that is now cancelled instead of freed under the worker. Read only.
+    if (!session.loadrel_at || now - *session.loadrel_at >= 1s) {
+        session.loadrel_at = now;
+        const u32 uses = Get<u32>(main + LOADREL_BOX);
+        if (uses != session.loadrel_logged) {
+            Log(fmt::format("load release: {} in-flight load process(es) cancelled instead of freed so far "
+                            "(+{}; LOADREL, phase {})",
+                            uses, uses - session.loadrel_logged, phase));
+            session.loadrel_logged = uses;
+        }
+    }
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    const u64 coordinator = Get<u64>(main + COORDINATOR);
+    const u64 gate = Get<u64>(main + PHASE_GATE);
+    if (phase == PHASE_INTERMISSION) {
+        // The server decides the start points and closes the travel menu.
+        if (!session.intermission_since) {
+            session.intermission_since = now;
+        }
+        const u32 mediator_state = mediator != 0 ? Get<u32>(mediator + 0x50) : ~0U;
+        const bool deciding = mediator != 0 && Get<u8>(mediator + 0xB9) != 0;
+        if (deciding && coordinator != 0 && Get<u8>(coordinator + 0xD8) != 0 &&
+            now - *session.intermission_since >= 5s) {
+            Put<u8>(coordinator + 0xD8, 0);
+            Log("intermission: start-point coordinator released");
+        }
+        if (deciding && (mediator_state == 3 || mediator_state == 4)) {
+            if (!session.selecting_since) {
+                session.selecting_since = now;
+            }
+            if (now - *session.selecting_since >= 10s) {
+                Put<u64>(mediator + 0x50, 0x0000'0001'0000'0001ULL); // state and next: InPhase
+                Log(fmt::format("intermission: start-point mediator {} -> InPhase",
+                                mediator_state));
+                session.selecting_since.reset();
+            }
+        } else {
+            session.selecting_since.reset();
+        }
+    } else {
+        session.intermission_since.reset();
+        session.selecting_since.reset();
+    }
+    // The server's phase message opens these gates: +0x39 lets a round begin, +0x38 lets its
+    // result show.
+    if (phase == PHASE_PRE_BEGIN && gate != 0 && Get<u8>(gate + 0x39) == 0) {
+        Put<u8>(gate + 0x39, 1);
+        Log("pre-begin: phase gate opened");
+    }
+    if (phase == PHASE_PRE_RESULT && gate != 0 && Get<u8>(gate + 0x38) == 0) {
+        Put<u8>(gate + 0x38, 1);
+        Log("pre-result: phase result gate opened");
+    }
+    if (phase == PHASE_UPDATE) {
+        session.played = true;
+        // The start-point map stays open without the server's begin message: send its dispatcher
+        // down the close path for 5 s.
+        if (!session.update_since) {
+            session.update_since = now;
+        }
+        if (!session.map_closed_at && now - *session.update_since >= 5s) {
+            SetCode(MAP_DISPATCH, MAP_DISPATCH_CLOSE);
+            session.map_closed_at = now;
+            Log("update phase: closing the start-point map");
+        } else if (session.map_closed_at && !session.map_restored &&
+                   now - *session.map_closed_at >= 5s) {
+            SetCode(MAP_DISPATCH, MAP_DISPATCH_ORIGINAL);
+            session.map_restored = true;
+            Log("update phase: map dispatcher restored");
+        }
+    } else {
+        if (session.map_closed_at && !session.map_restored) {
+            SetCode(MAP_DISPATCH, MAP_DISPATCH_ORIGINAL);
+            Log("map dispatcher restored (phase changed)");
+        }
+        session.update_since.reset();
+        session.map_closed_at.reset();
+        session.map_restored = false;
+    }
+    if (phase == PHASE_PREPARE_THIRD) {
+        // From the second round on, PrepareThird also waits for what the server confirms about
+        // the next environment event (its data, message 0x6B) and the players. The first round
+        // passes in well under a second; after 5 s, let it go on until the phase changes.
+        if (!session.third_since) {
+            session.third_since = now;
+        }
+        if (!session.third_forced && now - *session.third_since >= 5s) {
+            SetCode(THIRD_WAIT, THIRD_WAIT_GO);
+            session.third_forced = true;
+            Log("prepare third: going on without the server's confirmation");
+        }
+    } else {
+        if (session.third_forced) {
+            SetCode(THIRD_WAIT, THIRD_WAIT_ORIGINAL);
+            Log("prepare third: check restored");
+        }
+        session.third_since.reset();
+        session.third_forced = false;
+    }
+}
+
+void Assist::State::SetCode(u64 offset, u32 word) {
+    const u64 address = main + offset;
+    if (Write(address, &word, sizeof(word))) {
+        Core::InvalidateInstructionCacheRange(process, address, sizeof(word));
+    }
+}
+
+/// Census2 3.1: entries 0..STOCK_ENTRIES-1 are taken as before. An entry above is read past the
+/// part of the array the 2-3 player tests proved, so it counts only when it holds a player chr:
+/// chr data +0x1D0 -> player data with a player number 1..32 at +0xD0. Logged once per session.
+bool Assist::State::PlayerEntry(u64 chr, size_t entry) {
+    if (entry < STOCK_ENTRIES) {
+        return true;
+    }
+    const u64 chr_data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+    const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+    const u32 no = player_data != 0 ? Get<u32>(player_data + 0xD0) : 0;
+    if (no < 1 || no > 32) {
+        return false;
+    }
+    if (!entries_high_logged) {
+        entries_high_logged = true;
+        Log(fmt::format("players: character entry {} holds player {} (above the 8 entries sampled "
+                        "before; census2 3.1): it is sampled too",
+                        entry, no));
+    }
+    return true;
+}
+
+bool Assist::State::ChrPosition(size_t entry, f32& x, f32& z) {
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+    if (entries == 0) {
+        return false;
+    }
+    const u64 base = entries + entry * 0x38;
+    const u64 chr = Get<u64>(base);
+    const u64 physics = chr != 0 && PlayerEntry(chr, entry) ? Get<u64>(base + 0x28) : 0;
+    if (physics == 0) {
+        return false;
+    }
+    std::array<f32, 3> position{};
+    if (!Read(physics + 0x70, position.data(), sizeof(position))) {
+        return false;
+    }
+    x = position[0];
+    z = position[2];
+    return true;
+}
+
+/// 20 times a second in a battle: where our player is, and where our game shows the others.
+void Assist::State::Sample(Clock::time_point now) {
+    const double t = static_cast<double>(MicrosNow(now)) / 1e6;
+    const double keep = DELAY_WINDOW + DELAY_MAX + 2.0;
+    f32 x = 0;
+    f32 z = 0;
+    if (ChrPosition(0, x, z) && own_new.size() < 200) {
+        own_new.push_back(Spot{t, x, z});
+    }
+    for (size_t entry = 1; entry < MAX_ENTRIES; ++entry) {
+        auto& copy = copies[entry];
+        if (ChrPosition(entry, x, z)) {
+            copy.push_back(Spot{t, x, z});
+        }
+        while (!copy.empty() && t - copy.front().t > keep) {
+            copy.pop_front();
+        }
+    }
+    for (auto& [key, peer] : peers) {
+        while (!peer.own.empty() && t - peer.own.front().t > keep) {
+            peer.own.pop_front();
+        }
+    }
+}
+
+/// The game stamps each move with the sender's counter and turns it into local time with a clock
+/// difference it measures once, at the join. A stall on either side at that moment leaves the
+/// difference wrong for the whole session, and the receiver then shows every move that much late
+/// (0.3-0.8 s on one PC, seconds between two). Here the receiver measures the delay itself: each
+/// peer tells where its player was and when, our game shows where it puts that player, and the
+/// time shift between the two paths is the delay. Stepping the counter our guest reads forward by
+/// the delay cancels it. With several peers the largest stable delay is stepped.
+void Assist::State::MoveDelay(Clock::time_point now) {
+    if (!in_battle || now < delay_hold) {
+        return;
+    }
+    const double t_now = static_cast<double>(MicrosNow(now)) / 1e6;
+    const double newest = t_now - DELAY_MAX - 0.2; // so every shift can be checked
+    const double oldest = newest - DELAY_WINDOW;
+    double worst = 0; // the largest stable delay above its peer's floor
+    double worst_late = 0;
+    u32 worst_no = 0;
+    for (auto& [key, peer] : peers) {
+        std::vector<Spot> path;
+        double length = 0;
+        for (const Spot& spot : peer.own) {
+            if (spot.t < oldest || spot.t > newest) {
+                continue;
+            }
+            if (!path.empty()) {
+                length += std::hypot(spot.x - path.back().x, spot.z - path.back().z);
+            }
+            path.push_back(spot);
+        }
+        // A standing or teleporting player says nothing about time.
+        if (path.size() < 40 || length < 4.0 || length > 60.0) {
+            peer.why = fmt::format("no path to compare ({} samples, {:.1f} m in {:.0f} s)",
+                                   path.size(), length, DELAY_WINDOW);
+            continue;
+        }
+        std::vector<double> best_errors;
+        double best_shift = -1;
+        double best_error = 1e9;
+        int best_entry = -1;
+        for (size_t entry = 1; entry < MAX_ENTRIES; ++entry) {
+            const auto& copy = copies[entry];
+            if (copy.size() < 30) {
+                continue;
+            }
+            const auto shown = [&copy](double t, f32& x, f32& z) {
+                const auto after =
+                    std::lower_bound(copy.begin(), copy.end(), t,
+                                     [](const Spot& spot, double at) { return spot.t < at; });
+                if (after == copy.begin() || after == copy.end()) {
+                    return false;
+                }
+                const Spot& b = *after;
+                const Spot& a = *(after - 1);
+                const double part = b.t > a.t ? (t - a.t) / (b.t - a.t) : 0.0;
+                x = static_cast<f32>(a.x + (b.x - a.x) * part);
+                z = static_cast<f32>(a.z + (b.z - a.z) * part);
+                return true;
+            };
+            std::vector<double> errors(static_cast<size_t>(DELAY_MAX / 0.05) + 1, -1.0);
+            bool best_here = false;
+            for (int index = 0; index <= static_cast<int>(DELAY_MAX / 0.05); ++index) {
+                const double shift = index * 0.05;
+                double sum = 0;
+                size_t count = 0;
+                for (const Spot& spot : path) {
+                    f32 x = 0;
+                    f32 z = 0;
+                    if (shown(spot.t + shift, x, z)) {
+                        sum += std::hypot(x - spot.x, z - spot.z);
+                        ++count;
+                    }
+                }
+                if (count < path.size() * 3 / 4) {
+                    continue;
+                }
+                const double error = sum / static_cast<double>(count);
+                errors[static_cast<size_t>(index)] = error;
+                if (error < best_error) {
+                    best_error = error;
+                    best_shift = shift;
+                    best_entry = static_cast<int>(entry);
+                    best_here = true;
+                }
+            }
+            if (best_here) {
+                best_errors = std::move(errors);
+            }
+        }
+        // A path that repeats (pacing, circling) fits again one round later: of the shifts that
+        // fit about as well as the best one, the smallest is the delay.
+        for (size_t index = 0; index < best_errors.size() && best_shift >= 0; ++index) {
+            const double shift = static_cast<double>(index) * 0.05;
+            if (shift > best_shift - 0.5) {
+                break;
+            }
+            if (best_errors[index] >= 0 && best_errors[index] <= best_error * 1.5 + 0.03) {
+                best_shift = shift;
+                best_error = best_errors[index];
+                break;
+            }
+        }
+        // The two paths must really match at the best shift (this also picks the right entry).
+        if (best_shift < 0 || best_error > 0.35) {
+            peer.why = fmt::format("no time shift fits (best {:.2f} s, {:.2f} m off)", best_shift,
+                                   best_error);
+            continue;
+        }
+        peer.entry = best_entry;
+        peer.move_delay = best_shift;
+        peer.delays.push_back(best_shift);
+        if (peer.delays.size() > 3) {
+            peer.delays.erase(peer.delays.begin());
+        }
+        const auto [low, high] = std::minmax_element(peer.delays.begin(), peer.delays.end());
+        if (peer.delays.size() != 3 || *high - *low > 0.11) {
+            peer.why = fmt::format("{:.2f} s late, not steady yet ({} readings, {:.2f}-{:.2f})",
+                                   best_shift, peer.delays.size(), *low, *high);
+            continue;
+        }
+        const double late = (*low + *high) / 2;
+        if (peer.before_step >= 0) {
+            // The last step should have taken its size off this delay. If it did not, the delay
+            // was already as small as it gets (slow frames): that is this peer's floor.
+            if (late > peer.before_step - last_step + 0.08) {
+                peer.floor = std::max(peer.floor, late);
+                peer.floor_at = now;
+                Log(fmt::format("player {}: {:.2f} s is as early as its moves get here", peer.no,
+                                peer.floor));
+            }
+            peer.before_step = -1;
+        }
+        // A floor learned from one bad reading comes down again: 0.05 s a minute.
+        if (peer.floor > 0.1 && now - peer.floor_at > 60s) {
+            peer.floor = std::max(0.1, peer.floor - 0.05);
+            peer.floor_at = now;
+        }
+        peer.why = fmt::format("{:.2f} s late (floor {:.2f})", late, peer.floor);
+        if (late > DELAY_GOOD && late - peer.floor > DELAY_MARGIN && late - peer.floor > worst) {
+            worst = late - peer.floor;
+            worst_late = late;
+            worst_no = peer.no;
+        }
+    }
+    if (now - delay_logged >= 30s) {
+        delay_logged = now;
+        for (const auto& [key, peer] : peers) {
+            if (peer.move_delay >= 0) {
+                Log(fmt::format("peer player {}: its moves show {:.2f} s late here (entry {})",
+                                peer.no, peer.move_delay, peer.entry));
+            }
+            if (!peer.why.empty()) {
+                Log(fmt::format("peer player {}: delay check: {}", peer.no, peer.why));
+            }
+        }
+    }
+    if (worst <= 0) {
+        return;
+    }
+    // The network clock sync does this job exactly; the step is only for a peer that does not
+    // send its clock (an older version).
+    for (const auto& [key, peer] : peers) {
+        if (now - peer.net_at < 5s) {
+            return;
+        }
+    }
+    if (session_stepped_s > 30.0) {
+        if (!step_cap_logged) {
+            step_cap_logged = true;
+            Log("clock steps reached 30 s in this session: no more steps until the next one");
+        }
+        return;
+    }
+    // A big delay is stepped away at once. A small one by half: our step shows on the other game
+    // as its moves arriving later, so two games that each overdo it would undo each other for ever.
+    const double step = std::min(3.0, worst > 0.6 ? worst - 0.1 : worst * 0.5 + 0.05);
+    last_step = step;
+    for (auto& [key, peer] : peers) {
+        peer.before_step = peer.delays.size() == 3 ? peer.move_delay : -1;
+    }
+    Common::Nx2PerfFlags::g_guest_tick_offset.fetch_add(
+        static_cast<s64>(step * static_cast<double>(Common::g_wall_clock.GetGuestCNTFRQ())),
+        std::memory_order_relaxed);
+    stepped_s += step;
+    session_stepped_s += step;
+    ++step_count;
+    Log(fmt::format("player {}'s moves showed {:.2f} s late: guest clock stepped {:+.2f} s "
+                    "(total {:+.2f} s)",
+                    worst_no, worst_late, step, stepped_s));
+    for (auto& copy : copies) {
+        copy.clear();
+    }
+    for (auto& [key, peer] : peers) {
+        peer.own.clear();
+        peer.delays.clear();
+    }
+    delay_hold = now + 6s;
+}
+
+Assist::Assist(System& system) : state{std::make_unique<State>(system)} {
+    thread = std::jthread([this](std::stop_token stop) { state->Run(stop); });
+}
+
+Assist::~Assist() {
+    thread.request_stop();
+    if (thread.joinable()) {
+        thread.join();
+    }
+}
+
+std::unique_ptr<Assist> MaybeStart(System& system, u64 program_id) {
+    if (program_id != TITLE_ID) {
+        return nullptr;
+    }
+    if (const char* text = std::getenv("LICHII_DUSK_LAN"); text != nullptr &&
+                                                           std::string_view{text} == "0") {
+        LOG_INFO(Core, "Duskbloods LAN assist is off (LICHII_DUSK_LAN=0)");
+        return nullptr;
+    }
+    return std::make_unique<Assist>(system);
+}
+
