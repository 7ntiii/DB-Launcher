+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstddef>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Kernel {
+class KProcess;
+}
+
+// JIT seed: the guest code blocks each core's JIT compiled are kept per program and build, as
+// offsets from the program image (the image moves every boot). At the next boot every core's JIT
+// compiles its list before the application's first instruction, so code met in earlier sessions
+// no longer stalls the game while it compiles the first time it runs (match start, the first use
+// of a skill, new areas: frames of up to 0.6 s). The list grows as the game runs and is written to
+// <cache dir>/jit/<program id>/<build id>.bin every 10 s; a shared build can ship one in
+// <exe dir>/jit_seed/<program id>/ (both are read). EDEN_NX2_JIT_SEED=0 turns it off.
+namespace Core::JitSeed {
+
+/// Called by each core before it first runs the application's code: the first call for a process
+/// compiles every core's list (in parallel); the other cores wait until that is done.
+void EnsureSeeded(Core::System& system, Kernel::KProcess& process);
+
+/// A core's JIT compiled the block at `location` (dynarmic's A64 location descriptor value).
+void Record(const Kernel::KProcess& process, std::size_t core, u64 location);
+
+} // namespace Core::JitSeed
