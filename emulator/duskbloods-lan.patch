+void Assist::State::Log(const std::string& line) {
+    LOG_INFO(Core, "Duskbloods LAN: {}", line);
+    if (log.is_open()) {
+        log << Stamp() << ' ' << line << '\n';
+        log.flush();
+    }
+}
+
+bool Assist::State::Read(u64 address, void* out, size_t size) {
+    auto* dst = static_cast<u8*>(out);
+    while (size != 0) {
+        // GetPointerSilent reads the page entry as guest cores do, with no log or GPU download.
+        const u8* const src = (address >> 48) == 0 ? memory->GetPointerSilent(address) : nullptr;
+        if (src == nullptr) {
+            return false;
+        }
+        const size_t chunk = std::min<size_t>(size, PAGE_SIZE - (address & (PAGE_SIZE - 1)));
+        std::memcpy(dst, src, chunk);
+        dst += chunk;
+        address += chunk;
+        size -= chunk;
+    }
+    return true;
+}
+
+bool Assist::State::Write(u64 address, const void* in, size_t size) {
+    // Check every page first, so a write is either whole or not done.
+    for (u64 page = address & ~(PAGE_SIZE - 1); page < address + size; page += PAGE_SIZE) {
+        if ((page >> 48) != 0 || memory->GetPointerSilent(page) == nullptr) {
+            return false;
+        }
+    }
+    const auto* src = static_cast<const u8*>(in);
+    while (size != 0) {
+        u8* const dst = memory->GetPointerSilent(address);
+        const size_t chunk = std::min<size_t>(size, PAGE_SIZE - (address & (PAGE_SIZE - 1)));
+        std::memcpy(dst, src, chunk);
+        src += chunk;
+        address += chunk;
+        size -= chunk;
+    }
+    return true;
+}
+
+void Assist::State::FindMain() {
+    Loader::AppLoader::Modules modules;
+    if (system.GetAppLoader().ReadNSOModules(modules) == Loader::ResultStatus::Success) {
+        for (const auto& [base, name] : modules) {
+            std::array<u8, MAIN_BUILD_ID.size()> id{};
+            if (Read(base + MAIN_BUILD_ID_OFFSET, id.data(), id.size()) && id == MAIN_BUILD_ID) {
+                main = base;
+                break;
+            }
+        }
+    }
+    if (main == 0) {
+        if (++find_tries == 30) {
+            idle = true;
+            Log("no main module with build id 14925E87E1ACD4D5E9D071AFEED230A1D4569F98 (another "
+                "version of the game?); the assist is off");
+        }
+        return;
+    }
+    for (const auto& [offset, word] : HOOKS) {
+        if (Get<u32>(main + offset) != word) {
+            idle = true;
+            Log(fmt::format("main {:#x}: the built-in patch \"Duskbloods LAN\" is not applied (off "
+                            "in Add-Ons?); the assist is off",
+                            main));
+            LOG_WARNING(Core, "Duskbloods LAN: the built-in patch is not applied; LAN assist off");
+            return;
+        }
+    }
+    active = true;
+    Log(fmt::format("main base {:#x}; built-in LAN patch active", main));
+}
