+    }
+    std::erase_if(peers, [now](const auto& item) { return now - item.second.at > 20s; });
+    in_battle = join_state == 8 && phase == PHASE_UPDATE;
+    if (!in_battle) {
+        own_new.clear();
+        for (auto& copy : copies) {
+            copy.clear();
+        }
+        for (auto& [key, peer] : peers) {
+            peer.own.clear();
+            peer.delays.clear();
+        }
+    }
+    if (join_state != 8) {
+        return;
+    }
+    const u32 local_no = LocalPlayerNo();
+    const u64 clock = Get<u64>(stage + P_CLOCK);
+    const f32 left = clock != 0 ? Get<f32>(clock + 8) : 0.0f;
+    clock_left = left;
+    // CLOCKADD: a jump UP of 20..40 s in one tick, same UpdatePhase, against the last value we
+    // read or wrote (the sync, the final run-down and CUTAUTH update that baseline).
+    f32 clock_jump = 0;
+    if (clock != 0 && phase == PHASE_UPDATE && clock_prev_phase == PHASE_UPDATE &&
+        clock_prev_left > 1.0f && left > 1.0f) {
+        const f32 up = left - clock_prev_left;
+        if (up >= 20.0f && up <= 40.0f) {
+            clock_jump = up;
+        }
+    }
+    clock_prev_left = clock != 0 ? left : -1.0f;
+    clock_prev_phase = phase;
+    if (phase != PHASE_UPDATE) {
+        clock_add_pending = 0;
+        clock_add_resend = 0;
+    }
+    EnvEvent(stage, phase, local_no, now);
+    SyncNetClock(now);
+
+    // One message per address the game talks to on its P2P socket, each with that peer's echo.
+    for (const auto& [ip, port] : Network::LanSide::Peers()) {
+        SideMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.phase = static_cast<u8>(phase);
+        out.clock_left = left;
+        out.instance = instance;
+        out.steps = step_count;
+        const auto send_time = Clock::now();
+        out.sent_us = MicrosNow(send_time);
+        const u64 address = (u64{ip} << 16) | port;
+        for (const auto& [id, peer] : peers) {
+            if (now - peer.at < 3s && std::find(peer.addresses.begin(), peer.addresses.end(),
+                                                address) != peer.addresses.end()) {
+                out.echo_us = peer.sent_us;
+                out.echo_hold_us = static_cast<u32>(
+                    std::chrono::duration_cast<std::chrono::microseconds>(send_time - peer.at)
+                        .count());
+                break;
+            }
+        }
+        const bool sent = Network::LanSide::SendTo(
+            ip, port, std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+        ++side_sent[address][sent ? 0 : 1]; // v3.9.3 (C, 3c): false = the socket is gone
+    }
+    if (!own_new.empty()) {
+        const size_t count = std::min(own_new.size(), MAX_SPOTS);
+        std::vector<u8> bytes(sizeof(SpotsHeader) + count * sizeof(SpotSample));
+        SpotsHeader head;
+        head.count = static_cast<u8>(count);
+        head.instance = instance;
+        std::memcpy(bytes.data(), &head, sizeof(head));
+        for (size_t i = 0; i < count; ++i) {
+            const Spot& from = own_new[own_new.size() - count + i];
+            const SpotSample spot{static_cast<u64>(from.t * 1e6), from.x, from.z};
+            std::memcpy(bytes.data() + sizeof(head) + i * sizeof(spot), &spot, sizeof(spot));
+        }
+        Network::LanSide::Send(bytes);
+        own_new.clear();
+    }
+    MoveDelay(now);
+
+    // The match timer: follow the player with the lowest number that is in the battle too.
+    const Peer* leader = nullptr;
+    for (auto& [key, peer] : peers) {
+        if (now - peer.at >= 3s || peer.phase != PHASE_UPDATE || phase != PHASE_UPDATE ||
+            PeerCut(peer)) { // review1b C1: a cut game is not our match's timer
+            continue;
+        }
+        // Its clock now: the value when sent, less the time since it got here and half a trip.
+        const f32 age = std::chrono::duration<f32>(now - peer.at).count() +
+                        (peer.ping_us > 0 ? static_cast<f32>(peer.ping_us) / 2e6f : 0.0f);
+        peer.timer_gap = left - (peer.clock_left - age);
+        if (peer.no < local_no && (leader == nullptr || peer.no < leader->no)) {
+            leader = &peer;
+        }
+    }
+    if (leader != nullptr && clock != 0 && local_no != ~0U) {
+        const f32 target = left - leader->timer_gap;
+        if (std::fabs(leader->timer_gap) > 0.25f && target > 1.0f && left > 1.0f) {
+            Put<f32>(clock + 8, target);
+            clock_prev_left = target;
+            ++synced;
+            if (synced <= 3 || synced % 20 == 0) {
+                Log(fmt::format(
+                    "match timer set to player {}'s: {:.1f} -> {:.1f} s (correction #{})",
+                    leader->no, left, target, synced));
+            }
+        }
+    }
+    // CLOCKADD: a non-leader tells the leader about its own jump (3 sends, one seq: v2 C3); the
+    // leader applies heard adds.
+    if (clock_jump > 0 && leader != nullptr && local_no != ~0U) {
+        ClockAddMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.phase = static_cast<u8>(phase);
+        out.round = static_cast<u8>(Get<u32>(stage + P_ROUND));
+        out.add = clock_jump;
+        out.instance = instance;
+        out.seq = ++clock_add_seq;
+        std::memcpy(clock_add_out.data(), &out, sizeof(out));
+        clock_add_resend = 3;
+        Log(fmt::format("clock add: our phase clock jumped {:.1f} -> {:.1f} s (+{:.1f}); told "
+                        "the leader, player {} (CLOCKADD #{}, round {}, 3 sends)",
+                        left - clock_jump, left, clock_jump, leader->no, out.seq, out.round));
+    }
+    if (clock_add_resend > 0 && phase == PHASE_UPDATE) {
+        --clock_add_resend;
+        Network::LanSide::Send(std::span<const u8>(clock_add_out.data(), clock_add_out.size()));
+    }
+    if (clock_add_pending > 0 && phase == PHASE_UPDATE) {
+        if (now - clock_add_at > 2s) {
+            Log(fmt::format("clock add: {:.1f} s heard but not applied within 2 s; dropped "
+                            "(CLOCKADD v2 C2)",
+                            clock_add_pending));
+            clock_add_pending = 0;
+        } else if (leader == nullptr && clock != 0 && left > 1.0f) {
+            const f32 to = left + clock_add_pending;
+            Put<f32>(clock + 8, to);
+            clock_prev_left = to;
+            Log(fmt::format("clock add: we lead the timer; {:.1f} -> {:.1f} s (CLOCKADD)", left,
+                            to));
+            clock_add_pending = 0;
+        } else if (leader != nullptr) {
+            clock_add_pending = 0; // the leader heard the same message
+        }
+    }
+    // The final ends for a game when its own code sees the others out. The game of a player
+    // that was killed never sees that (the server told it), so it would watch the winner until
+    // its own clock ran out. When another game is past the final (winner sequence 12 / 13,
+    // result 14 / 29 / 36) and ours is still in it, our clock is run down: the game then ends
+    // the phase itself and shows its result (rank and rows as on the winner's game).
+    // Balance fix M1: only a finalist counts. A player culled after Phase III goes 10 -> 14 -> 29
+    // -> 36 and may still be in the session when the finalists fight; its result screen must not
+    // end their final. A finalist is a peer seen in UpdatePhase while our final's UpdatePhase runs
+    // (the culled one is past UpdatePhase by then). The marks are dropped outside a final (stage
+    // +0x3388 == 0, e.g. the next match of the session) and with the peers in EndSession.
+    const bool in_final_rounds = stage != 0 && Get<u64>(stage + 0x3388) != 0;
+    const bool our_final = in_final_rounds && phase == PHASE_UPDATE;
+    // N4: also while the match is before the final (round < 4): a mark from the last match's final
+    // must not make this match's culled player count as a finalist.
+    if (stage != 0 && (!in_final_rounds || Get<u32>(stage + P_ROUND) < FINAL_ROUND)) {
+        for (auto& [key, peer] : peers) {
+            if (peer.finalist) {
+                Log(fmt::format("final: player {}'s finalist mark cleared (round {}, final "
+                                "coordinator {}; N4)",
+                                peer.no, Get<u32>(stage + P_ROUND),
+                                in_final_rounds ? "still set" : "gone"));
+            }
+            peer.finalist = false;
+            peer.not_finalist_logged = false;
+        }
+    }
+    if (our_final) {
+        for (auto& [key, peer] : peers) {
+            if (!peer.finalist && now - peer.at < 3s && peer.phase == PHASE_UPDATE) {
+                peer.finalist = true;
+                Log(fmt::format("final: player {} is in the final with us", peer.no));
+            }
+        }
+    }
+    if (our_final && clock != 0 && left > 2.0f) {
+        const auto past = [](u32 theirs) {
+            return theirs == 12 || theirs == 13 || theirs == 14 || theirs == 29 || theirs == 36;
+        };
+        for (auto& [key, peer] : peers) {
+            if (!peer.finalist && !peer.not_finalist_logged && now - peer.at < 3s &&
+                past(peer.phase)) {
+                peer.not_finalist_logged = true;
+                Log(fmt::format("final: player {} is at step {} but was not in our final; our "
+                                "clock is left alone (balance fix M1)",
+                                peer.no, peer.phase));
+            }
+        }
+        // Final placement (lives_stuck_notes.md 4c): first see whether our own player is out for
+        // good (remembered only; FinalAlign places it after our EndPhase). Then the clock is run
+        // down when our player is out, or when every other finalist is out (we are the last
+        // alive), or (review3 F1) when a finalist has been past the final for 10 s anyway.
+        FinalOutCheck(now);
+        const std::optional<bool> alive = FinalLocalAlive();
+        const bool others_out = FinalOthersOut();
+        // Bloodbound (rule byte 2): our side is our pair. It is alive while our player is, or our
+        // partner is a finalist not out (bloodbound_notes 3). Rules 0 / 1: no partner, as before.
+        const u32 partner = PartnerOf(local_no);
+        const bool partner_alive =
+            partner != 0 && final_finalists.contains(partner) && !final_out.contains(partner);
+        const bool side_alive = alive.value_or(false) || partner_alive;
+        // V402b (spectate_notes.md 9; audit_v401_notes.md 4): with FINALOUT a finalist eliminated in
+        // a 3+ player final leaves UpdatePhase at once for its result (par+0x164 = 1 -> 0x114BA9C).
+        // While our side is alive that is not the end of OUR final, so such a finalist (its own game
+        // said it is out) does not count as "another game has finished the match" (before, review3
+        // F1 ran the survivors' clocks down 10 s later with no winner fought out). It is in final_out,
+        // so when it was the last other one, FinalOthersOut gives the 5-s "last alive" run-down.
+        // Unchanged, exactly as before: the 2-player final (FINALOUT never feeds the last
+        // elimination), Bloodbound (FinalFeed returns there; v399b), and a game whose side is out
+        // (it goes to its result as soon as any finalist is past, the game's own path).
+        const bool spectate_exit =
+            side_alive && final_finalists.size() >= 3 && Get<u8>(main + RULE_BYTE) != RULE_BLOODBOUND;
+        const auto out_for_good = [&](u32 player) {
+            const auto it = final_out.find(player);
+            return it != final_out.end() && it->second.told && !it->second.own;
+        };
+        const bool over = std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+            return entry.second.finalist && now - entry.second.at < 3s &&
+                   past(entry.second.phase) && !(spectate_exit && out_for_good(entry.second.no));
+        });
+        if (over) {
+            if (!final_over_since) {
+                final_over_since = now;
+            }
+        } else {
+            final_over_since.reset();
+        }
+        const bool hold_ended = final_over_since && now - *final_over_since >= 10s;
+        if (side_alive && others_out) {
+            if (!final_won_since) {
+                final_won_since = now;
+                Log(partner != 0
+                        ? fmt::format("final: every finalist of the other pairs is out and our "
+                                      "pair (us and player {}, {}) is alive: our pair is the last "
+                                      "alive; our clock is run down in 5 s unless our game ends "
+                                      "the final first",
+                                      partner,
+                                      alive.value_or(false) ? "our player alive"
+                                                            : "only the partner alive")
+                        : std::string("final: every other finalist is out and our player is "
+                                      "alive: we are the last alive; our clock is run down in 5 "
+                                      "s unless our game ends the final first"));
+            }
+        } else {
+            final_won_since.reset();
+        }
+        if (over && side_alive && !others_out && !hold_ended) {
+            if (!final_hold_logged) {
+                final_hold_logged = true;
+                Log(fmt::format("final: another game has finished the match, but our {} still "
+                                "alive and a finalist {}is not out; our clock is left alone "
+                                "for up to 10 s ({:.1f} s left)",
+                                partner != 0 ? "pair is" : "player is",
+                                partner != 0 ? "of another pair " : "", left));
+            }
+        } else if (over || (final_won_since && now - *final_won_since >= 5s)) {
+            Put<f32>(clock + 8, 1.0f);
+            clock_prev_left = 1.0f;
+            Log(fmt::format("final: {}; our phase clock is run down ({:.1f} -> 1.0 s; our player "
+                            "{})",
+                            !over ? (partner != 0 ? "every finalist of the other pairs is out "
+                                                    "(our pair is the last alive)"
+                                                  : "every other finalist is out (we are the last "
+                                                    "alive)")
+                            : side_alive && !others_out
+                                ? "another game has been past the final for 10 s although our "
+                                  "player is alive and a finalist is not out (review3 F1 bound)"
+                                : "another game has finished the match",
+                            left,
+                            !alive ? "not readable" : (*alive ? "alive" : "out")));
+        }
+    } else {
+        final_won_since.reset();
+        final_over_since.reset();
+    }
+    if (!peers.empty() && now - peers_logged >= 30s) {
+        peers_logged = now;
+        for (const auto& [key, peer] : peers) {
+            Log(fmt::format("peer player {}: ping {} ms, match timer gap {:+.2f} s", peer.no,
+                            peer.ping_us >= 0 ? fmt::format("{:.0f}", peer.ping_us / 1000.0) : "?",
+                            peer.timer_gap));
+        }
+        if (side_old_dropped != side_old_logged) {
+            Log(fmt::format("side channel: {} type-1 message(s) came out of order and were dropped "
+                            "(V400-4; {} in this session)",
+                            side_old_dropped - side_old_logged, side_old_dropped));
+            side_old_logged = side_old_dropped;
+        }
+    }
+}
+
+u32 Assist::State::LocalPlayerNo() {
+    const u64 table = Get<u64>(main + NET_PLAYERS);
+    u64 local = table != 0 ? Get<u64>(table + 0x28) : 0;
+    if (local == 0 && table != 0) {
+        local = Get<u64>(table + 0x20);
+    }
+    return local != 0 ? Get<u32>(local + 0xD0) : ~0U;
+}
+
+/// Bloodbound (rule byte 2 only): the partner of player `no` from the game's own alliance entries
+/// (AM deque, bloodbound_notes 1c; a +0, b +4), 0 when none, not readable, or another rule.
+u32 Assist::State::PartnerOf(u32 no) {
+    if (no == 0 || no > BB_MAX_PLAYERS || Get<u8>(main + RULE_BYTE) != RULE_BLOODBOUND) {
+        return 0;
+    }
+    const u64 am = Get<u64>(main + BB_AM);
+    if (am == 0) {
+        return 0;
+    }
+    const u64 block_map = Get<u64>(am + BB_AM_MAP);
+    const u64 first = Get<u64>(am + BB_AM_START);
+    const u64 entries = Get<u64>(am + BB_AM_COUNT);
+    if (block_map == 0 || entries > BB_AM_MAX) {
+        return 0;
+    }
+    for (u64 i = 0; i < entries; ++i) {
+        const u64 k = first + i;
+        const u64 block = Get<u64>(block_map + 8 * (k >> 7));
+        if (block == 0) {
+            continue;
+        }
+        const u64 at = block + (k & 0x7F) * BB_ENTRY_SIZE;
+        const u32 a = Get<u32>(at);
+        const u32 b = Get<u32>(at + 4);
+        const u32 mate = a == no ? b : b == no ? a : 0;
+        if (mate != 0 && mate != no && mate <= BB_MAX_PLAYERS) {
+            return mate;
+        }
+    }
+    return 0;
+}
+
+/// H1 (many_players_fix_notes.md): the one "still in the match" rule. A player whose game is at a
+/// result step (14 / 29 / 36) is cut while the match goes on: in rounds 2..3 always (a player who
+/// goes on passes 10 -> 11, never 14), in the final only when it is not a finalist (the finalists'
+/// games all end at 14 / 29 / 36).
+/// Review5: this only decides whether a report RECORDS a cut. The record (cut_nos) is latched for
+/// the match (A), so a cut player that leaves its Outcome or goes silent stays cut. In the final a
+/// cut is recorded only before our final's UpdatePhase (final_finalists empty, C). With exactly
+/// two players nobody is cut (top 6 / top 3 go on): a 14 then is an early match end (two allies,
+/// a points win) and the roles stay as in v3.4 (case 8).
+bool Assist::State::CutStep(u32 phase, u32 no, bool finalist) {
+    if (phase != 14 && phase != 29 && phase != 36) {
+        return false;
+    }
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    // Round 1 has no cut: a game at a result step then is still at the end of the last match
+    // (a new match in the same session), not cut from this one.
+    if (round < 2) {
+        return false;
+    }
+    if (TwoPlayers()) {
+        if (round < FINAL_ROUND && cut_two_logged != match_gen) {
+            cut_two_logged = match_gen;
+            Log(fmt::format("H1: two players in this match: player {} at result step {} (round {}) "
+                            "is not taken as cut; the roles stay as in v3.4 (review5 case 8)",
+                            no, phase, round));
+        }
+        return false;
+    }
+    if (round < FINAL_ROUND) {
+        return true;
+    }
+    return final_finalists.empty() && !finalist;
+}
+
+/// Review5 A: cut_nos belongs to one match. A new match (match_gen) or round 1 starts it empty.
+void Assist::State::CutLatchCheck() {
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    if (cut_gen == match_gen && (stage == 0 || round >= 2)) {
+        return;
+    }
+    if (!cut_nos.empty()) {
+        Log(fmt::format("H1: the cut players of the last match are forgotten (match load #{}, "
+                        "round {}; review5 A)",
+                        match_gen, round));
+    }
+    cut_nos.clear();
+    cut_stale_logged.clear();
+    cut_gen = match_gen;
+}
+
+/// Review5 case 8: exactly two players in this session (the most ever counted or heard).
+bool Assist::State::TwoPlayers() {
+    std::set<u32> numbers;
+    const u32 our_no = LocalPlayerNo();
+    if (our_no != 0 && our_no != ~0U) {
+        numbers.insert(our_no);
+    }
+    for (const auto& [key, peer] : peers) {
+        if (peer.no != 0 && peer.no != 0xFF) {
+            numbers.insert(peer.no);
+        }
+    }
+    session.players_seen = std::max(session.players_seen, numbers.size());
+    return std::max(session.match_players, session.players_seen) == 2;
+}
+
+/// H1: a peer is cut. Review5 A: latched by number for the match (cut_nos); a report from a game
+/// that played this match (D) at a result step records it, a match step (6 / 9 / 10 / 11 / 17..26)
+/// from it erases it again. Not recorded while our own game is cut (its round stays the old one).
+bool Assist::State::PeerCut(const Peer& peer) {
+    CutLatchCheck();
+    if (peer.no == 0) {
+        return false;
+    }
+    if (cut_instances_gen != match_gen) { // v410 H1: the latch belongs to one match
+        cut_instances_gen = match_gen;
+        cut_instances.clear();
+        cut_instance_drop_logged.clear();
+    }
+    const bool latched = peer.instance != 0 && cut_instances.contains(peer.instance);
+    const bool in_match = peer.in_match_gen == match_gen;
+    const bool match_step = peer.phase == PHASE_UPDATE || peer.phase == PHASE_PRE_RESULT ||
+                            peer.phase == 10 || peer.phase == 11 ||
+                            (peer.phase >= PHASE_ENV_LOT && peer.phase <= PHASE_INTERMISSION);
+    if (in_match && match_step && !latched && cut_nos.erase(peer.no) != 0) {
+        Log(fmt::format("H1: player {} is in a match step again (step {}); no longer cut "
+                        "(review5 A)",
+                        peer.no, peer.phase));
+    }
+    if (CutStep(peer.phase, peer.no, peer.finalist)) {
+        if (!in_match) {
+            if (cut_stale_logged.insert(peer.no).second) {
+                Log(fmt::format("H1: player {} is at result step {}, but its game was not seen in "
+                                "this match's steps 6 / 9 / 10; not taken as cut (an old match's "
+                                "result; review5 D)",
+                                peer.no, peer.phase));
+            }
+        } else if (latched) {
+            // v410 H1: cut already, by game: the number it shows now may be another match's.
+        } else if (!own_cut_logged && cut_nos.insert(peer.no).second) {
+            Log(fmt::format("H1: player {} is cut (its game is at result step {} while the match "
+                            "goes on); it is no longer taken as the host or waited for, for the "
+                            "rest of this match (latched: review5 A)",
+                            peer.no, peer.phase));
+        }
+        if (in_match && !latched && !own_cut_logged && peer.instance != 0 &&
+            cut_nos.contains(peer.no)) {
+            cut_instances.insert(peer.instance); // v410 H1: latched by game as well
+        }
+    }
+    if (latched) {
+        // v410 H1: this game was cut in our match; whatever step or number it shows now (a new
+        // match of its own) it is not one of our players again.
+        return true;
+    }
+    if (!cut_nos.contains(peer.no)) {
+        return false;
+    }
+    // Review5 C: a finalist is never cut (a wrong record is ignored in the final).
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    return round < FINAL_ROUND || !(peer.finalist || final_finalists.contains(peer.no));
+}
+
+/// H1: our own player is cut (our game's step). Review5 D: only after our game was at 6 / 9 / 10 in
+/// this match. Never in round 4: a game cut after Phase III stays at round 3 (it never reaches the
+/// 17 / 18 that count the round up), so a 14 at round 4 here is the end of our own final.
+bool Assist::State::LocalCut(u32 phase) {
+    if (phase == PHASE_UPDATE || phase == PHASE_PRE_RESULT || phase == 10) {
+        local_in_match_gen = match_gen;
+    }
+    const u32 local_no = LocalPlayerNo();
+    if (local_no == 0 || local_no == ~0U || local_in_match_gen != match_gen) {
+        return false;
+    }
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    return round < FINAL_ROUND && CutStep(phase, local_no, false);
+}
+
+/// v3.9.4 F4 (players8_notes.md F4): the player is cut in this match, by the H1 record (cut_nos,
+/// latched per match), with the same finalist exception as PeerCut. Empty in a two-player match
+/// (CutStep never records there) and in round 1.
+bool Assist::State::CutNo(u32 no) {
+    CutLatchCheck();
+    if (no == 0 || !cut_nos.contains(no)) {
+        return false;
+    }
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    if (round < FINAL_ROUND) {
+        return true;
+    }
+    if (final_finalists.contains(no)) {
+        return false;
+    }
+    for (const auto& [key, peer] : peers) {
+        if (peer.no == no && peer.finalist) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/// v3.9.4 F1 (players8_notes.md F1): (a) right after the cut step of rounds 1..3 (first pass at
+/// step 10 / 11 / 14) note our phase entries (no, rank +0x10, team rank +0x20 under Bloodbound,
+/// reason byte of +0x40) and log them with a hash; (b) the authority (role byte 0, not cut) sends
+/// that list as type 13 once a second, 20 times; (c) every other game compares the lists it hears
+/// for its round with its own and logs "same" or a loud mismatch.
+/// The authority's list is NOT written: the cut event has already fired on this game when the list
+/// can be compared (it fires inside EndPhase, before step 10), so writing ranks or state words now
+/// would not un-cut or cut anybody and would only make the result rows disagree with what the game
+/// did. The log line is the deliverable; a real fix decides the cut before EndPhase (notes 1).
+void Assist::State::CutCheck(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const u32 round = Get<u32>(stage + P_ROUND);
+    const u32 local_no = LocalPlayerNo();
+    if (round < 1 || round >= FINAL_ROUND || local_no == 0 || local_no > 0xFF) {
+        return;
+    }
+    const bool after_cut = phase == 10 || phase == 11 || phase == 14;
+    if (after_cut && (cut_snap_gen != match_gen || !cut_snap || cut_snap->round != round)) {
+        const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+        if (count == 0 || count > P_ENTRY_MAX) {
+            return; // not filled (yet): the next pass tries again
+        }
+        CutSnap snap;
+        snap.round = round;
+        snap.rule = Get<u8>(main + RULE_BYTE);
+        snap.at = now;
+        std::map<u32, u32> words;
+        for (u64 i = 0; i < count; ++i) {
+            const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+            const u32 no = Get<u32>(entry);
+            if (no == 0 || no > 0xFF) {
+                continue;
+            }
+            const u32 rank = Get<u32>(entry + PE_RANK);
+            const u32 team = snap.rule == RULE_BLOODBOUND ? Get<u32>(entry + 0x20) : 0;
+            const u32 word = Get<u32>(entry + PE_STATE);
+            snap.entries.push_back({static_cast<u8>(no), static_cast<u8>(std::min<u32>(rank, 0xFF)),
+                                    static_cast<u8>(std::min<u32>(team, 0xFF)),
+                                    static_cast<u8>((word >> 8) & 0xFF)});
+            words[no] = word;
+        }
+        std::ranges::sort(snap.entries);
+        snap.hash = CutHash(snap.entries, snap.rule);
+        std::string state_text;
+        for (const auto& [no, word] : words) {
+            state_text += fmt::format(" {}={}", no, StageBytes(word));
+        }
+        // v3.9.7 (diag/net/tiebreak_notes.md): the Virtue each entry was ranked with, read here
+        // (our player: the published total; a copy: its banked total, which VirtueShare keeps
+        // equal to its owner's), so a tie is visible in every game's log. The rank record builder
+        // 0xF88D60 keys (total, index of the player number) once VIRTUE_TIEBREAK has zeroed the
+        // category sums and pgd+0x6C: equal totals go to the lower player number on every game.
+        // Read only; nothing changes when there is no tie. Bloodbound ranks the Duo score
+        // (0xD17880) instead, so no tie is named there.
+        const u64 net_players = Get<u64>(main + NET_PLAYERS);
+        const bool own_known = Get<u32>(main + VIRTUE_BOX + 4) != 0;
+        std::map<u32, std::vector<u32>> by_total; // total -> player numbers (sorted)
+        std::string totals_text;
+        for (const auto& e : snap.entries) {
+            const u32 no = e[0];
+            u32 total = 0;
+            bool known = false;
+            if (no == local_no) {
+                known = own_known;
+                total = known ? static_cast<u32>(std::clamp<s32>(Get<s32>(main + VIRTUE_BOX), 0, VIRTUE_MAX))
+                              : 0; // v398c: clamped as the copies are (VirtueShare)
+            } else if (const u64 pgd = VirtuePlayer(net_players, no); pgd != 0) {
+                known = true;
+                total = Get<u16>(pgd + PGD_BANKED);
+            }
+            totals_text += known ? fmt::format(" {}={}", no, total) : fmt::format(" {}=?", no);
+            if (known) {
+                by_total[total].push_back(no);
+            }
+        }
+        std::string tie_text;
+        if (snap.rule != RULE_BLOODBOUND) {
+            for (const auto& [total, nos] : by_total) {
+                if (nos.size() < 2) {
+                    continue;
+                }
+                std::string ranked;
+                for (const u32 no : nos) {
+                    const auto it = std::ranges::find_if(
+                        snap.entries, [no](const auto& e) { return e[0] == no; });
+                    ranked += fmt::format(" {}:{}", no, it != snap.entries.end() ? it->at(1) : 0);
+                }
+                tie_text += fmt::format("; tie at {} (no:rank{}): lower player number first", total,
+                                        ranked);
+            }
+        }
+        const bool authority = Get<u8>(main + GENERATOR_IDLE) == 0;
+        Log(fmt::format("cut check (F1): round {} step {}: our list (no:rank{}){} hash {:08x}; "
+                        "state words{}; ranked totals{}{}; {}",
+                        round, phase, snap.rule == RULE_BLOODBOUND ? ":team" : "",
+                        CutText(snap.entries, snap.rule), snap.hash, state_text, totals_text,
+                        tie_text,
+                        authority ? "we are the authority: sent to the others"
+                                  : "compared with the authority's list"));
+        cut_snap = std::move(snap);
+        cut_snap_gen = match_gen;
+        cut_snap_authority = authority; // V401c: the role this list was made in
+        cut_sends = 0;
+        cut_acked.clear(); // V400-1
+        cut_acks_logged = false;
+    }
+    if (cut_snap_gen != match_gen || !cut_snap || cut_snap->round != round) {
+        return;
+    }
+    // (b) the authority sends its list. V400-1: every 500 ms until every other listed player has
+    // answered (type 15) or 10 s have passed (was: 20 times, 1 s apart, unanswered).
+    bool cut_all_acked = true;
+    for (const auto& e : cut_snap->entries) {
+        if (e[0] != local_no && !cut_acked.contains(e[0])) {
+            cut_all_acked = false;
+        }
+    }
+    const bool cut_window = cut_sends == 0 || now - cut_first_sent < 10s;
+    if (cut_sends != 0 && !cut_acks_logged && (cut_all_acked || !cut_window)) {
+        cut_acks_logged = true;
+        std::string acked;
+        for (const u8 no : cut_acked) {
+            acked += fmt::format(" {}", no);
+        }
+        Log(fmt::format("cut check (V400-1): round {}: {} after {} send(s), {:.1f} s "
+                        "(answered by{})",
+                        round,
+                        cut_all_acked ? "every listed player has our list"
+                                      : "!!! not every listed player answered in 10 s",
+                        cut_sends,
+                        std::chrono::duration<double>(now - cut_first_sent).count(),
+                        acked.empty() ? std::string(" nobody") : acked));
+    }
+    // V401: also when our own player was cut in this step: the guests' CUTAUTH waits for this list
+    // (its ranks are the authority's decision either way), else they would hold for 10 s.
+    // V401c: a cut authority gives the role up within a second (EnvEvent, H1), so the list goes on
+    // being resent by the game that was the authority when it took this snapshot.
+    if ((Get<u8>(main + GENERATOR_IDLE) == 0 || cut_snap_authority) &&
+        (cut_sends == 0 || (!cut_all_acked && cut_window)) && now - cut_sent_at >= 500ms) {
+        if (cut_sends == 0) {
+            cut_first_sent = now;
+        }
+        CutListMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.round = static_cast<u8>(round);
+        out.count = static_cast<u8>(std::min<size_t>(cut_snap->entries.size(), out.entries.size()));
+        out.instance = instance;
+        out.hash = cut_snap->hash;
+        out.rule = cut_snap->rule;
+        for (size_t i = 0; i < out.count; ++i) {
+            out.entries[i] = cut_snap->entries[i];
+        }
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+        cut_sent_at = now;
+        ++cut_sends;
+    }
+    // (c) compare with every list heard for this round.
+    bool heard_any = false;
+    for (const auto& [no, theirs] : cut_heard) {
+        if (theirs.round != round || now - theirs.at > 60s || no == local_no) {
+            continue;
+        }
+        heard_any = true;
+        if (!cut_compared.insert({match_gen, (u32{no} << 8) | round}).second) {
+            continue;
+        }
+        if (theirs.rule != cut_snap->rule) {
+            Log(fmt::format("!!! cut check (F1): round {}: player {} plays rule {} and we play "
+                            "rule {}: the games do not even share the rule set !!!",
+                            round, no, RuleName(theirs.rule), RuleName(cut_snap->rule)));
+        } else if (theirs.hash == cut_snap->hash) {
+            Log(fmt::format("cut check (F1): round {}: same list as the authority (player {}), "
+                            "hash {:08x}",
+                            round, no, theirs.hash));
+        } else {
+            std::string diff;
+            for (const auto& e : cut_snap->entries) {
+                const auto other = std::ranges::find_if(
+                    theirs.entries, [&e](const auto& t) { return t[0] == e[0]; });
+                if (other == theirs.entries.end()) {
+                    diff += fmt::format(" {}: only here", e[0]);
+                } else if ((*other)[1] != e[1] ||
+                           (cut_snap->rule == RULE_BLOODBOUND && (*other)[2] != e[2])) {
+                    diff += fmt::format(" {}: rank {} here, {} there", e[0], e[1], (*other)[1]);
+                }
+            }
+            for (const auto& t : theirs.entries) {
+                if (std::ranges::none_of(cut_snap->entries,
+                                         [&t](const auto& e) { return e[0] == t[0]; })) {
+                    diff += fmt::format(" {}: only there", t[0]);
+                }
+            }
+            Log(fmt::format("!!! CUT MISMATCH (F1) round {}: ours{} (hash {:08x}), the "
+                            "authority's (player {}){} (hash {:08x}); differences:{}. Nothing is "
+                            "written (the cut already ran here); the games may now cut different "
+                            "players !!!",
+                            round, CutText(cut_snap->entries, cut_snap->rule), cut_snap->hash, no,
+                            CutText(theirs.entries, theirs.rule), theirs.hash,
+                            diff.empty() ? std::string(" none listed") : diff));
+        }
+    }
+    if (!heard_any && Get<u8>(main + GENERATOR_IDLE) != 0 && now - cut_snap->at > 20s &&
+        cut_none_logged.insert({match_gen, round}).second) {
+        Log(fmt::format("cut check (F1): round {}: no authority list heard in 20 s (the authority "
+                        "runs an older build, or it is cut / gone); nothing compared",
+                        round));
+    }
+}
+
+/// v3.9.4 F1: side type 13 (CutListMessage), kept by sender number for CutCheck.
+void Assist::State::CutHeard(const Network::LanSide::Packet& packet) {
+    CutListMessage in;
+    if (packet.data.size() != sizeof(in)) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.player_no == 0 || in.count > in.entries.size() ||
+        in.round < 1 || in.round >= FINAL_ROUND) {
+        return;
+    }
+    // Audit J (J1): every entry's player number indexes CUTAUTH ranks[CUTAUTH_SLOTS] (CutAuth W2):
+    // a list with a number 0 or >= CUTAUTH_SLOTS is not ours (torn read or foreign), not taken.
+    for (size_t i = 0; i < in.count; ++i) {
+        if (in.entries[i][0] == 0 || in.entries[i][0] >= CUTAUTH_SLOTS) {
+            return;
+        }
+    }
+    CutSnap snap;
+    snap.round = in.round;
+    snap.rule = in.rule;
+    snap.at = packet.at;
+    snap.entries.assign(in.entries.begin(), in.entries.begin() + in.count);
+    std::ranges::sort(snap.entries);
+    snap.hash = CutHash(snap.entries, snap.rule); // recomputed: the carried hash is not trusted
+    // V400-1: answer the sender (every copy: the answer is what stops its resends), and say when
+    // the list came before our own cut step had run. Our cut is still our game's own: it is
+    // ranked and applied inside one game-thread call (EndPhase 0x1144A60 -> score manager vt+0x50
+    // rank 0xF871C0, then vt+0x60 cut 0xF879A0), so there is no moment at which this thread could
+    // safely put the authority's ranks in (assist_v400_notes.md 1).
+    const u32 our_no = main != 0 ? LocalPlayerNo() : 0;
+    if (our_no != 0 && our_no < 0x100) {
+        CutAckMessage ack;
+        ack.player_no = static_cast<u8>(our_no);
+        ack.round = in.round;
+        ack.instance = instance;
+        ack.to = in.instance;
+        ack.hash = snap.hash;
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&ack), sizeof(ack)));
+    }
+    // Before our cut = our game is still in this round's UpdatePhase (the cut runs in EndPhase).
+    const u64 stage = main != 0 ? Get<u64>(main + STAGE_PHASE) : 0;
+    const bool before_ours = stage != 0 && Get<u32>(stage + P_ROUND) == in.round &&
+                             Get<u32>(stage + P_STATE) == PHASE_UPDATE;
+    if (before_ours &&
+        cut_early_logged.insert({match_gen, (u32{in.player_no} << 8) | in.round}).second) {
+        Log(fmt::format("cut check (V400-1): round {}: the authority's list (player {}, hash {:08x})"
+                        " came before our own cut step; our game still cuts by its own ranking",
+                        in.round, in.player_no, snap.hash));
+    }
+    cut_heard[in.player_no] = std::move(snap);
+}
+
+/// V400-1: side type 15, an answer to the list this game sent for its current snapshot's round.
+void Assist::State::CutAckHeard(const Network::LanSide::Packet& packet) {
+    CutAckMessage in;
+    if (packet.data.size() != sizeof(in)) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.to != instance || in.instance == instance || in.player_no == 0 ||
+        cut_snap_gen != match_gen || !cut_snap || cut_snap->round != in.round) {
+        return; // not for us, ours, or for another round / match
+    }
+    if (cut_acked.insert(in.player_no).second && in.hash != cut_snap->hash) {
+        Log(fmt::format("!!! cut check (V400-1): round {}: player {} answered with hash {:08x}, "
+                        "ours is {:08x} (the list was damaged on the way?) !!!",
+                        in.round, in.player_no, in.hash, cut_snap->hash));
+    }
+}
+
+/// V401 CUTAUTH (cutauth_notes.md; realnet_notes R1; assist_v400_notes 1 "Real fix"). Every game cuts
+/// after Phases II / III from its own ranking (EndPhase: rank 0xF871C0, then cut 0xF879A0, back to back);
+/// after a stall at a phase end two games could cut different players. With the CUTAUTH group the cut
+/// compares the authority's rank from CUTAUTH_BOX. On a GUEST, in UpdatePhase of rounds 1..3 with 4+
+/// entries: (a) the phase clock is kept at about 0.5..0.8 s until the authority's type-13 list of this
+/// round is here (the authority cuts first; its list exists right after its own EndPhase); at most 10 s,
+/// then the game cuts by its own ranks as before (logged); (b) a list whose player numbers are exactly
+/// our entries' and whose rule is ours is written into the mailbox (ranks first, key last). After our
+/// cut step the players our game cut are compared with the authority's (reason byte 3) and logged.
+/// Inert: offline (the cave tests +0xBDA), on the authority (never filled, never held), with 2 / 3
+/// entries (nobody can be cut), without the group (hook word checked, logged once), in the final.
+void Assist::State::CutAuth(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const u32 round = Get<u32>(stage + P_ROUND);
+    const u64 key = (u64{match_gen} << 32) | round;
+    const bool authority = Get<u8>(main + GENERATOR_IDLE) == 0;
+    // The mailbox holds only this round's list of this match on a guest.
+    if (cutauth_for != 0 && (cutauth_for != key || authority || round < 1 || round >= FINAL_ROUND)) {
+        Put<u32>(main + CUTAUTH_BOX, 0);
+        cutauth_for = 0;
+        cutauth_list.clear();
+    }
+    // V401c: round 1 has no cut (PhaseInfo +0x92 = -1, CutStep), so no hold and no fill there.
+    if (authority || round < 2 || round >= FINAL_ROUND) {
+        return;
+    }
+    if (Get<u32>(main + CUTAUTH_SITE) != CUTAUTH_HOOK_WORD) {
+        if (!cutauth_missing_logged) {
+            cutauth_missing_logged = true;
+            Log("cut (CUTAUTH): the group is not in this build: every game cuts by its own ranks");
+        }
+        return;
+    }
+    const u8 rule = Get<u8>(main + RULE_BYTE);
+    const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+    if (count < CUTAUTH_MIN_ENTRIES || count > P_ENTRY_MAX) {
+        return; // nobody can be cut (or the list is not filled)
+    }
+    std::set<u8> ours;
+    for (u64 i = 0; i < count; ++i) {
+        const u32 no = Get<u32>(stage + P_ENTRIES + i * PE_SIZE);
+        if (no != 0 && no < CUTAUTH_SLOTS) {
+            ours.insert(static_cast<u8>(no));
+        }
+    }
+    // (b) fill the mailbox from the authority's list of this round
+    // V401c: UPDATE only. In PRE_RESULT our EndPhase may already be cutting: a box filled then
+    // could reach the cave half way through its entry loop (part own ranks, part the authority's).
+    if (cutauth_for != key && phase == PHASE_UPDATE) {
+        const CutSnap* best = nullptr;
+        u8 from = 0;
+        // walk8 W2: the authority's list of this round even when its player SET differs from ours
+        // (a player left and only some games dropped the entry yet). Only the authority sends type
+        // 13, so the lowest sender of this round is the authority (a hand-over gives a new sender).
+        const CutSnap* other = nullptr;
+        u8 other_from = 0;
+        for (const auto& [no, theirs] : cut_heard) {
+            if (theirs.round != round || now - theirs.at > 60s || theirs.rule != rule) {
+                continue;
+            }
+            std::set<u8> listed;
+            for (const auto& e : theirs.entries) {
+                listed.insert(e[0]);
+            }
+            if (listed == ours && (best == nullptr || no < from)) {
+                best = &theirs;
+                from = no;
+            } else if (listed != ours && (other == nullptr || no < other_from)) {
+                other = &theirs;
+                other_from = no;
+            }
+        }
+        // walk8 W2: no list with our exact set: take the authority's ranks BY PLAYER NUMBER instead
+        // of cutting by our own ranks after the hold. A player of ours missing from its list (it has
+        // left on the authority's game) gets rank CUTAUTH_GONE_RANK, above every threshold, so our
+        // game cuts it as the authority already did; its extra players are not in our loop anyway.
+        std::vector<std::array<u8, 4>> gone_here;
+        if (best == nullptr && other != nullptr) {
+            std::set<u8> listed;
+            for (const auto& e : other->entries) {
+                listed.insert(e[0]);
+            }
+            for (const u8 no : ours) {
+                if (!listed.contains(no)) {
+                    gone_here.push_back({no, CUTAUTH_GONE_RANK, CUTAUTH_GONE_RANK, 3});
+                }
+            }
+            std::string extra;
+            for (const u8 no : listed) {
+                if (!ours.contains(no)) {
+                    extra += fmt::format(" {}", no);
+                }
+            }
+            std::string gone_text;
+            for (const auto& e : gone_here) {
+                gone_text += fmt::format(" {}", e[0]);
+            }
+            Log(fmt::format("!!! cut (CUTAUTH, W2): round {}: our entry list differs from the authority's "
+                            "(player {}): ours has{} that it lacks (cut here as gone), it has{} that we "
+                            "lack (ignored); its ranks are taken by player number !!!",
+                            round, other_from, gone_text.empty() ? " none" : gone_text,
+                            extra.empty() ? " none" : extra));
+            best = other;
+            from = other_from;
+        }
+        if (best != nullptr) {
+            std::array<u8, CUTAUTH_SLOTS> ranks{};
+            for (const auto& e : best->entries) {
+                const u8 value = rule == RULE_BLOODBOUND ? e[2] : e[1];
+                if (e[0] < CUTAUTH_SLOTS) { // J1: never out of the array
+                    ranks[e[0]] = value; // 0 stays "not known": the game's own rank
+                }
+            }
+            for (const auto& e : gone_here) {
+                ranks[e[0]] = CUTAUTH_GONE_RANK;
+            }
+            if (!Write(main + CUTAUTH_BOX + CUTAUTH_RANKS, ranks.data(), ranks.size())) {
+                return;
+            }
+            Put<u32>(main + CUTAUTH_BOX, CUTAUTH_KEY | round); // last: the cave reads the key first
+            cutauth_for = key;
+            cutauth_list = best->entries;
+            cutauth_list.insert(cutauth_list.end(), gone_here.begin(), gone_here.end()); // W2: cut here too
+            const bool held = cutauth_hold_for == key && cutauth_holds != 0;
+            Log(fmt::format("cut (CUTAUTH): round {}: the authority's list (player {}, hash {:08x}) is in "
+                            "the mailbox (no:rank{}); our cut will use it{}",
+                            round, from, best->hash, CutText(best->entries, rule),
+                            held ? fmt::format(" (clock held {:.1f} s, {} raise(s))",
+                                               std::chrono::duration<double>(now - cutauth_hold_since)
+                                                   .count(),
+                                               cutauth_holds)
+                                 : std::string{}));
+        }
+    }
+    // (a) hold the end of our UpdatePhase until the list is in (at most CUTAUTH_HOLD_MAX)
+    if (phase == PHASE_UPDATE && cutauth_for != key && ours.size() >= CUTAUTH_MIN_ENTRIES) {
+        const u64 clock = Get<u64>(stage + P_CLOCK);
+        const f32 left = clock != 0 ? Get<f32>(clock + 8) : 1e9f;
+        if (cutauth_hold_for != key) {
+            if (left < CUTAUTH_HOLD_BELOW) {
+                cutauth_hold_for = key;
+                cutauth_hold_since = now;
+                cutauth_holds = 0;
+                cutauth_timeout_logged = false;
+                cutauth_handover = false;
+            }
+        }
+        if (cutauth_hold_for == key && left < CUTAUTH_HOLD_BELOW && !cutauth_handover) {
+            // v411 L1: is the authority (the LOWEST-numbered player still in the match) still heard?
+            // v411b: not "any lower player": players 3..N still hear player 2 when player 1 left,
+            // so they must test the lowest one, or they cut by their own ranks after 10 s.
+            const u32 local_no = LocalPlayerNo();
+            u32 lowest_known = ~0U;
+            u32 lowest_heard = ~0U;
+            for (const auto& [peer_key, peer] : peers) {
+                if (peer.no == 0 || peer.no >= local_no || PeerCut(peer)) {
+                    continue;
+                }
+                lowest_known = std::min<u32>(lowest_known, peer.no);
+                if (now - peer.at < CUTAUTH_AUTH_SILENT) {
+                    lowest_heard = std::min<u32>(lowest_heard, peer.no);
+                }
+            }
+            // Silent: nobody below us heard; or the lowest one heard is not the lowest one known
+            // (the leaver's record is kept 20 s); or the game still lists a player below the lowest
+            // one heard (record already dropped: the M5 window, up to 60 s). A false "silent" (a
+            // player cut earlier that is still listed) costs nothing: a list that arrives ends the hold.
+            const bool auth_silent =
+                lowest_heard == ~0U || lowest_heard > lowest_known ||
+                (lowest_heard > 1 && LowerPlayerListed(lowest_heard).value_or(false));
+            if (auth_silent && local_no != 0 && local_no < 0x100) {
+                cutauth_handover = true; // latched: the new authority's list comes after its own cut
+                Log(fmt::format("cut (CUTAUTH): round {}: no lower-numbered player heard for {} s (the "
+                                "authority left?): our phase end waits up to {} s for the new "
+                                "authority's list (v411 L1)",
+                                round, CUTAUTH_AUTH_SILENT.count(), CUTAUTH_HOLD_HANDOVER.count()));
+            }
+        }
+        const auto hold_max = cutauth_handover ? CUTAUTH_HOLD_HANDOVER : CUTAUTH_HOLD_MAX;
+        if (cutauth_hold_for == key && left < CUTAUTH_HOLD_BELOW) {
+            if (now - cutauth_hold_since < hold_max) {
+                Put<f32>(clock + 8, CUTAUTH_HOLD_TO);
+                clock_prev_left = CUTAUTH_HOLD_TO;
+                if (++cutauth_holds == 1) {
+                    Log(fmt::format("cut (CUTAUTH): round {}: our phase end waits for the authority's "
+                                    "list (clock {:.2f} -> {:.1f} s, at most {} s)",
+                                    round, left, CUTAUTH_HOLD_TO, CUTAUTH_HOLD_MAX.count()));
+                }
+            } else if (!cutauth_timeout_logged) {
+                cutauth_timeout_logged = true;
+                Log(fmt::format("!!! cut (CUTAUTH): round {}: no list from the authority in {} s: our "
+                                "game cuts by its own ranks (as before CUTAUTH) !!!",
+                                round,
+                                std::chrono::duration_cast<std::chrono::seconds>(hold_max).count()));
+            }
+        }
+    }
+    // after our cut step: what our game cut, against the authority's list (reason byte 3 = cut)
+    const bool after_cut = phase == 10 || phase == 11 || phase == 14;
+    if (after_cut && cutauth_for == key && cutauth_checked.insert(key).second) {
+        std::set<u8> cut_here;
+        std::set<u8> cut_there;
+        for (u64 i = 0; i < count; ++i) {
+            const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+            const u32 no = Get<u32>(entry);
+            const u32 word = Get<u32>(entry + PE_STATE);
+            if (no != 0 && no < 0x100 && (word & 0xFF) == 4 && ((word >> 8) & 0xFF) == 3) {
+                cut_here.insert(static_cast<u8>(no));
+            }
+        }
+        for (const auto& e : cutauth_list) {
+            if (e[3] == 3) {
+                cut_there.insert(e[0]);
+            }
+        }
+        const auto text = [](const std::set<u8>& nos) {
+            std::string out;
+            for (const u8 no : nos) {
+                out += fmt::format(" {}", no);
+            }
+            return out.empty() ? std::string(" none") : out;
+        };
+        Log(fmt::format("{}cut (CUTAUTH): round {}: cut here{}, cut by the authority{}: {}",
+                        cut_here == cut_there ? "" : "!!! ", round, text(cut_here), text(cut_there),
+                        cut_here == cut_there ? "same" : "DIFFERENT !!!"));
+    }
+}
