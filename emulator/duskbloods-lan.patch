+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Common::Nx2PerfFlags {
+
+/// Optimizations that can be switched while the game runs, for A/B timing in one scene (the
+/// debug server's "perf_flag" method). Each starts from its EDEN_NX2_* variable ("0" = off).
+enum class Flag : size_t {
+    DeferUncache, ///< OnCPUWrite changes page protection after dropping the caches' locks
+    FramesAhead2, ///< nx2_gsv present waits for the previous frame only (EDEN_NX2_FRAMES_AHEAD=2)
+    AcquireEarly, ///< puller: a GEQUAL acquire already met in memory skips the drain of the back
+    SkipListWriterWait, ///< dma_pusher: no wait for queued GPU writers before each entry
+    HitchLog, ///< logs every present > 50 ms apart with what each thread did (nx2_gsv.h)
+    TrapExpand, ///< a trapped CPU write marks its whole g_trap_expand_kb block (vk_rasterizer)
+    FramesAhead3, ///< with frames_ahead2, wait for the frame before the previous one (nx2_gsv)
+    FastMarks, ///< CPU write traps mark buffer pages without the buffer cache's lock
+    FastMarksKeep, ///< fast marks keep the pages protected (no page protection changes)
+    TrapFilter, ///< CPU write traps skip the texture and shader caches' locks off their pages
+    DlssAutoExposure, ///< DLSS computes its own exposure for HDR input (vk_streamline_dlss.cpp)
+    ManagerSkip, ///< uploads skip clean 4 MiB tracker managers by bitmap (memory_tracker_base.h)
+    Forward3D, ///< the GPU front runs the 3D methods, the back gets changes and draws (maxwell_3d)
+    MarkAfterStore, ///< guest writes to GPU-cached pages store, then mark (core/memory.cpp)
+    ForceRender, ///< debug: conditional rendering always draws (maxwell_3d ProcessQueryCondition)
+    D16BiasBoost, ///< 16-bit depth targets: constant depth bias x EDEN_NX2_D16_BIAS_SCALE (vk_rasterizer)
+    PinAdapt, ///< GPU thread pinning only while the GPU back thread is busy (nx2_gsv.h AdaptGpuPinning)
+    Count,
+};
+
+struct Info {
+    std::string_view name;
+    const char* env;
+    bool default_on;
+};
+
+inline constexpr std::array<Info, size_t(Flag::Count)> infos{{
+    {"defer_uncache", "EDEN_NX2_DEFER_UNCACHE", true},
+    {"frames_ahead2", "EDEN_NX2_FRAMES_AHEAD2_FLAG", false},
+    {"acquire_early", "EDEN_NX2_ACQUIRE_EARLY", false},
+    {"skip_list_writer_wait", "EDEN_NX2_SKIP_LIST_WRITER_WAIT", false},
+    {"hitch_log", "EDEN_NX2_HITCH_LOG", false},
+    {"trap_expand", "EDEN_NX2_TRAP_EXPAND", false},
+    {"frames_ahead3", "EDEN_NX2_FRAMES_AHEAD3", false},
+    {"fast_marks", "EDEN_NX2_FAST_MARKS", true},
+    {"fast_marks_keep", "EDEN_NX2_FAST_MARKS_KEEP", false},
+    {"trap_filter", "EDEN_NX2_TRAP_FILTER", true},
+    {"dlss_auto_exposure", "EDEN_NX2_DLSS_AUTO_EXPOSURE", true},
+    {"manager_skip", "EDEN_NX2_MANAGER_SKIP", true},
+    {"forward_3d", "EDEN_NX2_FORWARD_3D", false},
+    {"mark_after_store", "EDEN_NX2_MARK_AFTER_STORE", true},
+    {"force_render", "EDEN_NX2_FORCE_RENDER", false},
+    {"d16_bias_boost", "EDEN_NX2_D16_BIAS_BOOST", false},
+    {"pin_adapt", "EDEN_NX2_PIN_ADAPT", false},
+}};
+
+/// The flags' live values, read from the EDEN_NX2_* variables once at startup. A plain global:
+/// On() runs for every GPU command, where a function-local static's guard cost ~1% of the GPU
+/// thread.
+struct FlagValues {
+    std::array<std::atomic<bool>, size_t(Flag::Count)> values{};
+    FlagValues() {
+        for (size_t i = 0; i < infos.size(); ++i) {
+            const char* value = std::getenv(infos[i].env);
+            values[i].store(value == nullptr ? infos[i].default_on : value[0] != '0',
+                            std::memory_order_relaxed);
+        }
+    }
+};
+inline FlagValues g_flag_values;
+
+inline std::array<std::atomic<bool>, size_t(Flag::Count)>& Values() {
+    return g_flag_values.values;
+}
+
+inline bool On(Flag flag) {
+    return Values()[size_t(flag)].load(std::memory_order_relaxed);
+}
+
+/// Guest core idle spin in microseconds set live (debug server perf_flag idle_spin_us), -1 = the
+/// default (EDEN_NX2_IDLE_SPIN_US or the title's).
+inline std::atomic<long long> g_idle_spin_us{-1};
+
+/// JIT: returns and indirect branches get their own lookup + jump at each block exit (dynarmic
+/// a64_emit_x64.cpp). Read when a block is emitted; the "jit_inline_dispatch" perf flag sets it and
+/// clears the JIT caches so every block is emitted again. EDEN_NX2_JIT_INLINE_DISPATCH=1 turns it on.
+/// Default off: same-view live A/B in a Duskbloods match +0.4% +- 1.8% (no gain).
+inline std::atomic<bool> g_jit_inline_dispatch{[] {
+    const char* value = std::getenv("EDEN_NX2_JIT_INLINE_DISPATCH");
+    return value != nullptr && value[0] == '1';
+}()};
+
+/// Block size in KiB for TrapExpand (debug server perf_flag trap_expand_kb).
+inline std::atomic<unsigned> g_trap_expand_kb{[] {
+    const char* value = std::getenv("EDEN_NX2_TRAP_EXPAND_KB");
+    return value != nullptr ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : 64u;
+}()};
+
+/// GPU thread pinning plan (common/core_pinning.h: 0 whole cores for front and back, 1 the front
+/// shares its core with the guest cores, 2 front and back share one core, 3 front and back share
+/// their cores with the guest cores), debug server perf_flag pin_plan; EDEN_NX2_PIN_PLAN sets the
+/// start value.
+inline std::atomic<int> g_pin_plan{[] {
+    const char* value = std::getenv("EDEN_NX2_PIN_PLAN");
+    return value != nullptr ? static_cast<int>(std::strtol(value, nullptr, 10)) : 0;
+}()};
+
+/// Added to the counter the guest reads (CNTPCT_EL0 and svcGetSystemTick), in guest ticks
+/// (31.25 MHz for Switch 2 titles). Kernel timing does not use it. Lets a LAN game's clock be stepped to match its
+/// peer's (core/dusk_lan.cpp); debug server perf_flag tick_offset_ms sets it in milliseconds.
+inline std::atomic<s64> g_guest_tick_offset{0};
+
+/// Experiment: with frames_ahead3, presents wait for a frame this many further back (1 = three
+/// frames ahead ...; at most 5). Debug server perf_flag frames_ahead_extra. 0 = off.
+inline std::atomic<u32> g_frames_ahead_extra{0};
+
+/// Guest wait profile: while the present count is below this, Svc::Call times every system call
+/// per guest thread (svc.cpp) and logs the totals when the window ends. Debug server perf_flag
+/// svc_wait_frames N = the next N presents.
+inline std::atomic<u64> g_svc_wait_until{0};
+
+/// Service (HLE server) threads spin this many microseconds for their next request before they
+/// sleep (k_thread.cpp DummyThreadBeginWait): a request that follows closely is answered without
+/// a host thread wake-up. Debug server perf_flag service_spin_us; EDEN_NX2_SERVICE_SPIN_US.
+inline std::atomic<u32> g_service_spin_us{[] {
+    const char* value = std::getenv("EDEN_NX2_SERVICE_SPIN_US");
+    return value != nullptr ? static_cast<u32>(std::strtoul(value, nullptr, 10)) : 0U;
+}()};
+
+/// Hitch log (EDEN_NX2_HITCH_LOG): frames at least this many milliseconds long get a "hitch: frame"
+/// line. Debug server perf_flag hitch_ms; EDEN_NX2_HITCH_MS. Default 50.
+inline std::atomic<u32> g_hitch_ms{[] {
+    const char* value = std::getenv("EDEN_NX2_HITCH_MS");
+    return value != nullptr ? static_cast<u32>(std::strtoul(value, nullptr, 10)) : 50U;
+}()};
+
+/// Test knob: the GPU back thread stretches each batch of its work by this many percent
+/// (gpu_split.cpp BackLoop). Debug server perf_flag back_slow. 0 = off.
+inline std::atomic<u32> g_back_slow{0};
+
+/// Counter reads closer than ~1.7 us to the previous one that must come in a row before the JIT's
+/// counter callback pauses (arm_dynarmic_64.cpp GetCNTPCT). Debug server perf_flag cntpct_streak;
+/// EDEN_NX2_CNTPCT_STREAK. 1 = pause on every close read (the behaviour before), 0 = never.
+inline std::atomic<u32> g_cntpct_streak{[] {
+    const char* value = std::getenv("EDEN_NX2_CNTPCT_STREAK");
+    return value != nullptr ? static_cast<u32>(std::strtoul(value, nullptr, 10)) : 8U;
+}()};
+
+/// Adaptive GPU thread pinning (pin_adapt): the GPU back thread's busy share in percent under
+/// which pinning goes off (for 2 s in a row) and over which it comes back on. Debug server
+/// perf_flag pin_adapt_low / pin_adapt_high; EDEN_NX2_PIN_ADAPT_LOW / EDEN_NX2_PIN_ADAPT_HIGH.
+inline std::atomic<int> g_pin_adapt_low{[] {
+    const char* value = std::getenv("EDEN_NX2_PIN_ADAPT_LOW");
+    return value != nullptr ? static_cast<int>(std::strtol(value, nullptr, 10)) : 35;
+}()};
+inline std::atomic<int> g_pin_adapt_high{[] {
+    const char* value = std::getenv("EDEN_NX2_PIN_ADAPT_HIGH");
+    return value != nullptr ? static_cast<int>(std::strtol(value, nullptr, 10)) : 55;
+}()};
+
+/// Pause iterations the GPU front thread spins before it yields or sleeps while it waits for the
+/// back (gpu_split.cpp WaitForSpace and Backoff), debug server perf_flag front_spin;
+/// EDEN_NX2_FRONT_SPIN sets the start value (16384).
+inline std::atomic<unsigned> g_front_spin{[] {
+    const char* value = std::getenv("EDEN_NX2_FRONT_SPIN");
+    return value != nullptr ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : 16384u;
+}()};
+
+/// Sets a flag by name; false if there is none.
+inline bool Set(std::string_view name, bool on) {
+    for (size_t i = 0; i < infos.size(); ++i) {
+        if (infos[i].name == name) {
+            Values()[i].store(on, std::memory_order_relaxed);
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace Common::Nx2PerfFlags
