diff --git a/src/core/arm/dynarmic/jit_seed.cpp b/src/core/arm/dynarmic/jit_seed.cpp
new file mode 100644
index 0000000000..f269ffd8c6
--- /dev/null
+++ b/src/core/arm/dynarmic/jit_seed.cpp
@@ -0,0 +1,310 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <span>
+#include <thread>
+#include <unordered_set>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "common/fs/fs_util.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "core/arm/dynarmic/arm_dynarmic_64.h"
+#include "core/arm/dynarmic/jit_seed.h"
+#include "core/core.h"
+#include "core/hardware_properties.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/memory.h"
+
+namespace Core::JitSeed {
+namespace {
+namespace fs = std::filesystem;
+
+constexpr u32 FileMagic = 0x3153'4A4C; // "LJS1"
+constexpr u32 FileVersion = 1;
+// A dynarmic A64 location: the PC in bits 0-55, the FPCR mode bits and the single-step flag above.
+constexpr u64 PcMask = (u64{1} << 56) - 1;
+constexpr u64 ModeMask = ~PcMask;
+constexpr u64 SingleStepBit = u64{1} << 57;
+// A record: the location's mode bits, the core in bits 52-55, the offset from the image start.
+constexpr u64 CoreShift = 52;
+constexpr u64 OffsetMask = (u64{1} << CoreShift) - 1;
+// Code further than this from the image start (memory the game maps at run time) is not kept.
+constexpr u64 MaxOffset = u64{1} << 30;
+// Code cache each core keeps free for the blocks it compiles while playing.
+constexpr std::size_t ReserveBytes = std::size_t{128} << 20;
+constexpr auto FlushInterval = std::chrono::seconds{10};
+
+struct FileHeader {
+    u32 magic;
+    u32 version;
+    u64 reserved;
+};
+static_assert(sizeof(FileHeader) == 16);
+
+bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_JIT_SEED");
+        return value == nullptr || value[0] != '0';
+    }();
+    return enabled;
+}
+
+// The file's records (empty when it is missing or not a seed file).
+std::vector<u64> ReadRecords(const fs::path& path) {
+    std::ifstream in{path, std::ios::binary};
+    if (!in) {
+        return {};
+    }
+    FileHeader header{};
+    in.read(reinterpret_cast<char*>(&header), sizeof(header));
+    if (!in || header.magic != FileMagic || header.version != FileVersion) {
+        return {};
+    }
+    in.seekg(0, std::ios::end);
+    const auto end = static_cast<std::size_t>(in.tellg());
+    std::vector<u64> records((end - sizeof(header)) / sizeof(u64));
+    in.seekg(sizeof(header));
+    in.read(reinterpret_cast<char*>(records.data()),
+            static_cast<std::streamsize>(records.size() * sizeof(u64)));
+    if (!in) {
+        return {};
+    }
+    return records;
+}
+
+class Store {
+public:
+    static Store& Get() {
+        static Store store;
+        return store;
+    }
+
+    ~Store() {
+        StopFlusher();
+        Flush();
+    }
+
+    void EnsureSeeded(Core::System& system, Kernel::KProcess& process) {
+        std::scoped_lock seed_lock{seed_mutex};
+        const u64 base = GetInteger(process.GetEntryPoint());
+        if (seeded.process == &process && seeded.id == process.GetProcessId() &&
+            seeded.base == base) {
+            return;
+        }
+        // A new application (or the same one booted again): finish the previous one's list.
+        StopFlusher();
+        {
+            std::scoped_lock lock{record_mutex};
+            recording = {};
+        }
+        Flush();
+        seeded = {&process, process.GetProcessId(), base};
+
+        const u64 program_id = process.GetProgramId();
+        const auto& build_id = system.GetApplicationProcessBuildID();
+        std::string build;
+        for (std::size_t i = 0; i < 16; ++i) {
+            build += fmt::format("{:02X}", build_id[i]);
+        }
+        const std::string program = fmt::format("{:016x}", program_id);
+        const fs::path own = Common::FS::GetEdenPath(Common::FS::EdenPath::CacheDir) / "jit" /
+                             program / (build + ".bin");
+        const fs::path shipped =
+            Common::FS::GetExeDirectory() / "jit_seed" / program / (build + ".bin");
+
+        // Every core's list, rebased to this boot's image, in the order the code first ran (a
+        // block in both files compiles once: Precompile skips blocks already compiled).
+        std::vector<u64> known;
+        std::array<std::vector<u64>, Core::Hardware::NUM_CPU_CORES> lists;
+        std::size_t unmapped = 0;
+        auto& memory = process.GetMemory();
+        for (const auto& path : {own, shipped}) {
+            const std::vector<u64> records = ReadRecords(path);
+            known.insert(known.end(), records.begin(), records.end());
+            for (const u64 record : records) {
+                const std::size_t core = static_cast<std::size_t>((record >> CoreShift) & 0xF);
+                const u64 pc = base + (record & OffsetMask);
+                if (core >= lists.size()) {
+                    continue;
+                }
+                if (!memory.IsValidVirtualAddressRange(pc, sizeof(u32))) {
+                    ++unmapped; // Not mapped yet: compiled at its first run as before.
+                    continue;
+                }
+                lists[core].push_back((record & ModeMask) | pc);
+            }
+        }
+        // Sorted, for the lookups in Record (a hash set of ~1.4 M blocks would take ~60 MiB).
+        std::ranges::sort(known);
+        known.erase(std::ranges::unique(known).begin(), known.end());
+
+        if (!known.empty()) {
+            const auto begin = std::chrono::steady_clock::now();
+            std::array<std::size_t, Core::Hardware::NUM_CPU_CORES> compiled{};
+            std::array<std::size_t, Core::Hardware::NUM_CPU_CORES> left{};
+            {
+                std::vector<std::jthread> workers;
+                for (std::size_t core = 0; core < lists.size(); ++core) {
+                    auto* const arm =
+                        static_cast<Core::ArmDynarmic64*>(process.GetArmInterface(core));
+                    if (arm == nullptr || lists[core].empty()) {
+                        continue;
+                    }
+                    workers.emplace_back([arm, core, &lists, &compiled, &left] {
+                        compiled[core] = arm->Precompile(lists[core], ReserveBytes);
+                        left[core] = arm->CodeCacheSpaceRemaining();
+                    });
+                }
+            }
+            std::string per_core;
+            for (std::size_t core = 0; core < lists.size(); ++core) {
+                if (!lists[core].empty()) {
+                    per_core += fmt::format(" core{}={} ({} MiB cache left)", core, compiled[core],
+                                            left[core] >> 20);
+                }
+            }
+            LOG_WARNING(Core_ARM,
+                     "JIT seed: {} blocks known for {} build {}, compiled before the first run "
+                     "in {} ms:{}{}",
+                     known.size(), program, build,
+                     std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now() - begin)
+                         .count(),
+                     per_core,
+                     unmapped != 0 ? fmt::format(" ({} not mapped yet)", unmapped) : "");
+        } else {
+            LOG_WARNING(Core_ARM, "JIT seed: no list yet for {} build {}; recording to {}", program,
+                     build, Common::FS::PathToUTF8String(own));
+        }
+
+        {
+            std::scoped_lock lock{record_mutex};
+            recording = {&process, base, own, std::move(known)};
+        }
+        flusher = std::jthread([this](std::stop_token stop) {
+            std::mutex mutex;
+            std::condition_variable_any wake;
+            while (!stop.stop_requested()) {
+                std::unique_lock lock{mutex};
+                wake.wait_for(lock, stop, FlushInterval, [] { return false; });
+                Flush();
+            }
+        });
+    }
+
+    void Record(const Kernel::KProcess& process, std::size_t core, u64 location) {
+        if ((location & SingleStepBit) != 0) {
+            return;
+        }
+        std::scoped_lock lock{record_mutex};
+        if (recording.process != &process) {
+            return;
+        }
+        const u64 pc = location & PcMask;
+        if (pc < recording.base || pc - recording.base >= MaxOffset) {
+            return;
+        }
+        const u64 record = (location & ModeMask) | (static_cast<u64>(core) << CoreShift) | (pc - recording.base);
+        if (!std::ranges::binary_search(recording.known, record) &&
+            recording.added.insert(record).second) {
+            recording.pending.push_back(record);
+        }
+    }
+
+private:
+    // Appends the blocks recorded since the last call to the program's file.
+    void Flush() {
+        std::vector<u64> batch;
+        fs::path path;
+        {
+            std::scoped_lock lock{record_mutex};
+            batch.swap(recording.pending);
+            path = recording.file;
+        }
+        if (batch.empty() || path.empty()) {
+            return;
+        }
+        std::error_code ec;
+        fs::create_directories(path.parent_path(), ec);
+        const auto size = fs::file_size(path, ec);
+        const bool fresh = ec || size < sizeof(FileHeader) || ReadHeaderBad(path);
+        std::ofstream out{path, std::ios::binary | (fresh ? std::ios::trunc : std::ios::app)};
+        if (!out) {
+            return;
+        }
+        if (fresh) {
+            const FileHeader header{FileMagic, FileVersion, 0};
+            out.write(reinterpret_cast<const char*>(&header), sizeof(header));
+        }
+        out.write(reinterpret_cast<const char*>(batch.data()),
+                  static_cast<std::streamsize>(batch.size() * sizeof(u64)));
+    }
+
+    static bool ReadHeaderBad(const fs::path& path) {
+        std::ifstream in{path, std::ios::binary};
+        FileHeader header{};
+        in.read(reinterpret_cast<char*>(&header), sizeof(header));
+        return !in || header.magic != FileMagic || header.version != FileVersion;
+    }
+
+    void StopFlusher() {
+        if (flusher.joinable()) {
+            flusher.request_stop();
+            flusher.join();
+        }
+    }
+
+    std::mutex seed_mutex;
+    struct {
+        const Kernel::KProcess* process{};
+        u64 id{};
+        u64 base{};
+    } seeded;
+
+    std::mutex record_mutex;
+    struct Recording {
+        const Kernel::KProcess* process{};
+        u64 base{};
+        fs::path file;
+        std::vector<u64> known;          ///< The files' blocks, sorted
+        std::unordered_set<u64> added;   ///< Blocks first compiled in this session
+        std::vector<u64> pending;        ///< Of those, the ones not written yet
+    } recording;
+
+    std::jthread flusher;
+};
+
+} // Anonymous namespace
+
+void EnsureSeeded(Core::System& system, Kernel::KProcess& process) {
+    if (!Enabled() || !process.IsApplication() || !process.Is64Bit()) {
+        return;
+    }
+#ifdef HAS_NCE
+    if (Settings::IsNceEnabled()) {
+        return;
+    }
+#endif
+    Store::Get().EnsureSeeded(system, process);
+}
+
+void Record(const Kernel::KProcess& process, std::size_t core, u64 location) {
+    if (!Enabled()) {
+        return;
+    }
+    Store::Get().Record(process, core, location);
+}
+
+} // namespace Core::JitSeed
