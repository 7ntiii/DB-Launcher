+/// The host is on the side channel: the lowest-numbered player heard in the last 3 s has a lower
+/// number than ours and is the host, i.e. the lowest number heard at all in this session, or a
+/// game that has sent a map set or a kept environment draw in this match (it took the role after
+/// the first host left; review M6). A fresh lower-numbered player that is neither (player 2 while
+/// player 1 is gone and 2 has not taken the role) does not count. False when we have no number.
+bool Assist::State::HostFresh(Clock::time_point now) {
+    const u32 local_no = LocalPlayerNo();
+    if (local_no == 0 || local_no == ~0U) {
+        return false;
+    }
+    u32 lowest_known = ~0U;
+    const Peer* lowest_fresh = nullptr;
+    for (const auto& [key, peer] : peers) {
+        // H1: a cut player is not the host (it is out of the match, even though it is heard).
+        if (peer.no == 0 || PeerCut(peer)) {
+            continue;
+        }
+        lowest_known = std::min<u32>(lowest_known, peer.no);
+        // H5: 10 s (was 3 s): a short blip of the host does not send one game on alone.
+        if (now - peer.at < 10s && (lowest_fresh == nullptr || peer.no < lowest_fresh->no)) {
+            lowest_fresh = &peer;
+        }
+    }
+    if (lowest_fresh == nullptr || lowest_fresh->no >= local_no) {
+        return false;
+    }
+    const bool host = lowest_fresh->no <= lowest_known || lowest_fresh->host_at.has_value();
+    if (!host && host_skip_logged != lowest_fresh->no) {
+        host_skip_logged = lowest_fresh->no;
+        Log(fmt::format("host check: player {} is here but is not the host (player {} is gone and "
+                        "{} has sent no map set or draw in this match); not waiting for it (review "
+                        "M6)",
+                        lowest_fresh->no, lowest_known, lowest_fresh->no));
+    }
+    return host;
+}
+
+/// Whether the game itself still lists a player with a lower number than local_no; nullopt when
+/// that cannot be read. Numbers come from the member order (PlayerNumber: sorted member ids, the
+/// game server's member excluded), so a lower number = a member with a smaller id. With
+/// LICHII_DUSK_PLAYER the numbers are set by hand, so the player table's copies (pgd pool, player
+/// number at +0xD0) are read instead.
+std::optional<bool> Assist::State::LowerPlayerListed(u32 local_no) {
+    if (main == 0 || local_no == 0 || local_no == ~0U) {
+        return std::nullopt;
+    }
+    if (player) {
+        const u64 players = Get<u64>(main + NET_PLAYERS);
+        if (players == 0 || Get<u64>(players + PGD_POOL) == 0) {
+            return std::nullopt;
+        }
+        for (u32 no = 1; no < local_no; ++no) {
+            if (VirtuePlayer(players, no) != 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+    const u64 manager = session.manager;
+    if (manager == 0) {
+        return std::nullopt;
+    }
+    const u64 begin = Get<u64>(manager + S_MEMBERS);
+    const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+    if (begin == 0 || end <= begin || (end - begin) % MEMBER_SIZE != 0 ||
+        end - begin > 16 * MEMBER_SIZE) {
+        return std::nullopt;
+    }
+    std::optional<u64> self;
+    std::vector<u64> ids;
+    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+        if (Get<u8>(member + M_SERVER) != 0) {
+            continue;
+        }
+        const u64 id = Get<u64>(member + M_ID);
+        ids.push_back(id);
+        if (Get<u8>(member + M_SELF) != 0) {
+            self = id;
+        }
+    }
+    if (!self) {
+        return std::nullopt;
+    }
+    return std::any_of(ids.begin(), ids.end(), [&](u64 id) { return id < *self; });
+}
+
+/// The start-area pick (diag/net/startarea_fix_notes.md). With START_AREA (startarea_live.py) the
+/// builder 0x10F1AFC waits for M+0xBA ("all picks locked"), which only the offline path sets. The
+/// host sets it once every player's pick is locked (each game locks its own slot and sends the final
+/// 0x45 when its selection timer runs out) or 3 s after its own timer ran out; its game then builds
+/// the list from the picks it holds and sends it (0x51) to everybody. A guest that has heard no list
+/// 12 s after its own timer ran out builds its own the same way. Nothing here when the group is off.
+void Assist::State::StartArea(u32 phase, Clock::time_point now) {
+    if (phase != PHASE_INTERMISSION) {
+        session.area_timer_seen = false;
+        session.area_timeout_at.reset();
+        session.area_set = false;
+        session.area_list_logged = false;
+        session.area_wait_logged = false;
+        session.area_reads_host = false;
+        session.area_late.clear();
+        session.area_late_inter_since.reset();
+        session.area_late_logged = false;
+        return;
+    }
+    if (Get<u32>(main + START_AREA_GATE) != START_AREA_GATE_WAIT) {
+        if (!session.area_off_logged) {
+            session.area_off_logged = true;
+            Log("start area: START_AREA not applied (0x10F1B28 is not cbnz w9); rule off, every game "
+                "builds its start list at once");
+        }
+        return;
+    }
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    if (mediator == 0) {
+        return;
+    }
+    u64 slots = Get<u64>(mediator + MED_SLOT_COUNT);
+    if (slots > MED_SLOT_MAX) {
+        slots = 0; // not a sane slot vector: no early lock, only the timer
+    }
+    const auto pick_of = [&](u32 no) {
+        for (u64 i = 0; i < slots; ++i) {
+            const u64 slot = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+            if (Get<u32>(slot) == no) {
+                return Get<u8>(slot + SLOT_PICK_KIND) == 3 ? Get<s32>(slot + SLOT_PICK_ID) : -1;
+            }
+        }
+        return -1;
+    };
+    if (Get<u8>(mediator + MED_DECIDED) != 0) {
+        // A list was applied (ours or a peer's): log it once against the picks this game holds.
+        if (!session.area_list_logged) {
+            session.area_list_logged = true;
+            session.area_set = true;
+            const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+            std::string list;
+            for (u64 i = 0; i < count && count <= MED_LIST_MAX; ++i) {
+                const u64 entry = mediator + MED_LIST + i * MED_LIST_ENTRY;
+                const u32 no = Get<u32>(entry);
+                list += fmt::format("{}player {} area {} (picked {})", list.empty() ? "" : ", ",
+                                    no, Get<s32>(entry + ENTRY_INDEX), pick_of(no));
+            }
+            Log(fmt::format("start area: list decided, {} entries: {}", count, list));
+        }
+        return;
+    }
+    if (session.area_set) {
+        return;
+    }
+    if (Get<u8>(mediator + MED_PICKS_LOCKED) != 0) {
+        session.area_set = true; // set by the game itself (offline path) or still from us
+        return;
+    }
+    const f32 timer = Get<f32>(mediator + MED_TIMER);
+    if (Get<u32>(mediator + MED_STATE) == MED_POINT_SELECTING && timer > 0.0f) {
+        session.area_timer_seen = true;
+    }
+    // The timer is set at PreIntermission and set to -1 when it runs out (0x10F64E4); a value from
+    // the last round only counts once this intermission's timer was seen running.
+    if (session.area_timer_seen && !(timer > 0.0f) && !session.area_timeout_at) {
+        session.area_timeout_at = now;
+    }
+    const bool host = Get<u8>(main + GENERATOR_IDLE) == 0;
+    const auto since_timeout = [&](auto wait) {
+        return session.area_timeout_at && now - *session.area_timeout_at >= wait;
+    };
+    // Safety net: no running timer seen at all (the menu never reached PointSelecting). The game
+    // must build some list, or nobody is placed; StartPoint and Phases take it from there.
+    const bool no_timer = !session.area_timer_seen && session.intermission_since &&
+                          now - *session.intermission_since >= (host ? 40s : 52s);
+    std::string why;
+    if (host) {
+        size_t players = 0;
+        const u64 begin = Get<u64>(session.manager + S_MEMBERS);
+        const u64 end = Get<u64>(session.manager + S_MEMBERS + 8);
+        if (begin != 0 && end > begin && (end - begin) % MEMBER_SIZE == 0 &&
+            end - begin <= 16 * MEMBER_SIZE) {
+            for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+                players += Get<u8>(member + M_SERVER) == 0 ? 1 : 0;
+            }
+        }
+        u64 locked = 0;
+        for (u64 i = 0; i < slots; ++i) {
+            locked += Get<u8>(mediator + MED_SLOTS + i * MED_SLOT_SIZE + SLOT_LOCKED) != 0 ? 1 : 0;
+        }
+        // Only once this round's timer was seen running: slots left locked from the last round
+        // must not count, and PreIntermission (it sets the timer) clears +0xBA (0x10F4EE8).
+        // v408 (rankfail_notes): a player whose game is heard (not cut) but that has no pick slot
+        // here is still loading into this intermission. Building now leaves it out of the start
+        // list, and then this game has no entry and no result row for it all match (2026-11-16: a
+        // guest 19 s late). Its slot comes with its first 0x45, its lock with its final 0x45.
+        // Wait for both, at most AREA_LATE_MAX after our timer ran out; stop at once when a late
+        // one has been in its own intermission AREA_LATE_LOST s with still no slot here (its 0x45
+        // does not arrive: waiting does not help, and its own list would follow at 24 / 30 s).
+        // The game thread is not held: the builder 0x10F1AFC only polls M+0xBA each frame.
+        // Nobody late (every heard game has its slot) = exactly the old rule.
+        const auto slot_of = [&](u32 no) -> std::optional<u64> {
+            for (u64 i = 0; i < slots; ++i) {
+                const u64 slot = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+                if (Get<u32>(slot) == no) {
+                    return slot;
+                }
+            }
+            return std::nullopt;
+        };
+        bool late_in_inter = false;
+        std::set<u32> heard_now; // v408b F2: heard in the last 10 s and not cut
+        for (const auto& [key, peer] : peers) {
+            if (peer.no != 0 && now - peer.at < 10s && !PeerCut(peer)) {
+                heard_now.insert(peer.no);
+            }
+            // Only from our timeout on: a slot that shows up a moment late in an ordinary start
+            // must not make a no-op case wait for its lock.
+            if (session.area_timeout_at && peer.no != 0 && now - peer.at < 10s && !PeerCut(peer) &&
+                !slot_of(peer.no)) {
+                session.area_late.insert(peer.no);
+                late_in_inter = late_in_inter || peer.phase == PHASE_INTERMISSION;
+            }
+        }
+        if (!late_in_inter) {
+            session.area_late_inter_since.reset();
+        } else if (!session.area_late_inter_since) {
+            session.area_late_inter_since = now;
+        }
+        std::string waiting;
+        for (const u32 no : session.area_late) {
+            if (!heard_now.contains(no)) {
+                continue; // v408b F2: left or cut since: it holds nothing
+            }
+            const auto slot = slot_of(no);
+            if (!slot || Get<u8>(*slot + SLOT_LOCKED) == 0) {
+                waiting += fmt::format(" {}", no);
+            }
+        }
+        const bool late_lost = session.area_late_inter_since &&
+                               now - *session.area_late_inter_since >= AREA_LATE_LOST;
+        const bool late_hold = !waiting.empty() && session.area_timer_seen && !late_lost &&
+                               !since_timeout(AREA_LATE_MAX);
+        if (session.area_timer_seen && players >= 2 && slots >= players && locked == slots) {
+            why = fmt::format("every player's pick is locked ({} slots, {} players)", slots, players);
+        } else if (since_timeout(3s) && late_hold) {
+            if (!session.area_late_logged) {
+                session.area_late_logged = true;
+                Log(fmt::format("start area (host): our selection timer ran out, but player(s){} "
+                                "are still loading (heard, no locked pick here): the list waits "
+                                "for them, at most {} s (v408)",
+                                waiting, AREA_LATE_MAX.count()));
+            }
+        } else if (since_timeout(3s)) {
+            why = fmt::format("3 s after our selection timer ran out ({} of {} slots locked, {} "
+                              "players){}",
+                              locked, slots, players,
+                              waiting.empty()
+                                  ? std::string{}
+                                  : fmt::format("; still missing{} ({}, v408)", waiting,
+                                                late_lost ? "in their intermission with no slot "
+                                                            "here: their picks do not arrive"
+                                                          : "the wait ran out"));
+        } else if (no_timer) {
+            why = "no selection timer seen in 40 s (safety net)";
+        }
+    } else {
+        // Review2 R8: with no host (every game has GENERATOR_IDLE = 1) each guest built its own
+        // list 12 s after its timeout and the lists crossed. Only the lowest-numbered guest that is
+        // here builds then; one with a lower-numbered player heard in the last 3 s waits for that
+        // one's list as it waits for the host's: 12 s more (24 s / 64 s), then builds its own.
+        const u32 local_no = LocalPlayerNo();
+        u32 lower = 0;
+        // H1: a cut player builds nothing (it is not in the intermission); H5: 10 s, not 3 s, so
+        // a short blip of the lower guest does not make two lists.
+        for (const auto& [key, peer] : peers) {
+            if (peer.no != 0 && peer.no < local_no && now - peer.at < 10s && !PeerCut(peer) &&
+                (lower == 0 || peer.no < lower)) {
+                lower = peer.no;
+            }
+        }
+        const bool no_timer_late = no_timer && now - *session.intermission_since >= 64s;
+        // startarea_fix_notes.md 7: with START_AREA_LIST the host's 0x51 is applied here; our own
+        // list would replace it on every game, so while the host is heard wait 30 s for its list.
+        // (The host is always a lower-numbered player, so this is the `lower != 0` case.)
+        // Review3: latched for this intermission, so a 3-s host silence near 24..30 s does not
+        // drop the wait to 24 s (our list would then cross the host's).
+        if (!session.area_reads_host &&
+            Get<u32>(main + START_LIST_READ) == START_LIST_READ_ANY && HostFresh(now)) {
+            session.area_reads_host = true;
+        }
+        const bool reads_host = session.area_reads_host;
+        if (lower == 0 && since_timeout(12s)) {
+            why = "no start list from the host 12 s after our selection timer ran out; building our "
+                  "own (lowest-numbered guest here)";
+        } else if (lower == 0 && no_timer) {
+            why = "no selection timer and no start list in 52 s (safety net); building our own";
+        // v408b F1: a host that reads lists may wait AREA_LATE_MAX for a late player (v408), so
+        // a guest that reads the host's list waits that long plus 10 s, not 30 s.
+        } else if (lower != 0 && since_timeout(reads_host ? AREA_LATE_MAX + 10s : 24s)) {
+            why = fmt::format("no start list from the host or from player {} {} s after our "
+                              "selection timer ran out ({}); building our own (review2 R8)",
+                              lower, reads_host ? (AREA_LATE_MAX + 10s).count() : 24,
+                              reads_host ? "host heard, START_AREA_LIST" : "host not heard");
+        } else if (lower != 0 && no_timer_late) {
+            why = fmt::format("no selection timer and no start list from player {} in 64 s "
+                              "(safety net, review2 R8); building our own",
+                              lower);
+        } else if (lower != 0 && (since_timeout(12s) || no_timer) && !session.area_wait_logged) {
+            session.area_wait_logged = true;
+            Log(fmt::format("start area: no list yet; player {} is here with a lower number and "
+                            "builds it, waiting {} s more for its list (review2 R8)",
+                            lower, reads_host ? (AREA_LATE_MAX + 10s - 12s).count() : 12));
+        }
+    }
+    if (why.empty()) {
+        return;
+    }
+    Put<u8>(mediator + MED_PICKS_LOCKED, 1);
+    session.area_set = true;
+    std::string picks;
+    for (u64 i = 0; i < slots; ++i) {
+        const u32 no = Get<u32>(mediator + MED_SLOTS + i * MED_SLOT_SIZE);
+        picks += fmt::format("{}player {} {}", picks.empty() ? "" : ", ", no, pick_of(no));
+    }
+    Log(fmt::format("start area ({}): picks locked, the game builds the list: {}; picks {}",
+                    host ? "host" : "guest", why, picks.empty() ? "none" : picks));
+}
