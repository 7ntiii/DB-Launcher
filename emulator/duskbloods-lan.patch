+void Assist::State::TakeRaceLog(const std::string& line) {
+    if (race_logs >= TR_LOG_MAX) {
+        return;
+    }
+    ++race_logs;
+    Log(line);
+    if (race_logs == TR_LOG_MAX) {
+        Log(fmt::format("takerace: {} lines in this match; further ones are not logged", TR_LOG_MAX));
+    }
+}
