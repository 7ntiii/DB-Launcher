+std::mutex ipc_time_mutex;
+std::map<std::pair<std::string, u32>, std::pair<double, u32>> ipc_time; ///< {service, command} -> {ms, calls}
+} // Anonymous namespace
+
+std::string IpcTimeSummary() {
+    std::vector<std::tuple<double, u32, std::string, u32>> rows;
+    {
+        std::scoped_lock lock{ipc_time_mutex};
+        for (const auto& [key, value] : ipc_time) {
+            rows.emplace_back(value.first, value.second, key.first, key.second);
+        }
+        ipc_time.clear();
+    }
+    std::ranges::sort(rows, std::greater{});
+    std::string text;
+    for (size_t i = 0; i < std::min<size_t>(rows.size(), 7); ++i) {
+        const auto& [ms, calls, service, command] = rows[i];
+        text += fmt::format(" {}::{}={:.0f}ms/{}", service, command, ms, calls);
+    }
+    return text;
+}
