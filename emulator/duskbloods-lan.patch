+void Assist::State::PrepareSecondFlags(u64 stage, Clock::time_point now) {
+    // PrepareSecond (0x114F2C0) goes on when the sync global +0x77C (the peer's 0x4D answer to our
+    // step-12 request), [stage+0x2D8]+0x20 (we answered the peer's step-12 request) and
+    // [stage+0x3378]+0xA8 (we answered its step-7 request) are all set. The responder only answers
+    // in session state 8, so when the peer got there first, its requests came while this game was
+    // still loading. Once the peer has answered us, set our two answer flags as the answers would
+    // (in guest mode the step-12 answer 0x1114700 sends nothing and only sets +0x20).
+    const u64 global = Get<u64>(Get<u64>(main + SYNC_GLOBAL_REF));
+    if (global == 0) {
+        return;
+    }
+    // assist_final_prepare_r (timer_notes 8, deep_audit_P P1): in the final (last-phase coordinator
+    // par+0x3388 set) PrepareSecond does not read +0x77C at all: it waits for the coordinator's proxy
+    // (the final point and "ready", FINAL_POINT_* records) and for the step-7 answer flag below
+    // (match_structure_notes 6). +0x77C is still set in rounds 2 and 3 from round 1, so there the
+    // step-7 flag was set at once; in round 4 it is 0, and the 30-s "peer left" wait below held the step-7
+    // flag, so EVERY final started 30 s late on every game (23 of 23 finals). In the final the wait
+    // is skipped and +0x77C is left alone: the step-7 flag is set at once, as in rounds 2 and 3.
+    const bool final_coordinator = Get<u64>(stage + P_FINAL) != 0;
+    if (Get<u8>(global + 0x77C) == 0 && !final_coordinator) {
+        // Each game ends the match from its own result: a player who wins on points goes to the
+        // reward screen while the others play on (as with the server). From the second round on,
+        // a peer that has not answered for 30 s has left the match, so take its answer as given.
+        if (!session.played || now - *session.prepare_since < 30s) {
+            return;
+        }
+        Put<u8>(global + 0x77C, 1);
+        Log("prepare second: no answer from the peer for 30 s (it left the match); playing on "
+            "alone");
+    }
+    session.prepare_fixed = now;
+    // v409 (rankfail_notes 8): our step-12 answer flag stands for "we answered the peer's Phase
+    // request". A peer that loaded later than us sends that request only once it reaches its own
+    // PrepareSecond; setting the flag before then lets this game leave PrepareSecond without ever
+    // handling it, and then this game keeps that player's phase entry empty all match (state word
+    // 00 00 00 00: no result row for it; 2026-11-16, three runs, always on the EARLY game). So the
+    // flag waits until every heard, uncut peer has been in PrepareSecond or later for
+    // PREPARE_PEER_GRACE (time for its request and our real answer), at most PREPARE_PEER_MAX
+    // after our PrepareSecond began; then as before. The step-7 flag (the case the late game
+    // needs) is unchanged.
+    bool peers_ready = true;
+    std::string behind;
+    for (const auto& [key, peer] : peers) {
+        if (peer.no == 0 || now - peer.at >= 10s || PeerCut(peer)) {
+            continue;
+        }
+        const auto seen = session.prepare_peer_at.find(peer.no);
+        if (seen == session.prepare_peer_at.end() || now - seen->second < PREPARE_PEER_GRACE) {
+            peers_ready = false;
+            behind += fmt::format(" {}", peer.no);
+        }
+    }
+    const bool step12_due =
+        peers_ready || (session.prepare_since && now - *session.prepare_since >= PREPARE_PEER_MAX);
+    if (const u64 step12 = Get<u64>(stage + 0x2D8);
+        step12 != 0 && Get<u8>(step12 + 0x20) == 0 && !step12_due && !session.prepare_wait_logged) {
+        session.prepare_wait_logged = true;
+        Log(fmt::format("prepare second: our step-12 answer flag waits for player(s){} (not yet in "
+                        "their PrepareSecond {} s: their Phase request is still to come), at most "
+                        "{} s (v409)",
+                        behind, PREPARE_PEER_GRACE.count(), PREPARE_PEER_MAX.count()));
+    }
+    if (const u64 step12 = Get<u64>(stage + 0x2D8);
+        step12 != 0 && Get<u8>(step12 + 0x20) == 0 && step12_due) {
+        Put<u8>(step12 + 0x20, 1);
+        Log("prepare second: step-12 answer flag set (the peer's answer is in, ours was not)");
+    }
+    if (const u64 step7 = Get<u64>(stage + 0x3378); step7 != 0 && Get<u8>(step7 + 0xA8) == 0) {
+        Put<u8>(step7 + 0xA8, 1);
+        Log("prepare second: step-7 answer flag set (the peer's answer is in, ours was not)");
+    }
+}
+
+/// Between phases every game draws an environment event (EnvEventLot). The game server drew one
+/// for everybody and sent it as message 0x56. Here the player with the lowest number (the host)
+/// draws it, its assist tells the others, and their games wait for it (env box mode 1) and take it
+/// as the server's message. A game that hears nothing within 40 s of reaching EnvEventLot draws its
+/// own, so a match never hangs on a host that left.
+void Assist::State::EnvEvent(u64 stage, u32 phase, u32 local_no, Clock::time_point now) {
+    const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+    // Our own draws (the cave counts them).
+    const u32 count = Get<u32>(main + ENV_BOX + 0x10);
+    if (count != session.env_count) {
+        session.env_count = count;
+        // -1 = no event this time; the others must get that too.
+        const s32 id = Get<s32>(main + ENV_BOX + 0xC);
+        session.env_drawn = std::make_pair(round, id);
+        Log(fmt::format("environment event {} drawn here (round {})", id, round));
+    }
+    // Who draws: we wait when a player before us is here.
+    // H1: a cut player (at its result screen, still heard) does not count; when every lower
+    // number is such a player, the role passes at once (no 15-s wait, no member-list hold), on
+    // every game at the same time: each sees the same steps on the side channel.
+    // Review5 A: "every lower number is cut" comes from the match's record (cut_nos), whether or not
+    // the cut player is still heard, so the hand-over does not undo itself when it leaves its
+    // Outcome. Review5 B: not taken while our own game is at 9 / 10 (it may be cut itself; a
+    // survivor is at 11 within ~2 s and EnvEventLot waits for the flip).
+    CutLatchCheck();
+    bool before_us = false;
+    for (const auto& [key, peer] : peers) {
+        if (now - peer.at < 5s && peer.no != 0 && local_no != 0 && peer.no < local_no &&
+            !PeerCut(peer)) {
+            before_us = true;
+        }
+    }
+    bool lower_recorded = !before_us && local_no > 1 && local_no != ~0U;
+    for (u32 no = 1; lower_recorded && no < local_no; ++no) {
+        lower_recorded = cut_nos.contains(no) &&
+                         !(round >= FINAL_ROUND && final_finalists.contains(no));
+    }
+    const bool step_hold = phase == PHASE_PRE_RESULT || phase == 10;
+    if (lower_recorded && step_hold) {
+        const u64 key = (u64{match_gen} << 32) | round;
+        if (cut_hold_logged != key) {
+            cut_hold_logged = key;
+            Log(fmt::format("H1: every lower-numbered player is cut, but our game is at step {} "
+                            "(round {}); the role is taken from step 11 on (review5 B)",
+                            phase, round));
+        }
+    }
+    const bool lower_all_cut = lower_recorded && !step_hold;
+    // H1: our own player is cut: this game gives up the role and sends no host messages.
+    const bool own_cut = LocalCut(phase);
+    if (own_cut != own_cut_logged) {
+        own_cut_logged = own_cut;
+        Log(own_cut ? fmt::format("H1: our player (no {}) is cut (step {}, round {}); this game is "
+                                  "not the authority any more and sends no host messages",
+                                  local_no, phase, round)
+                    : fmt::format("H1: our player (no {}) is no longer at a cut player's result "
+                                  "step (step {})",
+                                  local_no, phase));
+    }
+    // The enemy generators (spawners) run on one game only, the same one: its spawn messages go
+    // to the others.
+    // It is also the authority for world items and levers. A game with a number above 1 must
+    // not act as one while it has not heard the others yet (it would answer the join item sync
+    // with an empty list): it takes the role only after no lower-numbered player was heard for
+    // 15 s. Player 1 has it at once.
+    if (before_us || role_since == Clock::time_point{}) {
+        role_since = now;
+        role_listed_logged = false;
+    }
+    bool guest_role = before_us || (local_no > 1 && now - role_since < 15s && !lower_all_cut);
+    // Balance fix M5: silence alone is not leaving. While the game still lists a lower-numbered
+    // player (the session's member list), that player's game is still the authority; taking the
+    // role too would make two (double loot, an item awarded twice). An unreadable list keeps the
+    // old rule. After ROLE_SILENT_CAP of silence the role is taken anyway, so a member list that
+    // does not drop a player who left cannot leave the match without any authority.
+    constexpr auto ROLE_SILENT_CAP = 60s;
+    if (!guest_role && local_no > 1 && now - role_since < ROLE_SILENT_CAP && !lower_all_cut &&
+        LowerPlayerListed(local_no).value_or(false)) {
+        guest_role = true;
+        if (!role_listed_logged) {
+            role_listed_logged = true;
+            Log("authority: no lower-numbered player heard for 15 s, but the game still lists "
+                "one; not taking the role (balance fix M5)");
+        }
+    }
+    if (own_cut) {
+        guest_role = true; // H1
+    }
+    if (static_cast<u32>(guest_role) != Get<u32>(main + GENERATOR_IDLE)) {
+        Put<u32>(main + GENERATOR_IDLE, guest_role ? 1 : 0);
+        Log(guest_role ? "authority (spawners, items, levers, events): a player before us"
+                       : "authority (spawners, items, levers, events): this game");
+        // deep_audit_L 1b: a game that takes the authority from a lower number checks and repairs
+        // the host-side state it mirrors as a guest (HandoverState, once, a few seconds later).
+        handover_pending = !guest_role && local_no > 1;
+        handover_at = now;
+        if (!guest_role && local_no > 1) {
+            // v3.9.3 (C, 3a): the reason from the member list as it is now, read only on this
+            // transition (role_listed_logged only says M5 was logged once: a list drop before the
+            // cap was reported as "silence cap reached"; dropout_notes 3a).
+            const std::optional<bool> listed = LowerPlayerListed(local_no);
+            Log(fmt::format("authority: taken after {} s without a lower-numbered player ({})",
+                            std::chrono::duration_cast<std::chrono::seconds>(now - role_since)
+                                .count(),
+                            lower_all_cut ? "every lower-numbered player is cut: H1, "
+                                            "recorded for this match (review5 A)"
+                            : listed.value_or(false) ? "still listed: silence cap reached"
+                            : !listed                ? "member list unreadable"
+                            : role_listed_logged     ? "the game stopped listing it"
+                                                     : "not listed"));
+        }
+    }
+    // The same game picks the "enemy group activates" events (cave 4 notes each pick) and tells
+    // the others for a few seconds; their games take it as the server's message.
+    const u32 picks = Get<u32>(main + GROUP_BOX + 0xC);
+    if (picks != group_count) {
+        group_count = picks;
+        group_id = Get<u32>(main + GROUP_BOX + 8);
+        group_until = now + 10s; // V400-5 (realnet_notes R7): was 4 s; the receiver keys by seq
+        group_round = round;     // V400-5b: a pick near a phase end is not handed into the next
+        Log(fmt::format("enemy group {} activated here (#{})", group_id, picks));
+    }
+    if (!before_us && !own_cut && local_no != 0 && now < group_until && round == group_round) {
+        GroupMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.seq = static_cast<u16>(group_count);
+        out.instance = instance;
+        out.id = group_id;
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+    }
+    // H5: wait for the host's draw under the 15-s role rule (guest_role), not the 5-s freshness:
+    // a short host blip no longer lets this one game draw its own event.
+    const u32 mode = guest_role && session.env_local_round != round ? 1 : 0;
+    if (mode != session.env_mode) {
+        if (mode == 0 && !guest_role && phase == PHASE_ENV_LOT) {
+            Log(fmt::format("environment event: we are the authority now; our game draws (round "
+                            "{})",
+                            round));
+        }
+        session.env_mode = mode;
+        Put<u32>(main + ENV_BOX + 8, mode);
+    }
+    // Tell the others what we drew (every second; they keep the newest). H1: not when cut.
+    if (session.env_drawn && local_no != 0 && !own_cut) {
+        EnvMessage out;
+        out.player_no = static_cast<u8>(local_no);
+        out.instance = instance;
+        out.round = session.env_drawn->first;
+        out.id = session.env_drawn->second;
+        Network::LanSide::Send(
+            std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+    }
+    if (phase != PHASE_ENV_LOT) {
+        session.env_wait_since.reset();
+        return;
+    }
+    if (!session.env_wait_since) {
+        session.env_wait_since = now;
+        session.env_wait_logged = false;
+        session.env_fallback_logged = false;
+        // Forget what was heard before this lot: side packets that queued while we were out of a
+        // match (the host's draw from the last match, same round number) are read at the join.
+        // The host resends its draw every second, so a fresh one arrives within a second.
+        session.env_host.reset();
+        session.env_host_no = 0;
+    }
+    if (mode == 0 || session.env_given_round == round) {
+        return;
+    }
+    if (session.env_host && session.env_host->first == round) {
+        Put<s32>(main + ENV_BOX, session.env_host->second);
+        Put<u32>(main + ENV_BOX + 4, 1);
+        session.env_given_round = round;
+        Log(fmt::format("environment event {} from player {} (round {})",
+                        session.env_host->second, session.env_host_no, round));
+    } else if (now - *session.env_wait_since > 40s) {
+        // Balance fix M4: a draw here can differ from the host's. While the host is still on the
+        // side channel, keep waiting for its draw, up to 90 s in all.
+        const bool host_here = HostFresh(now);
+        if (host_here && now - *session.env_wait_since < 90s) {
+            if (!session.env_wait_logged) {
+                session.env_wait_logged = true;
+                Log(fmt::format("environment event: nothing from the host in 40 s, but the host is "
+                                "still here; waiting up to 90 s (round {})",
+                                round));
+            }
+            return;
+        }
+        // H5: one shared fallback. Only the lowest-numbered game still in the match below the
+        // host we gave up on draws; the others wait for its draw (taken above, from any lower
+        // player) up to 120 s in all, so every game gets the same event.
+        std::vector<u32> lower_here;
+        for (const auto& [key, peer] : peers) {
+            if (peer.no != 0 && peer.no < local_no && now - peer.at < 10s && !PeerCut(peer)) {
+                lower_here.push_back(peer.no);
+            }
+        }
+        std::ranges::sort(lower_here);
+        if (host_here && !lower_here.empty()) {
+            lower_here.erase(lower_here.begin()); // the host itself: given up on
+        }
+        if (!lower_here.empty() && now - *session.env_wait_since < 120s) {
+            if (!session.env_fallback_logged) {
+                session.env_fallback_logged = true;
+                Log(fmt::format("environment event: no draw from the host; player {} is the "
+                                "lowest guest here and draws for everybody, waiting for its draw "
+                                "up to 120 s (round {}, H5)",
+                                lower_here.front(), round));
+            }
+            return;
+        }
+        if (lower_here.empty()) {
+            Log(fmt::format("environment event: we are the lowest-numbered game here; our draw is "
+                            "the shared one (round {}, H5)",
+                            round));
+        }
+        session.env_local_round = round;
+        session.env_mode = 0;
+        Put<u32>(main + ENV_BOX + 8, 0);
+        Log(fmt::format("environment event: nothing from the host in {} s, drawing here (round {})",
+                        std::chrono::duration_cast<std::chrono::seconds>(now -
+                                                                         *session.env_wait_since)
+                            .count(),
+                        round));
+    }
+}
+
+void Assist::State::EndSession(std::string_view why) {
+    RuleEnd();
+    if (main != 0 && Get<u32>(main + I1_SITE) == I1_HOOK) {
+        Put<u8>(main + I1_BOX, 0); // v4.40 ICONS1: stock again offline
+    }
+    // v410 review: cut players of the old match must not stay blocked in a new one
+    cut_instances.clear();
+    cut_instance_drop_logged.clear();
+    cut_instances_gen = ~0U;
+    Put<u32>(main + ENV_BOX + 4, 0);
+    Put<u32>(main + ENV_BOX + 8, 0);
+    Put<s32>(main + ENV_BOX + 0xC, -1);
+    Put<u32>(main + ENV_BOX + 0x10, 0); // session below starts counting from 0 again
+    Put<u32>(main + ENV_BOX + 0x14, 0);
+    Put<u32>(main + GENERATOR_IDLE, 0);
+    Put<u32>(main + GROUP_BOX + 4, 0);
+    Put<u32>(main + GROUP_BOX + 0xC, 0);
+    group_count = 0;
+    Put<u32>(main + REREQUEST, 0);
+    Put<u32>(main + LH_BOX, 0); // v4.52 LINEUPHOLD: never left holding after a session
+    pending_since.reset();
+    pending_box_logged = false; // v3.9.3 (B)
+    side_sent.clear();          // v3.9.3 (C, 3c)
+    role_since = {};
+    role_listed_logged = false;
+    group_until = {};
+    group_round = 0; // V400-5b
+    group_heard = 0;
+    if (session.armed) {
+        Put<u32>(main + MAILBOX + 8, 0);
+    }
+    if (session.map_closed_at && !session.map_restored) {
+        SetCode(MAP_DISPATCH, MAP_DISPATCH_ORIGINAL);
+    }
+    if (session.third_forced) {
+        SetCode(THIRD_WAIT, THIRD_WAIT_ORIGINAL);
+    }
+    Log(fmt::format("session over: {}", why));
+    // Review H1 / M3: map sharing forgets the match. A game still waiting in PrepareThird is let
+    // go (MAP_FED = its round; the role byte written 0 above lets it go too); otherwise MAP_FED is
+    // cleared. The next match's first MapShare resets again (map_manager = 0) and writes ~0U.
+    {
+        const u64 stage = Get<u64>(main + STAGE_PHASE);
+        const u32 round = stage != 0 ? Get<u32>(stage + P_ROUND) : 0;
+        const bool waiting = stage != 0 && Get<u32>(stage + P_STATE) == PHASE_PREPARE_THIRD &&
+                             round < 4 && Get<u32>(main + MAP_FED) != round;
+        if (waiting) {
+            Log(fmt::format("map: the game waits in PrepareThird of round {} at the session's end; "
+                            "let go (review M3)",
+                            round));
+        }
+        MapReset(waiting ? round : ~0U);
+        map_manager = 0;
+        map_stage = 0;
+        virtue_manager = 0; // the virtue reset runs at the next match for sure
+        // Review2 R3: the same for Commendation (a session that ended in round 1 kept its parts).
+        commend_manager = 0;
+        commend_heard.clear();
+        commend_written.clear();
+        taken_manager = 0; // taken state: TakenShare resets at the next match for sure
+        TakenClear();
+        taken_in.clear();
+        final_manager = 0; // final placement: FinalReset runs at the next match for sure
+        final_out.clear();
+        final_finalists.clear();
+        final_host.clear();
+        final_host_from = 0;
+        final_host_team.clear();
+        final_host_team_from = 0;
+        final_fed.clear();
+        final_fed_done.clear();
+        final_dead_since.reset();
+        final_won_since.reset();
+        final_heard_at.clear();
+        final_cut_off = false;
+        final_hear_reports.clear();
+        final_quorum_logged.clear();
+        final_hear_out.clear();
+        final_n2_logged.clear();
+        commend_last_out.clear();
+        cut_nos.clear(); // review5 A: the record belongs to the match
+        cut_stale_logged.clear();
+        cut_gen = ~0U;
+        cut_hold_logged = ~0ULL;
+        local_in_match_gen = ~0U;
+        own_cut_logged = false;
+        dup_logged.clear();
+        cut_snap.reset(); // v3.9.4 F1 / F4 / F2 / F3: per session
+        cut_snap_gen = ~0U;
+        cut_snap_authority = false; // V401c
+        cut_heard.clear();
+        cut_compared.clear();
+        cut_none_logged.clear();
+        cut_sends = 0;
+        cut_acked.clear(); // V400-1
+        cut_acks_logged = false;
+        cut_early_logged.clear();
+        owner_cut_logged.clear();
+        bb_box_key = ~0ULL;
+        bb_box_logged.clear();
+        bb_final_last.clear();
+        bb_final_logs = 0;
+        bb_final_gen = ~0U;
+        host_skip_logged = 0;
+        flask_idle.reset();
+        flask_pd = 0;
+    }
+    session = Session{};
+    peers.clear();
+    enemy_list.clear();
+    enemy_claims.clear();
+    enemy_claim_last.clear(); // v425r R1
+    owner_refusals.clear();
+    // review1 I2: match-keyed records that were never cleared (grew for the whole run).
+    state_repair_done.clear();
+    state_part_logged.clear();
+    rule_heard_key.clear();
+    cutauth_checked.clear();
+    owner_gone_logged.clear();
+    enemy_fight.clear(); // v425
+    enemy_idle_take.clear();
+    enemy_max_heard.clear(); // v426
+    enemy_max_logged.clear();
+    enemy_max_rewrites.clear(); // ZT1
+    boss_contested.clear();
+    boss_yielded.clear();
+    zeppelin_logged = 0;
+    owner_last_seen.fill(Clock::time_point{});
+    kin_last.clear();
+    kin_last_at = {};
+    kin_fix_logged = false;
+    entries_high_logged = false;
+    session_stepped_s = 0;
+    side_old_dropped = 0; // J3: the log says "in this session"
+    side_old_logged = 0;
+    final_points_round = ~0U;
+    final_points.clear();
+    final_rebuilds = 0;
+    final_numbers.clear();
+    final_started.reset();
+    final_crowd_logged = false;
+    final_placed = false;
+    step_cap_logged = false;
+    net_samples.clear();
+    net_have_last = false;
+    synced = 0;
+    clock_prev_left = -1;
+    clock_add_pending = 0;
+    clock_add_resend = 0;
+    clock_add_seen.clear();
+}
