+/// Our local player in the final: true = still in (stage byte 1), false = out or decided (another
+/// stage, or out for good by FinalOutCheck: its pgd is no longer written, so the stage byte stays 1),
+/// nullopt = not readable.
+std::optional<bool> Assist::State::FinalLocalAlive() {
+    if (final_own_out) {
+        return false;
+    }
+    const u64 table = Get<u64>(main + NET_PLAYERS);
+    u64 pgd = table != 0 ? Get<u64>(table + PGD_LOCAL_ALT) : 0;
+    if (pgd == 0 && table != 0) {
+        pgd = Get<u64>(table + PGD_LOCAL);
+    }
+    if (pgd == 0) {
+        return std::nullopt;
+    }
+    const u8 stage = Get<u8>(pgd + PGD_STAGE);
+    if (stage == 0) {
+        return std::nullopt;
+    }
+    return stage == 1;
+}
+
+/// Every other finalist is out of the final for good (its game told us, or our copy of it holds an
+/// "out" stage); false when no other finalist is known.
+/// Bloodbound (rule byte 2): pairs, not players. Our partner (from the game's alliance entries) is
+/// skipped: true when every finalist of the OTHER pairs is out; false when none of them is known.
+bool Assist::State::FinalOthersOut() {
+    const u32 local_no = LocalPlayerNo();
+    const u32 partner = PartnerOf(local_no); // 0 under rules 0 / 1: as before
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    size_t others = 0;
+    for (const u32 no : final_finalists) {
+        if (no == local_no || (partner != 0 && no == partner)) {
+            continue;
+        }
+        ++others;
+        if (final_out.contains(no)) {
+            continue;
+        }
+        const u64 pgd = VirtuePlayer(players, no);
+        if (pgd == 0 || !StageIsOut(Get<u32>(pgd + PGD_STAGE))) {
+            return false;
+        }
+    }
+    return others != 0;
+}
+
+/// Phase clock left in ms for the elimination order (review3 F7; the clocks are synced within about
+/// 0.25 s). 0 means unknown, so a run-out clock gives 1.
+static u32 FinalLeftMs(f32 left) {
+    return left > 0.0f && left < 4'000'000.0f ? std::max<u32>(1, static_cast<u32>(left * 1000.0f))
+                                              : 1;
+}
+
+/// (a) Our own player out of the final for good (lives_stuck_notes.md 4c rule 1), on every game:
+/// - our own game holds us eliminated (the host's own death list wrote 04 05 xx xx): in UpdatePhase
+///   any stage-4 "flag 1" word, in the result steps (7..14) only reason 5 (review3 F1: the host's
+///   game may leave UpdatePhase in the same frames, before the next tick);
+/// - or, in UpdatePhase with the point-select coordinator: own stock 0, HP <= 0, no respawn chosen
+///   (chr+0x26E4 bit 16), no respawn running (chrdata+0x2D0 bit 0), stage byte 1, all for 2 s, and
+///   only after our player was seen alive on its last life (review3 F8).
+/// NOTHING is written into our pgd any more (final_placement_fix2_notes.md): with 04 05 01 01 in our
+/// own pgd+0x46B0 the final's EndPhase list filler 0x115646C skips us, so we got no entry, no
+/// result-row update and no Outcome. We only remember it (FinalLocalAlive then says "out", so the
+/// run-down rule applies) and tell the others; FinalAlign places us after our EndPhase.
+void Assist::State::FinalOutCheck(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0 || !FinalReset(stage) || final_own_out) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const u32 local_no = LocalPlayerNo();
+    const auto clock_left_ms = [&]() {
+        const u64 clock = Get<u64>(stage + P_CLOCK);
+        return FinalLeftMs(clock != 0 ? Get<f32>(clock + 8) : 0.0f);
+    };
+    const auto mark_out = [&](u32 word, u32 left_ms) {
+        u32 others = 0;
+        for (const auto& [no, info] : final_out) {
+            others += info.own ? 0 : 1;
+        }
+        final_own_out = true;
+        final_own_stage = word;
+        final_own_order = others + 1;
+        final_own_left_ms = left_ms;
+        final_own_at = now;
+        final_out_sent_at = {};
+        FinalOutInfo info{final_own_order, word, now, true};
+        info.left_ms = left_ms;
+        info.told = true;
+        final_out[local_no] = info;
+    };
+    // F1: our own game's "out", read through the player table (the chr may be gone after the final).
+    if (phase >= PHASE_UPDATE && phase <= 14 && local_no != 0 && local_no < 0x100) {
+        const u64 table = Get<u64>(main + NET_PLAYERS);
+        u64 own_pgd = table != 0 ? Get<u64>(table + PGD_LOCAL_ALT) : 0;
+        if (own_pgd == 0 && table != 0) {
+            own_pgd = Get<u64>(table + PGD_LOCAL);
+        }
+        const u32 held = own_pgd != 0 && Get<u32>(own_pgd + PGD_NO) == local_no
+                             ? Get<u32>(own_pgd + PGD_STAGE)
+                             : 0;
+        // N5: the step read again after the word; the UpdatePhase test only while both reads say
+        // UpdatePhase (an EndPhase in between gives a beaten 04 03 01 01, which is not "out").
+        const bool in_update = phase == PHASE_UPDATE && Get<u32>(stage + P_STATE) == PHASE_UPDATE;
+        if (phase == PHASE_UPDATE && !in_update && StageIsOut(held) && !StageIsEliminated(held)) {
+            Log(fmt::format("final: our stage {} was read as the game left UpdatePhase; not taken "
+                            "as out (N5)",
+                            StageBytes(held)));
+        }
+        if (in_update ? StageIsOut(held) : StageIsEliminated(held)) {
+            mark_out(held, in_update ? clock_left_ms() : 0);
+            Log(fmt::format("final: our player (no {}) is out per our own game (stage {}, step {}); "
+                            "elimination #{}, told to the others, nothing written",
+                            local_no, StageBytes(held), phase, final_own_order));
+            return;
+        }
+    }
+    if (phase != PHASE_UPDATE) {
+        final_dead_since.reset();
+        return;
+    }
+    const u64 coordinator = Get<u64>(stage + P_FINAL);
+    if (Get<u64>(coordinator) != main + FINAL_POINT_VTABLE) {
+        if (!final_vt_logged) {
+            final_vt_logged = true;
+            Log(fmt::format("final placement: the final's coordinator is not the point-select one "
+                            "(vtable main+{:#x}); own elimination not checked",
+                            Get<u64>(coordinator) - main));
+        }
+        return;
+    }
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 chr = world != 0 ? Get<u64>(world + 0x1A8) : 0;
+    const u64 chr_data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+    const u64 pgd = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+    const u64 modules = chr != 0 ? Get<u64>(chr + CHR_MODULES) : 0;
+    const u64 hp_module = modules != 0 ? Get<u64>(modules + 0x18) : 0;
+    if (pgd == 0 || hp_module == 0 || local_no == 0 || local_no >= 0x100 ||
+        Get<u32>(pgd + PGD_NO) != local_no) {
+        final_dead_since.reset();
+        return;
+    }
+    const u32 own_stage = Get<u32>(pgd + PGD_STAGE);
+    const u8 stock = Get<u8>(pgd + PGD_STOCK);
+    const s32 hp = Get<s32>(hp_module + 0x290);
+    const u32 flags = Get<u32>(chr + CHR_FLAGS);
+    const u8 respawning = Get<u8>(chr_data + CHRDATA_RESPAWNING);
+    const bool calm = (own_stage & 0xFF) == 1 && stock == 0 && (flags & CHR_RESPAWN_CHOSEN) == 0 &&
+                      (respawning & 1) == 0;
+    // F8: only a death on the last life counts, i.e. after our player stood alive with stock 0.
+    if (calm && hp > 0 && !final_last_life_seen) {
+        final_last_life_seen = true;
+        Log(fmt::format("final: our player (no {}) is on its last life (stock 0, HP {}, stage {}); "
+                        "its next death puts it out",
+                        local_no, hp, StageBytes(own_stage)));
+    }
+    const bool dead = calm && hp <= 0 && final_last_life_seen;
+    if (!dead) {
+        if (final_dead_since) {
+            Log(fmt::format("final: our player (no {}) is no longer dead for good after {} ms "
+                            "(stock {}, HP {}, respawn flag {}, respawning {}, stage {}); not out",
+                            local_no,
+                            std::chrono::duration_cast<std::chrono::milliseconds>(
+                                now - *final_dead_since)
+                                .count(),
+                            stock, hp, (flags >> 16) & 1, respawning & 1, StageBytes(own_stage)));
+            final_dead_since.reset();
+        }
+        return;
+    }
+    if (!final_dead_since) {
+        final_dead_since = now;
+        const u64 clock = Get<u64>(stage + P_CLOCK);
+        final_dead_left = clock != 0 ? Get<f32>(clock + 8) : 0.0f;
+        Log(fmt::format("final: our player (no {}) is dead with no life left (stock 0, HP {}, no "
+                        "respawn flag, not respawning, stage {}, {:.1f} s left); out if it stays "
+                        "so for 2 s",
+                        local_no, hp, StageBytes(own_stage), final_dead_left));
+        return;
+    }
+    if (now - *final_dead_since < 2s) {
+        return;
+    }
+    mark_out(STAGE_OUT, FinalLeftMs(final_dead_left));
+    Log(fmt::format("final: our player (no {}) is out (elimination #{} as seen here, died at {:.1f} "
+                    "s left); told to the others as {}; our own pgd+0x46B0 stays {} so that our "
+                    "EndPhase still lists us (no write)",
+                    local_no, final_own_order, final_dead_left, StageBytes(STAGE_OUT),
+                    StageBytes(own_stage)));
+}
+
+/// Side-channel type 10 (FinalMessage), taken at once by SideFast.
+void Assist::State::FinalHeard(const Network::LanSide::Packet& packet) {
+    FinalMessage head;
+    if (packet.data.size() < sizeof(head)) {
+        return;
+    }
+    std::memcpy(&head, packet.data.data(), sizeof(head));
+    if (head.instance == instance || head.player_no == 0 || head.count == 0 ||
+        head.count > P_ENTRY_MAX || head.round != FINAL_ROUND ||
+        packet.data.size() != sizeof(head) + head.count * sizeof(FinalRecord)) {
+        return;
+    }
+    std::vector<FinalRecord> records(head.count);
+    std::memcpy(records.data(), packet.data.data() + sizeof(head),
+                head.count * sizeof(FinalRecord));
+    if (head.kind == FINAL_KIND_OUT) {
+        const FinalRecord& out = records[0];
+        if (head.count != 1 || out.no != head.player_no || out.no >= 0x100 ||
+            out.no == LocalPlayerNo() || !StageIsOut(out.stage)) {
+            return; // never our own player; only an "out" word
+        }
+        // N2: only from a finalist (seen in our final's UpdatePhase). A culled game that marks
+        // itself out must not make a clock final "aligned". Resent every second, so a finalist not
+        // marked yet is taken a moment later.
+        const bool from_finalist =
+            final_finalists.contains(out.no) ||
+            std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+                return entry.second.finalist && entry.second.no == out.no;
+            });
+        if (!from_finalist) {
+            if (final_n2_logged.insert(out.no).second) {
+                Log(fmt::format("final: player {} says it is out, but it is not a finalist here; "
+                                "ignored (N2)",
+                                out.no));
+            }
+            return;
+        }
+        // out.rank carries the sender's phase clock left at its death in ms (review3 F7).
+        FinalOutInfo info{out.order, out.stage, packet.at, false};
+        info.left_ms = out.rank;
+        info.told = true;
+        const auto [found, added] = final_out.emplace(out.no, info);
+        if (added) {
+            Log(fmt::format("final: player {} is out of the final for good, its game says "
+                            "(elimination #{} there, stage {}, {:.1f} s left); {} player(s) out "
+                            "here now",
+                            out.no, out.order, StageBytes(out.stage), out.rank / 1000.0,
+                            final_out.size()));
+        } else if (!found->second.told) {
+            // Seen here first (our copy or silence); its own game's clock value wins.
+            found->second.told = true;
+            found->second.silent = false; // H4: no longer a silence-only mark
+            found->second.order = out.order;
+            if (out.rank != 0) {
+                found->second.left_ms = out.rank;
+            }
+            Log(fmt::format("final: player {}'s own game confirms it is out (elimination #{} there, "
+                            "{:.1f} s left)",
+                            out.no, out.order, out.rank / 1000.0));
+        }
+        return;
+    }
+    if (head.kind == FINAL_KIND_TEAMS) {
+        // v3.9.6: the host's team ranks for BbAlign (Bloodbound only; the host takes nobody's, and
+        // as for kind 2 only a finalist's and the lowest-numbered sender's).
+        if (Get<u8>(main + RULE_BYTE) != RULE_BLOODBOUND || Get<u32>(main + GENERATOR_IDLE) == 0 ||
+            !final_finalists.contains(head.player_no) ||
+            (final_host_team_from != 0 && head.player_no > final_host_team_from && // M F2
+             packet.at - final_host_team_at < FINAL_HOST_SILENT)) {
+            return; // v406: a higher sender only once the current one is silent (hand-over)
+        }
+        const bool first_teams = final_host_team.empty() || head.player_no != final_host_team_from;
+        final_host_team.clear();
+        std::string teams;
+        for (const auto& record : records) {
+            final_host_team[record.no] = record.rank;
+            teams += fmt::format("{}player {} team rank {}", teams.empty() ? "" : ", ", record.no,
+                                 record.rank);
+        }
+        final_host_team_from = head.player_no;
+        final_host_team_at = packet.at;
+        if (first_teams) {
+            Log(fmt::format("final: the host's (player {}) team ranks: {}", head.player_no, teams));
+        }
+        return;
+    }
+    if (head.kind != FINAL_KIND_ENTRIES || Get<u32>(main + GENERATOR_IDLE) == 0) {
+        return; // the host takes nobody's entries
+    }
+    if (!final_finalists.contains(head.player_no)) {
+        return; // review3 F9: only a finalist's entries (a culled host's game is not in our final)
+    }
+    // deep audit M F2: a LOWER finalist that sends is taken at once, a higher one only once the
+    // kept one is silent. Before, the first sender heard stuck for as long as it kept sending, so
+    // during a short split brain (two games with the role) the guests could keep different hosts
+    // and place the final differently; the role rule makes the lowest number the authority.
+    if (final_host_from != 0 && head.player_no > final_host_from &&
+        packet.at - final_host_at < FINAL_HOST_SILENT) {
+        return; // the lowest-numbered sender is the host (v406: until it is silent: hand-over)
+    }
+    const bool first = final_host.empty() || head.player_no != final_host_from;
+    final_host.clear();
+    std::string list;
+    for (const auto& record : records) {
+        final_host.push_back(FinalEntry{record.no, record.rank, record.stage});
+        list += fmt::format("{}player {} rank {} stage {}", list.empty() ? "" : ", ", record.no,
+                            record.rank, StageBytes(record.stage));
+    }
+    final_host_from = head.player_no;
+    final_host_at = packet.at;
+    if (first) {
+        Log(fmt::format("final: the host's (player {}) final entries: {}", head.player_no, list));
+    }
+}
+
+/// v3.9.9 FINALOUT (spectate_notes.md 8). In a final with 3+ finalists the game processes an
+/// elimination only in its elimination block (offline only; online the server did it), so the eliminated
+/// player stayed dead at stage 01 01 00 00 with no spectator state. With the FINALOUT group the block runs
+/// online only in the frame the game takes a player from this mailbox (v399b: the host's death-list
+/// entries alone no longer run it, so the last elimination and the 2-player final stay stock); every
+/// game, the host too, gets it from here: every finalist out for good (its own game said so, or ours) is written once into the
+/// mailbox FINALOUT_BOX while our copy of it still holds stage 1. The game then gives it 04 05 01 01, its
+/// Outcome item and, on its own game, the spectator mark (par+0x164). Only while at least two finalists
+/// stay in (the last elimination ends the final the stock way, as in the proven 2-player final), only in
+/// the final's UpdatePhase, one player per tick, never over a word the game has not taken yet.
+void Assist::State::FinalFeed(u64 stage, u64 players) {
+    if (final_out.empty() || Get<u32>(stage + P_ROUND) != FINAL_ROUND) {
+        return;
+    }
+    if (Get<u32>(main + FINALOUT_SITE) != FINALOUT_HOOK_WORD) {
+        if (!final_feed_logged) {
+            final_feed_logged = true;
+            Log("final: the FINALOUT group is not in this build: eliminations are left to the end of "
+                "the final");
+        }
+        return;
+    }
+    if (Get<u8>(main + RULE_BYTE) == RULE_BLOODBOUND) {
+        // v399b: a dead partner of a living survivor is "out" here, but the host's death list gives it
+        // the team case 02 01 01 00 (0x116FD20 query 0x27), not 04 05 01 01; the pairs final (v3.9.6)
+        // stays as it is.
+        if (!final_feed_bb_logged) {
+            final_feed_bb_logged = true;
+            Log("final: Bloodbound rule: eliminations are not handed to the game's elimination block");
+        }
+        return;
+    }
+    const u32 local_no = LocalPlayerNo();
+    const auto pgd_of = [&](u32 no) -> u64 {
+        if (no != local_no) {
+            return VirtuePlayer(players, no);
+        }
+        u64 own = Get<u64>(players + PGD_LOCAL_ALT);
+        if (own == 0) {
+            own = Get<u64>(players + PGD_LOCAL);
+        }
+        return own != 0 && Get<u32>(own + PGD_NO) == no ? own : 0;
+    };
+    // the game's answer: a handed player whose stage is now 4
+    for (const u32 no : final_fed) {
+        if (final_fed_done.contains(no)) {
+            continue;
+        }
+        const u64 pgd = pgd_of(no);
+        const u32 word = pgd != 0 ? Get<u32>(pgd + PGD_STAGE) : 0;
+        if ((word & 0xFF) == 4) {
+            final_fed_done.insert(no);
+            // v4.32 FIREKEEP: the same frame's pgd apply skipped the second kill of the copy, or not
+            std::string keep;
+            if (no != local_no) {
+                const u32 skips = Get<u32>(main + FK_BOX);
+                if (Get<u32>(main + FK_SITE) == FK_STOCK_WORD) {
+                    keep = "; FIREKEEP not in this build: the copy is killed again and taken out";
+                } else if (skips != firekeep_seen) {
+                    keep = fmt::format("; its copy stays here as a dead body (FIREKEEP skip {}, "
+                                       "player {})",
+                                       skips, Get<u32>(main + FK_BOX + 4));
+                } else {
+                    keep = "; FIREKEEP did not skip (no copy found, or not the out word)";
+                }
+                firekeep_seen = skips;
+            }
+            Log(fmt::format("final: the game took player {}'s elimination (stage {}{}{})", no,
+                            StageBytes(word), no == local_no ? ", our player: spectating" : "",
+                            keep));
+        }
+    }
+    size_t out_count = 0;
+    for (const auto& [no, info] : final_out) {
+        out_count += info.silent && !info.told ? 0 : 1;
+    }
+    if (final_finalists.size() < 3) {
+        return; // a 2-player final: the stock end (kill decision)
+    }
+    // v418 (final3_notes.md): nothing is handed over on a game whose own player is out, or dead on
+    // its last life (the 2-s wait; the host's death list may already have queued it). Handing the
+    // local player, or running the block while the local player is queued, sets par+0x164, so
+    // UpdatePhase ends at once (0x114BA9C). That game's EndPhase then runs the kill decision
+    // 0x116F240 in survivor mode with the survivor array C+0x148 still empty (it is filled only when
+    // one is left, 0x116F1A0): EVERY listed player gets event 7 = 04 05 01 01, the list's "all at
+    // stage 4" bit gives par+0x16C = 1 (0x1144E78), and EndPhase jumps 7 -> 36 Finish
+    // (0x114C8F8..0x114C914), past PrepareMatchReward / MatchReward: no result screen, the last frame
+    // stays (user test 23:31, player 2 out first). Without the hand-over that game stays in its
+    // UpdatePhase (live view, our player dead) until another finalist's game is past the final; then
+    // its clock is run down, its EndPhase ranks on points (par+0x16D), and FinalAlign places every
+    // finalist from final_out / the host's entries, as for the last elimination. The other games
+    // still hand our player over (their copy of us gets 04 05 01 01 and its Outcome item).
+    if (final_own_out && !final_own_hidden && Clock::now() - final_own_at >= 1s) {
+        // v4.39 OUTHIDE (fire_alpha_notes.md): every other game ends our copy at the hand-over
+        // (0x17BFDD0: kill, then the disable tail); our own game never does it for our dead chr
+        // (v418), and its dead body went on burning until the final's world ended (match 4: A and
+        // B at 12 fps, the laptop at 8 fps for 5 min). Give our own chr only the disable tail,
+        // once, 1 s after we are out: no HP event, no pgd or spectator change.
+        final_own_hidden = true;
+        const u64 world = Get<u64>(main + WORLD_CHR);
+        const u64 chr = world != 0 ? Get<u64>(world + 0x1A8) : 0;
+        const u64 owner = chr != 0 ? Get<u64>(chr + 0x18) : 0;
+        const u64 net = owner != 0 ? Get<u64>(owner + 0x30) : 0;
+        if (Get<u32>(main + OH_SITE) != OH_HOOK) {
+            Log("final: OUTHIDE is not in this build: our dead body stays as it is (v4.39)");
+        } else if (chr == 0 || (net != 0 && (Get<u8>(net + 0x18) & 1) != 0)) {
+            Log(fmt::format("final: OUTHIDE: no own chr to end (chr {:#x}) (v4.39)", chr));
+        } else if (Get<u64>(main + OH_BOX) != 0) {
+            Log("final: OUTHIDE: the box is still full; not written (v4.39)");
+        } else {
+            Put<u64>(main + OH_BOX, chr);
+            Log(fmt::format("final: our player (no {}) is out: its dead body gets the stock end of an "
+                            "eliminated chr on the next tick (0x17BFDD0's disable tail; v4.39 OUTHIDE)",
+                            local_no));
+        }
+    }
+    if (final_own_out || final_dead_since) {
+        if (!final_feed_own_logged) {
+            final_feed_own_logged = true;
+            Log(fmt::format("final: our player (no {}) is out{}: no player is handed to the game's "
+                            "elimination block here (v418: our game waits for the end of the final, "
+                            "then shows its result)",
+                            local_no, final_own_out ? "" : " (dead on its last life)"));
+        }
+        return;
+    }
+    if (Get<u32>(main + FINALOUT_BOX) != 0) {
+        return; // the game has not taken the last one yet (it takes one per frame)
+    }
+    // v415 (audit8_final.md F1): the earliest out first, and never the last two not handed over.
+    // Before, "out_count + 2 > finalists" stopped every hand-over once all but one were marked out:
+    // two deaths in the same 50-ms tick (or told in one burst) left BOTH unhandled, so the game
+    // saw two dead players at stage 1 and no stock last elimination. Now the game always keeps
+    // exactly two not handed over (the survivor and the last out: the stock end, as with two
+    // players), and the earlier ones are handed in their elimination order (most clock left first,
+    // as FinalAlign ranks them; unknown clock = the last out; then when learned, then number).
+    std::vector<u32> order;
+    for (const auto& [no, info] : final_out) {
+        if ((info.silent && !info.told) || final_fed.contains(no) || no == 0 || no >= 0x100) {
+            continue; // H4: a silence-only mark is never handed over
+        }
+        order.push_back(no);
+    }
+    std::sort(order.begin(), order.end(), [&](u32 a, u32 b) {
+        const FinalOutInfo& ia = final_out.at(a);
+        const FinalOutInfo& ib = final_out.at(b);
+        if (ia.left_ms != ib.left_ms) {
+            return ia.left_ms > ib.left_ms; // more clock left = out earlier (0 = unknown: last)
+        }
+        if (ia.at != ib.at) {
+            return ia.at < ib.at;
+        }
+        return a < b;
+    });
+    // A finalist marked only by silence (a leaver, H4) still looks alive to the game, so the stock
+    // end cannot come before the clock anyway: then the rule stays as it was (every out one handed
+    // over while two are not out), so they still get their spectator mark.
+    const size_t silent_count = final_out.size() - out_count;
+    for (const u32 no : order) {
+        if (silent_count == 0 ? final_fed.size() + 2 >= final_finalists.size()
+                              : final_finalists.size() < out_count + 2) {
+            return; // the last elimination: the stock end of the final (kill decision)
+        }
+        // v4.27 (deathfx2_notes.md): the elimination block takes the out player's copy out of the
+        // world. Done while its death is still playing here (FINALOUT came 2-3 s after the death),
+        // the laptop saw the death effects stack / keep burning; only with 3+ finalists (a 2-player
+        // final never runs the block). Wait until 6 s after we learned it, unless another finalist
+        // is out too (then at once: two dead at stage 1 would lose the stock end, v415 F1).
+        // v4.33 (four_plus_audit_notes.md A3): "out too" means not handed over yet (order). With
+        // out_count every elimination after the first of a 4+ finalist final went at once, its
+        // death still playing. With 3 finalists the same as before.
+        constexpr auto FINALOUT_HOLD = std::chrono::milliseconds{6000};
+        if (order.size() < 2 && Clock::now() - final_out.at(no).at < FINALOUT_HOLD) {
+            if (finalout_hold_logged != no) {
+                finalout_hold_logged = no;
+                Log(fmt::format("final: player {} is handed to the elimination block in 6 s (its "
+                                "death plays out here first)",
+                                no));
+            }
+            return;
+        }
+        const u64 pgd = pgd_of(no);
+        if (pgd == 0) {
+            continue;
+        }
+        const u32 word = Get<u32>(pgd + PGD_STAGE);
+        final_fed.insert(no);
+        if ((word & 0xFF) != 1) {
+            final_fed_done.insert(no);
+            Log(fmt::format("final: player {} already holds stage {} here (the game processed it); "
+                            "not handed over",
+                            no, StageBytes(word)));
+            continue;
+        }
+        Put<u32>(main + FINALOUT_BOX, no);
+        Log(fmt::format("final: player {} handed to the game's elimination block (FINALOUT mailbox, "
+                        "{} of {} finalists out, stage {})",
+                        no, out_count, final_finalists.size(), StageBytes(word)));
+        return; // one per tick
+    }
+}
+
+/// The final's placement on every game (lives_stuck_notes.md 4c). Every 50 ms:
+/// (a) FinalOutCheck, and our own "out" to the others (type 10, kind 1, resent while the final
+///     lasts). No pgd+0x46B0 is written on any game any more (final_placement_fix2_notes.md); a
+///     finalist is also taken as out when our copy of it holds an "out" word (review3 F2) or when
+///     its game has not been heard for 10 s in the final (review3 F6);
+/// (c) the host sends its final entries in the result steps (type 10, kind 2); FinalAlign then
+///     places the finalists the same way on every game.
+void Assist::State::FinalPlacement(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 players = Get<u64>(main + NET_PLAYERS);
+    if (stage == 0 || players == 0 || !FinalReset(stage)) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const u32 local_no = LocalPlayerNo();
+    if (phase == PHASE_UPDATE) {
+        if (local_no != 0 && local_no < 0x100 && final_finalists.insert(local_no).second) {
+            Log(fmt::format("final placement: our player (no {}) is a finalist", local_no));
+        }
+        for (const auto& [key, peer] : peers) {
+            if (peer.finalist && peer.no != 0) {
+                final_finalists.insert(peer.no);
+            }
+        }
+    }
+    for (const auto& [no, info] : final_out) {
+        final_finalists.insert(no);
+    }
+    FinalOutCheck(now);
+
+    // (a) Ours to the others: every 250 ms for 5 s, then every second, up to the result screen.
+    // N2: only as a finalist (our player was seen in the final's UpdatePhase).
+    if (final_own_out && local_no != 0 && local_no < 0x100 && phase <= 14 &&
+        final_finalists.contains(local_no)) {
+        const auto every = now - final_own_at < 5s ? 250ms : 1000ms;
+        if (now - final_out_sent_at >= every) {
+            FinalMessage head;
+            head.player_no = static_cast<u8>(local_no);
+            head.kind = FINAL_KIND_OUT;
+            head.count = 1;
+            head.instance = instance;
+            head.round = FINAL_ROUND;
+            // rank = our phase clock left at our death, ms (review3 F7; 0 = unknown)
+            const FinalRecord record{local_no, final_own_left_ms, final_own_stage,
+                                     final_own_order};
+            std::array<u8, sizeof(head) + sizeof(record)> out{};
+            std::memcpy(out.data(), &head, sizeof(head));
+            std::memcpy(out.data() + sizeof(head), &record, sizeof(record));
+            Network::LanSide::Send(std::span<const u8>(out.data(), out.size()));
+            if (final_out_sent_at == Clock::time_point{}) {
+                Log(fmt::format("final: our elimination (player {}, #{}, stage {}) is sent to the "
+                                "others",
+                                local_no, final_own_order, StageBytes(final_own_stage)));
+            }
+            final_out_sent_at = now;
+        }
+    }
+
+    // (d) v3.9.9 FINALOUT: hand every finalist out for good to the game's own elimination block.
+    if (phase == PHASE_UPDATE) {
+        FinalFeed(stage, players);
+    }
+
+    // (a) Theirs: their own games tell us (FinalHeard). Nothing is written into our copies any
+    // more: a stage-4 copy is skipped by our final's EndPhase (0x115646C), so it would get no entry
+    // and no result-row update here. Two more ways a finalist is out here (seen order = `at`):
+    // F2: our copy holds an "out" word (the host's own death list, or an 0xBC record). In
+    //     UpdatePhase any stage-4 flag-1 word; after it only reason 5 (an EndPhase gives the players
+    //     beaten on points 04 03 01 01, which is not "out").
+    // F6: in our final's UpdatePhase its game has not been heard for 25 s (gone / disconnected;
+    // H4 / N3: 25 s, past the 20-s peer erase, and dropped again when it is heard in UpdatePhase).
+    // H4 / N3: when each finalist was last heard (kept here: the peer itself goes after 20 s).
+    for (const auto& [key, peer] : peers) {
+        if (peer.no != 0 && final_finalists.contains(peer.no)) {
+            auto& last = final_heard_at[peer.no];
+            last = std::max(last, peer.at);
+        }
+    }
+    // H4 / N3: a silence-only mark (its own game never said "out") is cleared when that finalist's
+    // game is heard again in UpdatePhase.
+    std::erase_if(final_out, [&](const auto& item) {
+        if (!item.second.silent || item.second.told) {
+            return false;
+        }
+        const bool back = std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+            return entry.second.no == item.first && now - entry.second.at < 3s &&
+                   entry.second.phase == PHASE_UPDATE;
+        });
+        if (back) {
+            Log(fmt::format("final: player {} is heard again in UpdatePhase; its silence mark is "
+                            "dropped, it is in the final again (H4 / N3)",
+                            item.first));
+        }
+        return back;
+    });
+    if (phase >= PHASE_UPDATE && phase <= 14) {
+        const u64 clock = Get<u64>(stage + P_CLOCK);
+        const u32 left_ms = phase == PHASE_UPDATE && clock != 0
+                                ? FinalLeftMs(Get<f32>(clock + 8))
+                                : 0;
+        // v429 stall guard (two winners, matches 3 and 5): a silence alone marks nobody out when
+        // this game hears none of two or more other finalists that are still in. Then it is this
+        // game that is cut off (stalled, or its link is gone); the others still hear each other
+        // and decide. The marks wait until one of them is heard again. Not while any other game is
+        // still heard (our link works: the silent ones are gone), and it lapses after 90 s of
+        // silence from all of them (they really dropped: crashed or left).
+        // v4.33 (four_plus_audit_notes.md A2): with 4+ finalists a split need not leave one game
+        // alone: at 2:2 each half hears its partner and marked the other half out (two finals, two
+        // winners). Now only the larger side marks for silence (our side = us and the finalists
+        // heard here); at a tie the side with the lowest player number still in. The smaller side
+        // waits, with no lapse while it still hears a finalist (a split is likelier than two games
+        // crashing together). With 3 finalists this is the v429b rule unchanged.
+        u32 others_in = 0;
+        u32 others_silent = 0;
+        u32 low_in = local_no;   // v4.33: lowest number among the finalists still in (us included)
+        u32 low_side = local_no; // v4.33: lowest number on our side (us and the ones heard)
+        Clock::duration quiet_for = Clock::duration::max(); // shortest silence among the silent ones
+        for (const u32 no : final_finalists) {
+            if (no == local_no || final_out.contains(no)) {
+                continue;
+            }
+            ++others_in;
+            low_in = std::min(low_in, no);
+            std::optional<Clock::time_point> heard;
+            for (const auto& [key, peer] : peers) {
+                if (peer.no == no && (!heard || peer.at > *heard)) {
+                    heard = peer.at;
+                }
+            }
+            if (const auto kept = final_heard_at.find(no);
+                kept != final_heard_at.end() && (!heard || kept->second > *heard)) {
+                heard = kept->second;
+            }
+            if (heard && now - *heard >= 25s) {
+                ++others_silent;
+                quiet_for = std::min<Clock::duration>(quiet_for, now - *heard);
+            } else {
+                low_side = std::min(low_side, no); // heard (or never heard yet: its count starts)
+            }
+        }
+        const bool link_alive = std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+            // v4.33: a cut player's game is not in our match; hearing it says nothing of our link
+            return entry.second.no != 0 && now - entry.second.at < 5s && !CutNo(entry.second.no);
+        });
+        const bool all_silent = others_in >= 2 && others_silent == others_in;
+        const u32 side = 1 + others_in - others_silent; // v4.33: us and the finalists heard here
+        const u32 total = 1 + others_in;
+        const bool smaller = others_in >= 2 && others_silent != 0 &&
+                             (side * 2 < total || (side * 2 == total && low_side != low_in));
+        const bool lapsed = all_silent && quiet_for >= 90s;
+        const bool cut_off =
+            phase == PHASE_UPDATE && smaller && !(all_silent && link_alive) && !lapsed;
+        if (phase != PHASE_UPDATE) {
+            final_cut_off = false;
+        } else if (cut_off != final_cut_off) {
+            final_cut_off = cut_off;
+            if (cut_off && !all_silent) {
+                Log(fmt::format("final: {} of the {} other finalists have not been heard for 25 s; "
+                                "our side ({} of {} finalists{}) is the smaller one, so nobody is "
+                                "marked out here for silence (v4.33 majority guard)",
+                                others_silent, others_in, side, total,
+                                side * 2 == total
+                                    ? fmt::format(", a tie without player {}", low_in)
+                                    : ""));
+            } else if (cut_off) {
+                Log(fmt::format("final: none of the {} other finalists (and no other game) has been "
+                                "heard for 25 s: this game is the one cut off, so nobody is marked "
+                                "out here for silence (v429 stall guard)",
+                                others_in));
+            } else if (lapsed) {
+                Log("final: the other finalists have been silent for 90 s: they are taken as gone "
+                    "and marked out (v429 stall guard lapses)");
+            } else {
+                Log(fmt::format("final: the v429 / v4.33 stall guard is off ({} of {} other "
+                                "finalists silent: another game is heard again, or we are on the "
+                                "larger side now)",
+                                others_silent, others_in));
+            }
+        }
+        // v4.34 quorum: tell the others which finalists we hear (in the last 5 s), once a second.
+        if (phase == PHASE_UPDATE && local_no != 0 && local_no <= 32 &&
+            now - final_hear_sent_at >= 1s) {
+            HearMessage out;
+            out.player_no = static_cast<u8>(local_no);
+            out.instance = instance;
+            for (const auto& [key, peer] : peers) {
+                if (peer.no != 0 && peer.no <= 32 && final_finalists.contains(peer.no) &&
+                    now - peer.at < 5s && !PeerCut(peer)) {
+                    out.heard |= 1U << (peer.no - 1);
+                }
+            }
+            // v4.34b: the finalists out here (our copy saw it, or its game said so); not silence
+            for (const auto& [no, info] : final_out) {
+                if (no != 0 && no <= 16 && !(info.silent && !info.told)) {
+                    out.out = static_cast<u16>(out.out | (1U << (no - 1)));
+                }
+            }
+            out.seq = static_cast<u32>(++final_hear_seq);
+            Network::LanSide::Send(
+                std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+            final_hear_sent_at = now;
+        }
+        // v4.34 quorum: the finalist that another game in the match (heard here in the last 5 s,
+        // itself still in, not cut) reported hearing in the last 3 s.
+        const auto heard_by = [&](u32 no) -> u32 {
+            if (no == 0 || no > 32) {
+                return 0;
+            }
+            for (const auto& [reporter, report] : final_hear_reports) {
+                if (reporter == no || reporter == local_no || final_out.contains(reporter) ||
+                    CutNo(reporter) || now - report.second >= 3s ||
+                    (report.first & (1U << (no - 1))) == 0) {
+                    continue;
+                }
+                const bool reporter_heard =
+                    std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+                        return entry.second.no == reporter && now - entry.second.at < 5s;
+                    });
+                if (reporter_heard) {
+                    return reporter;
+                }
+            }
+            return 0;
+        };
+        // v4.34b: a fresh, heard, in-match reporter that has this finalist out (see HearMessage::out).
+        const auto out_by = [&](u32 no) -> u32 {
+            if (no == 0 || no > 16) {
+                return 0;
+            }
+            for (const auto& [reporter, report] : final_hear_reports) {
+                const auto mask = final_hear_out.find(reporter);
+                if (reporter == no || reporter == local_no || CutNo(reporter) ||
+                    now - report.second >= 3s || mask == final_hear_out.end() ||
+                    (mask->second & (1U << (no - 1))) == 0) {
+                    continue;
+                }
+                const bool reporter_heard =
+                    std::any_of(peers.begin(), peers.end(), [&](const auto& entry) {
+                        return entry.second.no == reporter && now - entry.second.at < 5s;
+                    });
+                if (reporter_heard) {
+                    return reporter;
+                }
+            }
+            return 0;
+        };
+        for (const u32 no : final_finalists) {
+            if (no == local_no || final_out.contains(no)) {
+                continue;
+            }
+            const u64 pgd = VirtuePlayer(players, no);
+            const u32 held = pgd != 0 ? Get<u32>(pgd + PGD_STAGE) : 0;
+            // N5: the step again after the word; the UpdatePhase test only while both say so.
+            const bool in_update =
+                phase == PHASE_UPDATE && Get<u32>(stage + P_STATE) == PHASE_UPDATE;
+            std::string why;
+            bool silent = false;
+            if (in_update ? StageIsOut(held) : StageIsEliminated(held)) {
+                why = fmt::format("our copy of it holds stage {} (review3 F2)", StageBytes(held));
+            } else if (in_update) {
+                std::optional<Clock::time_point> heard;
+                for (const auto& [key, peer] : peers) {
+                    if (peer.no == no && (!heard || peer.at > *heard)) {
+                        heard = peer.at;
+                    }
+                }
+                if (const auto kept = final_heard_at.find(no); kept != final_heard_at.end() &&
+                                                               (!heard || kept->second > *heard)) {
+                    heard = kept->second;
+                }
+                if (const u32 relay_by = out_by(no);
+                    relay_by != 0 && (!heard || now - *heard >= 5s)) {
+                    // v4.34b: its own "out" cannot reach us (we do not hear its game)
+                    why = fmt::format("player {}'s game has it out and its own game is not heard "
+                                      "here (v4.34b relay)",
+                                      relay_by);
+                } else if (!heard) {
+                    final_heard_at[no] = now; // never heard here: the 25 s count from now
+                } else if (now - *heard >= 25s) {
+                    if (cut_off) {
+                        continue; // v429: we are the one cut off
+                    }
+                    if (const u32 by = heard_by(no); by != 0) {
+                        if (final_quorum_logged.insert(no).second) {
+                            Log(fmt::format("final: player {} is silent here but player {} still "
+                                            "hears it: a one-way link loss, not marked out "
+                                            "(v4.34 quorum)",
+                                            no, by));
+                        }
+                        continue;
+                    }
+                    silent = true;
+                    why = fmt::format("its game has not been heard for {} s in the final "
+                                      "(review3 F6, 25 s: H4)",
+                                      std::chrono::duration_cast<std::chrono::seconds>(now -
+                                                                                       *heard)
+                                          .count());
+                }
+            }
+            if (why.empty()) {
+                continue;
+            }
+            FinalOutInfo info{0, StageIsEliminated(held) ? held : STAGE_OUT, now, false};
+            info.left_ms = left_ms;
+            info.silent = silent;
+            final_out[no] = info;
+            Log(fmt::format("final: player {} is out of the final for good: {} (step {}, {:.1f} s "
+                            "left); {} player(s) out here now",
+                            no, why, phase, left_ms / 1000.0, final_out.size()));
+        }
+    }
+
+    // (c) The host's entries to the guests, in the result steps (after its EndPhase).
+    const bool host = Get<u32>(main + GENERATOR_IDLE) == 0;
+    if (host && phase >= 8 && phase <= 14 && local_no != 0 && local_no < 0x100 &&
+        now - final_entries_sent_at >= 250ms) {
+        const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+        if (count != 0 && count <= P_ENTRY_MAX) {
+            FinalMessage head;
+            head.player_no = static_cast<u8>(local_no);
+            head.kind = FINAL_KIND_ENTRIES;
+            head.count = static_cast<u8>(count);
+            head.instance = instance;
+            head.round = FINAL_ROUND;
+            std::vector<u8> out(sizeof(head) + count * sizeof(FinalRecord));
+            std::memcpy(out.data(), &head, sizeof(head));
+            std::string list;
+            for (u64 i = 0; i < count; ++i) {
+                const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+                FinalRecord record{Get<u32>(entry), Get<u32>(entry + PE_RANK),
+                                   Get<u32>(entry + PE_STATE), 0};
+                if (const auto found = final_out.find(record.no); found != final_out.end()) {
+                    record.order = found->second.order;
+                }
+                std::memcpy(out.data() + sizeof(head) + i * sizeof(record), &record,
+                            sizeof(record));
+                list += fmt::format("{}player {} rank {} stage {}", list.empty() ? "" : ", ",
+                                    record.no, record.rank, StageBytes(record.stage));
+            }
+            Network::LanSide::Send(std::span<const u8>(out.data(), out.size()));
+            final_entries_sent_at = now;
+            if (!final_entries_logged) {
+                final_entries_logged = true;
+                Log(fmt::format("final: our (host) final entries are sent at step {}: {}", phase,
+                                list));
+            }
+            // v3.9.6 Bloodbound: the same entries again as kind 3 with the TEAM rank (+0x20), the
+            // order the guests' BbAlign takes for pairs still alive (bbfinal_notes.md 4).
+            if (Get<u8>(main + RULE_BYTE) == RULE_BLOODBOUND) {
+                head.kind = FINAL_KIND_TEAMS;
+                std::memcpy(out.data(), &head, sizeof(head));
+                std::string teams;
+                for (u64 i = 0; i < count; ++i) {
+                    const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+                    const FinalRecord record{Get<u32>(entry), Get<u32>(entry + PE_TEAM_RANK),
+                                             Get<u32>(entry + PE_STATE), 0};
+                    std::memcpy(out.data() + sizeof(head) + i * sizeof(record), &record,
+                                sizeof(record));
+                    teams += fmt::format("{}player {} team rank {}", teams.empty() ? "" : ", ",
+                                         record.no, record.rank);
+                }
+                Network::LanSide::Send(std::span<const u8>(out.data(), out.size()));
+                if (!final_teams_logged) {
+                    final_teams_logged = true;
+                    Log(fmt::format("final: our (host) team ranks are sent at step {}: {}", phase,
+                                    teams));
+                }
+            }
+        }
+    }
+    FinalAlign(stage, players, now);
+}
+
+/// (c) In the result steps (8..14: our EndPhase has applied the entries; and 29..36, where the
+/// Outcome's copy par[0x4708] exists) and only when somebody was out of this final for good (a
+/// final the clock ended with nobody out is left to the points): one placement on every game.
+/// Our final's EndPhase ranked every finalist it listed on points (our own player is listed now,
+/// nothing is written into a pgd before it), so only these are changed, each write logged:
+/// - entry +0x10 rank, result row +0x20 rank (R+4 == 0 only, as 0x1145CA0), par[0x4708] row +0x20;
+/// - entry +0x40 / row +0x10 state, only its class: rank 1 with a beaten word (flag byte 1) gets
+///   04 02 00 01, a lower rank with a winner's word gets 04 03 01 01 (the v3.2 values, handoff 1:892
+///   and the kill test); a row that never got a stage-4 word (no entry: our game's own death list
+///   put that player at stage 4 before EndPhase, which then skipped it) gets the entry's word, else
+///   the out word of that player (04 05 01 01).
+/// Rank 1..k = the finalists not out, in the host's order (a guest, when the host's fresh entries
+/// rank every one of them) or else ours; then the out ones, the last out first (phase clock left
+/// at its death, review3 F7; else the time we learned it). Same inputs on every game -> same ranks.
+void Assist::State::FinalAlign(u64 stage, u64 players, Clock::time_point now) {
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const bool result_steps = phase >= 8 && phase <= 14;
+    const bool outcome_steps = phase >= 29 && phase <= 36;
+    if (!result_steps && !outcome_steps) {
+        return;
+    }
+    if (!final_result_since) {
+        final_result_since = now;
+    }
+    const auto decide = [&](const std::string& why) {
+        if (why != final_align_why) {
+            final_align_why = why;
+            Log(fmt::format("final placement (step {}): {}", phase, why));
+        }
+    };
+    // v3.9.6 Bloodbound (rule byte 2): pairs, not players (bbfinal_notes.md 4). BbAlign also takes
+    // "nobody out" (then only the host's fresh team ranks are applied). The per-player placement
+    // below must not run under rule 2 (it would rank the two members of one pair apart).
+    if (Get<u8>(main + RULE_BYTE) == RULE_BLOODBOUND) {
+        BbAlign(stage, now);
+        return;
+    }
+    if (final_out.empty()) {
+        decide("nobody was out of this final for good: points decide, our game's result is left "
+               "alone");
+        return;
+    }
+    const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+    if (count > P_ENTRY_MAX) {
+        decide(fmt::format("no usable phase entries ({}); nothing aligned", count));
+        return;
+    }
+    std::map<u32, FinalEntry> own; // our finalists' entries (a player our EndPhase skipped has none)
+    for (u64 i = 0; i < count; ++i) {
+        const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+        const u32 no = Get<u32>(entry);
+        if (final_finalists.contains(no)) {
+            own[no] = FinalEntry{no, Get<u32>(entry + PE_RANK), Get<u32>(entry + PE_STATE)};
+        }
+    }
+    std::vector<u32> alive;
+    std::vector<u32> gone;
+    for (const u32 no : final_finalists) {
+        (final_out.contains(no) ? gone : alive).push_back(no);
+    }
+    if (final_finalists.size() < 2) {
+        decide(fmt::format("{} finalist(s) known here; nothing aligned", final_finalists.size()));
+        return;
+    }
+    if (alive.empty()) {
+        decide("every finalist is out (review3 F10): no winner can be named, our game's result is "
+               "left alone");
+        return;
+    }
+    const bool host = Get<u32>(main + GENERATOR_IDLE) == 0;
+    const bool host_fresh = !host && !final_host.empty() && now - final_host_at < 10s;
+    const auto host_rank = [&](u32 no) -> u32 {
+        for (const auto& one : final_host) {
+            if (one.no == no && one.rank >= 1 && one.rank <= P_ENTRY_MAX) {
+                return one.rank;
+            }
+        }
+        return 0;
+    };
+    const auto own_rank = [&](u32 no) -> u32 {
+        const auto found = own.find(no);
+        return found != own.end() && found->second.rank >= 1 && found->second.rank <= P_ENTRY_MAX
+                   ? found->second.rank
+                   : 0xFF;
+    };
+    // Several alive (a clock end with somebody out): their order is the points order, the same on
+    // every game in principle; a guest takes the host's to be sure (waits up to 3 s for it).
+    const bool by_host =
+        host_fresh && alive.size() > 1 &&
+        std::all_of(alive.begin(), alive.end(), [&](u32 no) { return host_rank(no) != 0; });
+    if (!host && alive.size() > 1 && !by_host && result_steps &&
+        now - *final_result_since < 3s) {
+        decide("waiting up to 3 s for the host's final entries");
+        return;
+    }
+    std::sort(alive.begin(), alive.end(), [&](u32 a, u32 b) {
+        const u32 ka = by_host ? host_rank(a) : own_rank(a);
+        const u32 kb = by_host ? host_rank(b) : own_rank(b);
+        return ka != kb ? ka < kb : a < b;
+    });
+    // The out ones, the last out first: least phase clock left at the death (sent by its own game,
+    // or seen here in UpdatePhase), else the latest learned here.
+    // N6: by the clock for every one as soon as any has it (not only when all have it). One with
+    // no clock (0: learned only in the result steps, i.e. at the very end of the final) counts as
+    // 0 s left = the last out; among those the latest learned first. A strict order on every game.
+    const bool by_clock = std::any_of(gone.begin(), gone.end(),
+                                      [&](u32 no) { return final_out.at(no).left_ms != 0; });
+    const bool clock_mixed =
+        by_clock && !std::all_of(gone.begin(), gone.end(),
+                                 [&](u32 no) { return final_out.at(no).left_ms != 0; });
+    // walk8 W1 (3+ finalists): when the phase clock does not separate two out ones (both without a
+    // clock, or the same ms), "when we learned it" differs per game, so the games could place them
+    // differently. A guest with the host's fresh ranks for both takes the host's order there.
+    const bool host_gone = host_fresh && std::all_of(gone.begin(), gone.end(),
+                                                     [&](u32 no) { return host_rank(no) != 0; });
+    // v406 F1: without the host's (stale after 10 s, e.g. in the Outcome steps) our own entry ranks,
+    // which a guest has already set to the host's order and the host to its own: the order holds.
+    const bool own_gone = std::all_of(gone.begin(), gone.end(),
+                                      [&](u32 no) { return own_rank(no) != 0xFF; });
+    std::sort(gone.begin(), gone.end(), [&](u32 a, u32 b) {
+        const FinalOutInfo& ia = final_out.at(a);
+        const FinalOutInfo& ib = final_out.at(b);
+        if (by_clock && ia.left_ms != ib.left_ms) {
+            return ia.left_ms < ib.left_ms;
+        }
+        if (host_gone && host_rank(a) != host_rank(b)) {
+            return host_rank(a) < host_rank(b);
+        }
+        if (!host_gone && own_gone && own_rank(a) != own_rank(b)) {
+            return own_rank(a) < own_rank(b);
+        }
+        if (ia.at != ib.at) {
+            return ia.at > ib.at;
+        }
+        return a < b;
+    });
+    std::vector<std::pair<u32, u32>> want; // player no, rank
+    for (const u32 no : alive) {
+        want.emplace_back(no, static_cast<u32>(want.size() + 1));
+    }
+    for (const u32 no : gone) {
+        want.emplace_back(no, static_cast<u32>(want.size() + 1));
+    }
+    std::string list;
+    for (const auto& [no, rank] : want) {
+        list += fmt::format("{}player {} rank {}{}", list.empty() ? "" : ", ", no, rank,
+                            final_out.contains(no)
+                                ? fmt::format(" (out, {:.1f} s left)",
+                                              final_out.at(no).left_ms / 1000.0)
+                                : "");
+    }
+    decide(fmt::format("placement ({} alive in {} order, out ones {}): {}", alive.size(),
+                       by_host ? "the host's" : "our own entries'",
+                       by_clock ? (clock_mixed ? "by the phase clock at their death, one without a "
+                                                 "clock as the last out (N6)"
+                                               : "by the phase clock at their death")
+                                : "by when we learned it",
+                       list));
+
+    // The state word's class follows the rank: 1 = a winner's word (flag byte 0), below = beaten
+    // (flag byte 1). Other stage-4 words stay as the game made them (04 04 00 01, 04 05 01 01).
+    const auto class_fixed = [](u32 rank, u32 word) -> u32 {
+        if ((word & 0xFF) != 4) {
+            return word;
+        }
+        const bool beaten = ((word >> 16) & 0xFF) != 0;
+        if (rank == 1 && beaten) {
+            return STAGE_WON;
+        }
+        if (rank != 1 && !beaten) {
+            return STAGE_LOST;
+        }
+        return word;
+    };
+    const bool team = Get<u8>(stage + P_RESULT_TEAM) != 0; // 0x1145CA0: rank into rows only if 0
+    const auto rows = [&](u64 base, u64 rows_count, const char* where, u32 no, u32 rank,
+                          std::optional<u32> entry_word) {
+        for (u64 k = 0; k < rows_count && rows_count <= ROW_MAX; ++k) {
+            const u64 row = base + k * ROW_SIZE;
+            if (Get<u32>(row) != no) {
+                continue;
+            }
+            if (!team) {
+                FinalPut(row + ROW_RANK, rank,
+                         fmt::format("player {}'s {} row rank (+0x20)", no, where));
+                FinalPut(row + ROW_ENTRY_RANK, rank,
+                         fmt::format("player {}'s {} row entry rank (+0x30)", no, where));
+            }
+            // The Outcome's cup / number (fix 3): the game set it once at EndPhase from the
+            // points result and never again, so it must follow our rank here.
+            FinalPut(row + ROW_PLACE, rank,
+                     fmt::format("player {}'s {} row place (+0x50, shown on the Outcome)", no,
+                                 where));
+            const u32 have = Get<u32>(row + ROW_STATE);
+            u32 word = have;
+            if ((have & 0xFF) == 4) {
+                word = class_fixed(rank, have);
+            } else if (entry_word && (*entry_word & 0xFF) == 4) {
+                word = *entry_word; // as 0x1145CA0 would have written it
+            } else if (const auto found = final_out.find(no); found != final_out.end()) {
+                word = found->second.stage; // never updated: our EndPhase skipped it (stage 4)
+            }
+            FinalPut(row + ROW_STATE, word,
+                     fmt::format("player {}'s {} row state (+0x10, {} -> {})", no, where,
+                                 StageBytes(have), StageBytes(word)));
+        }
+    };
+    for (const auto& [no, rank] : want) {
+        std::optional<u32> entry_word;
+        for (u64 i = 0; i < count; ++i) {
+            const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+            if (Get<u32>(entry) != no) {
+                continue;
+            }
+            FinalPut(entry + PE_RANK, rank, fmt::format("player {}'s entry rank (+0x10)", no));
+            const u32 have = Get<u32>(entry + PE_STATE);
+            const u32 word = class_fixed(rank, have);
+            FinalPut(entry + PE_STATE, word,
+                     fmt::format("player {}'s entry state (+0x40, {} -> {})", no,
+                                 StageBytes(have), StageBytes(word)));
+            entry_word = word;
+        }
+        rows(stage + P_ROWS, Get<u64>(stage + P_ROW_COUNT), "result", no, rank, entry_word);
+        if constexpr (FINAL_ALIGN_RESULT_COPY) {
+            if (const u64 copy = Get<u64>(stage + P_MATCH_RESULT); copy != 0) {
+                rows(copy + MR_ROWS, Get<u64>(copy + MR_ROW_COUNT), "match-result copy", no, rank,
+                     entry_word);
+            }
+        }
+    }
+    (void)players;
+}
+
+/// v3.9.6 (bbfinal_notes.md 4, players8_notes.md F3): the Bloodbound final placed by PAIRS, the same
+/// on every game. FinalAlign's window (result steps 8..14, Outcome steps 29..36), every 50 ms on the
+/// DuskLan thread; every write through FinalPut (no write when the value is already right).
+/// - Units = the finalists with their partner (PartnerOf: the alliance entries BB_PAIRS made the
+///   same on every game); a unit is alive while one member is not in final_out.
+/// - Alive units first: by team rank, the host's (kind 3, fresh, every alive unit ranked) or ours
+///   (entry +0x20); then the out units, the last out first (the least phase clock left at the death
+///   of their LAST member; 0 = learned only at the end = the last out).
+/// - Per member: entry +0x20 = unit rank, entry / row state = winner class for BOTH members of
+///   rank 1 (kept when the game gave one, else 04 02 00 01, 04 04 01 01 for an out member), loser
+///   class below (kept, else 04 05 01 01 out / 04 03 01 01), row +0x50 = unit rank; row +0x20 / +0x30
+///   stay unwritten (team mode). Team records of R and of par[0x4708]: +0x10 / +0x20 = unit rank,
+///   +0x30 = the word of an alive member, else of the last-out one.
+/// Nobody out (a clock end): only a guest with the host's fresh team ranks for every unit writes;
+/// otherwise the game's team points stand. Fewer than two units: nothing (logged once).
+void Assist::State::BbAlign(u64 stage, Clock::time_point now) {
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const bool result_steps = phase >= 8 && phase <= 14;
+    const auto decide = [&](const std::string& why) {
+        if (why != final_align_why) {
+            final_align_why = why;
+            Log(fmt::format("final placement (step {}): Bloodbound: {}", phase, why));
+        }
+    };
+    struct Unit {
+        std::vector<u32> nos;
+        bool alive = false;
+        u32 left_ms = ~0U;
+        Clock::time_point at{};
+        u32 rank = 0;
+    };
+    std::vector<Unit> units;
+    std::set<u32> listed;
+    for (const u32 no : final_finalists) { // sorted: the same order on every game
+        if (!listed.insert(no).second) {
+            continue;
+        }
+        Unit unit;
+        unit.nos.push_back(no);
+        const u32 mate = PartnerOf(no);
+        if (mate != 0 && mate != no && final_finalists.contains(mate) &&
+            listed.insert(mate).second) {
+            unit.nos.push_back(mate);
+        }
+        for (const u32 member : unit.nos) {
+            const auto found = final_out.find(member);
+            if (found == final_out.end()) {
+                unit.alive = true;
+                continue;
+            }
+            unit.left_ms = std::min(unit.left_ms, found->second.left_ms);
+            unit.at = std::max(unit.at, found->second.at);
+        }
+        units.push_back(std::move(unit));
+    }
+    const auto unit_name = [](const Unit& unit) {
+        std::string text;
+        for (const u32 member : unit.nos) {
+            text += fmt::format("{}{}", text.empty() ? "" : " + ", member);
+        }
+        return text;
+    };
+    if (units.size() < 2) {
+        decide(fmt::format("{} pair(s) in this final; nothing aligned", units.size()));
+        return;
+    }
+    std::vector<size_t> alive;
+    std::vector<size_t> gone;
+    for (size_t i = 0; i < units.size(); ++i) {
+        (units[i].alive ? alive : gone).push_back(i);
+    }
+    if (alive.empty()) {
+        decide("every pair is out (review3 F10): no winner can be named, our game's result is left "
+               "alone");
+        return;
+    }
+    const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+    if (count > P_ENTRY_MAX) {
+        decide(fmt::format("no usable phase entries ({}); nothing aligned", count));
+        return;
+    }
+    const auto own_team = [&](u32 no) -> u32 {
+        for (u64 i = 0; i < count; ++i) {
+            const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+            if (Get<u32>(entry) == no) {
+                const u32 team = Get<u32>(entry + PE_TEAM_RANK);
+                return team >= 1 && team <= TEAM_MAX ? team : 0xFF;
+            }
+        }
+        return 0xFF;
+    };
+    const bool host = Get<u32>(main + GENERATOR_IDLE) == 0;
+    const bool host_fresh = !host && !final_host_team.empty() && now - final_host_team_at < 10s;
+    const auto host_team = [&](u32 no) -> u32 {
+        const auto found = final_host_team.find(no);
+        return host_fresh && found != final_host_team.end() && found->second >= 1 &&
+                       found->second <= TEAM_MAX
+                   ? found->second
+                   : 0xFF;
+    };
+    const auto unit_key = [&](const Unit& unit, bool from_host) {
+        u32 best = 0xFF;
+        for (const u32 member : unit.nos) {
+            best = std::min(best, from_host ? host_team(member) : own_team(member));
+        }
+        return best;
+    };
+    const bool by_host = host_fresh && std::all_of(alive.begin(), alive.end(), [&](size_t i) {
+                             return unit_key(units[i], true) != 0xFF;
+                         });
+    if (!host && !by_host && (alive.size() > 1 || gone.empty()) && result_steps &&
+        final_result_since && now - *final_result_since < 3s) {
+        decide("waiting up to 3 s for the host's team ranks");
+        return;
+    }
+    if (gone.empty() && (!by_host || alive.size() < 2)) {
+        decide("nobody was out of this final for good: team points decide, our game's result is "
+               "left alone");
+        return;
+    }
+    std::sort(alive.begin(), alive.end(), [&](size_t a, size_t b) {
+        const u32 ka = unit_key(units[a], by_host);
+        const u32 kb = unit_key(units[b], by_host);
+        return ka != kb ? ka < kb : units[a].nos[0] < units[b].nos[0];
+    });
+    // walk8 W1 (3+ pairs): a clock tie between two out pairs is broken by the host's team ranks,
+    // not by when this game learned it (that differs per game). v406 F2: all-or-none (a strict
+    // weak order for std::sort); F1: else our own team ranks (a guest already holds the host's).
+    const bool host_gone = host_fresh && std::all_of(gone.begin(), gone.end(), [&](size_t i) {
+                               return unit_key(units[i], true) != 0xFF;
+                           });
+    const bool own_gone = std::all_of(gone.begin(), gone.end(), [&](size_t i) {
+        return unit_key(units[i], false) != 0xFF;
+    });
+    std::sort(gone.begin(), gone.end(), [&](size_t a, size_t b) {
+        if (units[a].left_ms != units[b].left_ms) {
+            return units[a].left_ms < units[b].left_ms;
+        }
+        if (host_gone || own_gone) {
+            const u32 ka = unit_key(units[a], host_gone);
+            const u32 kb = unit_key(units[b], host_gone);
+            if (ka != kb) {
+                return ka < kb;
+            }
+        }
+        if (units[a].at != units[b].at) {
+            return units[a].at > units[b].at;
+        }
+        return units[a].nos[0] < units[b].nos[0];
+    });
+    u32 place = 1;
+    std::string list;
+    for (const size_t i : alive) {
+        units[i].rank = place++;
+        list += fmt::format("{}pair ({}) rank {} alive", list.empty() ? "" : ", ",
+                            unit_name(units[i]), units[i].rank);
+    }
+    for (const size_t i : gone) {
+        units[i].rank = place++;
+        list += fmt::format("{}pair ({}) rank {} out ({:.1f} s left)", list.empty() ? "" : ", ",
+                            unit_name(units[i]), units[i].rank,
+                            units[i].left_ms == ~0U ? 0.0 : units[i].left_ms / 1000.0);
+    }
+    decide(fmt::format("pair placement ({} alive in {} team order, out pairs by their last "
+                       "member's death): {}",
+                       alive.size(), by_host ? "the host's" : "our own", list));
+
+    // The word's class follows the unit rank (kept when the game already gave that class).
+    const auto word_for = [&](u32 no, u32 rank, u32 have) -> u32 {
+        const bool out = final_out.contains(no);
+        const u32 reason = (have >> 8) & 0xFF;
+        const bool stage4 = (have & 0xFF) == 4;
+        if (rank == 1) {
+            return stage4 && (reason == 2 || reason == 4 || reason == 6)
+                       ? have
+                       : (out ? STAGE_ALLY_WON : STAGE_WON);
+        }
+        return stage4 && (reason == 3 || reason == 5 || reason == 7) ? have
+                                                                     : (out ? STAGE_OUT : STAGE_LOST);
+    };
+    const auto put_rows = [&](u64 base, u64 rows_count, const char* where, u32 no, u32 rank) {
+        for (u64 k = 0; k < rows_count && rows_count <= ROW_MAX; ++k) {
+            const u64 row = base + k * ROW_SIZE;
+            if (Get<u32>(row) != no) {
+                continue;
+            }
+            FinalPut(row + ROW_PLACE, rank,
+                     fmt::format("player {}'s {} row place (+0x50, pair rank)", no, where));
+            const u32 have = Get<u32>(row + ROW_STATE);
+            const u32 word = word_for(no, rank, have);
+            FinalPut(row + ROW_STATE, word,
+                     fmt::format("player {}'s {} row state (+0x10, {} -> {})", no, where,
+                                 StageBytes(have), StageBytes(word)));
+        }
+    };
+    const auto put_teams = [&](u64 result, const char* where) {
+        if (result == 0) {
+            return;
+        }
+        const u64 rows_count = Get<u64>(result + MR_ROW_COUNT);
+        const u64 teams = Get<u64>(result + R_TEAM_COUNT);
+        if (rows_count > ROW_MAX || teams > TEAM_MAX) {
+            return;
+        }
+        for (const Unit& unit : units) {
+            u32 slot = ~0U;
+            u32 team_word = 0;
+            for (const u32 member : unit.nos) {
+                for (u64 k = 0; k < rows_count; ++k) {
+                    const u64 row = result + MR_ROWS + k * ROW_SIZE;
+                    if (Get<u32>(row) != member) {
+                        continue;
+                    }
+                    slot = Get<u32>(row + ROW_TEAM);
+                    const u32 word = word_for(member, unit.rank, Get<u32>(row + ROW_STATE));
+                    if (team_word == 0 || !final_out.contains(member)) {
+                        team_word = word; // an alive member's word, else the last one's
+                    }
+                }
+            }
+            if (slot == ~0U) {
+                continue;
+            }
+            for (u64 t = 0; t < teams; ++t) {
+                const u64 rec = result + R_TEAMS + t * TEAM_SIZE;
+                if (Get<u32>(rec) != slot) {
+                    continue;
+                }
+                FinalPut(rec + TEAM_RANK, unit.rank,
+                         fmt::format("pair ({}) {} team record {} rank (+0x20)", unit_name(unit),
+                                     where, slot));
+                FinalPut(rec + TEAM_DONE_RANK, unit.rank,
+                         fmt::format("pair ({}) {} team record {} rank (+0x10)", unit_name(unit),
+                                     where, slot));
+                if (team_word != 0) {
+                    FinalPut(rec + TEAM_STATE, team_word,
+                             fmt::format("pair ({}) {} team record {} state (+0x30, {})",
+                                         unit_name(unit), where, slot, StageBytes(team_word)));
+                }
+            }
+        }
+    };
+    for (const Unit& unit : units) {
+        for (const u32 no : unit.nos) {
+            for (u64 i = 0; i < count; ++i) {
+                const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+                if (Get<u32>(entry) != no) {
+                    continue;
+                }
+                FinalPut(entry + PE_TEAM_RANK, unit.rank,
+                         fmt::format("player {}'s entry team rank (+0x20)", no));
+                const u32 have = Get<u32>(entry + PE_STATE);
+                const u32 word = word_for(no, unit.rank, have);
+                FinalPut(entry + PE_STATE, word,
+                         fmt::format("player {}'s entry state (+0x40, {} -> {})", no,
+                                     StageBytes(have), StageBytes(word)));
+            }
+            put_rows(stage + P_ROWS, Get<u64>(stage + P_ROW_COUNT), "result", no, unit.rank);
+            if constexpr (FINAL_ALIGN_RESULT_COPY) {
+                if (const u64 copy = Get<u64>(stage + P_MATCH_RESULT); copy != 0) {
+                    put_rows(copy + MR_ROWS, Get<u64>(copy + MR_ROW_COUNT), "match-result copy", no,
+                             unit.rank);
+                }
+            }
+        }
+    }
+    put_teams(stage + P_RESULT, "result");
+    if constexpr (FINAL_ALIGN_RESULT_COPY) {
+        put_teams(Get<u64>(stage + P_MATCH_RESULT), "match-result copy");
+    }
+}
+
+void Assist::State::FinalStartPoints() {
+    if (main == 0 || session.manager == 0 || session.state != 8) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0 || Get<u64>(stage + 0x3388) == 0) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    if (phase == PHASE_INTERMISSION) {
+        final_started.reset();
+        final_placed = false;
+        const u64 mediator = Get<u64>(main + MEDIATOR);
+        if (mediator == 0 || Get<u8>(mediator + MED_DECIDED) == 0) {
+            return;
+        }
+        const u64 count = Get<u32>(mediator + MED_LIST_COUNT);
+        for (u64 i = 0; i < count && count <= MED_LIST_MAX; ++i) {
+            std::array<f32, 3> at{};
+            if (!Read(mediator + MED_LIST + i * MED_LIST_ENTRY + ENTRY_POSITION, at.data(),
+                      sizeof(at))) {
+                return;
+            }
+            if (std::none_of(final_points.begin(), final_points.end(),
+                             [&at](const auto& other) { return other == at; })) {
+                final_points.push_back(at);
+            }
+        }
+        return;
+    }
+    if (phase != PHASE_UPDATE || final_placed) {
+        return;
+    }
+    const auto now = Clock::now();
+    if (!final_started) {
+        final_started = now;
+    }
+    // From 1.5 s (the others' positions have arrived) to 8 s into the final.
+    if (now - *final_started < 1500ms) {
+        return;
+    }
+    if (now - *final_started > 8s) {
+        final_placed = true;
+        return;
+    }
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+    if (entries == 0) {
+        return;
+    }
+    struct Player {
+        u32 no;
+        std::array<f32, 3> at;
+        u64 physics;
+    };
+    std::vector<Player> players;
+    for (size_t entry = 0; entry < MAX_ENTRIES; ++entry) {
+        const u64 base = entries + entry * 0x38;
+        const u64 chr = Get<u64>(base);
+        const u64 physics = chr != 0 && PlayerEntry(chr, entry) ? Get<u64>(base + 0x28) : 0;
+        const u64 chr_data = chr != 0 ? Get<u64>(chr + 0x20) : 0;
+        const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+        Player one{};
+        if (physics == 0 || player_data == 0 ||
+            !Read(physics + 0x70, one.at.data(), sizeof(one.at))) {
+            if (entry == 0) {
+                return;
+            }
+            continue;
+        }
+        one.no = Get<u32>(player_data + 0xD0);
+        one.physics = physics;
+        players.push_back(one);
+    }
+    if (players.size() < 2 || players[0].no == 0) {
+        return;
+    }
+    const auto apart = [](const std::array<f32, 3>& p, const std::array<f32, 3>& q) {
+        return std::hypot(p[0] - q[0], p[2] - q[2]);
+    };
+    const Player& me = players[0];
+    const bool crowded = std::any_of(players.begin() + 1, players.end(), [&](const Player& other) {
+        // v4.33: a cut player's leftover copy is not a finalist on a start point
+        return other.no != 0 && other.no < me.no && !CutNo(other.no) &&
+               apart(other.at, me.at) < 0.4f;
+    });
+    if (!crowded) {
+        return;
+    }
+    // A known point with nobody within 1.5 m of it.
+    for (const auto& point : final_points) {
+        const bool taken = std::any_of(players.begin(), players.end(), [&](const Player& other) {
+            return (other.no == 0 || !CutNo(other.no)) && apart(other.at, point) < 0.6f;
+        });
+        if (!taken) {
+            Write(me.physics + 0x70, point.data(), sizeof(point));
+            Log(fmt::format("final: our player (no {}) stood on a lower-numbered player's start "
+                            "point and stepped to a free one ({:.1f}, {:.1f}, {:.1f})",
+                            me.no, point[0], point[1], point[2]));
+            final_placed = true;
+            return;
+        }
+    }
+    if (!final_crowd_logged) {
+        final_crowd_logged = true;
+        Log(fmt::format("final: our player (no {}) shares a start point with a lower-numbered "
+                        "player and no free point is known here ({} known)",
+                        me.no, final_points.size()));
+    }
+}
+
+/// v4.26 FINAL_SLOTS, host only: the final's start list (0x11679C0, every Intermission frame while
+/// M+0xB9 == 0) gives one point per pick slot M+0xC0. Online the server's roster filled those slots;
+/// on LAN only 0x45 picks do, and the final has no area menu, so the host's slots hold only its own
+/// player and the list has one entry ("1 entries: player 1 area 4"). The guests then copy that
+/// entry (StartPoint) and every finalist starts on the same point. Once the host's game decided
+/// its list, add a slot for every other player character in the world (a copy of our own slot
+/// with that player's number and no pick) and clear M+0xB9: the game builds the list again on the
+/// next frame, one shuffled point per slot, applies it and sends it (0x51; the guests read it with
+/// START_AREA_LIST and replace their copies by player number). Once per final; only while the
+/// start-point coordinator still holds Intermission (it is released 5 s after the decision).
+/// v4.40 ICONS1, alpha RECONSTRUCTION (alpha_reconstructions.md a): the network test showed area icons
+/// in Phase I; our regulation's Phase I rows name no trend list (PhaseInfoParam +0xE4 = -1) and there
+/// is no list for it (icons2_notes 6). On the host of a LAN match the cave makes the pick use the
+/// closest existing list, Phase II's 100002; the guests take the host's list (v4.27 AREA_ICONS).
+void Assist::State::IconPhaseOne(u64 stage) {
+    if (main == 0 || Get<u32>(main + I1_SITE) != I1_HOOK) {
+        return;
+    }
+    // v2: armed from the join (state 3) on. Round 1's pick runs in PrepareFirst while the session
+    // is still in state 7 (alpha match 1: phase 21 at 23:14:00, state 8 only at 23:14:11), so a box
+    // armed in state 8 came too late for Phase I and its list stayed empty.
+    const u8 want = session.state >= 3 && session.state <= 8 &&
+                            Get<u32>(main + GENERATOR_IDLE) == 0
+                        ? 1
+                        : 0;
+    if (Get<u8>(main + I1_BOX) != want) {
+        Put<u8>(main + I1_BOX, want);
+    }
+    if (want != 0 && icons1_logged_gen != match_gen) {
+        icons1_logged_gen = match_gen;
+        Log(fmt::format("area icons: RECONSTRUCTED (alpha): Phase I's param row names no trend list, "
+                        "so this host's pick uses the closest existing one, list 100002 (Phase II's "
+                        "weights 20:0, 40:1, 40:2) (v4.40 ICONS1, round {})",
+                        Get<u32>(stage + P_ROUND)));
+    }
+    if (const u32 uses = Get<u32>(main + I1_BOX + 4); uses != icons1_uses_seen) {
+        icons1_uses_seen = uses;
+        Log(fmt::format("area icons: RECONSTRUCTED Phase I list drawn from 100002 (use #{}, round {}; "
+                        "v4.40 ICONS1)",
+                        uses, Get<u32>(stage + P_ROUND)));
+    }
+}
