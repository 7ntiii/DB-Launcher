+/// {address, hex, code?}: writes the bytes into the application's guest memory, through the same
+/// host pointers the reads use. code = true also drops the JIT's translations of the range, for
+/// patching instructions. Fails, writing nothing, when a page of the range is unmapped.
+json WriteMemory(ToolState& state, const json& params) {
+    const u64 address = AddressParam(params, "address");
+    const std::vector<u8> bytes = ParseHexBytes(params.at("hex").get<std::string>());
+    if (bytes.empty() || bytes.size() > 0x1000) {
+        throw std::runtime_error{"hex: want 1 to 4096 bytes"};
+    }
+    if (address + bytes.size() < address) {
+        throw std::runtime_error{"address + size wraps around"};
+    }
+    Kernel::KProcess& process = Application(state);
+    Memory::Memory& memory = process.GetMemory();
+    for (u64 page = address & ~u64{0xFFF}; page < address + bytes.size(); page += 0x1000) {
+        if (GuestByte(memory, page) == nullptr) {
+            throw std::runtime_error{fmt::format("guest address {:#x} is not mapped (writing {} "
+                                                 "bytes at {:#x})",
+                                                 (std::max)(page, address), bytes.size(), address)};
+        }
+    }
+    for (size_t done = 0; done < bytes.size();) {
+        const u64 at = address + done;
+        const size_t chunk = (std::min)(bytes.size() - done, size_t{0x1000 - (at & 0xFFF)});
+        std::memcpy(memory.GetPointerSilent(at), bytes.data() + done, chunk);
+        done += chunk;
+    }
+    const bool code = params.value("code", false);
+    if (code) {
+        Core::InvalidateInstructionCacheRange(&process, address, bytes.size());
+    }
+    return {{"address", HexAddress(address)}, {"size", bytes.size()}, {"code", code}};
+}
