+
+/// One side-channel message, sent once a second while in a LAN session.
+struct SideMessage {
+    u8 type = 1;
+    u8 player_no = 0;
+    u8 phase = 0;
+    u8 steps = 0;         ///< how often the sender stepped its guest clock (wraps)
+    f32 clock_left = 0;
+    u64 sent_us = 0;      ///< sender's steady clock
+    u64 echo_us = 0;      ///< sent_us of the last message received from the peer (0 = none)
+    u32 echo_hold_us = 0; ///< how long that message waited here before this reply
+    u32 instance = 0;     ///< the sender's run id (a game whose server link is itself hears itself)
+};
+static_assert(sizeof(SideMessage) == 32);
+
+/// Side-channel message type 3: the environment event the sender drew for a round.
+struct EnvMessage {
+    u8 type = 3;
+    u8 player_no = 0;
+    u16 reserved = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    s32 id = -1;
+};
+static_assert(sizeof(EnvMessage) == 16);
+
+/// Side-channel message type 7: one MapSystem list of the host's round (or a part of a long one),
+/// followed by `size` bytes of 16-byte list elements.
+struct MapMessage {
+    u8 type = 7;
+    u8 player_no = 0;
+    u16 index = 0;   ///< number of this record in the round's set
+    u32 instance = 0;
+    u32 round = 0;
+    u16 total = 0;   ///< records in the set
+    u16 kind = 0;    ///< list kind 0..29, | 0x100 = append to the list, 0xFF = the set is complete
+    u32 size = 0;
+};
+static_assert(sizeof(MapMessage) == 20);
+
+/// Side-channel message type 17 (v4.23 MAP_TREND): the host's MapSystem group-arrangement table
+/// (MS+0x448, 0x70-byte entries; the simulation body that only the host runs fills s16 +4 / +6
+/// per group id each round; the area icons beside the area names read it, icons_notes.md).
+/// Followed by `count` pairs {u32 group id, u32 (s16 +4 | s16 +6 << 16)}: entries first ..
+/// first + count - 1 of `total`. Older builds ignore the type (not 1..16; a SideMessage needs
+/// type 1). Side packets arrive through the game's own receive buffer, so a part stays as small
+/// as a map record (16 + 8 * 56 = 464 bytes <= 20 + MAP_INBOX_DATA).
+struct TrendMessage {
+    u8 type = 17;
+    u8 player_no = 0;
+    u16 count = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    u16 first = 0;
+    u16 total = 0;
+};
+static_assert(sizeof(TrendMessage) == 16);
+constexpr u64 MAP_TREND_TABLE = 0x448;   ///< MapSystem: begin / end of the group-arrangement table
+constexpr u64 MAP_TREND_STRIDE = 0x70;
+constexpr size_t MAP_TREND_MAX = 256;    ///< entries in the table
+constexpr size_t MAP_TREND_PART = 56;    ///< entries per packet
+static_assert(16 + 8 * MAP_TREND_PART <= 20 + MAP_INBOX_DATA);
+
+/// Side-channel message type 22 (v4.27 AREA_ICONS): the host's MapSystem area-icon list MS+0x538,
+/// 8-byte entries {u32 area id, u32 icon kind 0..9}. The HUD's area-name icon lookup 0x1481160 reads
+/// it; only the host-only simulation body and the 0x6A reader section 0x1111260 fill it, so a guest's
+/// list stays empty and its map shows no area icons (icons4_notes.md). Followed by `count` entries
+/// (0 = the host's list is empty). A guest hands them to its game through ICON_BOX; the patched 0x6A
+/// reader copies them into the mod buffer LISTBUF and points the list there (v4.28: never the game's
+/// heap; a teardown guard keeps the game from freeing it, b_final_crash_notes.md).
+struct AreaIconMessage {
+    u8 type = 22;
+    u8 player_no = 0;
+    u16 count = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    u32 reserved = 0;
+};
+static_assert(sizeof(AreaIconMessage) == 16);
+
+/// Side-channel message type 28 (LEVELSHARE): the host's enemy strength-level map ([stage+0x3378]
+/// +0x38), followed by `count` entries {u16 key, s16 level} (count 0 = the host's map is empty).
+struct LevelMessage {
+    u8 type = LEVEL_TYPE;
+    u8 player_no = 0;
+    u16 count = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    u32 reserved = 0;
+};
+static_assert(sizeof(LevelMessage) == 16);
+static_assert(16 + 4 * LEVEL_MAX <= 20 + MAP_INBOX_DATA);
+
+/// PARTSYNC side-channel type 29: the sender's Trespasser battles in step 2..3, `count` entries.
+struct PartMessage {
+    u8 type = PART_TYPE;
+    u8 player_no = 0;
+    u8 count = 0;
+    u8 reserved = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    u32 reserved2 = 0;
+};
+static_assert(sizeof(PartMessage) == 16);
+/// One battle: its id (ins+0xC0), step, whether the SENDER's own player is in its own list (and that
+/// entry's +0xD), the sender's whole list (for the logs and the max check) and its boss max HP.
+struct PartEntry {
+    u32 id = 0;
+    u8 step = 0;
+    u8 self_in = 0;
+    u8 self_b = 0;
+    u8 list_n = 0;
+    s32 boss_max = 0;
+    u8 list[PART_LIST_MAX] = {};
+};
+static_assert(sizeof(PartEntry) == 20);
+static_assert(16 + 20 * PART_BATTLES_MAX <= 20 + MAP_INBOX_DATA);
+constexpr u64 MAP_ICONS = 0x538;          ///< MapSystem: begin / end / capacity of the area-icon list
+constexpr size_t MAP_ICONS_MAX = 56;      ///< entries in one packet and in ICON_BOX (the cave checks it)
+constexpr u32 MAP_ICON_KIND_MAX = 9;      ///< 0x1481160 maps kinds 0..9; 0x1111504 drops others
+static_assert(16 + 8 * MAP_ICONS_MAX <= 20 + MAP_INBOX_DATA);
+
+/// Side-channel message type 8: the sender's own Virtue total (VIRTUE_BOX), a few times a second
+/// in a match. The others write it into their copy of the sender (banked, pgd+0x42C8).
+struct VirtueMessage {
+    u8 type = 8;
+    u8 player_no = 0;
+    u16 reserved = 0;
+    u32 instance = 0;
+    u32 round = 0;
+    s32 total = 0;
+    u32 count = 0;   ///< the box's change counter (how often the sender's game computed it)
+};
+static_assert(sizeof(VirtueMessage) == 20);
+
+/// Side-channel message type 9: for each player this game holds, what this game itself added to
+/// that player's Bloodfang and Collector counts (cumulative for the match). Followed by count
+/// CommendPart records. The others add these parts into their pgd of that player.
+struct CommendMessage {
+    u8 type = 9;
+    u8 player_no = 0;
+    u8 count = 0;
+    u8 reserved = 0;
+    u32 instance = 0;
+    u32 round = 0;
+};
+struct CommendPart {
+    u8 no = 0;
+    u8 pad[3]{};
+    u32 bloodfang = 0;
+    u32 collector = 0;
+};
+static_assert(sizeof(CommendMessage) == 12 && sizeof(CommendPart) == 12);
+constexpr size_t COMMEND_MAX_PARTS = 13; ///< local pgd + 12 copies
+
+/// Side-channel message type 10: the final's placement. Kind FINAL_KIND_OUT: one record, the
+/// sender's own player is out of the final for good (rank 0, stage = the word its game holds,
+/// order = its elimination number); resent while the final lasts. Kind FINAL_KIND_ENTRIES (host
+/// only, in the result steps): count records, the host's phase entries (no, rank, state word).
+struct FinalMessage {
+    u8 type = 10;
+    u8 player_no = 0;
+    u8 kind = 0;
+    u8 count = 0;
+    u32 instance = 0;
+    u32 round = 0;
+};
+struct FinalRecord {
+    u32 no = 0;
+    u32 rank = 0;
+    u32 stage = 0;
+    u32 order = 0;
+};
+static_assert(sizeof(FinalMessage) == 12 && sizeof(FinalRecord) == 16);
+constexpr u8 FINAL_KIND_OUT = 1;
+constexpr u8 FINAL_KIND_ENTRIES = 2;
+/// v3.9.6 (Bloodbound only, host, with kind 2): the same records with rank = the entry's TEAM rank
+/// (+0x20). Builds before v3.9.6 drop this kind (FinalHeard takes only kinds 1 and 2).
+constexpr u8 FINAL_KIND_TEAMS = 3;
+/// v406: the host sends kinds 2 / 3 every 250 ms in the result steps; when the sender kept so far
+/// has been silent this long, a higher-numbered sender (the new host after a hand-over) is taken.
+constexpr auto FINAL_HOST_SILENT = std::chrono::seconds{3};
+
+/// Side-channel message type 11: the rule set the host (player 1) uses for the match, from its
+/// menu mask. Sent every second while in the session; taken at once by SideFast. Keyed by the
+/// sender's instance and (gen, seq): gen = the sender's session count, seq = its changes in it.
+struct RuleMessage {
+    u8 type = 11;
+    u8 player_no = 0;
+    u8 rule = 0;      ///< what every game writes: 0 Standard, 1 No Alliances, 2 Bloodbound
+    u8 asked = 0;     ///< what the host's menu asked for (logs only)
+    u32 instance = 0;
+    u32 gen = 0;
+    u16 seq = 0;
+    u8 mask = 0;      ///< the host's room+0xE4 (low byte; logs only)
+    u8 players = 0;   ///< rule 2: the host's N (= RulePlayers::count); else 0 (was `reserved`)
+};
+static_assert(sizeof(RuleMessage) == 16);
+/// Rule 2 only: follows RuleMessage (28 bytes in all). The host's ordered player numbers; every game
+/// pairs (nos[0], nos[1]), (nos[2], nos[3]), ... Rules 0 / 1 send the 16-byte RuleMessage alone,
+/// as before, and a 16-byte packet is still taken.
+struct RulePlayers {
+    u8 count = 0;
+    std::array<u8, BB_MAX_PLAYERS> nos{};
+    std::array<u8, 3> pad{};
+};
+static_assert(sizeof(RulePlayers) == 12);
+
+/// Side-channel message type 12: the taken state of one action-menu asset after it GAINED state
+/// on the sender's game (a player's bit, used up, a holder) or its holder was released. The whole
+/// state is sent (the receiver ORs / sets it), 3 times; seq orders one sender's changes.
+struct TakenMessage {
+    u8 type = 12;
+    u8 player_no = 0;
+    u8 used = 0;            ///< INFO_USED
+    u8 taker = 0;           ///< pay-once objects: the first taker the sender knows (player no), 0 = none
+    u32 instance = 0;
+    u32 round = 0;
+    u32 asset = 0;          ///< asset id (INFO_ASSET % 10000000)
+    u32 handle = 0;         ///< INS_HANDLE: which of the assets with that id
+    u32 players = 0;        ///< INFO_TAKEN as player numbers: bit n-1 = player n
+    s32 holder = -1;        ///< INFO_HOLDER
+    s32 holder_before = -1; ///< a release (holder -1): the holder it had on the sender, else -1
+    u32 seq = 0;            ///< the sender's change counter
+};
+static_assert(sizeof(TakenMessage) == 36);
+
+/// v3.9.4 F1: side-channel type 13, the sender's phase entries right after the cut step of a round
+/// (sent by the authority, role byte 0). Fixed 64 bytes: never 32, so the type-1 size test never
+/// takes it; builds before v3.9.4 drop it at `in.type != 1` (they ignore unknown types).
+struct CutListMessage {
+    u8 type = 13;
+    u8 player_no = 0;
+    u8 round = 0;
+    u8 count = 0;
+    u32 instance = 0;
+    u32 hash = 0;
+    u8 rule = 0;
+    std::array<u8, 3> reserved{};
+    std::array<std::array<u8, 4>, 12> entries{}; ///< {no, rank, team rank, reason byte}
+};
+static_assert(sizeof(CutListMessage) == 64);
+/// V400-1 (realnet_notes R1): side type 15, "your type-13 list of this round is here", sent by
+/// every game that takes one, to the list's sender (to = its instance). The authority resends its
+/// list every 500 ms until every listed player has answered or 10 s have passed. 16 bytes: older
+/// builds drop it (no type-15 handler; the type-1 test needs 32 bytes and type 1).
+struct CutAckMessage {
+    u8 type = 15;
+    u8 player_no = 0;
+    u8 round = 0;
+    u8 reserved = 0;
+    u32 instance = 0;
+    u32 to = 0;   ///< the instance of the list's sender
+    u32 hash = 0; ///< the hash of the list as received (recomputed here)
+};
+static_assert(sizeof(CutAckMessage) == 16);
+
+/// v3.9.8 F5: side-channel type 14, the lobby size of the match (how many games the host's match
+/// server put in it), sent once a second by every game that knows it, from the session's first
+/// pass on (before numbering; LanSide reaches the games the P2P join talks to). origin = the
+/// instance of the game that read it from dusk_lan_match.txt. 16 bytes; older builds drop it.
+struct LobbyMessage {
+    u8 type = 14;
+    u8 players = 0;  ///< 2..16
+    u16 reserved = 0;
+    u32 instance = 0;
+    u32 match_id = 0; ///< the match server's match number
+    u32 origin = 0;
+};
+static_assert(sizeof(LobbyMessage) == 16);
+
+/// v413: side-channel type 16, the sender's player number before and after message 4, once a
+/// second from the session's first pass on (and at once when it changes). Keyed by member id on
+/// the receiver. 16 bytes; older builds drop it (Side reads only 32-byte type 1).
+struct NumberMessage {
+    u8 type = 16;
+    u8 no = 0;        ///< 0 = none yet
+    u8 level = 0;     ///< 0 proposal, 1 armed, 2 delivered
+    u8 members = 0;   ///< the sender's member count (logs)
+    u32 instance = 0;
+    u64 member_id = 0; ///< the sender's own member id (M_ID of its self member)
+};
+static_assert(sizeof(NumberMessage) == 16);
+
+/// CLOCKADD v2: side-channel type 21 (17 v423 trend, 18 v423b, 19 Virtue-category design, 20 v426
+/// max HP). A non-leader saw its own phase clock jump up (the Moon Phase Watch, goods 3030, adds
+/// 30 s on the user's own game); the leader adds the same once, and the timer sync then carries it
+/// to every game. Sent 3 times (one seq). 16 bytes; older builds ignore the type.
+struct ClockAddMessage {
+    u8 type = 21;
+    u8 player_no = 0;
+    u8 phase = 0;
+    u8 round = 0;     ///< the sender's stage round (the receiver takes only its own)
+    f32 add = 0;      ///< seconds the sender's clock jumped up
+    u32 instance = 0; ///< the sender's run id
+    u32 seq = 0;      ///< per sender, from 1
+};
+static_assert(sizeof(ClockAddMessage) == 16);
+
+/// v4.37 NEEDDATA: side-channel type 26 (25 = v4.36 TAKERACE). A game whose member `waited` still
+/// has no chr 8 s into the match (the type-5 part of its player data never came) asks that game
+/// through the side channel as well, with every re-request (every 5 s). Its type-7 requests may be
+/// filed under the wrong link there (one IP for two peers: b_loadhang_notes 3), so the answering
+/// game puts the requester's own member id into its NEEDDATA box, and its game answers it with the
+/// right id. 32 bytes; older builds ignore the type.
+struct NeedDataMessage {
+    u8 type = 26;
+    u8 player_no = 0;  ///< the sender's player number (0 = not known yet)
+    u16 reserved = 0;
+    u32 instance = 0;  ///< the sender's run id
+    u64 requester = 0; ///< the sender's own member id (its self member's +0x10)
+    u64 waited = 0;    ///< the member id it waits for
+    u32 count = 0;     ///< its re-request number for this wait, from 1
+    u32 reserved2 = 0;
+};
+static_assert(sizeof(NeedDataMessage) == 32);
+
+/// v4.43 HOSTTEXT: side-channel type 27, the host's text for the players' screens. Read from
+/// dusk_lan_say.txt by the game on the host PC, sent 3 times (0.4 s apart), shown on every game
+/// whose player number is `target` (0 = all) with the phase-warning banner. 144 bytes; older builds
+/// ignore the type. A second game on the same PC reads the same file: receivers drop a seq they have.
+struct HostTextMessage {
+    u8 type = 27;
+    u8 target = 0;    ///< 0 = every player, else the player number
+    u8 len = 0;       ///< characters in text, 1..60
+    u8 reserved = 0;
+    u32 instance = 0; ///< the sender's run id (the cut-game filter reads it at +4)
+    u32 seq = 0;      ///< the host's number for this text (the file's)
+    u32 reserved2 = 0;
+    u16 text[64]{};   ///< ASCII 0x20..0x7E as UTF-16, no '<' or '>', not terminated
+};
+static_assert(sizeof(HostTextMessage) == 144);
+
+/// Side-channel message type 23 (v4.30 CUTSCENE_VOTE, cutscene_vote_notes.md): the sender's player
+/// pressed skip in a shared cutscene. Repeated every 0.5 s while its vote entry stands. The real
+/// game sent 0x25 kind 0 to the server, which answered kind 1 {count, total} and, once everybody
+/// had voted, kind 2 (skip) to all; the offline stand-in 0x11BA150 has the same rule (total =
+/// bots + 1, skip only when the own player voted too).
+struct CutsceneVoteMessage {
+    u8 type = 23;
+    u8 player_no = 0;
+    u16 reserved = 0;
+    u32 instance = 0; ///< the sender's run id
+    u32 id = 0;       ///< the cutscene id (the vote entry's +0)
+    u32 seq = 0;
+};
+static_assert(sizeof(CutsceneVoteMessage) == 16);
+/// The cutscene vote manager (0x1B814BC, 0x11BAB04): entries at +8 .. +0x10, 8 bytes each
+/// {u32 id, u8 skip (+4), u8 voted here (+5), u8 count (+6), u8 total (+7)}.
+constexpr u64 CUT_VOTE_MGR = 0x5B9DB58;
+/// Side-channel message type 24 (v4.34 quorum): in a final's UpdatePhase, once a second, which
+/// finalists the sender hears (heard in the last 5 s). A finalist that is silent here is not marked
+/// out while another game in the match still reports hearing it (a one-way link loss, not a drop).
+struct HearMessage {
+    u8 type = 24;
+    u8 player_no = 0;
+    u16 out = 0;      ///< v4.34b: bit (no - 1) per finalist the sender has out (not by silence), 1..16
+    u32 instance = 0; ///< the sender's run id
+    u32 heard = 0;    ///< bit (no - 1) per finalist heard, numbers 1..32
+    u32 seq = 0;
+};
+static_assert(sizeof(HearMessage) == 16);
+/// v4.36 TAKERACE: side-channel type 25. kind 0 = the authority is ready (its caves are in; once a
+/// second), 1 = a guest asks for a shared pay-once object its player pressed, 3 = granted, 4 = refused.
+struct TakeRaceMessage {
+    u8 type = 25;
+    u8 kind = 0;
+    u8 player_no = 0; ///< the requester (ask, answer); the sender's own number (ready)
+    u8 why = 0;       ///< answer: 0 first, 1 another player was granted it, 2 used up, 3 held, 4 not found
+    u32 instance = 0; ///< the sender's run id (+4: the cut filter reads it)
+    u32 to = 0;       ///< ask: the authority's instance; answer: the requester's
+    u32 handle = 0;
+    u32 ask = 0;      ///< the requester's park id
+    u32 round = 0;
+    u32 who = 0;      ///< answer: the player who has it (why 1 / 3)
+    u32 seq = 0;
+};
+static_assert(sizeof(TakeRaceMessage) == 32);
+
+namespace {
+/// v3.9.4 F1: FNV-1a over (no, rank) and, under Bloodbound, the team rank, in player-number order.
+/// The reason byte is not hashed (it is only logged).
+u32 CutHash(const std::vector<std::array<u8, 4>>& entries, u8 rule) {
+    u32 h = 2166136261U;
+    const auto mix = [&h](u8 b) {
+        h ^= b;
+        h *= 16777619U;
+    };
+    for (const auto& e : entries) {
+        mix(e[0]);
+        mix(e[1]);
+        mix(rule == RULE_BLOODBOUND ? e[2] : u8{0});
+    }
+    return h;
+}
+std::string CutText(const std::vector<std::array<u8, 4>>& entries, u8 rule) {
+    std::string out;
+    for (const auto& e : entries) {
+        out += rule == RULE_BLOODBOUND ? fmt::format(" {}:{}:t{}", e[0], e[1], e[2])
+                                       : fmt::format(" {}:{}", e[0], e[1]);
+    }
+    return out.empty() ? std::string(" none") : out;
+}
+} // namespace
+
+constexpr const char* RuleName(u8 rule) {
+    return rule == RULE_STANDARD       ? "Standard"
+           : rule == RULE_NO_ALLIANCES ? "No Alliances"
+           : rule == RULE_BLOODBOUND   ? "Bloodbound Alliances"
+                                       : "unknown";
+}
+
+/// Side channel type 4: the enemies the sender drives that another player is also near to. Followed
+/// by count u16 ids (sync set << 12 | entry).
+struct OwnerMessage {
+    u8 type = 4;
+    u8 player_no = 0;
+    u16 count = 0;
+    u32 instance = 0;
+};
+static_assert(sizeof(OwnerMessage) == 8);
+
+/// v426 side type 20: max HP of strong enemies the sender drives; followed by count entries.
+struct EnemyMaxMessage {
+    u8 type = ENEMY_MAX_TYPE;
+    u8 player_no = 0;
+    u16 count = 0;
+    u32 instance = 0;
+};
+static_assert(sizeof(EnemyMaxMessage) == 8);
+struct EnemyMaxEntry {
+    u16 id = 0;     ///< enemy list id (sync set << 12 | entry), the same as in the type-4 claims
+    u16 unused = 0;
+    u32 handle = 0; ///< chr+8 on the sender, checked against ours before any write
+    s32 max = 0;
+};
+static_assert(sizeof(EnemyMaxEntry) == 12);
+
+/// Side channel type 5: the sender's network clock, as its difference to the sender's steady clock
+/// (the same clock as SideMessage::sent_us), so the receiver can tell what that clock shows now.
+struct NetClockMessage {
+    u8 type = 5;
+    u8 player_no = 0;
+    u16 reserved = 0;
+    u32 instance = 0;
+    double offset = 0;
+};
+static_assert(sizeof(NetClockMessage) == 16);
+
+/// Side channel type 6: the enemy group the host's game activated (the server's message 0x66).
+struct GroupMessage {
+    u8 type = 6;
+    u8 player_no = 0;
+    u16 seq = 0;      ///< the host's count of activations in this session
+    u32 instance = 0;
+    u32 id = 0;
+    u32 reserved = 0;
+};
+static_assert(sizeof(GroupMessage) == 16);
+
+/// Side-channel message type 2: the sender's own player positions of the last second. The header
+/// is followed by count samples.
+struct SpotsHeader {
+    u8 type = 2;
+    u8 count = 0;
+    u16 reserved = 0;
+    u32 instance = 0;
+};
+struct SpotSample {
+    u64 at_us; ///< sender's steady clock
+    f32 x;
+    f32 z;
+};
+static_assert(sizeof(SpotsHeader) == 8 && sizeof(SpotSample) == 16);
+constexpr size_t MAX_SPOTS = 30;
+constexpr double DELAY_WINDOW = 4.0; ///< seconds of movement compared
+constexpr double DELAY_MAX = 6.0;    ///< largest delay looked for (a stall at the join gives seconds)
+constexpr double DELAY_GOOD = 0.2;   ///< delays up to this are left alone
+constexpr double DELAY_MARGIN = 0.08; ///< a delay this far over the peer's floor is stepped away
+
+u64 MicrosNow(Clock::time_point t) {
+    return static_cast<u64>(
+        std::chrono::duration_cast<std::chrono::microseconds>(t.time_since_epoch()).count());
+}
