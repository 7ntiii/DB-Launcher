+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <functional>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "common/cpu_features.h"
+#include "core/core.h"
+#include "core/hle/kernel/k_light_lock.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_thread.h"
+#include "core/hle/service/nx2_thread_probe.h"
+
+namespace Service::Nx2 {
+
+std::string GuestThreadProbe(Core::System& system, bool report) {
+    static std::mutex mutex;
+    static std::unordered_map<u64, s64> last_cpu;
+    Kernel::KProcess* const process = system.ApplicationProcess();
+    if (process == nullptr) {
+        return {};
+    }
+    struct Entry {
+        s64 delta;
+        u64 id;
+        s32 priority;
+        s32 core;
+        u32 state;
+        u64 pc;
+        u64 lr;
+    };
+    std::vector<Entry> entries;
+    std::scoped_lock lock{mutex};
+    {
+        Kernel::KScopedLightLock list_lock{process->GetListLock()};
+        for (auto& thread : process->GetThreadList()) {
+            const u64 id = thread.GetThreadId();
+            const s64 cpu = thread.GetCpuTime();
+            const auto [it, inserted] = last_cpu.try_emplace(id, cpu);
+            const s64 delta = inserted ? 0 : cpu - it->second;
+            it->second = cpu;
+            if (report && delta > 0) {
+                const auto& context = thread.GetContext();
+                entries.push_back({delta, id, thread.GetPriority(), thread.GetActiveCore(),
+                                   static_cast<u32>(thread.GetState()), context.pc, context.lr});
+            }
+        }
+    }
+    if (!report) {
+        return {};
+    }
+    std::ranges::sort(entries, std::greater{}, &Entry::delta);
+    const double ticks_per_ms = static_cast<double>(Common::g_wall_clock.GetGuestCNTFRQ()) / 1000.0;
+    const u64 base = GetInteger(process->GetEntryPoint());
+    const auto offset = [base](u64 address) { return address >= base ? address - base : address; };
+    std::string text;
+    for (std::size_t i = 0; i < (std::min)(entries.size(), std::size_t{6}); ++i) {
+        const Entry& e = entries[i];
+        text += fmt::format(" t{}={:.1f}ms(p{} c{} s{} pc+{:#x} lr+{:#x})", e.id,
+                            static_cast<double>(e.delta) / ticks_per_ms, e.priority, e.core,
+                            e.state, offset(e.pc), offset(e.lr));
+    }
+    return text.empty() ? " none" : text;
+}
+
+std::string GuestThreadShares(Core::System& system, double seconds) {
+    static std::mutex mutex;
+    static std::unordered_map<u64, s64> last_cpu;
+    Kernel::KProcess* const process = system.ApplicationProcess();
+    if (process == nullptr || seconds <= 0) {
+        return {};
+    }
+    struct Entry {
+        s64 delta;
+        u64 id;
+        s32 priority;
+        s32 core;
+    };
+    std::vector<Entry> entries;
+    s64 all = 0;
+    std::scoped_lock lock{mutex};
+    {
+        Kernel::KScopedLightLock list_lock{process->GetListLock()};
+        for (auto& thread : process->GetThreadList()) {
+            const u64 id = thread.GetThreadId();
+            const s64 cpu = thread.GetCpuTime();
+            const auto [it, inserted] = last_cpu.try_emplace(id, cpu);
+            const s64 delta = inserted ? 0 : cpu - it->second;
+            it->second = cpu;
+            if (delta > 0) {
+                all += delta;
+                entries.push_back({delta, id, thread.GetPriority(), thread.GetActiveCore()});
+            }
+        }
+    }
+    std::ranges::sort(entries, std::greater{}, &Entry::delta);
+    const double window_ticks = static_cast<double>(Common::g_wall_clock.GetGuestCNTFRQ()) * seconds;
+    std::string text = fmt::format(" all={:.0f}%", 100.0 * static_cast<double>(all) / window_ticks);
+    for (std::size_t i = 0; i < (std::min)(entries.size(), std::size_t{12}); ++i) {
+        const Entry& e = entries[i];
+        text += fmt::format(" t{}={:.0f}%(p{} c{})", e.id,
+                            100.0 * static_cast<double>(e.delta) / window_ticks, e.priority, e.core);
+    }
+    return text;
+}
+
+} // namespace Service::Nx2
