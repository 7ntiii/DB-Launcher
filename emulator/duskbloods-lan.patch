+void Assist::State::FinalSlots(u32 phase) {
+    if (main == 0 || session.manager == 0 || session.state != 8 || phase != PHASE_INTERMISSION ||
+        Get<u8>(main + GENERATOR_IDLE) != 0) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    if (stage == 0 || mediator == 0 || Get<u64>(stage + 0x3388) == 0) {
+        return;
+    }
+    if (final_slots_gen == match_gen) {
+        // After our rebuild: log the new list once.
+        if (!final_slots_logged && final_slots_count != 0 &&
+            Get<u8>(mediator + MED_DECIDED) != 0) {
+            final_slots_logged = true;
+            const u64 count = Get<u64>(mediator + MED_LIST_COUNT);
+            std::string list;
+            for (u64 i = 0; i < count && count <= MED_LIST_MAX; ++i) {
+                const u64 entry = mediator + MED_LIST + i * MED_LIST_ENTRY;
+                list += fmt::format("{}player {} area {} at ({:.1f}, {:.1f})",
+                                    list.empty() ? "" : ", ", Get<u32>(entry),
+                                    Get<s32>(entry + ENTRY_INDEX),
+                                    Get<f32>(entry + ENTRY_POSITION),
+                                    Get<f32>(entry + ENTRY_POSITION + 8));
+            }
+            Log(fmt::format("final: start list rebuilt, {} entries: {}", count, list));
+        }
+        return;
+    }
+    if (Get<u8>(mediator + MED_DECIDED) == 0 || (hold_on && hold_gen == match_gen)) {
+        return; // the game has not built its own list yet (or v4.47 holds it)
+    }
+    const u64 slots = Get<u64>(mediator + MED_SLOT_COUNT);
+    const u32 local_no = LocalPlayerNo();
+    if (slots == 0 || slots > MED_SLOT_MAX || local_no == 0 || local_no == ~0U) {
+        return;
+    }
+    std::array<u8, MED_SLOT_SIZE> mine{};
+    std::vector<u32> have;
+    bool found = false;
+    for (u64 i = 0; i < slots; ++i) {
+        const u64 slot = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+        const u32 no = Get<u32>(slot);
+        have.push_back(no);
+        if (no == local_no && Read(slot, mine.data(), mine.size())) {
+            found = true;
+        }
+    }
+    final_slots_gen = match_gen; // one decision per final, whatever comes next
+    final_slots_count = 0;
+    final_slots_logged = false;
+    if (!found) {
+        Log(fmt::format("final: our player {} has no start slot here ({} slots); start list left "
+                        "as the game built it",
+                        local_no, slots));
+        return;
+    }
+    // Every other player character in the world (the finalists that are still in).
+    std::vector<u32> others;
+    std::vector<u32> cut_skipped; // v4.33 A1: copies of cut players, logged once with the decision
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+    for (size_t entry = 0; entries != 0 && entry < MAX_ENTRIES; ++entry) {
+        const u64 base = entries + entry * 0x38;
+        const u64 chr = Get<u64>(base);
+        if (chr == 0 || !PlayerEntry(chr, entry)) {
+            continue;
+        }
+        const u64 chr_data = Get<u64>(chr + 0x20);
+        const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+        const u32 no = player_data != 0 ? Get<u32>(player_data + 0xD0) : 0;
+        if (no == 0 || no >= 100 || std::ranges::find(have, no) != have.end() ||
+            std::ranges::find(others, no) != others.end()) {
+            continue;
+        }
+        // v4.33 (four_plus_audit_notes.md A1): a player cut in round 3 (4+ players: Phase III takes
+        // 3) can still have a copy in this world; it is no finalist and gets no start point.
+        if (CutNo(no)) {
+            if (std::ranges::find(cut_skipped, no) == cut_skipped.end()) {
+                cut_skipped.push_back(no);
+            }
+            continue;
+        }
+        others.push_back(no);
+    }
+    // v4.38 FINALSLOTS2 (final_spawn_notes.md): a finalist can hold a slot and still have no entry in
+    // the decided list (match 4: 3 slots, list "1 entries: player 1 area 4"; the slots of players 2
+    // and 3 kept their round-3 picks, which name no area of the final's map). Such a slot is made a
+    // copy of ours with no pick, as the added ones are, and the list is built again.
+    std::vector<u32> listed;
+    {
+        const u64 list_count = Get<u64>(mediator + MED_LIST_COUNT);
+        for (u64 i = 0; i < list_count && list_count <= MED_LIST_MAX; ++i) {
+            listed.push_back(Get<u32>(mediator + MED_LIST + i * MED_LIST_ENTRY));
+        }
+    }
+    std::string reset;
+    for (u64 i = 0; i < slots; ++i) {
+        const u64 at = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+        const u32 no = Get<u32>(at);
+        if (no == 0 || no >= 100 || no == local_no || CutNo(no) ||
+            std::ranges::find(listed, no) != listed.end()) {
+            continue;
+        }
+        const u8 old_kind = Get<u8>(at + SLOT_PICK_KIND);
+        const s32 old_id = Get<s32>(at + SLOT_PICK_ID);
+        std::array<u8, MED_SLOT_SIZE> slot = mine;
+        const u8 none_kind = 4;
+        const s32 none_id = -1;
+        std::memcpy(slot.data(), &no, sizeof(no));
+        std::memcpy(slot.data() + SLOT_PICK_KIND, &none_kind, sizeof(none_kind));
+        std::memcpy(slot.data() + SLOT_PICK_ID, &none_id, sizeof(none_id));
+        if (Write(at, slot.data(), slot.size())) {
+            reset += fmt::format("{}{} (was pick kind {} id {})", reset.empty() ? "" : ", ", no,
+                                 old_kind, old_id);
+        }
+    }
+    if (!reset.empty()) {
+        Log(fmt::format("final: start slots of player(s) {} had no entry in the decided list ({} "
+                        "slots, {} entries); their picks are cleared and the start list is built "
+                        "again (v4.38 FINALSLOTS2)",
+                        reset, slots, listed.size()));
+        if (others.empty()) {
+            Put<u8>(mediator + MED_DECIDED, 0); // the game builds and sends the list again
+            final_slots_count = slots;
+            return;
+        }
+    }
+    if (!cut_skipped.empty()) {
+        std::string cut;
+        for (const u32 no : cut_skipped) {
+            cut += fmt::format("{}{}", cut.empty() ? "" : ", ", no);
+        }
+        Log(fmt::format("final: no start slot for cut player(s) {} (their copies are in the world "
+                        "here, but they are not finalists; v4.33)",
+                        cut));
+    }
+    if (others.empty()) {
+        Log(fmt::format("final: start slots complete here ({} slots); list left as built", slots));
+        return;
+    }
+    u64 count = slots;
+    std::string added;
+    for (const u32 no : others) {
+        if (count >= MED_SLOT_MAX) {
+            break;
+        }
+        std::array<u8, MED_SLOT_SIZE> slot = mine;
+        const u8 none_kind = 4;
+        const s32 none_id = -1;
+        std::memcpy(slot.data(), &no, sizeof(no));
+        std::memcpy(slot.data() + SLOT_PICK_KIND, &none_kind, sizeof(none_kind));
+        std::memcpy(slot.data() + SLOT_PICK_ID, &none_id, sizeof(none_id));
+        if (!Write(mediator + MED_SLOTS + count * MED_SLOT_SIZE, slot.data(), slot.size())) {
+            break;
+        }
+        ++count;
+        added += fmt::format("{}{}", added.empty() ? "" : ", ", no);
+    }
+    if (count == slots) {
+        return;
+    }
+    Put<u64>(mediator + MED_SLOT_COUNT, count);
+    Put<u8>(mediator + MED_DECIDED, 0); // the game builds and sends the list again
+    final_slots_count = count;
+    Log(fmt::format("final: start slots added for player(s) {} ({} -> {} slots); the start list "
+                    "is built again so each finalist gets its own point",
+                    added, slots, count));
+}
+
+/// v4.46 DECIDEONCE (13-ALPHA_TEST.md, trigger proof 2026-11-20): every final on the rig had the
+/// host decide a short list first (1 entry: only the host) at phase 26 entry; FinalSlots then
+/// added or reset the other finalists' slots and cleared MED_DECIDED, so the game built and sent
+/// the start list a second time. The crashed finals all came from that path. Here the host
+/// makes every finalist's slot complete BEFORE the first decide (round 4, phases 21 / 22 / 26
+/// while MED_DECIDED is 0), the same slot FinalSlots would make (a copy of ours with no pick), so
+/// the game's first list is already complete and nothing is cleared or sent again. FinalSlots
+/// stays as the fallback when the first list still comes out short.
+void Assist::State::FinalSlotsEarly(u32 phase) {
+    if (main == 0 || session.manager == 0 || session.state != 8 ||
+        Get<u8>(main + GENERATOR_IDLE) != 0 ||
+        (phase != PHASE_PREPARE_SECOND && phase != PHASE_PREPARE_THIRD &&
+         phase != PHASE_INTERMISSION)) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    const u64 mediator = Get<u64>(main + MEDIATOR);
+    if (stage == 0 || mediator == 0 || Get<u32>(stage + P_ROUND) != FINAL_ROUND ||
+        final_slots_gen == match_gen) {
+        return;
+    }
+    // v4.47 DECIDEHOLD (rig probe 2026-11-20, diag/twin/slot_watch_f2.log): the final has no slot
+    // before Intermission (phase 18 empties the vector and M+0xB9), and the game makes our slot and
+    // decides its list in the first Intermission frame, so v4.46's early fill never had a vector to
+    // fill. The final's builder (0x11679C0 path) runs only while M+0xB9 == 0, so the host sets
+    // M+0xB9 from phase 21 on (no list yet: nothing reads it there), keeps it set in phase 26
+    // until our own slot is in the vector, fills every finalist's slot below, then clears it: the
+    // game's first list is complete. If our slot does not come within HOLD_MAX, the flag is
+    // cleared and today's path (FinalSlots) takes over.
+    constexpr auto HOLD_MAX = 2s;
+    const auto now_tp = Clock::now();
+    if (hold_gen != match_gen) {
+        if (phase == PHASE_INTERMISSION && Get<u8>(mediator + MED_DECIDED) != 0) {
+            hold_gen = match_gen; // the game decided before we could hold: FinalSlots' case
+            hold_on = false;
+            Log("final: the start list was decided before the hold was set; today's rebuild "
+                "follows (v4.47 DECIDEHOLD)");
+            return;
+        }
+        hold_gen = match_gen;
+        hold_on = true;
+        hold_since.reset();
+        Put<u8>(mediator + MED_DECIDED, 1);
+        Log(fmt::format("final: the game's start list decide is held from phase {} until every "
+                        "finalist has a slot (v4.47 DECIDEHOLD)",
+                        phase));
+        return;
+    }
+    if (!hold_on) {
+        return;
+    }
+    if (Get<u8>(mediator + MED_DECIDED) == 0) {
+        Put<u8>(mediator + MED_DECIDED, 1); // cleared by the game (phase 18 / PreIntermission)
+    }
+    if (phase != PHASE_INTERMISSION) {
+        return;
+    }
+    if (!hold_since) {
+        hold_since = now_tp;
+    }
+    const auto release = [&](const char* why) {
+        hold_on = false;
+        Put<u8>(mediator + MED_DECIDED, 0); // the game builds its list on the next frame, once
+        Log(fmt::format("final: start list decide released after {:.2f} s: {} (v4.47 DECIDEHOLD)",
+                        std::chrono::duration<double>(now_tp - *hold_since).count(), why));
+    };
+    if (early_slots_gen != match_gen) {
+        early_slots_gen = match_gen;
+        early_slots_writes = 0;
+    }
+    const u64 slots = Get<u64>(mediator + MED_SLOT_COUNT);
+    const u32 local_no = LocalPlayerNo();
+    if (slots > MED_SLOT_MAX || local_no == 0 || local_no == ~0U) {
+        release("no sane slot vector");
+        return;
+    }
+    std::array<u8, MED_SLOT_SIZE> mine{};
+    std::vector<u32> have;
+    bool found = false;
+    for (u64 i = 0; i < slots; ++i) {
+        const u64 slot = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+        const u32 no = Get<u32>(slot);
+        have.push_back(no);
+        if (no == local_no && Read(slot, mine.data(), mine.size())) {
+            found = true;
+        }
+    }
+    if (!found) {
+        if (now_tp - *hold_since >= HOLD_MAX) {
+            release("our slot did not come; today's rebuild follows");
+        }
+        return; // no slot of ours yet: nothing to copy
+    }
+    const auto finalist_slot = [&](u32 no) {
+        std::array<u8, MED_SLOT_SIZE> slot = mine;
+        const u8 none_kind = 4;
+        const s32 none_id = -1;
+        std::memcpy(slot.data(), &no, sizeof(no));
+        std::memcpy(slot.data() + SLOT_PICK_KIND, &none_kind, sizeof(none_kind));
+        std::memcpy(slot.data() + SLOT_PICK_ID, &none_id, sizeof(none_id));
+        return slot;
+    };
+    std::string reset;
+    std::string added;
+    // The other finalists' existing slots: the copy FinalSlots (v4.38) would make after the list.
+    for (u64 i = 0; i < slots; ++i) {
+        const u64 at = mediator + MED_SLOTS + i * MED_SLOT_SIZE;
+        const u32 no = have[i];
+        if (no == 0 || no >= 100 || no == local_no || CutNo(no)) {
+            continue;
+        }
+        const auto want = finalist_slot(no);
+        std::array<u8, MED_SLOT_SIZE> now{};
+        if (Read(at, now.data(), now.size()) && now != want && Write(at, want.data(), want.size())) {
+            reset += fmt::format("{}{}", reset.empty() ? "" : ", ", no);
+        }
+    }
+    // Finalists with a player character here and no slot at all (FinalSlots' "slots added").
+    u64 count = slots;
+    const u64 world = Get<u64>(main + WORLD_CHR);
+    const u64 entries = world != 0 ? Get<u64>(world + 0x30) : 0;
+    for (size_t entry = 0; entries != 0 && entry < MAX_ENTRIES && count < MED_SLOT_MAX; ++entry) {
+        const u64 base = entries + entry * 0x38;
+        const u64 chr = Get<u64>(base);
+        if (chr == 0 || !PlayerEntry(chr, entry)) {
+            continue;
+        }
+        const u64 chr_data = Get<u64>(chr + 0x20);
+        const u64 player_data = chr_data != 0 ? Get<u64>(chr_data + 0x1D0) : 0;
+        const u32 no = player_data != 0 ? Get<u32>(player_data + 0xD0) : 0;
+        if (no == 0 || no >= 100 || CutNo(no) || std::ranges::find(have, no) != have.end()) {
+            continue;
+        }
+        const auto slot = finalist_slot(no);
+        if (!Write(mediator + MED_SLOTS + count * MED_SLOT_SIZE, slot.data(), slot.size())) {
+            break;
+        }
+        have.push_back(no);
+        ++count;
+        added += fmt::format("{}{}", added.empty() ? "" : ", ", no);
+    }
+    if (count != slots) {
+        Put<u64>(mediator + MED_SLOT_COUNT, count);
+    }
+    if (!reset.empty() || !added.empty()) {
+        ++early_slots_writes;
+        if (early_slots_writes <= 3) {
+            Log(fmt::format("final: start slots made complete before the game decides the list "
+                            "(phase {}): slots set for player(s) {}, added for player(s) {} ({} -> "
+                            "{} slots), write #{} (v4.46 DECIDEONCE)",
+                            phase, reset.empty() ? "-" : reset, added.empty() ? "-" : added, slots,
+                            count, early_slots_writes));
+        }
+    }
+    release(fmt::format("{} slot(s) ready", count).c_str());
+}
