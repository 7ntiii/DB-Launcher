+bool Assist::State::PlayerNumber(u64 manager, u32& no, u32& team, size_t& players) {
+    const u64 begin = Get<u64>(manager + S_MEMBERS);
+    const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+    if (begin == 0 || end <= begin || (end - begin) % MEMBER_SIZE != 0 ||
+        end - begin > 16 * MEMBER_SIZE) {
+        return false;
+    }
+    std::vector<u64> ids;
+    std::optional<u64> self;
+    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+        if (Get<u8>(member + M_SERVER) != 0) {
+            continue;
+        }
+        const u64 id = Get<u64>(member + M_ID);
+        ids.push_back(id);
+        if (Get<u8>(member + M_SELF) != 0) {
+            self = id;
+        }
+    }
+    players = ids.size();
+    if (player) {
+        no = player->first;
+        team = player->second;
+        return true;
+    }
+    // Wait for the other players, so every side numbers everyone the same way. The members come
+    // in one by one over a second or two: with three players a game that numbered itself among
+    // the first two took a number another game also took. So the list must hold still for 3 s.
+    if (ids.size() != session.member_count) {
+        session.member_count = ids.size();
+        session.member_since = Clock::now();
+    }
+    // v3.9.5 F5: a game numbered from a list that still lacks a late joiner whose id sorts below
+    // its own takes a number that joiner's game also takes. With DUSK_MATCH_MIN set (2 changes
+    // nothing: 2 members are needed anyway) wait until that many are listed, or until the list
+    // has held still for MEMBER_WAIT_MAX (a player who never comes); the 3-s still time stays.
+    // v3.9.8: without DUSK_MATCH_MIN (the packaged game) the lobby size the host's match server
+    // wrote (LobbyShare) is waited for the same way. 2 changes nothing; unknown (0) = as before.
+    const size_t wanted = match_min != 0 ? match_min : session.lobby_players;
+    const char* const wanted_from = match_min != 0 ? "DUSK_MATCH_MIN" : "lobby size";
+    if (wanted > 2 && ids.size() < wanted) {
+        if (Clock::now() - session.member_since < MEMBER_WAIT_MAX) {
+            if (!session.member_wait_logged) {
+                session.member_wait_logged = true;
+                Log(fmt::format("player no: {} of {} players listed ({}); waiting for the others "
+                                "(F5)",
+                                ids.size(), wanted, wanted_from));
+            }
+            return false;
+        }
+        if (!session.member_fallback_logged) {
+            session.member_fallback_logged = true;
+            Log(fmt::format("player no: still {} of {} players listed ({}), no change for {} s; "
+                            "numbering from this list (F5)",
+                            ids.size(), wanted, wanted_from, MEMBER_WAIT_MAX.count()));
+        }
+    }
+    // V400-3 (realnet_notes R3): with no lobby size known (no DUSK_MATCH_MIN, no match file read
+    // here, no type 14 heard) a late joiner over a slow link can come after 3 s: wait 5 s then.
+    const auto still = wanted != 0 ? 3s : 5s;
+    if (!self || ids.size() < 2 || Clock::now() - session.member_since < still) {
+        return false;
+    }
+    std::ranges::sort(ids);
+    const auto index = static_cast<u32>(std::ranges::find(ids, *self) - ids.begin());
+    no = index + 1;
+    team = index;
+    // v412 N2 / v413 (audit8_numbering.md): the index rule gives every game the same numbers only
+    // when all lists were the same. A late joiner after the 12-s fallback, or a game numbering after
+    // a member left, can land on a number another game holds. v413: every game tells the others its
+    // number (type 16: proposed, armed, delivered), games arm in member-id order, and a number held
+    // by another game is never taken: a delivered one is never contested, an armed one stays with
+    // the LOWER member id; the loser takes, among the numbers nobody holds, the one at its place
+    // among the members that hold none (sorted by id: the same choice on every game with the same
+    // view). Two players (and no lobby size above 2): exactly the index rule, no wait (v412b).
+    session.number_self_id = *self;
+    if (number_force != 0) {
+        no = number_force;
+        team = no - 1;
+    }
+    session.number_proposal = no;
+    const bool many = ids.size() >= 3 || wanted > 2 || number_force != 0;
+    if (!many) {
+        return true;
+    }
+    const auto now = Clock::now();
+    struct Hold {
+        u64 id = 0;
+        u8 level = 0;
+    };
+    std::map<u32, Hold> held;    // number -> its holder (delivered before armed, then lower id)
+    std::set<u64> holders;
+    const auto add = [&](u32 n, u64 id, u8 level) {
+        if (n < 1 || n > 16 || id == *self) {
+            return;
+        }
+        holders.insert(id);
+        const auto it = held.find(n);
+        if (it == held.end() || level > it->second.level ||
+            (level == it->second.level && id < it->second.id)) {
+            held[n] = Hold{id, level};
+        }
+    };
+    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+        if (Get<u8>(member + M_SERVER) != 0 || Get<u8>(member + M_SELF) != 0) {
+            continue;
+        }
+        add(Get<u32>(member + M_REMOTE_NO), Get<u64>(member + M_ID), 2); // v412b: +0xD4 alone
+    }
+    const std::set<u64> in_list(ids.begin(), ids.end());
+    std::set<u64> heard_ids;
+    for (const auto& [id, h] : session.number_heard) {
+        if (!in_list.contains(id) || id == *self || now - h.at > NUMBER_FRESH) {
+            continue; // not in our session's list (another match, a leaver) or stale
+        }
+        heard_ids.insert(id);
+        if (h.level >= 1) {
+            add(h.no, id, h.level);
+        }
+    }
+    // Bounded waits, only before we arm and only when type 16 is in use in this session (a match of
+    // older packages numbers exactly as before).
+    if (!session.armed && session.number_heard_any) {
+        if (!session.number_ready_since) {
+            session.number_ready_since = now;
+        }
+        const auto waited = now - *session.number_ready_since;
+        std::string missing;
+        std::string lower_open;
+        for (const u64 id : ids) {
+            if (id == *self) {
+                continue;
+            }
+            if (!heard_ids.contains(id)) {
+                missing += fmt::format(" {:#x}", id & 0xFFFFFFFFFF);
+            } else if (id < *self && !holders.contains(id)) {
+                lower_open += fmt::format(" {:#x}", id & 0xFFFFFFFFFF);
+            }
+        }
+        if ((!missing.empty() && waited < NUMBER_HEAR_MAX) ||
+            (!lower_open.empty() && waited < NUMBER_ORDER_MAX)) {
+            if (!session.number_wait_logged) {
+                session.number_wait_logged = true;
+                Log(fmt::format("player no: waiting before message 4 (v413): not heard yet{} (at "
+                                "most {} s), lower ids without a number yet{} (at most {} s)",
+                                missing.empty() ? " none" : missing, NUMBER_HEAR_MAX.count(),
+                                lower_open.empty() ? " none" : lower_open,
+                                NUMBER_ORDER_MAX.count()));
+            }
+            return false;
+        }
+        if ((!missing.empty() || !lower_open.empty()) && !session.number_wait_over_logged) {
+            session.number_wait_over_logged = true;
+            Log(fmt::format("player no: numbering after {:.1f} s without type 16 from{} and with "
+                            "lower ids still open{} (older package or lost; v413)",
+                            std::chrono::duration<double>(waited).count(),
+                            missing.empty() ? " none" : missing,
+                            lower_open.empty() ? " none" : lower_open));
+        }
+    }
+    const auto taken = held.find(no);
+    if (taken != held.end() && (taken->second.level >= 2 || taken->second.id < *self)) {
+        std::vector<u64> open_ids;
+        for (const u64 id : ids) {
+            if (!holders.contains(id)) {
+                open_ids.push_back(id); // ours included (we are never in holders)
+            }
+        }
+        const auto place =
+            static_cast<size_t>(std::ranges::find(open_ids, *self) - open_ids.begin());
+        std::vector<u32> free_nos;
+        for (u32 n = 1; n <= 16 && free_nos.size() <= place; ++n) {
+            if (!held.contains(n)) {
+                free_nos.push_back(n);
+            }
+        }
+        if (place < free_nos.size()) {
+            if (session.number_yield_logged != free_nos[place]) {
+                session.number_yield_logged = free_nos[place];
+                std::string known;
+                for (const auto& [n, h] : held) {
+                    known += fmt::format(" {}({:#x}{})", n, h.id & 0xFFFFFFFFFF,
+                                         h.level >= 2 ? ", delivered" : ", armed");
+                }
+                Log(fmt::format("!!! player no: {} is held by another game (held here:{}); taking "
+                                "{} instead (v413) !!!",
+                                no, known, free_nos[place]));
+            }
+            no = free_nos[place];
+            team = no - 1;
+        }
+    }
+    return true;
+}
+
+/// v413: side type 16, our number before and after message 4 (see PlayerNumber).
+void Assist::State::NumberShare(Clock::time_point now) {
+    if (main == 0 || session.manager == 0) {
+        return;
+    }
+    if (session.number_self_id == 0) {
+        const u64 begin = Get<u64>(session.manager + S_MEMBERS);
+        const u64 end = Get<u64>(session.manager + S_MEMBERS + 8);
+        if (begin != 0 && end > begin && (end - begin) % MEMBER_SIZE == 0 &&
+            end - begin <= 16 * MEMBER_SIZE) {
+            for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+                if (Get<u8>(member + M_SERVER) == 0 && Get<u8>(member + M_SELF) != 0) {
+                    session.number_self_id = Get<u64>(member + M_ID);
+                }
+            }
+        }
+    }
+    if (session.number_self_id == 0) {
+        return;
+    }
+    NumberMessage out;
+    out.instance = instance;
+    out.member_id = session.number_self_id;
+    out.members = static_cast<u8>(std::min<size_t>(session.member_count, 0xFF));
+    const u32 local = LocalPlayerNo();
+    if (session.number_delivered && local == session.no && local >= 1 && local <= 16) {
+        out.no = static_cast<u8>(local);
+        out.level = 2;
+    } else if (session.armed && session.no >= 1 && session.no <= 16) {
+        out.no = static_cast<u8>(session.no);
+        out.level = 1;
+    } else if (session.number_proposal >= 1 && session.number_proposal <= 16) {
+        out.no = static_cast<u8>(session.number_proposal);
+        out.level = 0;
+    }
+    const u32 sig = out.no | (u32{out.level} << 8);
+    if (sig != session.number_sent_sig || now - session.number_sent_at >= 1s) {
+        Network::LanSide::Send(std::span<const u8>(reinterpret_cast<const u8*>(&out), sizeof(out)));
+        session.number_sent_sig = sig;
+        session.number_sent_at = now;
+    }
+}
+
+void Assist::State::NumberHeard(const Network::LanSide::Packet& packet) {
+    NumberMessage in;
+    if (packet.data.size() != sizeof(in) || session.manager == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.member_id == 0 || in.no > 16 || in.level > 2) {
+        return;
+    }
+    session.number_heard[in.member_id] =
+        Session::NumberHeard{in.no, in.level, packet.at, in.instance};
+    session.number_heard_any = true;
+}
+
+void Assist::State::ClockAddHeard(const Network::LanSide::Packet& packet) {
+    ClockAddMessage in;
+    if (packet.data.size() != sizeof(in) || main == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.seq == 0 || in.player_no == 0 ||
+        !(in.add >= 20.0f && in.add <= 40.0f)) {
+        return;
+    }
+    if (CutNo(in.player_no)) {
+        return; // v2 C4: a cut player's game is not in our match
+    }
+    // v2 C2: only for the round and UpdatePhase we are in (an add heard after the next phase
+    // began belongs to the old one).
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0 || Get<u32>(stage + P_STATE) != PHASE_UPDATE ||
+        Get<u32>(stage + P_ROUND) != in.round) {
+        return;
+    }
+    if (!clock_add_seen.insert((u64{in.instance} << 32) | in.seq).second) {
+        return; // a repeat (sent 3 times) or a replay
+    }
+    clock_add_pending += in.add;
+    clock_add_at = packet.at;
+    Log(fmt::format("clock add: player {} (game {:#010x}) added {:.1f} s to its phase clock "
+                    "(#{}, round {}); the leader applies it (CLOCKADD)",
+                    in.player_no, in.instance, in.add, in.seq, in.round));
+}
+
+/// v4.52 LINEUPHOLD (diag/net/loadscreen/lineuphold_gen.py): the loading screen lists one figure per
+/// player-data copy that exists when it is built (stage step 2). On LAN a member's copy comes from
+/// its single type-5 answer, sent when the slower game reaches state 5, and that answer comes late
+/// or is lost while the link is not up (user_zt_1121: player 3's type 5 came only after the in-match
+/// NEEDDATA, 30 s later). So, from our state 5 until the screen is built: every member whose type 5
+/// is missing is asked again through the side channel (NEEDDATA, every 1.5 s), and the screen's
+/// step is held (LH_BOX) until every copy is here, at most LH_CAP. The game then builds its own
+/// line-up from its own copies; nothing is written into them.
+void Assist::State::LineupHold(Clock::time_point now, u64 manager, u32 join_state, u32 phase) {
+    if (session.lineup_done || Get<u32>(main + LH_SITE) != LH_HOOK) {
+        return;
+    }
+    const auto release = [&](std::string_view why, const std::string& missing) {
+        session.lineup_done = true;
+        if (Get<u32>(main + LH_BOX) != 0 || session.lineup_hold_since) {
+            Put<u32>(main + LH_BOX, 0);
+            const double held_s =
+                session.lineup_hold_since
+                    ? std::chrono::duration<double>(now - *session.lineup_hold_since).count()
+                    : 0.0;
+            Log(fmt::format("line-up: hold off ({}; held {:.1f} s, {} frame(s); {} early ask(s){}; "
+                            "session state {}, match phase {}) (v4.52 LINEUPHOLD)",
+                            why, held_s, Get<u32>(main + LH_BOX + 4), session.lineup_asks,
+                            missing.empty() ? "" : ", still missing " + missing, join_state,
+                            static_cast<s32>(phase)));
+        }
+    };
+    // The window: our player-data request is out (state 5+) and the screen is not built yet
+    // (stage step 0..2; ~0U = no stage yet). State 8 or a later step: too late, stop.
+    const bool before_stage = phase == ~0U || phase == 0;
+    if (join_state < 5) {
+        return;
+    }
+    if (join_state > 7 || !(before_stage || phase == 1 || phase == 2)) {
+        release("the loading screen is past its line-up", {});
+        return;
+    }
+    const u64 begin = Get<u64>(manager + S_MEMBERS);
+    const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+    if (begin == 0 || end <= begin || end - begin > 16 * MEMBER_SIZE ||
+        (end - begin) % MEMBER_SIZE != 0) {
+        return;
+    }
+    u64 self_id = 0;
+    std::vector<u64> missing;
+    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+        const u64 id = Get<u64>(member + M_ID);
+        if (Get<u8>(member + M_SELF) != 0) {
+            self_id = id;
+        } else if (Get<u8>(member + M_SERVER) == 0 && id != 0 && id != ~0ULL &&
+                   Get<u8>(member + M_TYPE5_SEEN) == 0) {
+            missing.push_back(id);
+        }
+    }
+    std::string list;
+    for (const u64 id : missing) {
+        list += fmt::format("{}{:#x}", list.empty() ? "" : " ", id & 0xFFFFFFFFFF);
+    }
+    if (missing.empty()) {
+        release("every member's player data is here", {});
+        return;
+    }
+    if (!session.lineup_hold_since) {
+        session.lineup_hold_since = now;
+        session.lineup_asked = now - LH_ASK_EVERY;
+        Put<u32>(main + LH_BOX + 4, 0);
+        Put<u32>(main + LH_BOX, 1);
+        Log(fmt::format("line-up: player data of {} not here yet (session state {}, match phase "
+                        "{}): the loading screen waits for it, at most {} s, and asks again (v4.52 "
+                        "LINEUPHOLD)",
+                        list, join_state, static_cast<s32>(phase),
+                        std::chrono::duration_cast<std::chrono::seconds>(LH_CAP).count()));
+    }
+    if (phase == 2 && !session.lineup_step2_since) {
+        session.lineup_step2_since = now; // the screen's step only waits from here on
+    }
+    if (session.lineup_step2_since && now - *session.lineup_step2_since >= LH_CAP) {
+        release("cap reached: the screen is built with the copies that are here", list);
+        return;
+    }
+    if (now - session.lineup_asked < LH_ASK_EVERY || self_id == 0 || self_id == ~0ULL) {
+        return;
+    }
+    session.lineup_asked = now;
+    ++session.lineup_asks;
+    const u32 own = LocalPlayerNo();
+    for (const u64 waited : missing) {
+        NeedDataMessage need;
+        need.player_no = own >= 1 && own <= 0xFF ? static_cast<u8>(own) : 0;
+        need.instance = instance;
+        need.requester = self_id;
+        need.waited = waited;
+        need.count = std::min<u32>(session.lineup_asks, NEED_MAX_ASKS);
+        need.reserved2 = NEED_EARLY;
+        Network::LanSide::Send(
+            std::span<const u8>(reinterpret_cast<const u8*>(&need), sizeof(need)));
+    }
+    if (session.lineup_asks == 1) {
+        Log(fmt::format("line-up: asked {} through the side channel for their player data (early "
+                        "NEEDDATA, our member id {:#x})",
+                        list, self_id & 0xFFFFFFFFFF));
+    }
+}
+
+/// v4.37 NEEDDATA (b_loadhang_notes 5): another game still has no chr for our player because our
+/// game never answered its type-7 request with its id (filed under the wrong link, or dropped as -1).
+/// Put its member id in the NEEDDATA box; the cave on our pump answers it on the game's next tick
+/// that can answer, through the type-7 stub with that id (0x14DE8B4 -> 0x1CD9D88 -> 0x14DC040), which
+/// sends our type 5 (player data and number) to it. The box has one writer per state (assist: valid
+/// 0 -> 1, game: 1 -> 0), so no word is written by both threads at once.
+void Assist::State::NeedDataHeard(const Network::LanSide::Packet& packet) {
+    NeedDataMessage in;
+    if (packet.data.size() != sizeof(in) || main == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.requester == 0 || in.requester == ~0ULL || in.waited == 0 ||
+        in.count == 0 || in.count > NEED_MAX_ASKS) {
+        return;
+    }
+    const u64 manager = Get<u64>(Get<u64>(main + SESSION_REF));
+    if (manager == 0) {
+        return;
+    }
+    const u64 begin = Get<u64>(manager + S_MEMBERS);
+    const u64 end = Get<u64>(manager + S_MEMBERS + 8);
+    if (begin == 0 || end <= begin || end - begin > 16 * MEMBER_SIZE) {
+        return;
+    }
+    u64 self_id = 0;
+    bool known = false;
+    for (u64 member = begin; member < end; member += MEMBER_SIZE) {
+        const u64 id = Get<u64>(member + M_ID);
+        if (Get<u8>(member + M_SELF) != 0) {
+            self_id = id;
+        } else if (Get<u8>(member + M_SERVER) == 0 && id == in.requester) {
+            known = true;
+        }
+    }
+    if (self_id == 0 || self_id != in.waited) {
+        return; // asked of another game
+    }
+    const auto refuse = [&](u8 reason, std::string_view why) {
+        if (need_refused_logged.insert((in.requester << 8) | reason).second) {
+            Log(fmt::format("player data: player {} ({:#x}) waits for our player data, not queued: "
+                            "{} (v4.37 NEEDDATA)",
+                            in.player_no, in.requester & 0xFFFFFFFFFF, why));
+        }
+    };
+    if (!known) {
+        refuse(1, "it is not a member of our session");
+        return;
+    }
+    if (Get<u32>(main + ND_SITE) != ND_HOOK) {
+        refuse(2, fmt::format("the NEEDDATA cave is not in this build (word {:#010x} at 0x14DE8B4)",
+                              Get<u32>(main + ND_SITE)));
+        return;
+    }
+    // v4.52: an early ask (loading screen, every 1.5 s) may be answered once a second.
+    if (const auto at = need_queued_at.find(in.requester);
+        at != need_queued_at.end() &&
+        packet.at - at->second < (in.reserved2 == NEED_EARLY ? 1s : 4s)) {
+        return; // one answer per request (they come every 5 s)
+    }
+    const u64 box = main + ND_BOX;
+    if (Get<u32>(box) != 0) {
+        refuse(3, fmt::format("the NEEDDATA box is still full: our game cannot answer yet (state {})",
+                              Get<u32>(manager + S_STATE)));
+        return; // the game has not taken the last one: the next request tries again
+    }
+    Put<u64>(box + 8, in.requester);
+    Put<u32>(box, 1);
+    need_queued_at[in.requester] = packet.at;
+    Log(fmt::format("player data: player {} ({:#x}) still waits for ours (its request #{}); its id "
+                    "is queued in our game's NEEDDATA box, answered on its next tick that can answer "
+                    "({} answered so far, state {}) (v4.37 NEEDDATA)",
+                    in.player_no, in.requester & 0xFFFFFFFFFF, in.count, Get<u32>(box + 4),
+                    Get<u32>(manager + S_STATE)));
+}
+
+/// v4.43 HOSTTEXT: are both hook words of the cave pair in the game (looked at once a second)?
+bool Assist::State::HostTextHooks(Clock::time_point now) {
+    if (main == 0) {
+        return false;
+    }
+    if (now - host_text_hooks_at >= 1s) {
+        host_text_hooks_at = now;
+        const bool caves = Get<u32>(main + HT_REQ_SITE) == HT_REQ_HOOK &&
+                           Get<u32>(main + HT_TXT_SITE) == HT_TXT_HOOK;
+        // The on / off switch: the feature runs only while a file dusk_lan_hosttext_on.txt exists next
+        // to the status file or in <package>\lan_fix. No file = off: nothing is read, sent, taken or
+        // written to the box, on this game.
+        // alpha 14: ON by default (every player shows the host's texts with no set-up); a file
+        // dusk_lan_hosttext_off.txt next to the status file switches it off on this game.
+        bool on = caves;
+        if (caves && !status_path.empty()) {
+            std::error_code ec;
+            on = !std::filesystem::exists(status_path.parent_path() / "dusk_lan_hosttext_off.txt", ec);
+        }
+        const bool ok = caves && on;
+        if (ok != host_text_hooks) {
+            host_text_hooks = ok;
+            Log(ok ? "host text: ON (the HOSTTEXT caves are in this game at 0x12E36CC and 0x1A2C354); "
+                     "dusk_lan_say.txt and type 27 are used"
+                   : caves ? "host text: OFF (dusk_lan_hosttext_off.txt exists); texts are not read, taken or shown"
+                           : "host text: the HOSTTEXT caves are not in this game; texts are not shown");
+        }
+    }
+    return host_text_hooks;
+}
+
+/// v4.43 HOSTTEXT: a text for the box. Drops the oldest when 4 wait.
+void Assist::State::HostTextAdd(u32 seq, u8 target, std::u16string text, Clock::time_point now) {
+    if (host_text_seen.size() > 64) {
+        host_text_seen.clear();
+    }
+    host_text_seen.insert(seq);
+    host_text_queue.push_back(HostTextItem{seq, target, std::move(text), now});
+    while (host_text_queue.size() > HT_QUEUE_MAX) {
+        host_text_queue.pop_front();
+    }
+}
+
+/// v4.43 HOSTTEXT: ASCII 0x20..0x7E only (anything else becomes '?'), '<' and '>' dropped (the UI
+/// reads <?tag?> as markup), trimmed, at most 60 characters.
+static std::u16string HostTextClean(std::string_view in) {
+    std::u16string out;
+    for (const unsigned char c : in) {
+        if (c == '<' || c == '>' || c == '\r' || c == '\n' || c == '\t') {
+            continue;
+        }
+        out.push_back(c >= 0x20 && c <= 0x7E ? static_cast<char16_t>(c) : u'?');
+    }
+    while (!out.empty() && out.back() == u' ') {
+        out.pop_back();
+    }
+    size_t first = 0;
+    while (first < out.size() && out[first] == u' ') {
+        ++first;
+    }
+    out.erase(0, first);
+    if (out.size() > HT_MAX) {
+        out.resize(HT_MAX);
+    }
+    return out;
+}
+
+/// v4.43 HOSTTEXT: the cleaned text (ASCII by now) as a std::string for the log.
+static std::string HostTextAscii(const std::u16string& in) {
+    std::string out;
+    for (const char16_t c : in) {
+        out.push_back(c < 0x80 ? static_cast<char>(c) : '?');
+    }
+    return out;
+}
+
+/// v4.43 HOSTTEXT: the host panel (frontend_api.py /api/say) writes dusk_lan_say.txt next to
+/// dusk_lan_match.txt: "say <seq> <target> <unix time>" and, on the next line, the text in UTF-8.
+/// The game on the host PC reads it once a second (as LobbyShare reads the match file), shows the
+/// text itself and sends it to the others (type 27, 3 copies). Every game queues what it gets and
+/// writes one text at a time into the HTBOX (at most every 3 s, only in a stage, only while the box
+/// is free), then waits for the cave pair: 1 (written) -> 2 (game asked) -> 3 (shown) -> 0.
+/// Without the two hook words, or without the file, nothing here reads or writes anything.
+void Assist::State::HostText(Clock::time_point now) {
+    if (main == 0 || status_path.empty() || !HostTextHooks(now)) {
+        return;
+    }
+    // 1: the file.
+    if (now - host_text_read_at >= 1s) {
+        host_text_read_at = now;
+        std::vector<std::filesystem::path> paths{status_path.parent_path() / "dusk_lan_say.txt"};
+#ifdef _WIN32
+        paths.push_back(Common::FS::GetExeDirectory().parent_path() / "lan_fix" / "dusk_lan_say.txt");
+#endif
+        for (const auto& path : paths) {
+            std::ifstream file{path};
+            if (!file) {
+                continue;
+            }
+            std::string word;
+            u64 seq_wide = 0; // the panel writes a number of up to 31 bits; a time in ms is also taken
+            unsigned target = 0;
+            long long written = 0;
+            std::string rest;
+            std::string line;
+            if (!(file >> word >> seq_wide >> target >> written) || word != "say") {
+                if (!host_text_parse_logged) {
+                    host_text_parse_logged = true;
+                    Log(fmt::format("host text: {} exists but its first line is not \"say <seq> <target> "
+                                    "<unix time>\" (read: word \"{}\", seq {}, target {}, time {}); ignored",
+                                    Common::FS::PathToUTF8String(path), word, seq_wide, target, written));
+                }
+                continue;
+            }
+            u32 seq = static_cast<u32>(seq_wide ^ (seq_wide >> 32));
+            if (seq == 0) {
+                seq = 1;
+            }
+            std::getline(file, rest); // the end of the header line
+            std::getline(file, line);
+            const long long age = static_cast<long long>(std::time(nullptr)) - written;
+            if (seq == 0 || host_text_seen.contains(seq) || target > 8 || age < -60 || age > 20) {
+                continue;
+            }
+            std::u16string text = HostTextClean(line);
+            if (text.empty()) {
+                host_text_seen.insert(seq);
+                Log(fmt::format("host text: #{} in {} is empty after cleaning; ignored", seq,
+                                Common::FS::PathToUTF8String(path)));
+                continue;
+            }
+            const std::string shown = HostTextAscii(text);
+            Log(fmt::format("host text: #{} for {} read from {} ({} s old): \"{}\"; shown here and sent "
+                            "to the other games (type 27, 3 copies) (v4.43 HOSTTEXT)",
+                            seq,
+                            target == 0 ? std::string("every player") : fmt::format("player {}", target),
+                            Common::FS::PathToUTF8String(path), age, shown));
+            HostTextMessage out;
+            out.target = static_cast<u8>(target);
+            out.len = static_cast<u8>(text.size());
+            out.instance = instance;
+            out.seq = seq;
+            for (size_t i = 0; i < text.size(); ++i) {
+                out.text[i] = static_cast<u16>(text[i]);
+            }
+            host_text_out.assign(reinterpret_cast<const u8*>(&out),
+                                 reinterpret_cast<const u8*>(&out) + sizeof(out));
+            host_text_sends = 3;
+            host_text_next_send = now;
+            HostTextAdd(seq, static_cast<u8>(target), std::move(text), now);
+        }
+    }
+    // 2: the copies.
+    if (host_text_sends > 0 && now >= host_text_next_send) {
+        Network::LanSide::Send(std::span<const u8>(host_text_out.data(), host_text_out.size()));
+        --host_text_sends;
+        host_text_next_send = now + 400ms;
+    }
+    // 3: the box.
+    const u64 box = main + HT_BOX;
+    const u32 box_state = Get<u32>(box);
+    if (box_state != host_text_state_seen) {
+        host_text_state_seen = box_state;
+        host_text_state_since = now;
+        if (box_state == 2) {
+            Log(fmt::format("host text: the game asked for the banner (request #{}) (HTREQ)",
+                            Get<u32>(box + 12)));
+        } else if (box_state == 3) {
+            Log(fmt::format("host text: the banner took our text (shown #{}) (HTTEXT)",
+                            Get<u32>(box + 8)));
+        }
+    }
+    if (box_state == 3 && now - host_text_state_since >= 8s) {
+        Put<u32>(box, 0); // the banner is over (the UI keeps a pointer into the box until then)
+    } else if (box_state == 2 && now - host_text_state_since >= 5s) {
+        Log("host text: the game asked for the banner but the lookup never took the text in 5 s "
+            "(another 10810 lookup, or the UI did not run); the box is freed (HTTEXT)");
+        Put<u32>(box, 0);
+    } else if (box_state == 1 && now - host_text_state_since >= 30s) {
+        Log("host text: the text waited 30 s and the game never asked for the banner (not in a stage, "
+            "or HTREQ is not running); dropped (HTREQ)");
+        Put<u32>(box, 0);
+    }
+    if (box_state != 0 || host_text_queue.empty() || now - host_text_last_shown < 3s) {
+        return;
+    }
+    if (Get<u64>(main + STAGE_PHASE) == 0) {
+        return; // not in a match: the text waits (up to 10 s)
+    }
+    const u32 own = LocalPlayerNo();
+    while (!host_text_queue.empty()) {
+        HostTextItem item = std::move(host_text_queue.front());
+        host_text_queue.pop_front();
+        if (now - item.at > 10s) {
+            continue; // too old to be news
+        }
+        if (item.target != 0 && item.target != own) {
+            continue; // for another player
+        }
+        for (size_t i = 0; i < item.text.size(); ++i) {
+            Put<u16>(box + 0x10 + 2 * i, static_cast<u16>(item.text[i]));
+        }
+        Put<u16>(box + 0x10 + 2 * item.text.size(), 0);
+        Put<u32>(box + 4, item.seq);
+        Put<u32>(box, 1); // last: the game thread may take it from here
+        host_text_last_shown = now;
+        host_text_state_seen = 1;
+        host_text_state_since = now;
+        Log(fmt::format("host text: #{} is in the box (state 1), waiting for the game's request: \"{}\"",
+                        item.seq, HostTextAscii(item.text)));
+        return;
+    }
+}
+
+/// v4.43 HOSTTEXT: type 27 from another game.
+void Assist::State::HostTextHeard(const Network::LanSide::Packet& packet) {
+    HostTextMessage in;
+    if (packet.data.size() != sizeof(in) || main == 0) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.seq == 0 || in.len == 0 || in.len > HT_MAX || in.target > 8) {
+        return;
+    }
+    if (!HostTextHooks(Clock::now())) {
+        if (!host_text_refused_logged) {
+            host_text_refused_logged = true;
+            Log("host text: a text came from the host, but host text is OFF here (no switch file) or its caves are not in this game; ignored");
+        }
+        return;
+    }
+    if (host_text_seen.contains(in.seq)) {
+        return; // one of the 3 copies, or the same file read by a second game on this PC
+    }
+    std::string raw;
+    for (size_t i = 0; i < in.len; ++i) {
+        raw.push_back(in.text[i] < 0x80 ? static_cast<char>(in.text[i]) : '?');
+    }
+    std::u16string text = HostTextClean(raw);
+    if (text.empty()) {
+        host_text_seen.insert(in.seq);
+        return;
+    }
+    Log(fmt::format("host text: #{} from game {:#010x} for {}: \"{}\" (v4.43 HOSTTEXT)", in.seq,
+                    in.instance,
+                    in.target == 0 ? std::string("every player") : fmt::format("player {}", in.target),
+                    HostTextAscii(text)));
+    HostTextAdd(in.seq, in.target, std::move(text), packet.at);
+}
+
+/// v4.34 quorum: another game's list of the finalists it hears (type 24), read by FinalPlacement.
+void Assist::State::HearHeard(const Network::LanSide::Packet& packet) {
+    HearMessage in;
+    if (packet.data.size() != sizeof(in)) {
+        return;
+    }
+    std::memcpy(&in, packet.data.data(), sizeof(in));
+    if (in.instance == instance || in.player_no == 0 || in.player_no > 32 || CutNo(in.player_no)) {
+        return; // ours, no number, or a cut player's game (not in our match)
+    }
+    final_hear_reports[in.player_no] = {in.heard, packet.at};
+    final_hear_out[in.player_no] = in.out; // v4.34b
+}
