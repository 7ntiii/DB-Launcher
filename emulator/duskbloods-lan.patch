+/// v4.41 POWER46A, alpha RECONSTRUCTION (alpha_reconstructions.md b): the intermission Power offer
+/// is drawn by each game's own generator with weight 1 for every SkillParam row and the roll forced
+/// (the shipped weights are all 0; the network test's server sent the options). One line per
+/// intermission, so a log shows where the offered Powers came from.
+void Assist::State::PowerOfferNote(u32 phase, u64 stage) {
+    if (main == 0 || session.state != 8 || phase != PHASE_INTERMISSION ||
+        Get<u32>(main + P46_SITE) != P46_WORD) {
+        return;
+    }
+    const u64 key = (u64{match_gen} << 8) | (Get<u32>(stage + P_ROUND) & 0xFF);
+    if (power46a_logged == key) {
+        return;
+    }
+    power46a_logged = key;
+    Log(fmt::format("Powers: RECONSTRUCTED (alpha): this intermission's Power offer (round {}) is drawn "
+                    "here with weight 1 for every SkillParam row and the roll forced for every player; "
+                    "the network test's server list is not known (v4.41 POWER46A)",
+                    Get<u32>(stage + P_ROUND)));
+}
