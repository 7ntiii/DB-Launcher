diff --git a/src/video_core/buffer_cache/nx2_fast_cpu_marks.h b/src/video_core/buffer_cache/nx2_fast_cpu_marks.h
new file mode 100644
index 0000000000..fe28dc5c08
--- /dev/null
+++ b/src/video_core/buffer_cache/nx2_fast_cpu_marks.h
@@ -0,0 +1,216 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cstddef>
+#include <utility>
+
+#include "common/common_types.h"
+#include "common/spin_recursive_mutex.h"
+
+/// Lock-free CPU write marks for the buffer cache (perf flag fast_marks).
+///
+/// A guest write trapped on a buffer page used to take the buffer cache's lock to mark the page
+/// CPU-modified. The GPU thread holds that lock for every draw it configures, so in The
+/// Duskbloods' matches (~62k traps a second) the guest cores spent ~9% of their time waiting for
+/// it. With fast_marks the trap only sets the page's bit in `pending` (one atomic OR, no lock)
+/// and returns; whoever takes the buffer cache's lock next (Nx2DrainingMutex) applies the pending
+/// marks before doing anything else. That is the order the locked trap could have had anyway: as
+/// if the guest had taken the lock just before that thread.
+///
+/// Pages that hold GPU-written data need the exact write (it is collected and replayed in order),
+/// so they keep the locked path. `maybe_gpu` holds a bit for every page the buffer cache ever
+/// marked GPU-modified (never cleared: a superset). The buffer cache sets the bits before it marks
+/// the pages and then takes their pending bits itself (TakePending), and the trap sets its pending
+/// bit before it reads maybe_gpu again: one of the two sees the other's store (both seq_cst), so a
+/// fast mark is never left behind on a page that became GPU-modified.
+namespace VideoCommon::Nx2FastMarks {
+
+constexpr u64 PAGE_BITS = 12;
+constexpr u64 NUM_PAGES = u64{1} << (36 - PAGE_BITS);
+constexpr u64 NUM_WORDS = NUM_PAGES / 64;
+constexpr u64 NUM_L1 = NUM_WORDS / 64;
+constexpr u64 NUM_L2 = NUM_L1 / 64;
+static_assert(NUM_L2 <= 64);
+
+struct State {
+    std::array<std::atomic<u64>, NUM_WORDS> pending{};
+    std::array<std::atomic<u64>, NUM_WORDS> maybe_gpu{};
+    std::array<std::atomic<u64>, NUM_L1> pending_l1{}; ///< a bit per pending word
+    std::atomic<u64> pending_l2{};                     ///< a bit per pending_l1 word
+};
+inline State g_state;
+
+/// Calls func(word_index, mask) for the words of the pages in [addr, addr + size).
+template <typename Func>
+inline void ForEachWord(u64 addr, u64 size, Func&& func) {
+    if (size == 0) {
+        return;
+    }
+    u64 page = addr >> PAGE_BITS;
+    const u64 last = (std::min)((addr + size - 1) >> PAGE_BITS, NUM_PAGES - 1);
+    while (page <= last) {
+        const u64 word = page / 64;
+        const u64 first_bit = page % 64;
+        const u64 last_bit = (std::min)(last - word * 64, u64{63});
+        const u64 mask = (~u64{0} >> (63 - last_bit)) & (~u64{0} << first_bit);
+        func(word, mask);
+        page = (word + 1) * 64;
+    }
+}
+
+/// True when a page of the range was ever marked GPU-modified.
+inline bool MaybeGpu(u64 addr, u64 size) {
+    bool any = false;
+    ForEachWord(addr, size, [&](u64 word, u64 mask) {
+        any |= (g_state.maybe_gpu[word].load(std::memory_order_seq_cst) & mask) != 0;
+    });
+    return any;
+}
+
+/// True when every page of the range is pending already.
+inline bool AllPending(u64 addr, u64 size) {
+    bool all = true;
+    ForEachWord(addr, size, [&](u64 word, u64 mask) {
+        all &= (g_state.pending[word].load(std::memory_order_relaxed) & mask) == mask;
+    });
+    return all;
+}
+
+/// Sets the pending bits of the range's pages.
+inline void SetPending(u64 addr, u64 size) {
+    ForEachWord(addr, size, [](u64 word, u64 mask) {
+        auto& slot = g_state.pending[word];
+        if ((slot.fetch_or(mask, std::memory_order_seq_cst) & mask) == mask) {
+            return; // already pending: the summary bits are (being) set by whoever set them
+        }
+        const u64 l1 = word / 64;
+        g_state.pending_l1[l1].fetch_or(u64{1} << (word % 64), std::memory_order_seq_cst);
+        g_state.pending_l2.fetch_or(u64{1} << (l1 / 64), std::memory_order_seq_cst);
+    });
+}
+
+/// Calls func(addr, size) for each run of pending pages in the bits taken from `bits`.
+template <typename Func>
+inline void ReleaseRuns(u64 word, u64 bits, Func&& func) {
+    while (bits != 0) {
+        const u64 begin = std::countr_zero(bits);
+        const u64 run = std::countr_one(bits >> begin);
+        func(((word * 64 + begin) << PAGE_BITS), run << PAGE_BITS);
+        if (begin + run >= 64) {
+            break;
+        }
+        bits &= ~u64{0} << (begin + run);
+    }
+}
+
+/// Marks the range's pages GPU-modified for the traps, then takes (clears) their pending bits and
+/// calls func on them: the caller applies those marks before it marks the range GPU-modified.
+template <typename Func>
+inline void MarkGpuAndTakePending(u64 addr, u64 size, Func&& func) {
+    ForEachWord(addr, size, [](u64 word, u64 mask) {
+        auto& slot = g_state.maybe_gpu[word];
+        if ((slot.load(std::memory_order_relaxed) & mask) != mask) {
+            slot.fetch_or(mask, std::memory_order_seq_cst);
+        }
+    });
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    ForEachWord(addr, size, [&](u64 word, u64 mask) {
+        auto& slot = g_state.pending[word];
+        if ((slot.load(std::memory_order_seq_cst) & mask) == 0) {
+            return;
+        }
+        const u64 taken = slot.fetch_and(~mask, std::memory_order_seq_cst) & mask;
+        ReleaseRuns(word, taken, func);
+    });
+}
+
+inline bool AnyPending() {
+    return g_state.pending_l2.load(std::memory_order_relaxed) != 0;
+}
+
+/// Takes every pending page and calls func(addr, size) on each run of them.
+template <typename Func>
+inline void Drain(Func&& func) {
+    u64 l2 = g_state.pending_l2.exchange(0, std::memory_order_seq_cst);
+    while (l2 != 0) {
+        const u64 l2_bit = std::countr_zero(l2);
+        l2 &= l2 - 1;
+        for (u64 l1 = l2_bit * 64; l1 < (std::min)(l2_bit * 64 + 64, NUM_L1); ++l1) {
+            if (g_state.pending_l1[l1].load(std::memory_order_relaxed) == 0) {
+                continue;
+            }
+            u64 words = g_state.pending_l1[l1].exchange(0, std::memory_order_seq_cst);
+            while (words != 0) {
+                const u64 word = l1 * 64 + std::countr_zero(words);
+                words &= words - 1;
+                const u64 bits = g_state.pending[word].exchange(0, std::memory_order_seq_cst);
+                ReleaseRuns(word, bits, func);
+            }
+        }
+    }
+}
+
+/// The buffer cache's lock: a SpinRecursiveMutex that applies the pending fast marks whenever a
+/// thread takes it (not when it re-enters it), and runs `after` once it let go of it, when the
+/// drain asked for that (page protection changes the drain left for later, see DeferUncache).
+class Nx2DrainingMutex {
+public:
+    using DrainHook = bool (*)(void*);
+    using AfterHook = void (*)(void*);
+
+    void SetHooks(DrainHook drain_, AfterHook after_, void* context_) {
+        drain = drain_;
+        after = after_;
+        context = context_;
+    }
+
+    void lock() {
+        inner.lock();
+        if (++depth == 1) {
+            OnAcquire();
+        }
+    }
+
+    bool try_lock() {
+        if (!inner.try_lock()) {
+            return false;
+        }
+        if (++depth == 1) {
+            OnAcquire();
+        }
+        return true;
+    }
+
+    void unlock() {
+        if (--depth != 0) {
+            inner.unlock();
+            return;
+        }
+        const bool run_after = std::exchange(after_pending, false);
+        inner.unlock();
+        if (run_after) {
+            after(context);
+        }
+    }
+
+private:
+    void OnAcquire() {
+        if (drain != nullptr && AnyPending()) [[unlikely]] {
+            after_pending |= drain(context);
+        }
+    }
+
+    Common::SpinRecursiveMutex inner;
+    DrainHook drain{};
+    AfterHook after{};
+    void* context{};
+    u32 depth{};             ///< Touched only by the owner
+    bool after_pending{};    ///< Touched only by the owner
+};
+
+} // namespace VideoCommon::Nx2FastMarks
