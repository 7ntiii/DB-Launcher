+Assist::State::State(System& system_) : system{system_} {
+    // Keep the logs of the last five runs (dusk_lan.1.txt is the run before this one): a problem
+    // seen in a match can still be read after the game was started again. Once per emulator run
+    // (this object is made again for every game start, and the old one may still hold the file).
+    const auto log_dir = Common::FS::GetEdenPath(Common::FS::EdenPath::LogDir);
+    static bool rotated = false;
+    if (!rotated) {
+        rotated = true;
+        std::error_code ignored;
+        for (int n = 4; n >= 1; --n) {
+            std::filesystem::rename(log_dir / fmt::format("dusk_lan.{}.txt", n),
+                                    log_dir / fmt::format("dusk_lan.{}.txt", n + 1), ignored);
+        }
+        // Copy, not rename: a file another handle still has open cannot be renamed on Windows.
+        std::filesystem::copy_file(log_dir / "dusk_lan.txt", log_dir / "dusk_lan.1.txt",
+                                   std::filesystem::copy_options::overwrite_existing, ignored);
+        log.open(log_dir / "dusk_lan.txt", std::ios::out | std::ios::trunc);
+    } else {
+        log.open(log_dir / "dusk_lan.txt", std::ios::out | std::ios::app);
+    }
+    status_path = Common::FS::GetEdenPath(Common::FS::EdenPath::LogDir) / "dusk_lan_status.json";
+    Log("Duskbloods LAN assist started");
+    Network::LanSide::Enable(P2P_PORT);
+    instance = std::random_device{}() | 1;
+    if (const char* text = std::getenv("LICHII_DUSK_PLAYER"); text != nullptr && *text != '\0') {
+        unsigned no = 0;
+        unsigned team = 0;
+        if (std::sscanf(text, "%u:%u", &no, &team) == 2 && no >= 1 && no <= 16 && team <= 0xFF) {
+            player.emplace(no, team);
+            Log(fmt::format("LICHII_DUSK_PLAYER: player no {} team {}", no, team));
+        } else {
+            Log(fmt::format("LICHII_DUSK_PLAYER={} is not no:team with no 1..16; using the member "
+                            "order",
+                            text));
+        }
+    }
+    if (const char* text = std::getenv("DUSK_NUMBER_FORCE_B"); text != nullptr && *text != '\0') {
+        const char* user_dir = std::getenv("LICHII_USER_DIR");
+        unsigned forced = 0;
+        if (user_dir != nullptr && *user_dir != '\0' && std::sscanf(text, "%u", &forced) == 1 &&
+            forced >= 1 && forced <= 16) {
+            number_force = forced;
+            Log(fmt::format("DUSK_NUMBER_FORCE_B: this game proposes player no {} (rig test of the "
+                            "v413 number exchange)",
+                            forced));
+        }
+    }
+    // v3.9.5 F5: the match server (frontend_api.py MIN_PLAYERS) and the rig (go4.sh) read the same
+    // variable; with it set, numbering waits until that many members are listed (late joiners).
+    if (const char* text = std::getenv("DUSK_MATCH_MIN"); text != nullptr && *text != '\0') {
+        unsigned wanted = 0;
+        if (std::sscanf(text, "%u", &wanted) == 1 && wanted >= 2 && wanted <= 16) {
+            match_min = wanted;
+            Log(fmt::format("DUSK_MATCH_MIN: numbering waits for {} players (or {} s with no "
+                            "new member, F5)",
+                            wanted, MEMBER_WAIT_MAX.count()));
+        } else {
+            Log(fmt::format("DUSK_MATCH_MIN={} is not 2..16; numbering does not wait for it",
+                            text));
+        }
+    }
+}
