+void Assist::State::Run(std::stop_token stop) {
+    Common::SetCurrentThreadName("DuskLan");
+    auto next = Clock::now() + 1s;
+    // Audit Q2 (measure only): the slowest pass of each 10 s, with its three biggest parts, is
+    // logged when it took 5 ms or more (at most one line per 10 s, 60 per run). The assist runs on
+    // its own thread and takes no lock the game needs, so this is CPU time, not a frame stall.
+    using Ms = std::chrono::duration<double, std::milli>;
+    auto perf_at = Clock::now() + 10s;
+    double perf_worst = 0.0, perf_tick = 0.0, perf_enemies = 0.0, perf_map = 0.0, perf_taken = 0.0;
+    u32 perf_lines = 0;
+    while (!stop.stop_requested()) {
+        const auto pass_start = Clock::now();
+        double tick_ms = 0.0;
+        if (pass_start >= next) {
+            Tick();
+            next = Clock::now() + 1s;
+            tick_ms = Ms(Clock::now() - pass_start).count();
+        }
+        if (in_battle) {
+            Sample(Clock::now());
+        }
+        ConfirmEffects();
+        const auto enemies_start = Clock::now();
+        EnemyOwners(enemies_start);
+        PartSync(Clock::now()); // PARTSYNC: Trespasser participant lists (every 100 ms)
+        const double enemies_ms = Ms(Clock::now() - enemies_start).count();
+        SampleNetClock(Clock::now());
+        FinalStartPoints();
+        const auto map_start = Clock::now();
+        MapShare(map_start);
+        const double map_ms = Ms(Clock::now() - map_start).count();
+        SideFast(); // review2 R6: Virtue / Commendation sets within 50 ms, not up to 1 s
+        VirtueShare(Clock::now());
+        CommendShare(Clock::now());
+        PowerChoiceWatch(Clock::now()); // v4.31 POWER_CHOICE (read only)
+        const auto taken_start = Clock::now();
+        TakenShare(taken_start);
+        const double taken_ms = Ms(Clock::now() - taken_start).count();
+        TakeRace(Clock::now());        // v4.36 TAKERACE (after the side channel and TakenShare)
+        ItemMarkWatch(Clock::now(), false); // deep_audit_L 1b: unanswered take marks
+        HandoverState(Clock::now());        // deep_audit_L 1b: once, after taking the authority
+        FinalPlacement(Clock::now());
+        CutCheck(Clock::now());        // v3.9.4 F1
+        CutAuth(Clock::now());         // V401 CUTAUTH
+        BloodboundWatch(Clock::now()); // v3.9.4 F2 / F3 (read only)
+        CutsceneVote(Clock::now());    // v4.30 CUTSCENE_VOTE
+        HostText(Clock::now());        // v4.43 HOSTTEXT (does nothing without its hooks / say file)
+        const auto pass_end = Clock::now();
+        if (const double pass_ms = Ms(pass_end - pass_start).count(); pass_ms > perf_worst) {
+            perf_worst = pass_ms;
+            perf_tick = tick_ms;
+            perf_enemies = enemies_ms;
+            perf_map = map_ms;
+            perf_taken = taken_ms;
+        }
+        if (pass_end >= perf_at) {
+            if (perf_worst >= 5.0 && perf_lines < 60) {
+                ++perf_lines;
+                Log(fmt::format("perf: slowest assist pass of 10 s {:.1f} ms (tick {:.1f}, enemies "
+                                "{:.1f}, map {:.1f}, taken {:.1f}; audit Q2, line {} of 60)",
+                                perf_worst, perf_tick, perf_enemies, perf_map, perf_taken,
+                                perf_lines));
+            }
+            perf_worst = 0.0;
+            perf_at = pass_end + 10s;
+        }
+        std::this_thread::sleep_for(50ms);
+    }
+}
