+namespace {
+/// A state word as its four bytes (stage, reason, flag, done), e.g. "04 05 01 01".
+std::string StageBytes(u32 word) {
+    return fmt::format("{:02x} {:02x} {:02x} {:02x}", word & 0xFF, (word >> 8) & 0xFF,
+                       (word >> 16) & 0xFF, word >> 24);
+}
+/// Stage 4 with the flag byte set: out (cut or eliminated), not the winner.
+constexpr bool StageIsOut(u32 word) {
+    return (word & 0xFF) == 4 && ((word >> 16) & 0xFF) == 1;
+}
+/// Stage 4, reason 5, flag 1 (04 05 xx xx): eliminated (the host's death list, H1:950). Unlike
+/// StageIsOut this is not what a final's EndPhase gives a player beaten on points (04 03 01 01), so
+/// it still means "out" after the final's UpdatePhase.
+constexpr bool StageIsEliminated(u32 word) {
+    return StageIsOut(word) && ((word >> 8) & 0xFF) == 5;
+}
+} // namespace
