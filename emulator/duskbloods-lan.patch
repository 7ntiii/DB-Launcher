+/// v3.9.4 F2 / F3 (players8_notes.md), read only, Bloodbound (rule byte 2) only.
+/// F2: in UpdatePhase of rounds 1..3 the VIRTUE_BOX publish count (+4) must keep moving; if it
+/// stands still 5 s the partner copies on the other games go stale (the Duo HUD path 0xD17B80
+/// bypasses the VIRTUE_PUB hook) -> logged once per round. The fix is a game hook (notes 3).
+/// F3: in the final (round 4), from UpdatePhase on, the team records R+0xCB8 (0x40 each, count
+/// R+0xDC0) of the stage and of the match-result copy, and every entry's no / +0x10 / +0x20 /
+/// +0x40, logged whenever they change (12 lines per match at most): the data FinalAlign's pair
+/// placement needs (bloodbound_notes 3). Nothing is written.
+void Assist::State::BloodboundWatch(Clock::time_point now) {
+    if (main == 0 || session.manager == 0 || session.state != 8 ||
+        Get<u8>(main + RULE_BYTE) != RULE_BLOODBOUND) {
+        return;
+    }
+    const u64 stage = Get<u64>(main + STAGE_PHASE);
+    if (stage == 0) {
+        return;
+    }
+    const u32 phase = Get<u32>(stage + P_STATE);
+    const u32 round = Get<u32>(stage + P_ROUND);
+    if (round >= 1 && round < FINAL_ROUND && phase == PHASE_UPDATE) {
+        const u64 key = (u64{match_gen} << 32) | round;
+        const u32 count = Get<u32>(main + VIRTUE_BOX + 4);
+        if (key != bb_box_key) {
+            bb_box_key = key;
+            bb_box_count = count;
+            bb_box_moved = now;
+        } else if (count != bb_box_count) {
+            bb_box_count = count;
+            bb_box_moved = now;
+            if (bb_box_logged.insert(key).second) {
+                Log(fmt::format("bloodbound (F2): round {}: the Virtue box is published "
+                                "(count {}); partner totals reach the other games",
+                                round, count));
+            }
+        } else if (now - bb_box_moved > 5s && bb_box_logged.insert(key | (u64{1} << 63)).second) {
+            Log(fmt::format("!!! bloodbound (F2): round {}: the Virtue box count stood at {} for "
+                            "5 s in UpdatePhase: our total is not published (Duo HUD path "
+                            "0xD17B80 skips VIRTUE_PUB), so the other games rank our pair with "
+                            "a stale copy; needs the VIRTUE_PUB2 hook (assist_v394_notes 3) !!!",
+                            round, count));
+        }
+        return;
+    }
+    if (round != FINAL_ROUND || phase < PHASE_UPDATE) {
+        return;
+    }
+    if (bb_final_gen != match_gen) {
+        bb_final_gen = match_gen;
+        bb_final_logs = 0;
+        bb_final_last.clear();
+    }
+    if (bb_final_logs >= 12) {
+        return;
+    }
+    const auto team_list = [&](u64 r) {
+        if (r == 0) {
+            return std::string(" -");
+        }
+        const u64 n = Get<u64>(r + 0xDC0);
+        if (n > 4) {
+            return fmt::format(" count {:#x} (not 0..4)", n);
+        }
+        std::string out = fmt::format(" n {}", n);
+        for (u64 i = 0; i < n; ++i) {
+            const u64 rec = r + 0xCB8 + i * 0x40;
+            out += fmt::format(" [{:08x} {:08x} {:08x} {:08x}]", Get<u32>(rec), Get<u32>(rec + 0x10),
+                               Get<u32>(rec + 0x20), Get<u32>(rec + 0x30));
+        }
+        return out;
+    };
+    std::string text = "stage R" + team_list(stage + 0x3940) + "; copy" +
+                       team_list(Get<u64>(stage + P_MATCH_RESULT)) + "; entries";
+    const u64 count = Get<u64>(stage + P_ENTRY_COUNT);
+    for (u64 i = 0; i < count && count <= P_ENTRY_MAX; ++i) {
+        const u64 entry = stage + P_ENTRIES + i * PE_SIZE;
+        text += fmt::format(" {}:r{}:t{}:{}", Get<u32>(entry), Get<u32>(entry + PE_RANK),
+                            Get<u32>(entry + 0x20), StageBytes(Get<u32>(entry + PE_STATE)));
+    }
+    if (text != bb_final_last) {
+        bb_final_last = text;
+        ++bb_final_logs;
+        Log(fmt::format("bloodbound (F3 data): final step {}: {}", phase, text));
+    }
+}
