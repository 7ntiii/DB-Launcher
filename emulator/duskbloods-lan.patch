+/// Forgets everything MapShare knew about a match (review H1): at a new match and at the session's
+/// end. The inbox valid word is cleared (a record left from the old match is not fed into the new
+/// one; writing 0 while the game is in the setter is harmless, it writes 0 itself after it) and
+/// the fed-round marker is set to `fed`: ~0U for a new match, the current round at the session's
+/// end so a PrepareThird that still waits goes on (review M3).
+void Assist::State::MapReset(u32 fed) {
+    map_round_seen = 0;
+    map_sent_round = map_in_round = map_fed_round = ~0U;
+    // LEVELSHARE: a new match (or the session's end) forgets the levels; the cave's box is disarmed.
+    level_sent.clear();
+    level_sent_round = level_in_round = level_done_round = level_armed_round = ~0U;
+    level_in.clear();
+    level_in_from = 0;
+    level_arms = 0;
+    level_late_logged = false;
+    if (main != 0) {
+        Put<u32>(main + LEVEL_BOX, 0);
+    }
+    map_out.clear();
+    map_in.clear();
+    map_out_repeats = 0;
+    map_out_cursor = 0;
+    map_feed_next = 0;
+    map_feed_since.reset();
+    map_wait_since.reset();
+    map_wait_logged = false;
+    map_in_instance = 0;
+    map_in_from = 0;
+    map_other_logged = ~0U;
+    map_off_since.reset();
+    map_ready_low_round = ~0U;
+    map_round_logged = ~0U;
+    map_slow_logged = false;
+    trend_in_round = trend_done_round = ~0U;
+    trend_in_from = 0;
+    trend_in.clear();
+    trend_parts.clear();
+    trend_parts_round = ~0U;
+    trend_parts_from = 0;
+    trend_writes = 0;
+    icons_in.clear();
+    icons_in_valid = false;
+    icons_in_round = icons_done_round = ~0U;
+    icons_in_from = 0;
+    icons_writes = 0;
+    host_skip_logged = 0;
+    for (auto& [key, peer] : peers) {
+        peer.host_at.reset();
+    }
+    if (main != 0) {
+        Put<u32>(main + MAP_INBOX, 0);
+        Put<u32>(main + ICON_BOX, 0);
+        Put<u32>(main + MAP_FED, fed);
+    }
+}
