+VKAPI_ATTR void VKAPI_CALL FreeMemory(VkDevice device, VkDeviceMemory memory,
+                                      const VkAllocationCallbacks*) {
+    auto& state{Get()};
+    {
+        std::scoped_lock lock{state.mutex};
+        state.queue.emplace_back(device, memory);
+    }
+    state.cv.notify_one();
