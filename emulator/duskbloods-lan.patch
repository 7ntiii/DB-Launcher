+    /// A cached page count change UpdatePagesCachedCount put off (DeferCachedUpdates).
+    struct DeferredCachedUpdate {
+        DAddr addr;
+        size_t size;
+        s32 delta;
+    };
+    /// While set on a thread, its UpdatePagesCachedCount calls are queued here instead of run:
+    /// a guest write trapped on a cached page changes the counts (and the page protection, a
+    /// system call) under the GPU caches' locks, which the GPU thread needs for every draw. The
+    /// caller applies the queue once it dropped those locks (ApplyDeferredCachedUpdates).
+    /// (merge build-366: renamed from deferred_cached_updates, which is now upstream's counter of
+    /// Begin/EndDeferredCachedUpdates holders.)
+    static inline thread_local std::vector<DeferredCachedUpdate>* nx2_deferred_cached_updates{};
+    void ApplyDeferredCachedUpdates(std::vector<DeferredCachedUpdate>& updates) {
+        for (const auto& update : updates) {
+            UpdatePagesCachedCount(update.addr, update.size, update.delta);
+        }
+        updates.clear();
+    }
+
     // New batch API to update multiple ranges with a single lock acquisition.
     void UpdatePagesCachedBatch(std::span<const std::pair<DAddr, size_t>> ranges, s32 delta);
 
