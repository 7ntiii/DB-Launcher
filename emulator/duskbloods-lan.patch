+struct State {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<std::pair<VkDevice, VkDeviceMemory>> queue;
+    PFN_vkFreeMemory real{};
+    std::thread thread;
+    bool stop{};
+};
+State& Get() {
+    static State state;
+    return state;
