+/// v4.23 MAP_TREND, host: one type-17 packet with this round's group-arrangement table, or empty
+/// when the table is not plausible (then nothing is sent and the guests keep theirs).
+std::vector<std::vector<u8>> Assist::State::TrendSnapshot(u64 map_system, u32 round) {
+    const u64 begin = Get<u64>(map_system + MAP_TREND_TABLE);
+    const u64 end = Get<u64>(map_system + MAP_TREND_TABLE + 8);
+    if (begin == 0 || end <= begin || (end - begin) % MAP_TREND_STRIDE != 0 ||
+        (end - begin) / MAP_TREND_STRIDE > MAP_TREND_MAX) {
+        Log(fmt::format("map trend: round {} table not sent (begin {:#x} end {:#x})", round, begin,
+                        end));
+        return {};
+    }
+    const size_t count = (end - begin) / MAP_TREND_STRIDE;
+    std::vector<u8> raw(count * MAP_TREND_STRIDE);
+    std::vector<u8> again(raw.size());
+    // Two equal reads (the game thread may be in its lottery): a torn table is not sent.
+    if (!Read(begin, raw.data(), raw.size()) || !Read(begin, again.data(), again.size()) ||
+        raw != again || Get<u64>(map_system + MAP_TREND_TABLE) != begin ||
+        Get<u64>(map_system + MAP_TREND_TABLE + 8) != end) {
+        Log(fmt::format("map trend: round {} table changed while read; not sent", round));
+        return {};
+    }
+    const u32 player_no = LocalPlayerNo();
+    if (player_no == 0 || player_no > 0xFF) {
+        return {};
+    }
+    std::vector<std::vector<u8>> packets;
+    size_t set = 0;
+    for (size_t first = 0; first < count; first += MAP_TREND_PART) {
+        const size_t part = std::min(MAP_TREND_PART, count - first);
+        TrendMessage head;
+        head.player_no = static_cast<u8>(player_no);
+        head.count = static_cast<u16>(part);
+        head.instance = instance;
+        head.round = round;
+        head.first = static_cast<u16>(first);
+        head.total = static_cast<u16>(count);
+        std::vector<u8> packet(sizeof(head) + part * sizeof(TrendEntry));
+        std::memcpy(packet.data(), &head, sizeof(head));
+        for (size_t i = 0; i < part; ++i) {
+            const u8* const at = raw.data() + (first + i) * MAP_TREND_STRIDE;
+            TrendEntry entry;
+            std::memcpy(&entry.id, at, 4);
+            std::memcpy(&entry.values, at + 4, 4);
+            set += entry.values != 0xFFFFFFFFU;
+            std::memcpy(packet.data() + sizeof(head) + i * sizeof(TrendEntry), &entry,
+                        sizeof(entry));
+        }
+        packets.push_back(std::move(packet));
+    }
+    Log(fmt::format("map trend: round {} table sent with the lists ({} groups, {} set, {} "
+                    "packets)",
+                    round, count, set, packets.size()));
+    return packets;
+}
